@page "/"
@page "/w/{WorkspaceId?}"
@inject WorkspaceApiClient Api
@inject IConfiguration Configuration

<PageTitle>Workspace editor</PageTitle>

<h1>Workspace editor</h1>

<div class="card">
    <div class="row">
        <div class="field">
            <label for="workspace-id">Workspace id (GUID)</label>
            <InputText
                id="workspace-id"
                @bind-Value="_workspaceId"
                placeholder="11111111-1111-1111-1111-111111111111"
                size="40"
            />
        </div>
        <div class="field">
            <label for="api-base-url">API base URL (empty = same origin)</label>
            <InputText
                id="api-base-url"
                @bind-Value="_apiBaseUrl"
                placeholder="http://localhost:5000"
                size="40"
            />
        </div>
        <div class="field">
            <label>&nbsp;</label>
            <button type="button" @onclick="LoadAsync" disabled="@_loading">Load</button>
        </div>
    </div>
    <p class="muted">
        Revision: <strong>@_revision</strong>
        @if (_etag is not null)
        {
            <span>· ETag: <code>@_etag</code></span>
        }
        @if (_session?.HasChanges == true)
        {
            <span>· <strong>unsaved changes</strong></span>
        }
    </p>
</div>

@if (!string.IsNullOrEmpty(_status))
{
    <p class="@(_isError ? "status error" : "status")">@_status</p>
}

@if (_session is null)
{
    <p class="muted">Loading workspace…</p>
}
else
{
    <EditForm EditContext="@_session.EditContext" OnValidSubmit="SaveAsync">
        <div class="card">
            <h2>Workspace</h2>
            <div class="field">
                <label for="workspace-name">Name</label>
                <InputText id="workspace-name" @bind-Value="_session.Model.Name" />
            </div>
        </div>

        <div class="card">
            <h2>Settings overrides</h2>
            <div class="field">
                <label for="settings-theme">Theme</label>
                <InputText id="settings-theme" @bind-Value="_session.Model.Settings.Theme" />
            </div>
            <div class="field">
                <label for="settings-retry">Retry count</label>
                <InputNumber id="settings-retry" @bind-Value="_session.Model.Settings.RetryCount" />
            </div>
            <div class="field">
                <label>
                    <InputCheckbox @bind-Value="_session.Model.Settings.Notifications" />
                    Notifications
                </label>
            </div>
            @if (_effectiveSettings is not null)
            {
                <p class="muted">
                    Effective settings (system defaults layered under overrides):
                    Theme=@_effectiveSettings.Theme,
                    RetryCount=@_effectiveSettings.RetryCount,
                    Notifications=@_effectiveSettings.Notifications
                </p>
            }
        </div>

        <div class="card">
            <h2>Quests</h2>
            @foreach (var quest in _session.Model.Quests)
            {
                <div class="card" @key="quest">
                    <div class="row">
                        <div class="field">
                            <label>Id (key)</label>
                            <InputText @bind-Value="quest.Id" size="12" />
                        </div>
                        <div class="field">
                            <label>Title</label>
                            <InputText @bind-Value="quest.Title" size="30" />
                        </div>
                        <div class="field">
                            <label>Points</label>
                            <InputNumber @bind-Value="quest.Points" />
                        </div>
                        <div class="field">
                            <label>Scores (comma-separated)</label>
                            <input
                                type="text"
                                value="@GetScoresText(quest)"
                                @onchange="(e) => SetScoresText(quest, e.Value?.ToString() ?? string.Empty)"
                                size="20"
                            />
                        </div>
                        <div class="field">
                            <label>&nbsp;</label>
                            <button type="button" @onclick="() => RemoveQuest(quest)">Remove</button>
                        </div>
                    </div>
                </div>
            }
            <button type="button" @onclick="AddQuest">Add quest</button>
        </div>

        <div class="row">
            <button type="submit" disabled="@(_saving || _session?.HasChanges != true)">
                @(_saving ? "Saving…" : "Save")
            </button>
            <button type="button" @onclick="LoadAsync" disabled="@_loading">Reload latest</button>
        </div>
    </EditForm>

    @if (_conflicts.Count > 0)
    {
        <div class="card">
            <h2>Conflicts (@_conflicts.Count)</h2>
            <p>
                Another editor changed the same members. The table keeps your value
                under Local; conflicting members currently show the server value.
                Re-apply your edits, then save again.
            </p>
            <table>
                <thead>
                    <tr>
                        <th>Path</th>
                        <th>Kind</th>
                        <th>Base</th>
                        <th>Local</th>
                        <th>Current</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var conflict in _conflicts)
                    {
                        <tr>
                            <td>
                                <code>@(string.IsNullOrEmpty(conflict.PathText) ? "(root)" : conflict.PathText)</code>
                            </td>
                            <td>@conflict.Kind</td>
                            <td>@FormatValue(conflict.BaseValue)</td>
                            <td>@FormatValue(conflict.LocalValue)</td>
                            <td>@FormatValue(conflict.CurrentValue)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    // Seed workspace id served by the demo server (GET / exposes it as
    // seedWorkspaceId; the API routes require a GUID).
    private const string SeedWorkspaceId = "11111111-1111-1111-1111-111111111111";

    [Parameter]
    public string? WorkspaceId { get; set; }

    private SparseEditSession<Workspace, Workspace.Fragment, Workspace.Patch>? _session;
    private Optional<Workspace.Fragment?> _baseFragment;
    private WorkspaceSettings? _effectiveSettings;
    private IReadOnlyList<SparsePatchConflict> _conflicts = [];
    private readonly Dictionary<Quest, string> _scoresText = new(ReferenceEqualityComparer.Instance);
    private string _workspaceId = SeedWorkspaceId;
    private string _apiBaseUrl = string.Empty;
    private string _loadedForId = string.Empty;
    private long _revision;
    private string? _etag;
    private string _status = string.Empty;
    private bool _isError;
    private bool _loading;
    private bool _saving;

    protected override void OnInitialized()
    {
        _apiBaseUrl = Configuration["ApiBaseUrl"] ?? string.Empty;
    }

    protected override async Task OnParametersSetAsync()
    {
        var id = string.IsNullOrWhiteSpace(WorkspaceId) ? SeedWorkspaceId : WorkspaceId.Trim();
        if (_session is null || !string.Equals(id, _loadedForId, StringComparison.Ordinal))
        {
            _workspaceId = id;
            _loadedForId = id;
            await LoadAsync();
        }
    }

    private void ApplyBaseUrl()
    {
        Api.BaseUrlOverride = string.IsNullOrWhiteSpace(_apiBaseUrl) ? null : _apiBaseUrl.Trim();
    }

    private async Task LoadAsync()
    {
        var id = string.IsNullOrWhiteSpace(_workspaceId) ? SeedWorkspaceId : _workspaceId.Trim();
        _workspaceId = id;
        _loadedForId = id;
        _loading = true;
        ApplyBaseUrl();
        try
        {
            var snapshot = await Api.GetAsync(id);
            AdoptSnapshot(snapshot, $"Loaded workspace '{id}' at revision {snapshot.Revision}.");
        }
        catch (Exception ex)
        {
            _isError = true;
            _status = $"Load failed: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void AdoptSnapshot(LoadedSnapshot snapshot, string status)
    {
        // Fragment.From captures an isolated baseline copy, so later model
        // edits never alias the baseline used for Between/ToJsonPatch/Rebase.
        _baseFragment = Optional<Workspace.Fragment?>.Present(
            Workspace.Fragment.From(snapshot.Workspace)
        );
        _session = CreateSession(snapshot.Workspace);
        _revision = snapshot.Revision;
        _etag = snapshot.ETag;
        _effectiveSettings = snapshot.EffectiveSettings;
        _conflicts = [];
        _scoresText.Clear();
        foreach (var quest in _session.Model.Quests)
        {
            _scoresText[quest] = string.Join(",", quest.Scores);
        }

        _isError = false;
        _status = status;
    }

    private async Task SaveAsync()
    {
        if (_session is null || _saving)
        {
            return;
        }

        _saving = true;
        ApplyBaseUrl();
        try
        {
            // Typed diff of baseline versus current, exported as RFC 6902.
            var after = Optional<Workspace.Fragment?>.Present(
                Workspace.Fragment.From(_session.Model)
            );
            var localPatch = Workspace.Patch.Between(_baseFragment, after);
            if (localPatch.IsEmpty)
            {
                _isError = false;
                _status = "No changes to save.";
                return;
            }

            var outcome = await Api.PatchAsync(
                _workspaceId,
                _etag,
                localPatch.ToJsonPatch(_baseFragment)
            );
            switch (outcome)
            {
                case Saved saved:
                    AdoptSnapshot(
                        saved.Snapshot,
                        $"Saved as revision {saved.Snapshot.Revision}."
                    );
                    break;
                case SaveConflict conflict:
                    await HandleConflictAsync(localPatch, conflict.Latest);
                    break;
                case SaveRejected rejected:
                    _isError = true;
                    _status = rejected.Detail;
                    break;
            }
        }
        catch (Exception ex)
        {
            _isError = true;
            _status = $"Save failed: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task HandleConflictAsync(
        Workspace.Patch localPatch,
        LoadedSnapshot latest
    )
    {
        var latestFragment = Optional<Workspace.Fragment?>.Present(
            Workspace.Fragment.From(latest.Workspace)
        );
        var rebased = Workspace.Patch.Rebase(_baseFragment, localPatch, latestFragment);
        if (!rebased.HasConflicts)
        {
            // Disjoint edits: replay onto the latest state and retry once with
            // the new revision so the user never sees a spurious conflict.
            var merged = rebased.Patch.Apply(latestFragment);
            if (merged.Value is null)
            {
                _isError = true;
                _status = "Rebase produced no state; reload and try again.";
                return;
            }

            _baseFragment = latestFragment;
            _session = CreateSession(merged.Value.ToModel());
            SyncScoresText();
            _revision = latest.Revision;
            _etag = latest.ETag;
            _effectiveSettings = latest.EffectiveSettings;

            var retry = await Api.PatchAsync(
                _workspaceId,
                _etag,
                rebased.Patch.ToJsonPatch(latestFragment)
            );
            switch (retry)
            {
                case Saved saved:
                    AdoptSnapshot(
                        saved.Snapshot,
                        $"Rebased onto revision {latest.Revision} and saved as revision {saved.Snapshot.Revision}."
                    );
                    break;
                case SaveConflict second:
                    await ShowConflictsAsync(second.Latest);
                    break;
                case SaveRejected rejected:
                    _isError = true;
                    _status = $"Rebased save rejected: {rejected.Detail}";
                    break;
            }

            return;
        }

        await ShowConflictsAsync(latest, rebased);
    }

    private Task ShowConflictsAsync(
        LoadedSnapshot latest,
        RebaseResult<Workspace.Patch>? rebased = null
    )
    {
        if (rebased is not null)
        {
            // Keep the non-conflicting edits merged onto the latest server
            // state; conflicting members show the server value until the user
            // re-applies their edit and saves again.
            var merged = rebased.Patch.Apply(
                Optional<Workspace.Fragment?>.Present(
                    Workspace.Fragment.From(latest.Workspace)
                )
            );
            if (merged.Value is not null)
            {
                _session = CreateSession(merged.Value.ToModel());
                SyncScoresText();
            }

            _conflicts = rebased.Conflicts;
        }
        else
        {
            _conflicts = [];
        }

        _baseFragment = Optional<Workspace.Fragment?>.Present(
            Workspace.Fragment.From(latest.Workspace)
        );
        _revision = latest.Revision;
        _etag = latest.ETag;
        _effectiveSettings = latest.EffectiveSettings;
        _isError = true;
        _status = rebased is null
            ? "Still stale after rebasing; review the latest state and save again."
            : $"{rebased.Conflicts.Count} conflicting change(s) kept the server value. Review, re-apply your edits, then save again.";
        return Task.CompletedTask;
    }

    private static SparseEditSession<
        Workspace,
        Workspace.Fragment,
        Workspace.Patch
    > CreateSession(Workspace model)
    {
        // Equivalent to the generated model.CreateEditSession(), which the
        // generator only emits when the model's own compilation references
        // SparseFragments.Blazor. Contracts deliberately has no UI
        // dependency, so the client wires the session explicitly.
        return SparseEditSession<
            Workspace,
            Workspace.Fragment,
            Workspace.Patch
        >.Create(
            model,
            Workspace.Fragment.From,
            Workspace.Patch.Between,
            static patch => patch.IsEmpty
        );
    }

    private void AddQuest()
    {
        if (_session is null)
        {
            return;
        }

        var quest = new Quest
        {
            Id = Guid.NewGuid().ToString("N")[..8],
            Title = "New quest",
        };
        _session.Model.Quests.Add(quest);
        _scoresText[quest] = string.Empty;
    }

    private void RemoveQuest(Quest quest)
    {
        _session?.Model.Quests.Remove(quest);
        _scoresText.Remove(quest);
    }

    private string GetScoresText(Quest quest)
    {
        if (_scoresText.TryGetValue(quest, out var text))
        {
            return text;
        }

        text = string.Join(",", quest.Scores);
        _scoresText[quest] = text;
        return text;
    }

    private void SetScoresText(Quest quest, string text)
    {
        _scoresText[quest] = text;
        quest.Scores = ParseScores(text);
        _session?.EditContext.NotifyFieldChanged(
            new FieldIdentifier(quest, nameof(Quest.Scores))
        );
    }

    private void SyncScoresText()
    {
        if (_session is null)
        {
            return;
        }

        _scoresText.Clear();
        foreach (var quest in _session.Model.Quests)
        {
            _scoresText[quest] = string.Join(",", quest.Scores);
        }
    }

    private static List<int> ParseScores(string text)
    {
        var scores = new List<int>();
        foreach (var token in text.Split([',', ';', ' '], StringSplitOptions.RemoveEmptyEntries))
        {
            if (int.TryParse(token.Trim(), out var score))
            {
                scores.Add(score);
            }
        }

        return scores;
    }

    private static string FormatValue(Optional<object?> value)
    {
        return value.IsPresent ? value.Value?.ToString() ?? "null" : "— (absent)";
    }
}
