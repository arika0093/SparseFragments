<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- SparseFragments.Blazor targets the shared ASP.NET Core framework, which
      has no browser-wasm runtime pack. The Blazor forms types it surfaces are
      provided here by the standalone Components.Forms package instead, so the
      inapplicable transitive framework reference is not passed through. -->
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
    <!-- No public API surface to document. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Demo app only: never ship as a NuGet package via slnx pack. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Forms" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference
      Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer"
      Version="10.0.12"
      PrivateAssets="all"
    />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CollaborativeEditing.Contracts\CollaborativeEditing.Contracts.csproj" />
    <ProjectReference Include="..\..\..\src\SparseFragments\SparseFragments.csproj" />
    <ProjectReference Include="..\..\..\src\SparseFragments.Blazor\SparseFragments.Blazor.csproj" />
    <ProjectReference
      Include="..\..\..\src\SparseFragments.Generator\SparseFragments.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
</Project>
