<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>CollaborativeEditing.Client.Wpf</AssemblyName>
    <RootNamespace>CollaborativeEditing.Client.Wpf</RootNamespace>
    <!-- Keep the demo build lenient: XAML + code-behind sample, not product code. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <MSBuildTreatAllWarningsAsErrors>false</MSBuildTreatAllWarningsAsErrors>
    <RestoreTreatWarningsAsErrors>false</RestoreTreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CollaborativeEditing.Contracts\CollaborativeEditing.Contracts.csproj" />
    <ProjectReference Include="..\..\..\src\SparseFragments\SparseFragments.csproj" />
    <ProjectReference
      Include="..\..\..\src\SparseFragments.Generator\SparseFragments.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
</Project>
