<Window
  x:Class="CollaborativeEditing.Client.Wpf.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Collaborative Editing — Workspace"
  Height="640"
  Width="860"
>
  <DockPanel Margin="8">
    <!-- Connection bar -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="Server:" VerticalAlignment="Center" Margin="0,0,4,0" />
      <TextBox x:Name="ServerBox" Width="220" Text="http://localhost:5000" />
      <TextBlock Text="Workspace:" VerticalAlignment="Center" Margin="8,0,4,0" />
      <TextBox x:Name="WorkspaceBox" Width="250" Text="11111111-1111-1111-1111-111111111111" />
      <Button x:Name="LoadButton" Content="Load" Width="70" Margin="8,0,0,0" Click="OnLoadClick" />
      <Button x:Name="SaveButton" Content="Save" Width="70" Margin="4,0,0,0" Click="OnSaveClick" />
    </StackPanel>

    <!-- Status bar -->
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock x:Name="RevisionText" Text="revision: —" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock x:Name="RebaseText" Text="idle" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem>
        <TextBlock x:Name="DirtyText" Text="" />
      </StatusBarItem>
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.1*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left: workspace edits bound to Workspace.Observable -->
      <StackPanel Grid.Column="0" Margin="0,0,8,0">
        <TextBlock Text="Workspace" FontWeight="Bold" />
        <TextBlock Text="Name" Margin="0,6,0,0" />
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Settings.Theme" Margin="0,6,0,0" />
        <TextBox Text="{Binding Settings.Theme, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Settings.RetryCount" Margin="0,6,0,0" />
        <TextBox Text="{Binding Settings.RetryCount, UpdateSourceTrigger=PropertyChanged}" />
        <CheckBox
          Content="Settings.Notifications"
          IsChecked="{Binding Settings.Notifications}"
          Margin="0,6,0,0"
        />

        <TextBlock
          Text="Quests (replace-only list; edits go through code-behind)"
          FontWeight="Bold"
          Margin="0,12,0,0"
        />
        <ListBox
          x:Name="QuestList"
          Height="140"
          DisplayMemberPath="Title"
          SelectionChanged="OnQuestSelectionChanged"
        />
        <Grid Margin="0,4,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Content="Add" Click="OnQuestAdd" Margin="0,0,2,0" />
          <Button Grid.Column="1" Content="Remove" Click="OnQuestRemove" Margin="2,0,2,0" />
          <Button Grid.Column="2" Content="Up" Click="OnQuestUp" Margin="2,0,2,0" />
          <Button Grid.Column="3" Content="Down" Click="OnQuestDown" Margin="2,0,0,0" />
        </Grid>
        <TextBlock Text="Selected quest title" Margin="0,6,0,0" />
        <TextBox x:Name="QuestTitleBox" LostFocus="OnQuestTitleChanged" />
        <TextBlock Text="Selected quest points" Margin="0,6,0,0" />
        <TextBox x:Name="QuestPointsBox" LostFocus="OnQuestPointsChanged" />
      </StackPanel>

      <!-- Right: conflicts -->
      <StackPanel Grid.Column="1">
        <TextBlock Text="Rebase conflicts (Path / kind / values)" FontWeight="Bold" />
        <ListBox x:Name="ConflictList" Height="380" />
        <TextBlock
          Text="How it works: edits mutate the model via Workspace.Observable. Save keeps the baseline Fragment, derives Workspace.Patch.Between(baseline, current), exports ToJsonPatch, and PATCHes with If-Match. A 412 triggers Rebase(base, local, current): clean rebase auto-retries, conflicts are listed here."
          TextWrapping="Wrap"
          Margin="0,8,0,0"
        />
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
