@using Microsoft.EntityFrameworkCore
@using SparseTypes
@using SparseTypes.Blazor
@using SparseTypes.EntityFrameworkCore
@using SparseTypes.Playground.Models
@using SparseTypes.Playground.Components
@implements IAsyncDisposable

<div class="pg-stack">
    <div class="pg-grid pg-grid-duo">
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>1. Entity (tracked)</h3>
                <FluentButton Appearance="ButtonAppearance.Primary" @onclick="Reset">Reseed</FluentButton>
            </div>
            <MonacoView Content="@EntityJson" Language="json" Height="270px" />
        </FluentCard>
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>2. DTO projection</h3>
            </div>
            <MonacoView Content="@BaselineJson" Language="json" Height="270px" />
        </FluentCard>
    </div>
    <div class="pg-grid pg-grid-duo">
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>3. Edit draft</h3>
                <div class="pg-actions">
                    <FluentButton Appearance="ButtonAppearance.Default" Disabled="@_saveApplying" @onclick="ResetDraft">Reset draft</FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Primary" Class="pg-submit-button"
                        Disabled="@(_savePending || _saveApplying || _changes?.IsChanged != true)" @onclick="OpenSaveDialog">Save</FluentButton>
                </div>
            </div>
            <SparseEdit Session="_session" Context="edit">
            <div class="pg-stack pg-edit-fields">
                <SparseField Path="edit.Path.Customer" Context="customer">
                    <div class="pg-row pg-session-field @(customer.IsChanged ? "pg-changed" : "")">
                        <span class="pg-name notranslate" translate="no">@ChangedDot(customer.IsChanged)Customer <small>string</small></span>
                        <div class="pg-case5-field-control">
                            <FluentTextInput Value="@customer.Value"
                                ValueChanged="@(v => EditFieldAsync(customer, v))" />
                            @if (_latestCustomerUpdate is { } customerUpdate)
                            {
                                <small class="pg-case5-update-notice" aria-live="polite">
                                    Updated to @PlaygroundOrderJson.FormatValue(customerUpdate.After)
                                </small>
                            }
                        </div>
                    </div>
                </SparseField>
                <SparseField Path="edit.Path.Notes" Context="notes">
                    <div class="pg-row pg-session-field @(notes.IsChanged ? "pg-changed" : "")">
                        <span class="pg-name notranslate" translate="no">@ChangedDot(notes.IsChanged)Notes <small>string</small></span>
                        <div class="pg-case5-field-control">
                            <FluentTextInput Value="@notes.Value"
                                ValueChanged="@(v => EditFieldAsync(notes, v))" />
                            @if (_latestNotesUpdate is { } notesUpdate)
                            {
                                <small class="pg-case5-update-notice" aria-live="polite">
                                    Updated to @PlaygroundOrderJson.FormatValue(notesUpdate.After)
                                </small>
                            }
                        </div>
                    </div>
                </SparseField>
                <SparseField Path="edit.Path.Total" Context="total">
                    <div class="pg-row pg-session-field @(total.IsChanged ? "pg-changed" : "")">
                        <span class="pg-name notranslate" translate="no">@ChangedDot(total.IsChanged)Total <small>decimal</small></span>
                        <FluentNumberInput TValue="decimal" Style="width: 10rem;"
                            Value="@total.Value"
                            ValueChanged="@(v => EditFieldAsync(total, v))" />
                    </div>
                </SparseField>
            </div>
            <div class="pg-row pg-session-field pg-task-field">
                <span class="pg-name notranslate" translate="no">Lines <small>List&lt;Line&gt;</small></span>
                <span class="pg-task-add">
                    <FluentButton Appearance="ButtonAppearance.Primary" Title="Add a random line" @onclick="AddLine">Add</FluentButton>
                </span>
            </div>
            <SparseField Path="edit.Path.Lines" Context="lines">
                @* One collection view per render, shared by all rows: capturing
                the snapshot here diffs once, and row lookups below only probe
                it. The save pipeline below keeps its own retained ChangeSet. *@
                @{ var roster = lines.TryGetCollectionState(out var view) ? view : null; }
                <SortableList @key="_draft.Lines.Count" Items="_draft.Lines" Handle=".pg-drag" Class="pg-roster-list"
                    OnUpdate="OnLinesReordered" Context="line">
                    <SortableItemTemplate>
                        <OrderLineRow @key="LineKey(line)" Line="line" Draft="_draft" Lines="lines" Roster="roster"
                            Session="_session" OnEditError="ShowCollectionEditError" OnEdited="OnDraftEdited" />
                    </SortableItemTemplate>
                </SortableList>
            </SparseField>
            </SparseEdit>
            <div class="pg-legend pg-session-legend" aria-label="Edit highlight legend">
                <span class="pg-lg"><span class="pg-sw pg-sw-add"></span>added</span>
                <span class="pg-lg"><span class="pg-sw pg-sw-move"></span>moved</span>
                <span class="pg-lg"><span class="pg-dot"></span>edited</span>
            </div>
            <MonacoView Content="@DraftJson" Language="json" Height="200px" />
            <div class="pg-case5-rebase-options">
                <FluentCheckbox Value="@_waitBeforeApply"
                    ValueChanged="@(value => _waitBeforeApply = value)" Disabled="@_savePending">
                    Wait 10 seconds before applying save
                </FluentCheckbox>
                <FluentCheckbox Value="@_simulateConflict"
                    ValueChanged="@(value => _simulateConflict = value)" Disabled="@_savePending">
                    Simulate another user editing before save
                </FluentCheckbox>
                <FluentCheckbox Value="@_periodicSimulationEnabled"
                    ValueChanged="OnPeriodicSimulationChanged">
                    Simulate real-time edits every 10 seconds
                </FluentCheckbox>
                <div class="pg-case5-rebase-select">
                    <span class="pg-name">Conflict handling</span>
                    <FluentSelect TOption="string" TValue="string"
                        Items="@ConflictHandlingOptions"
                        OptionValue="@(value => value)"
                        OptionText="@(value => value)"
                        Value="@ConflictHandlingName(_conflictHandlingMode)"
                        ValueChanged="OnConflictHandlingChanged"
                        Disabled="@(!_simulateConflict || _savePending)"
                        aria-label="Conflict handling" />
                </div>
                <p class="pg-hint">Standard uses per-field three-way rebase: overlapping edits are reported, and unrelated edits are saved. Strict rejects the whole save when the revision changes.</p>
                @if (_simulationError is not null)
                {
                    <FluentMessageBar Intent="MessageBarIntent.Error">@_simulationError</FluentMessageBar>
                }
            </div>
        </FluentCard>
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>4. Save Entity</h3>
                <span class="pg-has-changes-badge @(_changes?.IsChanged == true ? "pg-has-changes" : "pg-no-changes")">
                    <span aria-hidden="true"></span>@(_changes?.IsChanged == true ? "Changes" : "No changes")
                </span>
            </div>
            <p class="pg-hint">Saving checks the order revision. The simulation increments it to demonstrate each conflict handling mode.</p>
            @if (_changesError is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Error">@_changesError</FluentMessageBar>
            }
            @if (_applyError is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Error">@_applyError</FluentMessageBar>
            }
            @if (_saveError is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Error">@_saveError</FluentMessageBar>
            }
            @if (!_applied && _applyError is null)
            {
                @if (_waitBeforeApply)
                {
                    <p class="pg-hint">Confirm a ChangeSet to apply its snapshot after 10 seconds. You can keep editing the draft during the delay.</p>
                }
                else
                {
                    <p class="pg-hint">Confirm a ChangeSet to apply its snapshot immediately.</p>
                }
            }
            @if (_applied)
            {
                @if (_modifiedRows.Count == 0)
                {
                    <p class="pg-hint">No EF Core properties changed.</p>
                }
                else
                {
                    <div class="pg-change-table-wrap pg-case5-results-wrap">
                        <table class="pg-change-table pg-case5-results-table" aria-label="Modified EF properties">
                            <thead>
                                <tr><th>Entity</th><th>Operation</th><th>Property</th><th>Before</th><th>After</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _modifiedRows)
                                {
                                    <tr>
                                        <td><span class="pg-change-value">@row.Entity</span></td>
                                        <td><span class="@PlaygroundPageHelper.ChangeOperationClass(PlaygroundEfPresentation.EfStateOperation(row.State))">@PlaygroundEfPresentation.EfStateOperation(row.State)</span></td>
                                        <td><span class="pg-change-value">@row.Property</span></td>
                                        <td><span class="pg-change-value">@row.Before</span></td>
                                        <td><span class="pg-change-value">@row.After</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <MonacoDiffView Original="@_entityJsonBeforeApply" Modified="@EntityJson" Language="json" Height="240px" />
            }
        </FluentCard>
    </div>
</div>

<SaveSnackbar Visible="_savePending" OnApply="ApplyPendingSave" />

<FluentDialog @ref="_saveDialog" Hidden="@_saveDialogHidden" Modal="true" TrapFocus="true"
    Size="@DialogSize.Full" Class="pg-submit-preview-dialog" AriaLabel="Confirm save changes">
    <div class="pg-dialog-heading">
        <h3>Save changes</h3>
    </div>
    <div class="pg-dialog-body">
        @if (_waitBeforeApply)
        {
            <p class="pg-hint">Review the ChangeSet. After confirmation, this snapshot applies in 10 seconds; you can keep editing the draft meanwhile.</p>
        }
        else
        {
            <p class="pg-hint">Review the ChangeSet. After confirmation, this snapshot applies immediately.</p>
        }
        @if (_changeRows.Count == 0)
        {
            <p class="pg-hint">No changes.</p>
        }
        else
        {
            <ChangePreviewTable Rows="_changeRows" TargetHeader="Path" AriaLabel="Order ChangeSet" />
        }
    </div>
    <div class="pg-dialog-footer">
        <FluentButton Appearance="ButtonAppearance.Primary" @onclick="ConfirmSave">Save</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Default" @onclick="CloseSaveDialog">Cancel</FluentButton>
    </div>
</FluentDialog>

<ConflictDialog Visible="_conflictVisible" Summary="@_conflictSummary"
    Conflicts="_conflictRows" CanApplyResolution="@CanApplyResolution" IsApplying="@_resolutionApplying"
    SubmittedHeader="@_conflictSubmittedHeader"
    OnUseSubmitted="UseSubmittedConflictValue" OnUseCurrent="UseCurrentConflictValue"
    OnResolve="ApplyConflictResolution" OnClose="CloseConflictDialog" />

@code {
    private enum ConflictHandlingMode
    {
        Standard,
        Strict,
    }

    private static readonly DbContextOptions<PlaygroundEfContext> SharedOptions =
        new DbContextOptionsBuilder<PlaygroundEfContext>()
            .UseInMemoryDatabase("pg-ef-demo")
            .Options;
    private readonly SemaphoreSlim _storeGate = new(1, 1);

    private PlaygroundEfContext? _db;
    private PlaygroundOrderEntity? _tracked;
    private SparseEntityMapper<PlaygroundOrderEntity, PlaygroundOrderDto>? _mapper;
    private SparseEntityApplyResult? _applyResult;
    // Session-owned draft and baseline.
    private PlaygroundOrderDto.EditSession _session = null!;
    private PlaygroundOrderDto _liveDraft = null!;
    private PlaygroundOrderDto _baselineView = new();
    private PlaygroundOrderDto.ChangeSet? _changes;
    private string? _changesError;
    private string? _applyError;
    private string? _saveError;
    private bool _applied;
    private bool _savePending;
    private bool _saveApplying;
    private bool _simulateConflict;
    private bool _periodicSimulationEnabled;
    private bool _waitBeforeApply;
    private ConcurrentUpdate? _latestCustomerUpdate;
    private ConcurrentUpdate? _latestNotesUpdate;
    private string? _simulationError;
    private CancellationTokenSource? _simulationCancellation;
    private Task? _simulationTask;
    private string _entityJsonBeforeApply = string.Empty;
    private FluentDialog? _saveDialog;
    private bool _saveDialogHidden = true;
    private bool _conflictVisible;
    private string _conflictSummary = string.Empty;
    private IReadOnlyList<ChangePreviewRow> _changeRows = [];
    private List<(string Entity, string State, string Property, string Before, string After)> _modifiedRows = [];
    private PlaygroundOrderDto.ChangeSet? _pendingSubmitted;
    private PlaygroundOrderDto? _pendingDraft;
    private bool _pendingSimulateConflict;
    private List<(
        SparsePath? Path,
        string PathText,
        string Baseline,
        string Submitted,
        string Current,
        string Kind,
        bool CanResolve,
        bool? UseSubmitted
    )> _conflictRows = [];
    private PlaygroundOrderDto.ChangeSet.Resolution? _conflictResolution;
    private PlaygroundOrderDto.ChangeSet? _resolutionSubmitted;
    private PlaygroundOrderDto? _resolutionSubmittedDraft;
    private int _resolutionExpectedRevision;
    private int _resolutionOrderId;
    private bool _resolutionStale;
    private bool _resolutionApplying;
    private string _conflictSubmittedHeader = "Captured submitted value";
    private ConflictHandlingMode _conflictHandlingMode = ConflictHandlingMode.Standard;
    private ConflictHandlingMode? _pendingConflictHandlingMode;

    private static readonly string[] ConflictHandlingOptions = ["Standard", "Strict"];
    private bool CanApplyResolution =>
        _conflictResolution is not null
        && !_resolutionStale
        && !_resolutionApplying
        && _conflictRows.Any(static row => row.CanResolve)
        && _conflictRows.Where(static row => row.CanResolve).All(static row => row.UseSubmitted.HasValue);

    private string EntityJson => PlaygroundEfPresentation.Try(() => _tracked is null ? "{}" : PlaygroundOrderJson.WriteEntity(_tracked));
    private string BaselineJson => PlaygroundEfPresentation.Try(() => PlaygroundOrderJson.WriteDto(_baselineView));
    private string DraftJson => PlaygroundEfPresentation.Try(() => PlaygroundOrderJson.WriteDto(_draft));

    // The live draft instance owned by the session; the UI mutates it directly.
    private PlaygroundOrderDto _draft => _liveDraft;

    /// <summary>Reseeds the store and resets the whole pipeline. Called by the page too.</summary>
    public async Task Reset()
    {
        await StopPeriodicSimulationAsync();
        await _storeGate.WaitAsync();
        try
        {
            _saveDialogHidden = true;
            Seed();
        }
        finally
        {
            _storeGate.Release();
        }
    }

    protected override void OnInitialized() => Seed();

    public async ValueTask DisposeAsync()
    {
        await StopPeriodicSimulationAsync();
        await _storeGate.WaitAsync();
        try
        {
            _db?.Dispose();
            _db = null;
        }
        finally
        {
            _storeGate.Release();
            _storeGate.Dispose();
        }
    }

    private async Task OnPeriodicSimulationChanged(bool enabled)
    {
        _periodicSimulationEnabled = enabled;
        _simulationError = null;
        if (enabled)
        {
            StartPeriodicSimulation();
        }
        else
        {
            await StopPeriodicSimulationAsync();
        }
    }

    private void StartPeriodicSimulation()
    {
        if (_simulationTask is { IsCompleted: false })
        {
            return;
        }

        _simulationCancellation?.Dispose();
        var cancellation = new CancellationTokenSource();
        _simulationCancellation = cancellation;
        _simulationTask = RunPeriodicSimulationAsync(cancellation.Token);
    }

    private async Task StopPeriodicSimulationAsync()
    {
        var cancellation = _simulationCancellation;
        var task = _simulationTask;
        _simulationCancellation = null;
        _simulationTask = null;
        if (cancellation is null)
        {
            return;
        }

        cancellation.Cancel();
        if (task is not null)
        {
            await task;
        }

        cancellation.Dispose();
    }

    private async Task RunPeriodicSimulationAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (true)
            {
                await Task.Delay(TimeSpan.FromSeconds(10), cancellationToken);
                await _storeGate.WaitAsync(cancellationToken);
                ConcurrentUpdate update;
                try
                {
                    if (_tracked is null || _db is null)
                    {
                        throw new InvalidOperationException("The EF Core demo store is not initialized.");
                    }

                    var orderId = _tracked.Id;
                    update = PlaygroundConcurrency.SimulatePeriodicUpdate(SharedOptions, orderId);
                    _db.ChangeTracker.Clear();
                    _tracked = _db.Orders
                        .Include(static order => order.Note)
                        .Include(static order => order.Lines)
                        .Single(order => order.Id == orderId);
                }
                finally
                {
                    _storeGate.Release();
                }

                await InvokeAsync(() =>
                {
                    if (update.Property == "Customer")
                    {
                        _latestCustomerUpdate = update;
                    }
                    else if (update.Property == "Notes")
                    {
                        _latestNotesUpdate = update;
                    }
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception ex)
        {
            await InvokeAsync(() =>
            {
                _simulationError = $"Periodic update failed: {ex.GetType().Name}: {ex.Message}";
                _periodicSimulationEnabled = false;
                StateHasChanged();
            });
        }
    }

    private void Seed()
    {
        _savePending = false;
        _saveApplying = false;
        _pendingSubmitted = null;
        _pendingDraft = null;
        _pendingConflictHandlingMode = null;
        _pendingSimulateConflict = false;
        _db?.Dispose();
        _db = new PlaygroundEfContext(SharedOptions);
        _db.Database.EnsureDeleted();
        _db.Database.EnsureCreated();
        var seeded = _db.Orders.Add(
            new PlaygroundOrderEntity
            {
                CustomerName = "Cafe Vienna",
                Total = 13.75m,
                Note = new PlaygroundNoteEntity { Text = "first order" },
                Lines =
                [
                    new PlaygroundOrderLineEntity
                    {
                        Product = "Espresso",
                        Qty = 2,
                        SortOrder = 0,
                    },
                    new PlaygroundOrderLineEntity
                    {
                        Product = "Croissant",
                        Qty = 3,
                        SortOrder = 1,
                    },
                ],
            }
        ).Entity;
        _db.SaveChanges();
        _db.Entry(seeded).Collection(static order => order.Lines).Load();
        _tracked = seeded;
        _mapper = PlaygroundOrderMapper.Create(_db.Model);
        var initial = _mapper.ToDto(_tracked);
        _liveDraft = initial;
        _session = initial.CreateEditSession();
        _baselineView = initial.DeepClone();
        _applied = false;
        _applyResult = null;
        _simulateConflict = false;
        _periodicSimulationEnabled = false;
        _waitBeforeApply = false;
        _latestCustomerUpdate = null;
        _latestNotesUpdate = null;
        _simulationError = null;
        _conflictHandlingMode = ConflictHandlingMode.Standard;
        _modifiedRows = [];
        _saveDialogHidden = true;
        _conflictVisible = false;
        _conflictRows = [];
        ClearConflictResolution();
        RefreshChanges();
    }

    private void ResetDraft()
    {
        if (_saveApplying)
        {
            return;
        }

        // A pending submission references the retained baseline, so cancel it
        // first: reverting would otherwise orphan the in-flight snapshot.
        _savePending = false;
        _pendingSubmitted = null;
        _pendingDraft = null;
        _pendingConflictHandlingMode = null;
        _pendingSimulateConflict = false;
        try
        {
            _session.RevertChanges();
        }
        catch (InvalidOperationException)
        {
            RefreshChanges();
            _changesError = "The pending changes cannot be reverted in place; reseed to recover.";
            return;
        }

        _applied = false;
        _applyResult = null;
        _modifiedRows = [];
        RefreshChanges();
    }

    // Field writes arrive through SparseField bindings (which own the session
    // write and refresh).
    private void OnDraftEdited()
    {
        _applied = false;
        _applyResult = null;
        _modifiedRows = [];
        RefreshChanges();
    }

    // Scalar writes through one shared adapter: the field owns the session
    // write, and the draft bookkeeping above follows it.
    private async Task EditFieldAsync<TValue>(SparseFieldContext<PlaygroundOrderDto, TValue> field, TValue? value)
    {
        await field.SetAsync(value);
        OnDraftEdited();
    }

    // New lines never carry an Id: like the case 4 task list, Add appends a
    // random draft row and the store assigns the integer identity on save.
    private static readonly string[] NewLineProducts =
        ["Espresso", "Croissant", "Latte", "Muffin", "Cappuccino", "Cookie"];
    private static readonly Random NewLineRandom = new();

    private void AddLine()
    {
        var editor = _session.EditCollection<PlaygroundOrderLineDto, int>(
            PlaygroundOrderDto.SparsePath.Lines
        );
        var line = new PlaygroundOrderLineDto
        {
            Product = NewLineProducts[NewLineRandom.Next(NewLineProducts.Length)],
            Qty = NewLineRandom.Next(1, 6),
            TemporaryId = Guid.NewGuid(),
        };
        if (!editor.TryAdd(line, out var error))
        {
            _applyError = $"Could not add line: {error}.";
            return;
        }

        OnDraftEdited();
    }

    private Task ShowCollectionEditError(string message)
    {
        _applyError = message;
        return Task.CompletedTask;
    }

    private static string LineKey(PlaygroundOrderLineDto line) =>
        line.Id is int id ? $"id:{id}" : $"temporary:{line.TemporaryId}";

    private Task OnLinesReordered((int oldIndex, int newIndex) indices)
    {
        var (oldIndex, newIndex) = indices;
        var lines = _draft.Lines;
        if (oldIndex == newIndex || oldIndex < 0 || oldIndex >= lines.Count || newIndex < 0 || newIndex > lines.Count)
        {
            return Task.CompletedTask;
        }

        var editor = _session.EditCollection<PlaygroundOrderLineDto, int>(
            PlaygroundOrderDto.SparsePath.Lines
        );
        var target = Math.Min(newIndex, lines.Count - 1);
        if (!editor.TryMove(oldIndex, target, out var error))
        {
            _applyError = $"Could not reorder lines: {error}.";
            return Task.CompletedTask;
        }

        OnDraftEdited();
        return Task.CompletedTask;
    }

    private static RenderFragment ChangedDot(bool changed) => builder =>
    {
        if (changed)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "pg-dot");
            builder.AddAttribute(2, "title", "edited");
            builder.CloseElement();
        }
    };

    // Scalar highlights now come from each SparseField's render-scoped state.
    private static string ConflictHandlingName(ConflictHandlingMode mode) => mode switch
    {
        ConflictHandlingMode.Standard => "Standard",
        ConflictHandlingMode.Strict => "Strict",
        _ => throw new ArgumentOutOfRangeException(nameof(mode), mode, null),
    };

    private void OnConflictHandlingChanged(string? value)
    {
        _conflictHandlingMode = value switch
        {
            "Standard" => ConflictHandlingMode.Standard,
            "Strict" => ConflictHandlingMode.Strict,
            _ => throw new ArgumentOutOfRangeException(nameof(value), value, null),
        };
    }

    private void RefreshChanges()
    {
        _changesError = null;
        _applyError = null;
        _saveError = null;
        // Line Ids are read-only and new rows never set one, so duplicate keys
        // cannot be introduced from the UI.
        try
        {
            _changes = _session.CreateChangeSet();
            _changeRows = SparseChangeRowProjection.Project(
                _changes,
                new SparseChangeRowOptions
                {
                    FormatOperation = PlaygroundPageHelper.ChangeOperation,
                    FormatValue = static value => PlaygroundOrderJson.FormatValue(value),
                }
            )
                .Select(static row => new ChangePreviewRow
                {
                    Target = row.PathText,
                    Operation = row.Operation,
                    Before = row.BeforeText,
                    After = row.AfterText,
                })
                .ToArray();
        }
        catch (Exception ex)
        {
            _changes = null;
            _changeRows = [];
            _changesError = $"{ex.GetType().Name}: {ex.Message}";
        }
    }

    private async Task OpenSaveDialog()
    {
        if (_savePending || _saveApplying)
        {
            return;
        }

        _saveDialogHidden = false;
        if (_saveDialog is null)
        {
            throw new InvalidOperationException("The save dialog is not initialized.");
        }

        await _saveDialog.ShowAsync();
    }

    private async Task CloseSaveDialog()
    {
        _saveDialogHidden = true;
        if (_saveDialog is null)
        {
            throw new InvalidOperationException("The save dialog is not initialized.");
        }

        await _saveDialog.HideAsync();
    }

    private async Task ConfirmSave()
    {
        if (_savePending || _saveApplying)
        {
            return;
        }

        // Capture the exact immutable submission before the awaited save.
        var submitted = _session.CreateChangeSet();
        if (submitted.IsChanged != true)
        {
            await CloseSaveDialog();
            return;
        }

        _pendingSubmitted = submitted;
        _pendingDraft = _liveDraft.DeepClone();
        _pendingConflictHandlingMode = _conflictHandlingMode;
        _pendingSimulateConflict = _simulateConflict;
        var waitBeforeApply = _waitBeforeApply;
        await CloseSaveDialog();
        _savePending = true;
        _applied = false;
        _applyResult = null;
        _modifiedRows = [];
        RefreshChanges();
        if (!waitBeforeApply)
        {
            await ApplyPendingSave();
        }
    }

    private async Task ApplyPendingSave()
    {
        if (!_savePending || _pendingSubmitted is null || _pendingDraft is null || _pendingConflictHandlingMode is null)
        {
            return;
        }

        var submitted = _pendingSubmitted;
        var submittedDraft = _pendingDraft;
        var conflictHandlingMode = _pendingConflictHandlingMode.Value;
        var simulateConflict = _pendingSimulateConflict;
        _saveApplying = true;
        _pendingSubmitted = null;
        _pendingDraft = null;
        _pendingConflictHandlingMode = null;
        _pendingSimulateConflict = false;
        await _storeGate.WaitAsync();
        try
        {
            ApplyChanges(submitted);
            if (_applied)
            {
                await SaveEntity(submitted, submittedDraft, simulateConflict, conflictHandlingMode);
            }
            else
            {
                // Acknowledgement never ran, so the retained baseline is
                // untouched and the submission simply stays pending for a
                var applyError = _applyError;
                RefreshChanges();
                _applyError = applyError;
            }
        }
        finally
        {
            _storeGate.Release();
            _saveApplying = false;
            _savePending = false;
        }
    }

    private void ApplyChanges(PlaygroundOrderDto.ChangeSet changes)
    {
        _applyError = null;
        _applied = false;
        _applyResult = null;
        _modifiedRows = [];
        if (_db is null || _tracked is null || _mapper is null)
        {
            _applyError = "The EF Core demo store is not initialized.";
            return;
        }

        _entityJsonBeforeApply = EntityJson;
        try
        {
            // ApplyWithResult correlates created child entities by temporary
            // identity so generated keys can be written back after SaveChanges.
            _applyResult = _mapper.ApplyWithResult(_db, _tracked, changes);
            _modifiedRows = PlaygroundEfPresentation.CollectModifiedRows(_db);
            _applied = true;
        }
        catch (Exception ex)
        {
            _applyError = $"{ex.GetType().Name}: {ex.Message}";
            _applied = false;
            _applyResult = null;
            _modifiedRows = [];
        }
    }

    private async Task SaveEntity(
        PlaygroundOrderDto.ChangeSet submitted,
        PlaygroundOrderDto submittedDraft,
        bool simulateConflict,
        ConflictHandlingMode conflictHandlingMode
    )
    {
        _saveError = null;
        if (_db is null || _tracked is null)
        {
            _saveError = "The EF Core demo store is not initialized.";
            return;
        }

        var orderId = _tracked.Id;
        var expectedRevision = _tracked.Revision;
        try
        {
            if (simulateConflict)
            {
                PlaygroundConcurrency.SimulateConcurrentEdit(SharedOptions, orderId);
            }

            // Check before SaveChanges because the in-memory provider cannot
            // roll back a partial write.
            PlaygroundConcurrency.EnsureCurrentRevision(SharedOptions, orderId, expectedRevision);
            _tracked.Revision++;
            _db.SaveChanges();
            _db.ChangeTracker.Clear();
            _tracked = _db.Orders
                .Include(static order => order.Note)
                .Include(static order => order.Lines)
                .Single(order => order.Id == orderId);
            if (_mapper is null || _applyResult is null)
            {
                throw new InvalidOperationException("The EF Core mapper result is not available.");
            }

            // Correlate created rows by temporary identity onto the
            // authoritative projection, then acknowledge through the session
            var persisted = _mapper.ToDto(_tracked);
            _mapper.AssignTemporaryKeys(_db, _applyResult, submittedDraft, persisted);
            AcknowledgeSave(submitted, submittedDraft, persisted);
            _applyResult = null;
            RefreshChanges();
        }
        catch (DbUpdateConcurrencyException)
        {
            try
            {
                await RecoverFromConflict(
                    submitted,
                    submittedDraft,
                    expectedRevision,
                    conflictHandlingMode);
            }
            catch (Exception ex)
            {
                _applied = false;
                _applyResult = null;
                _modifiedRows = [];
                RefreshChanges();
                _saveError = $"Conflict recovery failed: {ex.GetType().Name}: {ex.Message}. The submitted snapshot may have persisted; review the entity or reseed to recover.";
            }
        }
        catch (Exception ex)
        {
            _applied = false;
            _applyResult = null;
            _modifiedRows = [];
            RefreshChanges();
            _saveError = $"{ex.GetType().Name}: {ex.Message}. The submitted snapshot may have persisted, but the fresh entity could not be reconciled; reseed to recover.";
        }
    }

    private void AcknowledgeSave(
        PlaygroundOrderDto.ChangeSet submitted,
        PlaygroundOrderDto submittedDraft,
        PlaygroundOrderDto persisted
    )
    {
        if (!_session.TryReconcile(submitted, persisted, out var error))
        {
            throw new InvalidOperationException(
                error ?? "The submitted changes could not be reconciled with the persisted order."
            );
        }

        var postSubmitConflicts = PreparePostSubmitDraft(submittedDraft, persisted);
        _baselineView = persisted;
        _conflictRows = postSubmitConflicts;
        _conflictSubmittedHeader = "Later local draft";
        _conflictSummary = postSubmitConflicts.Count > 0
            ? "The submitted changes were saved. Later local edits that conflict with persisted values remain in the draft."
            : string.Empty;
        _conflictVisible = postSubmitConflicts.Count > 0;
    }

    private async Task RecoverFromConflict(
        PlaygroundOrderDto.ChangeSet submitted,
        PlaygroundOrderDto submittedDraft,
        int expectedRevision,
        ConflictHandlingMode conflictHandlingMode
    )
    {
        if (_db is null || _tracked is null)
        {
            throw new InvalidOperationException("The EF Core demo store is not initialized.");
        }

        var orderId = _tracked.Id;
        _db.ChangeTracker.Clear();
        _tracked = _db.Orders
            .Include(static order => order.Note)
            .Include(static order => order.Lines)
            .Single(order => order.Id == orderId);
        if (_mapper is null)
        {
            throw new InvalidOperationException("The EF Core mapper is not initialized.");
        }

        var current = _mapper.ToDto(_tracked);
        if (conflictHandlingMode == ConflictHandlingMode.Strict)
        {
            // Reject the whole submission.
            _session = current.CreateEditSession(_liveDraft);
            _baselineView = current;
            ClearConflictResolution();
            _conflictSubmittedHeader = "Submitted changes";
            _conflictRows =
            [
                (
                    Path: (SparsePath?)null,
                    PathText: "Revision",
                    Baseline: expectedRevision.ToString(),
                    Submitted: "Submitted changes",
                    Current: _tracked.Revision.ToString(),
                    Kind: "Strict rejection",
                    CanResolve: false,
                    UseSubmitted: (bool?)null
                ),
            ];
            _conflictSummary = "Strict handling rejected the submitted changes because the order revision changed. The draft remains available for another save.";
            _applied = false;
            _applyResult = null;
            _modifiedRows = [];
            RefreshChanges();
            _conflictVisible = true;
            return;
        }

        var submittedRebase = submitted.RebaseOnto(current);
        if (submittedRebase.HasConflicts)
        {
            _conflictResolution = PlaygroundOrderDto.ChangeSet.BeginResolution(
                submittedRebase,
                current
            );
            _resolutionSubmitted = submitted;
            _resolutionSubmittedDraft = submittedDraft;
            _resolutionExpectedRevision = _tracked.Revision;
            _resolutionOrderId = orderId;
            _resolutionStale = false;
            _conflictSubmittedHeader = "Captured submitted value";
            _conflictRows = submittedRebase.Conflicts
                .Select(static conflict => (
                    Path: (SparsePath?)conflict.Path,
                    PathText: conflict.PathText,
                    Baseline: PlaygroundEfPresentation.FormatChangeValue(conflict.BaseValue),
                    Submitted: PlaygroundEfPresentation.FormatChangeValue(conflict.LocalValue),
                    Current: PlaygroundEfPresentation.FormatChangeValue(conflict.CurrentValue),
                    Kind: conflict.Kind.ToString(),
                    CanResolve: true,
                    UseSubmitted: (bool?)null))
                .ToList();
            _conflictSummary = "Another user changed fields in the submitted snapshot. Choose the captured value or the current persisted value for each conflict before applying the non-conflicting changes.";
            _applied = false;
            _applyResult = null;
            _modifiedRows = [];
            RefreshChanges();
            _conflictVisible = true;
            return;
        }

        _entityJsonBeforeApply = EntityJson;
        // Retry only the rebased submission; post-submit edits stay out of the
        // write and are merged back by the reconciliation below.
        var retry = _mapper.ApplyWithResult(_db, _tracked, submittedRebase.Rebased);
        _modifiedRows = PlaygroundEfPresentation.CollectModifiedRows(_db);
        if (_db.ChangeTracker.HasChanges())
        {
            _tracked.Revision++;
            _db.SaveChanges();
        }

        _db.ChangeTracker.Clear();
        _tracked = _db.Orders
            .Include(static order => order.Note)
            .Include(static order => order.Lines)
            .Single(order => order.Id == orderId);
        var merged = _mapper.ToDto(_tracked);
        _mapper.AssignTemporaryKeys(_db, retry, submittedDraft, merged);
        _applyResult = null;

        // Rebase later edits onto the authoritative state before reconciliation
        // so remote field values and local post-submit edits both survive.
        try
        {
            _conflictRows = PreparePostSubmitDraft(submittedDraft, merged);
        }
        catch (Exception ex)
        {
            _applied = false;
            _modifiedRows = [];
            RefreshChanges();
            _saveError = $"The retry may have persisted, but later draft edits could not be merged: {ex.GetType().Name}: {ex.Message}. Reseed to recover.";
            return;
        }

        if (!_session.TryReconcile(submitted, merged, out var reconcileError))
        {
            _applied = false;
            _modifiedRows = [];
            RefreshChanges();
            _saveError = $"The retry save could not be reconciled: {reconcileError} The submitted snapshot may have persisted; reseed to recover.";
            return;
        }

        _baselineView = merged;
        ClearConflictResolution();
        _conflictSubmittedHeader = "Later local draft";
        var hasFieldConflicts = _conflictRows.Count > 0;
        _conflictSummary = hasFieldConflicts
            ? "The submitted changes were saved. Later local edits that conflict with the persisted order remain in the draft and were not overwritten."
            : "Another user updated this order while the save was pending. The submitted changes were saved on top of the latest entity.";
        _applied = true;
        RefreshChanges();
        _conflictVisible = hasFieldConflicts;
    }

    private void UseSubmittedConflictValue(string pathText) => SetConflictChoice(pathText, true);

    private void UseCurrentConflictValue(string pathText) => SetConflictChoice(pathText, false);

    private void SetConflictChoice(string pathText, bool useSubmitted)
    {
        var index = _conflictRows.FindIndex(row => row.CanResolve && row.PathText == pathText);
        if (index < 0 || _conflictResolution is null)
        {
            throw new InvalidOperationException($"No resolvable conflict exists at '{pathText}'.");
        }

        var row = _conflictRows[index];
        if (row.Path is not SparsePath path)
        {
            throw new InvalidOperationException($"The conflict at '{pathText}' has no typed path.");
        }

        if (useSubmitted)
        {
            _conflictResolution.UseIncoming(path);
        }
        else
        {
            _conflictResolution.UseCurrent(path);
        }

        _conflictRows[index] = (
            row.Path,
            row.PathText,
            row.Baseline,
            row.Submitted,
            row.Current,
            row.Kind,
            row.CanResolve,
            useSubmitted
        );
    }

    private async Task ApplyConflictResolution()
    {
        if (
            !CanApplyResolution
            || _conflictResolution is null
            || _resolutionSubmitted is null
            || _resolutionSubmittedDraft is null
        )
        {
            return;
        }

        if (!_conflictResolution.TryBuild(out var resolved, out var failure) || resolved is null)
        {
            _conflictSummary = failure?.Reason ?? "The selected conflict resolutions could not be built.";
            return;
        }

        var submitted = _resolutionSubmitted;
        var submittedDraft = _resolutionSubmittedDraft;
        var orderId = _resolutionOrderId;
        var expectedRevision = _resolutionExpectedRevision;
        _resolutionApplying = true;
        _saveError = null;
        var resolutionPersisted = false;
        var resolutionWriteAttempted = false;
        await _storeGate.WaitAsync();
        try
        {
            if (_db is null || _tracked is null || _mapper is null)
            {
                throw new InvalidOperationException("The EF Core demo store is not initialized.");
            }

            PlaygroundConcurrency.EnsureCurrentRevision(SharedOptions, orderId, expectedRevision);
            if (_tracked.Id != orderId || _tracked.Revision != expectedRevision)
            {
                throw new DbUpdateConcurrencyException(
                    $"Order {orderId} is no longer at revision {expectedRevision}."
                );
            }

            _entityJsonBeforeApply = EntityJson;
            resolutionWriteAttempted = true;
            var result = _mapper.ApplyWithResult(_db, _tracked, resolved);
            _modifiedRows = PlaygroundEfPresentation.CollectModifiedRows(_db);
            if (_db.ChangeTracker.HasChanges())
            {
                _tracked.Revision++;
                _db.SaveChanges();
            }

            resolutionPersisted = true;
            _db.ChangeTracker.Clear();
            _tracked = _db.Orders
                .Include(static order => order.Note)
                .Include(static order => order.Lines)
                .Single(order => order.Id == orderId);
            var persisted = _mapper.ToDto(_tracked);
            _mapper.AssignTemporaryKeys(_db, result, submittedDraft, persisted);
            _conflictRows = PreparePostSubmitDraft(submittedDraft, persisted);
            if (!_session.TryReconcile(submitted, persisted, out var reconcileError))
            {
                throw new InvalidOperationException(
                    reconcileError ?? "The resolved save could not be reconciled with the draft."
                );
            }

            _baselineView = persisted;
            _conflictSubmittedHeader = "Later local draft";
            _conflictSummary = _conflictRows.Count > 0
                ? "The selected values were applied. Later local edits that conflict with the persisted order remain in the draft and were not overwritten."
                : "The selected conflict values and non-conflicting submitted changes were applied.";
            _conflictVisible = _conflictRows.Count > 0;
            _applied = true;
            _applyResult = null;
            ClearConflictResolution();
            RefreshChanges();
        }
        catch (Exception ex)
        {
            if (_db is not null)
            {
                _db.ChangeTracker.Clear();
                _tracked = _db.Orders
                    .Include(static order => order.Note)
                    .Include(static order => order.Lines)
                    .Single(order => order.Id == orderId);
                _resolutionStale = _tracked.Revision != expectedRevision;
            }

            _applied = false;
            _applyResult = null;
            _modifiedRows = [];
            _conflictVisible = true;
            _conflictSummary = resolutionPersisted
                ? "The chosen values were persisted, but the local draft could not be reconciled. The revision is newer; continue editing and save again to review the current state."
                : _resolutionStale
                    ? resolutionWriteAttempted
                        ? "The revision changed during the save attempt, so the resolution could not be confirmed. Review the error and current entity before retrying."
                        : "The persisted revision changed while the dialog was open. The selected values were not applied; continue editing and save again to review the newer state."
                    : "The selected values were not confirmed as saved. Review the error before retrying.";
            RefreshChanges();
            _saveError = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _storeGate.Release();
            _resolutionApplying = false;
        }
    }

    private List<(
        SparsePath? Path,
        string PathText,
        string Baseline,
        string Submitted,
        string Current,
        string Kind,
        bool CanResolve,
        bool? UseSubmitted
    )> PreparePostSubmitDraft(PlaygroundOrderDto submittedDraft, PlaygroundOrderDto persisted)
    {
        var postSubmit = submittedDraft.CreateChangeSet(_liveDraft);
        var postSubmitRebase = postSubmit.RebaseOnto(persisted);
        var pending = postSubmitRebase.Rebased;
        if (postSubmitRebase.HasConflicts)
        {
            var resolution = PlaygroundOrderDto.ChangeSet.BeginResolution(
                postSubmitRebase,
                persisted
            );
            foreach (var conflict in resolution.EnumerateUnresolvedConflicts())
            {
                resolution.UseIncoming(conflict.Path);
            }

            if (!resolution.TryBuild(out var resolved, out var failure) || resolved is null)
            {
                throw new InvalidOperationException(
                    failure?.Reason ?? "The later draft edits could not be rebased."
                );
            }

            pending = resolved;
        }

        var targetDraft = pending.ToPatch()
            .Apply(
                Optional<PlaygroundOrderDto.Fragment?>.Present(
                    PlaygroundOrderDto.Fragment.From(persisted)
                )
            )
            .Value!
            .ToModel();
        var syncDraft = PlaygroundOrderDto.ChangeSet.Between(_liveDraft, targetDraft);
        if (
            !syncDraft.IsEmpty
            && !_session.TryApplyInPlace(syncDraft, out var syncConflicts)
        )
        {
            var paths = syncConflicts is null
                ? "unknown paths"
                : string.Join(", ", syncConflicts.Select(static conflict => conflict.PathText));
            throw new InvalidOperationException(
                $"The authoritative values could not be merged into the live draft: {paths}."
            );
        }

        return postSubmitRebase.Conflicts
            .Select(static conflict => (
                Path: (SparsePath?)conflict.Path,
                PathText: conflict.PathText,
                Baseline: PlaygroundEfPresentation.FormatChangeValue(conflict.BaseValue),
                Submitted: PlaygroundEfPresentation.FormatChangeValue(conflict.LocalValue),
                Current: PlaygroundEfPresentation.FormatChangeValue(conflict.CurrentValue),
                Kind: conflict.Kind.ToString(),
                CanResolve: false,
                UseSubmitted: (bool?)null))
            .ToList();
    }

    private void ClearConflictResolution()
    {
        _conflictResolution = null;
        _resolutionSubmitted = null;
        _resolutionSubmittedDraft = null;
        _resolutionExpectedRevision = 0;
        _resolutionOrderId = 0;
        _resolutionStale = false;
        _resolutionApplying = false;
    }

    private void CloseConflictDialog()
    {
        _conflictVisible = false;
        ClearConflictResolution();
    }

}
