@using SparseTypes

<FluentDialog @ref="_dialog" Hidden="@(!Visible)" Modal="true" TrapFocus="true"
    Size="full"
    Class="pg-conflict-dialog" AriaLabel="Concurrent save conflict">
    <div class="pg-dialog-heading">
        <h3>Concurrent update detected</h3>
    </div>
    <div class="pg-dialog-body">
        <p class="pg-hint">@Summary</p>
        @if (Conflicts.Count > 0)
        {
            <div class="pg-change-table-wrap pg-conflict-table-wrap">
                <table class="pg-change-table pg-conflict-table" aria-label="Concurrent save details">
                    <thead>
                        <tr><th>Path</th><th>Base</th><th>@SubmittedHeader</th><th>Current persisted value</th><th>Conflict</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Conflicts)
                        {
                            <tr>
                                <td><span class="pg-change-value">@row.PathText</span></td>
                                <td><span class="pg-change-value">@row.Baseline</span></td>
                                <td>
                                    <span class="pg-change-value">@row.Submitted</span>
                                    @if (row.CanResolve)
                                    {
                                        <FluentButton Class="pg-conflict-choice"
                                            Appearance="@(row.UseSubmitted == true ? ButtonAppearance.Primary : ButtonAppearance.Default)"
                                            Disabled="@IsApplying" aria-pressed="@(row.UseSubmitted == true ? "true" : "false")"
                                            @onclick="() => OnUseSubmitted.InvokeAsync(row.PathText)">Use captured value</FluentButton>
                                    }
                                </td>
                                <td>
                                    <span class="pg-change-value">@row.Current</span>
                                    @if (row.CanResolve)
                                    {
                                        <FluentButton Class="pg-conflict-choice"
                                            Appearance="@(row.UseSubmitted == false ? ButtonAppearance.Primary : ButtonAppearance.Default)"
                                            Disabled="@IsApplying" aria-pressed="@(row.UseSubmitted == false ? "true" : "false")"
                                            @onclick="() => OnUseCurrent.InvokeAsync(row.PathText)">Use current value</FluentButton>
                                    }
                                </td>
                                <td><span class="pg-change-value">@row.Kind</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="pg-dialog-footer">
        @if (Conflicts.Any(static row => row.CanResolve))
        {
            <FluentButton Appearance="ButtonAppearance.Primary" Disabled="@(!CanApplyResolution)"
                @onclick="OnResolve">Apply resolutions</FluentButton>
        }
        <FluentButton Appearance="ButtonAppearance.Primary" Disabled="@IsApplying" @onclick="OnClose">Continue editing</FluentButton>
    </div>
</FluentDialog>

@code {
    private FluentDialog? _dialog;
    private bool _dialogVisible;

    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public string Summary { get; set; } = string.Empty;

    [Parameter]
    public string SubmittedHeader { get; set; } = "Captured submitted value";

    [Parameter]
    public IReadOnlyList<(
        SparsePath? Path,
        string PathText,
        string Baseline,
        string Submitted,
        string Current,
        string Kind,
        bool CanResolve,
        bool? UseSubmitted
    )> Conflicts { get; set; } = [];

    [Parameter]
    public bool CanApplyResolution { get; set; }

    [Parameter]
    public bool IsApplying { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnClose { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<string> OnUseSubmitted { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<string> OnUseCurrent { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnResolve { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_dialog is null || _dialogVisible == Visible)
        {
            return;
        }

        _dialogVisible = Visible;
        if (Visible)
        {
            await _dialog.ShowAsync();
        }
        else
        {
            await _dialog.HideAsync();
        }
    }
}
