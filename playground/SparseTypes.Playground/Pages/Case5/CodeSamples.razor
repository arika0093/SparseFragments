@using SparseTypes.Playground.Components

<div class="pg-code-samples">
    <p class="pg-hint">The submit action captures an immutable ChangeSet; the session baseline advances when the save is acknowledged. A progress bar tracks the 10-second delay; concurrent edits are rebased and shown in a conflict dialog.</p>
    <FluentTabs Orientation="Orientation.Vertical">
        <FluentTab Header="Mapper" Id="code-5-mapper">
            <MonacoView Content="@EfMapperCode" Language="csharp" Height="330px" />
        </FluentTab>
        <FluentTab Header="Shapes" Id="code-5-shapes">
            <MonacoView Content="@EfShapesCode" Language="csharp" Height="360px" />
        </FluentTab>
        <FluentTab Header="Apply flow" Id="code-5-flow">
            <MonacoView Content="@EfFlowCode" Language="csharp" Height="330px" />
        </FluentTab>
        <FluentTab Header="Inspect changes" Id="code-5-inspect">
            <MonacoView Content="@EfInspectCode" Language="csharp" Height="330px" />
        </FluentTab>
    </FluentTabs>
</div>

@code {
    private const string EfMapperCode = """
        // Generate defaults for same-name scalar properties.
        [SparseFragmentMapper<PlaygroundOrderEntity, PlaygroundOrderDto>]
        public sealed partial class PlaygroundOrderMapper
        {
            private void Configure()
            {
                Map.Member(dto => dto.Customer, entity => entity.CustomerName); // Map the renamed customer property.
                Map.Member(dto => dto.Notes, entity => entity.Note!.Text);      // Flatten Notes onto the related note.
                Map.Collection<PlaygroundOrderLineDto, PlaygroundOrderLineEntity>(
                    dto => dto.Lines,       // Read changes from the DTO collection.
                    entity => entity.Lines, // Apply them to the tracked EF collection.
                    lines =>
                    {
                        // Same-name Product/Qty resolve via generated defaults.
                        // Mark removed line entities for deletion by EF.
                        lines.Delete();
                        // Persist the collection order.
                        lines.Order((entity, index) => entity.SortOrder = index);
                    });
            }
        }
        // Total, Product, and Qty map automatically because their names and types match.
        // Key and TemporaryId identify keyed changes, so they need no scalar mapping.
        // The generator implements IEntityModelMapping and backs Map for this build.
        """;

    private const string EfFlowCode = """
        var session = draft.CreateEditSession(); // The draft is the live model; the session retains the baseline.
        // ... edit draft ...
        var submitted = session.CreateChangeSet(); // Exact immutable snapshot before the awaited save.
        var submittedDraft = draft.DeepClone(); // Correlates temporary identities after the save.
        // Keep editing draft while the save is in flight.

        var mapper = PlaygroundOrderMapper.Create(db.Model);
        // Apply now, or when the 10-second snackbar expires.
        // ApplyWithResult correlates created lines by temporary identity.
        var result = mapper.ApplyWithResult(db, tracked, submitted); // No query, no SaveChanges.
        var modified = db.ChangeTracker.Entries()
            .SelectMany(static entry => entry.Properties)
            .Where(static property => property.IsModified);

        try
        {
            if (simulateConflict) PlaygroundConcurrency.SimulateConcurrentEdit(SharedOptions, tracked.Id);
            PlaygroundConcurrency.EnsureCurrentRevision(SharedOptions, tracked.Id, tracked.Revision);
            tracked.Revision++;
            await db.SaveChangesAsync(); // The concurrency token also protects the write after the preflight check.
            var persisted = Project(await ReloadOrderAsync(tracked.Id));
            // Generated keys land on the authoritative projection; acknowledgement routes
            // by what the server returned, never by list position.
            mapper.AssignTemporaryKeys(db, result, submittedDraft, persisted);
            if (submitted.Lines.Added.Count == 0)
                session.AcceptChanges(submitted); // No key changes: advance the baseline, live untouched.
            else if (!session.TryReconcile(submitted, persisted, out var error))
                throw new InvalidOperationException(error); // No partial key writeback; retry or reseed.
            // Post-submit edits stay pending against the persisted baseline.
        }
        catch (DbUpdateConcurrencyException)
        {
            db.ChangeTracker.Clear();
            var current = Project(await ReloadOrderAsync(tracked.Id));
            if (selectedMode == ConflictHandlingMode.Strict)
            {
                session = current.CreateEditSession(draft); // Reject the save; the live draft stays pending.
                ShowRevisionConflict(tracked.Revision, currentEntity.Revision);
                return; // Reject every submitted field when the order revision changed.
            }

            var rebase = submitted.RebaseOnto(current);
            var retry = mapper.ApplyWithResult(db, currentEntity, rebase.Rebased);
            if (db.ChangeTracker.HasChanges())
            {
                currentEntity.Revision++;
                await db.SaveChangesAsync();
            }

            var merged = Project(await ReloadOrderAsync(tracked.Id));
            mapper.AssignTemporaryKeys(db, retry, submittedDraft, merged);
            var postSubmit = submittedDraft.CreateChangeSet(draft);
            var postRebase = postSubmit.RebaseOnto(merged);
            if (!session.TryReconcile(submitted, merged, out var reconcileError))
                throw new InvalidOperationException(reconcileError); // The retry persisted; reseed to recover.
            if (rebase.HasConflicts || postRebase.HasConflicts) ShowConflictDialog(rebase, postRebase);
        }
        """;

    private const string EfShapesCode = """
        [SparseModel]
        public partial class PlaygroundOrderDto
        {
            public string Customer { get; set; } = string.Empty;
            public string Notes { get; set; } = string.Empty; // Flattened onto Note.Text.
            public decimal Total { get; set; }
            public List<PlaygroundOrderLineDto> Lines { get; set; } = [];
        }

        public partial class PlaygroundOrderLineDto
        {
            public int? Id { get; set; } // Null means unassigned.
            [SparseKey(Unassigned = 0)]
            public int Key => Id ?? 0;
            [SparseTemporaryKey]
            public Guid? TemporaryId { get; set; }
            public string Product { get; set; } = string.Empty;
            public int Qty { get; set; }
        }

        public sealed class PlaygroundOrderEntity
        {
            public int Id { get; set; }
            public int Revision { get; set; } // Optimistic concurrency token.
            public string CustomerName { get; set; } = string.Empty;
            public decimal Total { get; set; }
            public PlaygroundNoteEntity? Note { get; set; } // Required 1:1.
            public List<PlaygroundOrderLineEntity> Lines { get; set; } = [];
        }

        public sealed class PlaygroundNoteEntity
        {
            public int Id { get; set; }
            public string Text { get; set; } = string.Empty;
            public int OrderId { get; set; }
        }
        """;

    private const string EfInspectCode = """
        var changes = session.CreateChangeSet(); // Typed before-to-after transition against the retained baseline.
        if (!changes.IsChanged)
        {
            return; // The Save button stays disabled, like the draft card.
        }

        foreach (var change in changes.EnumerateChanges())
        {
            // Kind: Changed / Added / Removed / Order.
            // PathText: e.g. Customer, Lines[3].Qty. Before/After are
            // Optional<object?>; missing renders as — in the dialog table.
            Console.WriteLine($"{change.Kind} {change.PathText}");
        }
        """;
}
