@using SparseTypes
@using SparseTypes.Blazor
@using SparseTypes.Playground.Models

@if (Index >= 0)
{
    <div class="@RowClass pg-task-row">
        <div class="pg-task-line-ef">
            <div class="pg-roster-field">
                <span class="pg-mini notranslate" translate="no">Id <small>@(Line.Id.HasValue ? "int" : "new")</small></span>
                <FluentTextInput Value="@(Line.Id.HasValue ? $"#{Line.Id.Value}" : "#new")" ReadOnly="true" />
            </div>
            <SparseField Path="ProductPath" Context="product">
                <div class="pg-roster-field @(product.IsChanged ? "pg-changed" : "")">
                    <span class="pg-mini notranslate" translate="no">
                        @if (product.IsChanged)
                        {
                            <span class="pg-dot" title="edited"></span>
                        }
                        Product
                    </span>
                    <FluentTextInput Value="@product.Value"
                        ValueChanged="@(value => UpdateLineAsync(product, value))" />
                </div>
            </SparseField>
            <SparseField Path="QtyPath" Context="qty">
                <div class="pg-roster-field @(qty.IsChanged ? "pg-changed" : "")">
                    <span class="pg-mini notranslate" translate="no">
                        @if (qty.IsChanged)
                        {
                            <span class="pg-dot" title="edited"></span>
                        }
                        Qty
                    </span>
                    <FluentNumberInput TValue="int" Value="@qty.Value"
                        ValueChanged="@(value => UpdateLineAsync(qty, value))" />
                </div>
            </SparseField>
            <div class="pg-roster-actions pg-task-actions">
                <span class="pg-drag sortable-grab" title="Drag to reorder">⠿</span>
                <FluentButton Appearance="ButtonAppearance.Default" Title="Move up"
                    Disabled="@(Index == 0)" @onclick="() => MoveAsync(-1)">↑</FluentButton>
                <FluentButton Appearance="ButtonAppearance.Default" Title="Move down"
                    Disabled="@(Index == Draft.Lines.Count - 1)" @onclick="() => MoveAsync(1)">↓</FluentButton>
                <FluentButton Appearance="ButtonAppearance.Default" Title="Remove"
                    @onclick="RemoveAsync">✕</FluentButton>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public PlaygroundOrderLineDto Line { get; set; } = null!;

    [Parameter, EditorRequired]
    public PlaygroundOrderDto Draft { get; set; } = null!;

    // Collection field captured by the parent list: navigates to the row's
    // member paths with root-preserving typing, keyed by store identity for
    // persisted rows and by temporary identity for new rows.
    [Parameter, EditorRequired]
    public SparseFieldContext<PlaygroundOrderDto, List<PlaygroundOrderLineDto>> Lines { get; set; } = null!;

    // Render-scoped collection snapshot captured once by the parent list, so
    // rows share one view instead of diffing per row.
    [Parameter]
    public SparseCollectionState? Roster { get; set; }

    [Parameter, EditorRequired]
    public PlaygroundOrderDto.EditSession Session { get; set; } = null!;

    [Parameter, EditorRequired]
    public EventCallback<string> OnEditError { get; set; }

    // Field writes go through the SparseField bindings above; the parent
    // refreshes its retained ChangeSet when this fires.
    [Parameter, EditorRequired]
    public EventCallback OnEdited { get; set; }

    private int Index => Draft.Lines.IndexOf(Line);

    // AddLine always assigns a temporary identity, so the fallback below only
    // fails fast on a programming error instead of misaddressing a row.
    private ISparseTypedPath<PlaygroundOrderDto, string> ProductPath =>
        Line.Id is int id
            ? Lines.Key(id, (PlaygroundOrderLineDto line) => line.Product)
            : Lines.TemporaryKey<PlaygroundOrderLineDto, string>(
                Line.TemporaryId ?? Guid.Empty,
                static line => line.Product);

    private ISparseTypedPath<PlaygroundOrderDto, int> QtyPath =>
        Line.Id is int id
            ? Lines.Key(id, (PlaygroundOrderLineDto line) => line.Qty)
            : Lines.TemporaryKey<PlaygroundOrderLineDto, int>(
                Line.TemporaryId ?? Guid.Empty,
                static line => line.Qty);

    // Row and field highlights reuse the shared collection state. New rows
    // carry no store identity, exactly as before: they render added. Moved
    // observes surviving-key relative rank, matching the old manual rank
    // comparison. Added rows never query per-field state.
    private SparseCollectionItemState ItemState =>
        Roster is { } roster
            ? Line.Id is int id
                ? roster.GetItemState(id)
                : Line.TemporaryId is { } temporaryId
                    ? roster.GetTemporaryState(temporaryId)
                    : default
            : default;

    private bool IsAdded => !Line.Id.HasValue || ItemState.IsAdded;

    private bool IsMoved =>
        !IsAdded
        && Line.Id is int
        && ItemState is { IsRemoved: false, IsReordered: true };

    private string RowClass => IsAdded ? "pg-roster-row pg-added" : IsMoved ? "pg-roster-row pg-moved" : "pg-roster-row";

    // The field owns the session write; the parent only refreshes its
    // retained save snapshot afterwards.
    private async Task UpdateLineAsync<TValue>(SparseFieldContext<PlaygroundOrderDto, TValue> field, TValue? value)
    {
        await field.SetAsync(value);
        await OnEdited.InvokeAsync();
    }

    private async Task RemoveAsync()
    {
        var editor = Session.EditCollection<PlaygroundOrderLineDto, int>(
            PlaygroundOrderDto.SparsePath.Lines
        );
        var removed = Line.Id is int id
            ? editor.TryRemoveByKey(id, out var error)
            : editor.TryRemoveByTemporaryKey(Line.TemporaryId ?? Guid.Empty, out error);
        if (!removed)
        {
            await OnEditError.InvokeAsync($"Could not remove line: {error}.");
            return;
        }

        await OnEdited.InvokeAsync();
    }

    private async Task MoveAsync(int direction)
    {
        var editor = Session.EditCollection<PlaygroundOrderLineDto, int>(
            PlaygroundOrderDto.SparsePath.Lines
        );
        var index = Line.Id is int id
            ? editor.IndexOfKey(id)
            : editor.IndexOfTemporaryKey(Line.TemporaryId ?? Guid.Empty);
        var target = index + direction;
        if (index < 0 || target < 0 || target >= Draft.Lines.Count)
        {
            return;
        }

        if (!editor.TryMove(index, target, out var error))
        {
            await OnEditError.InvokeAsync($"Could not move line: {error}.");
            return;
        }

        await OnEdited.InvokeAsync();
    }
}
