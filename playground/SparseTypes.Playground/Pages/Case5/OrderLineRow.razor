@using SparseTypes
@using SparseTypes.Blazor
@using SparseTypes.Playground.Models

@if (Index >= 0)
{
    <div class="@RowClass pg-task-row" @ondragover:preventDefault @ondrop="OnDrop">
        <div class="pg-task-line-ef">
            <div class="pg-roster-field">
                <span class="pg-mini notranslate" translate="no">Id <small>@(IsAdded ? "new" : "int")</small></span>
                <FluentTextInput Value="@(IsAdded ? "#new" : $"#{Line.Key}")" ReadOnly="true" />
            </div>
            <SparseField Path="ProductPath" Context="product">
                <div class="pg-roster-field @(product.IsChanged ? "pg-changed" : "")">
                    <span class="pg-mini notranslate" translate="no">
                        @if (product.IsChanged)
                        {
                            <span class="pg-dot" title="edited"></span>
                        }
                        Product
                    </span>
                    <FluentTextInput Value="@product.Value" Disabled="@Disabled"
                        ValueChanged="@(value => UpdateLineAsync(product, value))" />
                </div>
            </SparseField>
            <SparseField Path="QtyPath" Context="qty">
                <div class="pg-roster-field @(qty.IsChanged ? "pg-changed" : "")">
                    <span class="pg-mini notranslate" translate="no">
                        @if (qty.IsChanged)
                        {
                            <span class="pg-dot" title="edited"></span>
                        }
                        Qty
                    </span>
                    <FluentNumberInput TValue="int" Value="@qty.Value" Disabled="@Disabled"
                        ValueChanged="@(value => UpdateLineAsync(qty, value))" />
                </div>
            </SparseField>
            <div class="pg-roster-actions pg-task-actions">
                <span class="pg-drag sortable-grab" draggable="@(!Disabled)"
                    @ondragstart="OnDragStart" @ondragend="OnDragEnd"
                    style="@(Disabled ? "pointer-events: none;" : null)" title="Drag to reorder">⠿</span>
                <FluentButton Appearance="ButtonAppearance.Default" Title="Move up"
                    Disabled="@(Disabled || Index == 0)" @onclick="() => MoveAsync(-1)">↑</FluentButton>
                <FluentButton Appearance="ButtonAppearance.Default" Title="Move down"
                    Disabled="@(Disabled || Index == LineCount - 1)" @onclick="() => MoveAsync(1)">↓</FluentButton>
                <FluentButton Appearance="ButtonAppearance.Default" Title="Remove"
                    Disabled="@Disabled" @onclick="RemoveAsync">✕</FluentButton>
            </div>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public SparseCollectionRow<PlaygroundOrderDto, PlaygroundOrderLineDto> Row { get; set; } = null!;

    [Parameter]
    public int LineCount { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<string> OnEditError { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnEdited { get; set; }

    [Parameter]
    public EventCallback<Guid> OnDragStarted { get; set; }

    [Parameter]
    public EventCallback OnDragEnded { get; set; }

    [Parameter]
    public EventCallback<int> OnDropAt { get; set; }

    private PlaygroundOrderLineDto Line => Row.Item;
    private int Index => Row.Index;
    private ISparseTypedPath<PlaygroundOrderDto, string> ProductPath =>
        Row.Select(static line => line.Product);
    private ISparseTypedPath<PlaygroundOrderDto, int> QtyPath =>
        Row.Select(static line => line.Qty);
    private SparseCollectionItemState ItemState => Row.RequireItemState();
    private bool IsAdded => ItemState.IsAdded;
    private bool IsMoved => !IsAdded && ItemState.IsReordered;
    private string RowClass => IsAdded
        ? "pg-roster-row pg-added"
        : IsMoved
            ? "pg-roster-row pg-moved"
            : "pg-roster-row";

    private async Task UpdateLineAsync<TValue>(
        SparseFieldContext<PlaygroundOrderDto, TValue> field,
        TValue? value
    )
    {
        if (Disabled)
        {
            return;
        }

        await field.SetAsync(value);
        await OnEdited.InvokeAsync();
    }

    private async Task RemoveAsync()
    {
        if (Disabled)
        {
            return;
        }

        if (!Row.TryRemove(out var error))
        {
            await OnEditError.InvokeAsync($"Could not remove line: {error}.");
            return;
        }

        await OnEdited.InvokeAsync();
    }

    private async Task MoveAsync(int direction)
    {
        if (Disabled)
        {
            return;
        }

        var target = Index + direction;
        if (target < 0 || target >= LineCount)
        {
            return;
        }

        if (!Row.TryMoveTo(target, out var error))
        {
            await OnEditError.InvokeAsync($"Could not move line: {error}.");
            return;
        }

        await OnEdited.InvokeAsync();
    }

    private Task OnDragStart()
    {
        if (Disabled)
        {
            return Task.CompletedTask;
        }

        return OnDragStarted.InvokeAsync(Row.UiKey);
    }

    private Task OnDragEnd() => OnDragEnded.InvokeAsync();

    private Task OnDrop() => Disabled
        ? Task.CompletedTask
        : OnDropAt.InvokeAsync(Index);
}
