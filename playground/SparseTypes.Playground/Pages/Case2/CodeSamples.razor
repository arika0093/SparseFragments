@using SparseTypes.Playground.Components

<div class="pg-code-samples">
    <p class="pg-hint">A regular ChangePayload can reconstruct this ChangeSet. The before-redaction case is covered in Section 4.</p>
    <FluentTabs Orientation="Orientation.Vertical">
        <FluentTab Header="Build a patch" Id="code-2-patch">
            <MonacoView Content="@PatchCode" Language="csharp" Height="360px" />
        </FluentTab>
        <FluentTab Header="Create and apply a ChangeSet" Id="code-2-changeset">
            <MonacoView Content="@ChangeSetCode" Language="csharp" Height="380px" />
        </FluentTab>
    </FluentTabs>
</div>

@code {
    private const string PatchCode = """
        using System.Text.Json;
        using SparseTypes;

        var fragment = lower.Merge(higher);

        var patch = new PlaygroundSettings.Patch();
        patch.Enabled.Keep();
        var retryOperation = FragmentOperation<int>.Set(5);
        patch.RetryCount.CopyFrom(retryOperation);
        patch.Label.Set("patched!");
        // Set(null) keeps an explicit null distinct from Keep and Remove.
        // patch.Label.Set(null);
        patch.Nested.Host.Remove();
        patch.Nested.Port.Set(9000);
        patch.Plugins.Keep();
        """;

    private const string ChangeSetCode = """
        using System.Text.Json;
        using SparseTypes;

        // Continue with the fragment and patch from the previous tab.
        var baseline = Optional<PlaygroundSettings.Fragment?>.Present(fragment);
        var changes = PlaygroundSettings.ChangeSet.FromPatch(baseline, patch);
        var options = PlaygroundJson.ChangeSetOptions();
        var json = JsonSerializer.Serialize(changes.ToPayload(), options);
        var payload = JsonSerializer.Deserialize<PlaygroundSettings.ChangePayload>(json, options)
            ?? throw new JsonException("The ChangePayload JSON deserialized to null.");
        var importedChanges = payload.ToChangeSet();
        var updated = fragment.Apply(importedChanges.ToPatch());
        """;
}
