@using SparseTypes.Playground.Models

@{
    // One typed lookup per row render: the row reads its own flags
    // directly instead of rebuilding the whole keyed collection state.
    var typed = Changes.GetChange(Quest.Id);
    var visible = !typed.IsEmpty && (!RemovedOnly || typed.IsRemoved);
    var moved = !typed.IsAdded && !typed.IsRemoved && typed.IsReordered;
    var rowClass = "pg-roster-row"
        + (visible && typed.IsAdded ? " pg-added" : "")
        + (visible && typed.IsRemoved ? " pg-removed" : "")
        + (visible && moved ? " pg-moved" : "");
    var titleChanged = !RemovedOnly && !typed.IsEmpty && typed.IsEdited && typed.Edit.Title.IsChanged;
    var pointsChanged = !RemovedOnly && !typed.IsEmpty && typed.IsEdited && typed.Edit.Points.IsChanged;
    var scoresChanged = !RemovedOnly && !typed.IsEmpty && typed.IsEdited && typed.Edit.Scores.IsChanged;
}

<div class="@rowClass">
    <div class="pg-rline1">
        <div class="pg-roster-field">
            <span class="pg-mini notranslate" translate="no">Id <small>key</small></span>
            <FluentTextInput Placeholder="id" Style="width: 100%"
                Value="@Quest.Id"
                ValueChanged="@(async value => { Quest.Id = value; await NotifyAsync(); })" />
        </div>
        <div class="pg-roster-field @(titleChanged ? "pg-changed" : "")">
            <span class="pg-mini notranslate" translate="no">
                @if (titleChanged)
                {
                    <span class="pg-dot" title="edited"></span>
                }
                Title
            </span>
            <FluentTextInput Placeholder="title" Style="width: 100%"
                Value="@Quest.Title"
                ValueChanged="@(async value => { Quest.Title = value; await NotifyAsync(); })" />
        </div>
        <div class="pg-roster-field @(pointsChanged ? "pg-changed" : "")">
            <span class="pg-mini notranslate" translate="no">
                @if (pointsChanged)
                {
                    <span class="pg-dot" title="edited"></span>
                }
                Points
            </span>
            <FluentNumberInput TValue="int" Style="width: 100%"
                Value="@Quest.Points"
                ValueChanged="@(async value => { Quest.Points = value; await NotifyAsync(); })" />
        </div>
    </div>
    <div class="pg-rline2">
        <div class="pg-roster-field @(scoresChanged ? "pg-changed" : "")">
            <span class="pg-mini notranslate" translate="no">
                @if (scoresChanged)
                {
                    <span class="pg-dot" title="edited"></span>
                }
                Scores <small>List&lt;int&gt; whole</small>
            </span>
            <IntListField Placeholder="10, 20" Style="width: 100%"
                Value="@Quest.Scores"
                ValueChanged="@(async value => { Quest.Scores = value; await NotifyAsync(); })" />
        </div>
        <div class="pg-roster-field">
            <span class="pg-mini notranslate" translate="no">Order</span>
            <div class="pg-order @((visible && moved) ? "pg-moved-num" : "")" title="Position in this list">@(Position + 1)</div>
        </div>
        <div class="pg-roster-actions">
            @if (AllowReorder)
            {
                <span class="pg-drag sortable-grab" title="Drag to reorder">⠿</span>
                <FluentButton Appearance="ButtonAppearance.Default" Title="Move up" Disabled="@(Position == 0)" @onclick="() => MoveAsync(-1)">↑</FluentButton>
                <FluentButton Appearance="ButtonAppearance.Default" Title="Move down" Disabled="@(Position == Model.Quests.Count - 1)" @onclick="() => MoveAsync(1)">↓</FluentButton>
            }
            <FluentButton Appearance="ButtonAppearance.Default" Title="Remove" @onclick="RemoveAsync">✕</FluentButton>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public PlaygroundRoster Model { get; set; } = null!;

    [Parameter, EditorRequired]
    public PlaygroundQuest Quest { get; set; } = null!;

    [Parameter, EditorRequired]
    public PlaygroundRoster.ChangeSet.QuestsTransition Changes { get; set; } = null!;

    [Parameter]
    public bool AllowReorder { get; set; }

    [Parameter]
    public bool RemovedOnly { get; set; }

    /// <summary>Gets or sets the render-time position built once by the parent list.</summary>
    /// <remarks>Display only: callbacks re-resolve the live index by reference.</remarks>
    [Parameter]
    public int Position { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private Task RemoveAsync()
    {
        // The render-time position may be stale after a reorder, so the row
        // removes its own live position instead.
        var index = Model.Quests.IndexOf(Quest);
        if (index < 0 || !ReferenceEquals(Model.Quests[index], Quest))
        {
            return Task.CompletedTask;
        }
        Model.Quests.RemoveAt(index);
        return NotifyAsync();
    }

    private Task MoveAsync(int delta)
    {
        var quests = Model.Quests;
        var index = quests.IndexOf(Quest);
        if (index < 0 || !ReferenceEquals(quests[index], Quest))
        {
            return Task.CompletedTask;
        }
        var target = index + delta;
        if (target < 0 || target >= quests.Count)
        {
            return Task.CompletedTask;
        }
        (quests[target], quests[index]) = (quests[index], quests[target]);
        return NotifyAsync();
    }

    private Task NotifyAsync() => OnChanged.InvokeAsync();
}
