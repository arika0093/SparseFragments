@page "/"
@using SparseTypes.Playground.Components

<PageTitle>SparseTypes Playground</PageTitle>

<section class="pg-section pg-intro">
    <div class="pg-badges" aria-label="Project badges">
        <a href="https://www.nuget.org/packages/SparseTypes/" target="_blank" rel="noopener">
            <img src="https://img.shields.io/nuget/v/SparseTypes?style=flat-square&amp;logo=NuGet&amp;color=0080CC" alt="NuGet Version" />
        </a>
        <img src="https://img.shields.io/github/actions/workflow/status/arika0093/SparseTypes/test.yaml?branch=main&amp;label=Test&amp;style=flat-square" alt="GitHub Actions Workflow Status" />
        <a href="https://deepwiki.com/arika0093/SparseTypes" target="_blank" rel="noopener">
            <img src="https://img.shields.io/badge/DeepWiki-SparseTypes-blue.svg?logo=data:image/png;base64," alt="DeepWiki" />
        </a>
    </div>
    <p>Source-generated partial state and typed changes for C#.</p>
    <div class="pg-generation-layout pg-intro-code-grid">
        <FluentCard Class="pg-fluent-card">
            <h3>Model</h3>
            <FluentTabs Orientation="Orientation.Horizontal">
                <FluentTab Header="Settings.cs" Id="intro-model-settings">
                    <p class="pg-hint">Add <code>[SparseModel]</code> to a partial class.</p>
                    <MonacoEditor Value="@ModelCode" Language="csharp" Height="360px" ReadOnly="true" />
                </FluentTab>
            </FluentTabs>
        </FluentCard>
        <FluentCard Class="pg-fluent-card">
            <h3>Generated API (simplified)</h3>
            <FluentTabs Orientation="Orientation.Horizontal">
                <FluentTab Header="Fragment" Id="intro-generated-fragment">
                    <p class="pg-hint">Stores model values and tracks whether each member is present.</p>
                    <MonacoEditor Value="@FragmentCode" Language="csharp" Height="360px" ReadOnly="true" />
                </FluentTab>
                <FluentTab Header="Patch" Id="intro-generated-patch">
                    <p class="pg-hint">Represents member changes as typed operations that can be applied to a model.</p>
                    <MonacoEditor Value="@PatchCode" Language="csharp" Height="360px" ReadOnly="true" />
                </FluentTab>
                <FluentTab Header="ChangeSet" Id="intro-generated-changeset">
                    <p class="pg-hint">Describes the transition between two model states and can create a patch or payload.</p>
                    <MonacoEditor Value="@ChangeSetCode" Language="csharp" Height="360px" ReadOnly="true" />
                </FluentTab>
                <FluentTab Header="EditSession" Id="intro-generated-edit-session">
                    <p class="pg-hint">Tracks edits against a baseline and supports accepting or reverting them.</p>
                    <MonacoEditor Value="@EditSessionCode" Language="csharp" Height="360px" ReadOnly="true" />
                </FluentTab>
                <FluentTab Header="Observable" Id="intro-generated-observable">
                    <p class="pg-hint">Wraps the model and raises property-change notifications as values change.</p>
                    <MonacoEditor Value="@ObservableCode" Language="csharp" Height="360px" ReadOnly="true" />
                </FluentTab>
                <FluentTab Header="ReadOnlyView" Id="intro-generated-read-only-view">
                    <p class="pg-hint">Exposes model values through a read-only view.</p>
                    <MonacoEditor Value="@ReadOnlyViewCode" Language="csharp" Height="360px" ReadOnly="true" />
                </FluentTab>
            </FluentTabs>
        </FluentCard>
    </div>
    <p>Install and try it: <a href="https://www.nuget.org/packages/SparseTypes/">NuGet</a></p>
</section>

<section class="pg-section" id="samples">
    <div class="pg-section-heading">
        <h2>Samples</h2>
    </div>
    <p class="pg-hint">Pick a sample from the menu or below. Each page is self-contained with its own playground and code tabs.</p>
    <div class="pg-grid">
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>01 Layers merge</h3>
            </div>
            <p class="pg-hint">Merge a Lower baseline with a Higher overlay; only present members override.</p>
            <FluentAnchorButton Appearance="ButtonAppearance.Primary" Href="case-1">Open sample</FluentAnchorButton>
        </FluentCard>
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>02 Typed patch</h3>
            </div>
            <p class="pg-hint">Apply Set / Remove / Keep edits to the merged fragment and export the ChangePayload.</p>
            <FluentAnchorButton Appearance="ButtonAppearance.Primary" Href="case-2">Open sample</FluentAnchorButton>
        </FluentCard>
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>03 Keyed list</h3>
            </div>
            <p class="pg-hint">Diff Before / After quest lists by Id key and inspect the ChangeSet table.</p>
            <FluentAnchorButton Appearance="ButtonAppearance.Primary" Href="case-3">Open sample</FluentAnchorButton>
        </FluentCard>
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>04 Undo / Redo</h3>
            </div>
            <p class="pg-hint">Edit the observable model, then submit, reset, undo, or redo.</p>
            <FluentAnchorButton Appearance="ButtonAppearance.Primary" Href="case-4">Open sample</FluentAnchorButton>
        </FluentCard>
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>05 EF Core mapping</h3>
            </div>
            <p class="pg-hint">Apply an order ChangeSet to a tracked EF Core entity and persist it.</p>
            <FluentAnchorButton Appearance="ButtonAppearance.Primary" Href="case-5">Open sample</FluentAnchorButton>
        </FluentCard>
    </div>
</section>

@code {
    private const string ModelCode = """
        using SparseTypes;

        [SparseModel]         // add this attribute
        public partial class Settings // mark the class as partial
        {
            public string? Theme { get; set; }
            public List<NestedClass> Items { get; set; } = [];
        }

        // Nested class should also be marked as partial.
        public partial class NestedClass
        {
            public string? Name { get; set; }
        }
        """;

    private const string FragmentCode = """
        public partial class Settings
        {
            // Stores sparse values together with their presence state.
            public sealed class Fragment
            {
                // Optional values distinguish absent members from explicit values.
                public Optional<string?> Theme { get; init; }
                public Optional<List<NestedClass>> Items { get; init; }

                // Copies a model into a fragment.
                public static Fragment From(Settings value);
                // Creates a model from this fragment.
                public Settings ToModel();
                // Merges a higher-priority fragment over this one.
                public Fragment Merge(Fragment higher);
            }
        }
        """;

    private const string PatchCode = """
        public partial class Settings
        {
            // Holds typed operations for applying partial updates.
            public sealed class Patch
            {
                // Describes the operations to apply to model members.
                public FragmentOperation<string?> Theme { get; set; }
                public FragmentOperation<List<NestedClass>> Items { get; set; }

                // Applies these operations to a model.
                public Settings ApplyTo(Settings current);
            }
        }
        """;

    private const string ChangeSetCode = """
        public partial class Settings
        {
            // Describes a typed transition between model states.
            public sealed class ChangeSet
            {
                // Indicates whether the transition contains no changes.
                public bool IsEmpty { get; }

                // Calculates the changes from before to after.
                public static ChangeSet Between(Settings before, Settings after);
                // Converts the transition into patch operations.
                public Patch ToPatch();
                // The payload carries this transition in a transport-friendly form.
                public ChangePayload ToPayload();
                // Reverses this transition.
                public ChangeSet Invert();
            }
        }
        """;

    private const string EditSessionCode = """
        public partial class Settings
        {
            // Tracks pending edits against a retained baseline.
            public sealed class EditSession
            {
                // The core retains the baseline snapshot and current model.
                private readonly EditSessionCore<Settings, Fragment, Patch, ChangeSet, Observable, ReadOnlyView> _session;
                public bool HasChanges { get; }
                public ReadOnlyView Current { get; }

                // Initializes the session with a model and captures its baseline.
                internal EditSession(Settings model, Action? onChanged);
                // Creates a change set for the pending edits.
                public ChangeSet CreateChangeSet();
                // Accepts the current model as the new baseline.
                public void AcceptChanges();
                // Restores the model to its retained baseline.
                public void RevertChanges();
            }
        }
        """;

    private const string ObservableCode = """
        public partial class Settings
        {
            // Provides property-change notifications for model edits.
            public sealed class Observable : INotifyPropertyChanged
            {
                // Proxies the model and notifies listeners when a property changes.
                private readonly Settings _model;

                // Wraps an existing model instance.
                public Observable(Settings model) => _model = model;

                public event PropertyChangedEventHandler? PropertyChanged;

                public string? Theme
                {
                    get => _model.Theme;
                    set
                    {
                        if (_model.Theme == value) return;
                        _model.Theme = value;
                        PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(nameof(Theme)));
                    }
                }

                // Other properties are omitted.
            }
        }
        """;

    private const string ReadOnlyViewCode = """
        public partial class Settings
        {
            // Exposes model values without mutation methods.
            public sealed class ReadOnlyView
            {
                // Exposes model values through a read-only projection.
                public string? Theme { get; }
                public IReadOnlyList<NestedClass> Items { get; }
            }
        }
        """;
}
