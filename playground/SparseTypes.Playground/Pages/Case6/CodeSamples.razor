@using SparseTypes.Playground.Components

<div class="pg-code-samples">
    <p class="pg-hint">A shared session scope can retain section drafts or automatically merge each child edit into its parent. BatchEdit keeps a multi-field child action as one parent history entry.</p>
    <FluentTabs Orientation="Orientation.Vertical">
        <FluentTab Header="Shapes" Id="code-6-shapes">
            <MonacoView Content="@ShapesCode" Language="csharp" Height="470px" />
        </FluentTab>
        <FluentTab Header="Scope and fields" Id="code-6-scopes">
            <MonacoView Content="@ScopesCode" Language="csharp" Height="450px" />
        </FluentTab>
        <FluentTab Header="Workflow and keyed scopes" Id="code-6-workflow">
            <MonacoView Content="@WorkflowCode" Language="csharp" Height="390px" />
        </FluentTab>
        <FluentTab Header="History and save" Id="code-6-history">
            <MonacoView Content="@HistoryCode" Language="csharp" Height="360px" />
        </FluentTab>
    </FluentTabs>
</div>

