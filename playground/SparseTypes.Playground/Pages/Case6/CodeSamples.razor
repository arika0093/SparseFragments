@using SparseTypes.Playground.Components

<div class="pg-code-samples">
    <p class="pg-hint">Each tab edits a child model through its own typed EditSession and Undo/Redo history. Workflow steps and work masters use separate keyed collections, so saving one section does not change the other section's draft.</p>
    <FluentTabs Orientation="Orientation.Vertical">
        <FluentTab Header="Shapes" Id="code-6-shapes">
            <MonacoView Content="@ShapesCode" Language="csharp" Height="390px" />
        </FluentTab>
        <FluentTab Header="Child sessions" Id="code-6-scopes">
            <MonacoView Content="@ScopesCode" Language="csharp" Height="330px" />
        </FluentTab>
        <FluentTab Header="Workflow and keyed scopes" Id="code-6-workflow">
            <MonacoView Content="@WorkflowCode" Language="csharp" Height="360px" />
        </FluentTab>
        <FluentTab Header="History and save" Id="code-6-history">
            <MonacoView Content="@HistoryCode" Language="csharp" Height="330px" />
        </FluentTab>
    </FluentTabs>
</div>

@code {
    private const string ShapesCode = """
        [SparseModel]
        public partial class EnterpriseCatalogItem
        {
            public CatalogOverview Overview { get; set; } = new();
            public CatalogCommercialDetails Commercial { get; set; } = new();
            public CatalogOperationsDetails Operations { get; set; } = new();
            public CatalogWorkflow Workflow { get; set; } = new();
            public List<CatalogWorkMaster> WorkMasters { get; set; } = [];
        }

        [SparseModel]
        public partial class CatalogCommercialDetails
        {
            public List<CatalogPriceTier> PriceTiers { get; set; } = [];
        }

        [SparseModel]
        public partial class CatalogPriceTier
        {
            [SparseKey]
            public string Code { get; set; } = string.Empty;
            public List<CatalogDiscountBand> Discounts { get; set; } = [];
        }

        [SparseModel]
        public partial class CatalogWorkflow
        {
            public List<CatalogWorkStep> Steps { get; set; } = [];
        }

        public sealed class CatalogWorkStep
        {
            [SparseKey]
            public string Id { get; set; } = string.Empty;
            public string Name { get; set; } = string.Empty;
        }

        [SparseModel]
        public partial class CatalogWorkMaster
        {
            [SparseKey]
            public string StepId { get; set; } = string.Empty;
            public string WorkCenter { get; set; } = string.Empty;
        }
        """;

    private const string ScopesCode = """
        var session = catalog.CreateEditSession();

        using var overview = session.OpenChildSession(EnterpriseCatalogItem.SparsePath.Overview);
        overview.Session.Observable.Name = "Modular Drive Unit";
        if (!overview.TryAcceptChanges(out var conflicts))
        {
            ShowConflicts(conflicts);
        }

        using var commercial = session.OpenChildSession(EnterpriseCatalogItem.SparsePath.Commercial);
        commercial.Session.Observable.UnitPrice = 2480m;
        commercial.TryAcceptChanges(out _);

        var changes = session.CreateChangeSet();
        // Each child session contributes changes to the same typed session.
        """;

    private const string WorkflowCode = """
        var workflow = session.OpenChildSession(EnterpriseCatalogItem.SparsePath.Workflow);
        var steps = workflow.Session.EditCollection<CatalogWorkStep, string>(CatalogWorkflow.SparsePath.Steps);
        steps.TryInsert(steps.Count, new CatalogWorkStep
        {
            Id = "new-step",
            Name = "Calibration",
        }, out _);

        workflow.TryAcceptChanges(out _);

        var workMasters = session.EditCollection<CatalogWorkMaster, string>(
            EnterpriseCatalogItem.SparsePath.WorkMasters);
        workMasters.TryInsert(workMasters.Count, new CatalogWorkMaster { StepId = "new-step" }, out _);

        using var stepMaster = session.OpenChildSession(
            EnterpriseCatalogItem.SparsePath.WorkMasters.Key("new-step"));
        stepMaster.Session.Observable.WorkCenter = "WC-17";
        stepMaster.TryAcceptChanges(out _);
        """;

    private const string HistoryCode = """
        var session = catalog.CreateEditSession();
        var overview = session.OpenChildSession(EnterpriseCatalogItem.SparsePath.Overview);
        var history = overview.Session.EnableHistory();
        overview.Session.Observable.Active = false;

        if (history.CanUndo)
        {
            history.Undo();
        }

        history.Redo();
        overview.TryAcceptChanges(out _);
        // Accepting the child session resets its history baseline.

        var changes = session.CreateChangeSet();
        if (changes.IsChanged)
        {
            var beforeJson = JsonSerializer.Serialize(savedCatalog, PlaygroundJsonContext.Default.EnterpriseCatalogItem);
            var afterJson = JsonSerializer.Serialize(catalog, PlaygroundJsonContext.Default.EnterpriseCatalogItem);
            PresentDiff(beforeJson, afterJson);
            session.AcceptChanges();
        }
        """;
}
