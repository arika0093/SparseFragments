    private const string ScopesCode = """
        using SparseTypes;
        using SparseTypes.Blazor;
        using SparseTypes.Playground.Models;

        <SparseSessionScope Session="_session" AutoAccept="true">
            <OverviewEditor />
        </SparseSessionScope>

        [CascadingParameter]
        ISparseEditSession<EnterpriseCatalogItem>? ParentSession { get; set; }

        [CascadingParameter]
        SparseSessionScopeContext<EnterpriseCatalogItem>? ScopeContext { get; set; }

        private ISparseChildEditContext<CatalogOverview, SparseConflict> _overview = null!;
        private CatalogOverview.EditSession _draft = null!;

        protected override void OnParametersSet()
        {
            var parent = ParentSession as EnterpriseCatalogItem.EditSession
                ?? throw new InvalidOperationException("The catalog session is unavailable.");
            var child = ScopeContext!.OpenChildSession(parent, EnterpriseCatalogItem.SparsePath.Overview);
            _overview = child;
            _draft = child.Session;
        }

        var hasPendingChildEdits = ScopeContext!.HasChanges;

        if (_overview.AutoAcceptConflicts is { Count: > 0 } conflicts)
        {
            ShowConflicts(conflicts);
        }

        <SparseEdit Session="_draft" Context="edit">
            <SparseField Path="edit.Path.Name" Context="name">
                <FluentTextInput Value="@name.Value" ValueChanged="name.ValueChanged" />
            </SparseField>
        </SparseEdit>

        """;

    private const string WorkflowCode = """
        var workflow = scope.OpenChildSession(
            session,
            EnterpriseCatalogItem.SparsePath.Workflow);

        var steps = workflow.Session.EditCollection<CatalogWorkStep, string>(
            CatalogWorkflow.SparsePath.Steps);
        if (!steps.TryInsert(steps.Count, new CatalogWorkStep
        {
            Id = "new-step",
            Name = "Calibration",
            ResponsibleTeam = "Engineering",
            StandardHours = 0.8m,
        }, out var error))
        {
            ShowEditError(error);
        }

        if (!workflow.TryAcceptChanges(out var conflicts))
        {
            ShowConflicts(conflicts);
        }

        // Work-master tabs use steps accepted into the catalog session.
        var workMaster = scope.OpenChildSession(
            session,
            EnterpriseCatalogItem.SparsePath.WorkMasters.Key("new-step"));
        """;

    private const string HistoryCode = """
        var history = session.EnableHistory();
        var overview = scope.OpenChildSession(
            session,
            EnterpriseCatalogItem.SparsePath.Overview);
        overview.Session.BatchEdit(() =>
        {
            overview.Session.Observable.Active = false;
            overview.Session.Observable.Name = "Revised unit";
        });

        if (overview.AutoAcceptConflicts is { Count: > 0 } conflicts)
        {
            ShowConflicts(conflicts);
        }

        // AutoAccept records the batch as one parent-history transition.
        if (history.CanUndo)
        {
            history.Undo();
        }
        """;
}
