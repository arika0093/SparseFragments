@using SparseTypes
@using SparseTypes.Blazor
@using SparseTypes.Playground.Models
@using CatalogSession = global::SparseTypes.Playground.Models.EnterpriseCatalogItem.EditSession;

@if (_childSession is not null)
{
        <SparseEdit Session="_draftSession" Context="edit">
            <FluentCard Class="pg-fluent-card">
                <div class="pg-card-head">
                    <h3>Commercial details</h3>
                    <span class="pg-has-changes-badge @(HasChanges ? "pg-has-changes" : "pg-no-changes")">
                        <span aria-hidden="true"></span>@(HasChanges ? "Edited" : "Current")
                    </span>
                </div>
                <CatalogDraftStatus HasChanges="edit.HasChanges" OnChanged="ReportStatus" />
                <div class="pg-stack pg-edit-fields">
                    <SparseField Path="edit.Path.Customer" Context="customer">
                        <div class="pg-row pg-session-field @(customer.IsChanged ? "pg-changed" : "")">
                            <span class="pg-name notranslate" translate="no">Customer <small>string</small></span>
                            <FluentTextInput Value="@customer.Value" ValueChanged="customer.ValueChanged" />
                        </div>
                    </SparseField>
                    <SparseField Path="edit.Path.Region" Context="region">
                        <div class="pg-row pg-session-field @(region.IsChanged ? "pg-changed" : "")">
                            <span class="pg-name notranslate" translate="no">Region <small>string</small></span>
                            <FluentTextInput Value="@region.Value" ValueChanged="region.ValueChanged" />
                        </div>
                    </SparseField>
                    <SparseField Path="edit.Path.ContractCode" Context="contractCode">
                        <div class="pg-row pg-session-field @(contractCode.IsChanged ? "pg-changed" : "")">
                            <span class="pg-name notranslate" translate="no">ContractCode <small>string</small></span>
                            <FluentTextInput Value="@contractCode.Value" ValueChanged="contractCode.ValueChanged" />
                        </div>
                    </SparseField>
                    <SparseField Path="edit.Path.Currency" Context="currency">
                        <div class="pg-row pg-session-field @(currency.IsChanged ? "pg-changed" : "")">
                            <span class="pg-name notranslate" translate="no">Currency <small>string</small></span>
                            <FluentTextInput Value="@currency.Value" ValueChanged="currency.ValueChanged" />
                        </div>
                    </SparseField>
                    <SparseField Path="edit.Path.UnitPrice" Context="unitPrice">
                        <div class="pg-row pg-session-field @(unitPrice.IsChanged ? "pg-changed" : "")">
                            <span class="pg-name notranslate" translate="no">UnitPrice <small>decimal</small></span>
                            <FluentNumberInput TValue="decimal" Value="@unitPrice.Value" ValueChanged="unitPrice.ValueChanged" />
                        </div>
                    </SparseField>
                    <SparseField Path="edit.Path.AnnualVolume" Context="annualVolume">
                        <div class="pg-row pg-session-field @(annualVolume.IsChanged ? "pg-changed" : "")">
                            <span class="pg-name notranslate" translate="no">AnnualVolume <small>int</small></span>
                            <FluentNumberInput TValue="int" Value="@annualVolume.Value" ValueChanged="annualVolume.ValueChanged" />
                        </div>
                    </SparseField>
                </div>

                <div class="pg-catalog-list-section">
                    <div class="pg-card-head">
                        <h4>Price tiers</h4>
                        <FluentButton Appearance="ButtonAppearance.Primary" @onclick="AddTier">Add price tier</FluentButton>
                    </div>
                    <SparseField Path="edit.Path.PriceTiers" Context="tiers">
                        @{ var roster = tiers.TryGetCollectionState(out var state) ? state : null; }
                        <div class="pg-roster-list">
                            @foreach (var tier in Draft.PriceTiers)
                            {
                                <SparseSessionScope @key="tier.Code" Session="_draftSession">
                                    <CatalogPriceTierEditor Code="tier.Code"
                                        State="@(roster?.GetItemState(tier.Code) ?? default)"
                                        ChildSessions="ChildSessions"
                                        SectionDraftsEnabled="SectionDraftsEnabled"
                                        OpenOnLoad="@(_tierToOpen == tier.Code)"
                                        OnOpened="ClearTierToOpen" OnRemove="RemoveTier"
                                        OnChanged="ReportNestedStatus" />
                                </SparseSessionScope>
                            }
                            @foreach (var removed in _baseline.PriceTiers.Where(tier =>
                                !Draft.PriceTiers.Any(current => current.Code == tier.Code)))
                            {
                                <div class="pg-roster-row pg-removed">
                                    <div class="pg-catalog-inline-row">
                                        <span>@removed.Label</span>
                                        <span class="pg-change-remove">Removed</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </SparseField>
                </div>
                <div class="pg-legend pg-session-legend" aria-label="Edit highlight legend">
                    <span class="pg-lg"><span class="pg-sw pg-sw-add"></span>added</span>
                    <span class="pg-dot"></span>edited
                </div>
                <ChildSessionActions HasChanges="GetHasChanges" CanUndo="GetCanUndo" CanRedo="GetCanRedo"
                    SectionDraftsEnabled="SectionDraftsEnabled"
                    Undo="Undo" Redo="Redo" Accept="TryAcceptChildSession" Discard="DiscardChildSession"
                    OnFinished="RefreshBaseline" />
            </FluentCard>
        </SparseEdit>

}

@code {
    [CascadingParameter]
    public ISparseEditSession<EnterpriseCatalogItem>? ParentSession { get; set; }

    [CascadingParameter]
    public SparseSessionScopeContext<EnterpriseCatalogItem>? ScopeContext { get; set; }

    [Parameter, EditorRequired]
    public CatalogChildSessionCoordinator ChildSessions { get; set; } = null!;

    [Parameter]
    public bool SectionDraftsEnabled { get; set; } = true;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private CatalogSession? _parentSession;
    private SparseSessionScopeContext<EnterpriseCatalogItem>? _scopeContext;
    private ISparseChildEditContext<CatalogCommercialDetails, SparseConflict>? _childSession;
    private CatalogCommercialDetails.EditSession _draftSession = null!;
    private CatalogCommercialDetails _baseline = null!;
    private string? _tierToOpen;
    private CatalogCommercialDetails.Observable Draft => _draftSession.Observable;
    private bool HasChanges => _childSession?.HasChanges == true;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_parentSession, ParentSession) && ReferenceEquals(_scopeContext, ScopeContext))
        {
            return;
        }

        _parentSession = ParentSession as CatalogSession
            ?? throw new InvalidOperationException("The catalog edit session is unavailable.");
        _scopeContext = ScopeContext
            ?? throw new InvalidOperationException("The catalog session scope is unavailable.");
        var childSession = _scopeContext.OpenChildSession(
            _parentSession,
            EnterpriseCatalogItem.SparsePath.Commercial
        );
        _childSession = childSession;
        _draftSession = childSession.Session;
        _baseline = _draftSession.GetModelForFrameworkAccess().DeepClone();
    }

    private Task ReportStatus(bool hasChanges)
    {
        AcceptImmediatelyIfNeeded();
        ChildSessions.SetHasChanges(CatalogChildSessionCoordinator.CommercialId, HasChanges);
        return OnChanged.InvokeAsync();
    }

    private Task ReportNestedStatus(bool hasChanges)
    {
        AcceptImmediatelyIfNeeded();
        ChildSessions.SetHasChanges(CatalogChildSessionCoordinator.CommercialId, HasChanges);
        return OnChanged.InvokeAsync();
    }

    private void AcceptImmediatelyIfNeeded()
    {
        if (!SectionDraftsEnabled && _childSession!.HasChanges)
        {
            ChildSessions.TryAcceptImmediately(_childSession);
        }
    }

    private Task RefreshBaseline()
    {
        _baseline = _draftSession.GetModelForFrameworkAccess().DeepClone();
        return OnChanged.InvokeAsync();
    }

    private bool GetHasChanges() => _childSession?.HasChanges == true;
    private bool GetCanUndo() => _childSession?.CanUndo == true;
    private bool GetCanRedo() => _childSession?.CanRedo == true;
    private void Undo() => _childSession?.Undo();
    private void Redo() => _childSession?.Redo();

    private (bool Accepted, IReadOnlyList<SparseConflict>? Conflicts) TryAcceptChildSession()
    {
        var accepted = _childSession!.TryAcceptChanges(out var conflicts);
        return (accepted, conflicts);
    }

    private void DiscardChildSession()
    {
        _childSession!.DiscardChanges();
        _baseline = _draftSession.GetModelForFrameworkAccess().DeepClone();
    }

    private Task AddTier()
    {
        var tiers = _draftSession.EditCollection<CatalogPriceTier, string>(
            CatalogCommercialDetails.SparsePath.PriceTiers
        );
        if (!tiers.TryAdd(
            new CatalogPriceTier
            {
                Code = $"tier-{Guid.NewGuid():N}",
                Label = "New tier",
                MinimumQuantity = 1,
                UnitPrice = Draft.UnitPrice,
            },
            out var error
        ))
        {
            throw new InvalidOperationException($"Could not add the price tier ({error}).");
        }

        _tierToOpen = Draft.PriceTiers[^1].Code;
        return Task.CompletedTask;
    }

    private Task ClearTierToOpen()
    {
        _tierToOpen = null;
        return Task.CompletedTask;
    }

    private Task RemoveTier(string code)
    {
        var tiers = _draftSession.EditCollection<CatalogPriceTier, string>(
            CatalogCommercialDetails.SparsePath.PriceTiers
        );
        if (!tiers.TryRemoveByKey(code, out var error))
        {
            throw new InvalidOperationException($"Could not remove the price tier ({error}).");
        }

        return Task.CompletedTask;
    }
}
