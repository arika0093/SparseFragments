@using SparseTypes
@using SparseTypes.Blazor
@using SparseTypes.Playground.Models

@if (ParentSession is not null && ScopeContext is not null)
{
    <SparseChildEditDefault Path="EnterpriseCatalogItem.SparsePath.Commercial" Context="child">
        @{
            if (!ReferenceEquals(_childSession, child))
            {
                _childSession = child;
                _draftSession = child.Session;
            }
        }
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>Commercial details</h3>
                <span class="pg-has-changes-badge @(IsSectionEdited ? "pg-has-changes" : "pg-no-changes")">
                    <span aria-hidden="true"></span>@(IsSectionEdited ? "Edited" : "Current")
                </span>
            </div>
            <CatalogDraftStatus HasChanges="IsSectionEdited" OnChanged="ReportStatus" />
            <div class="pg-stack pg-edit-fields">
                <SparseField Path="child.Path.Customer" Context="customer">
                    <div class="pg-row pg-session-field @(customer.IsChanged ? "pg-changed" : "")">
                        <span class="pg-name notranslate" translate="no">Customer <small>string</small></span>
                        <FluentTextInput Value="@customer.Value" ValueChanged="customer.ValueChanged" />
                    </div>
                </SparseField>
                <SparseField Path="child.Path.Region" Context="region">
                    <div class="pg-row pg-session-field @(region.IsChanged ? "pg-changed" : "")">
                        <span class="pg-name notranslate" translate="no">Region <small>string</small></span>
                        <FluentTextInput Value="@region.Value" ValueChanged="region.ValueChanged" />
                    </div>
                </SparseField>
                <SparseField Path="child.Path.ContractCode" Context="contractCode">
                    <div class="pg-row pg-session-field @(contractCode.IsChanged ? "pg-changed" : "")">
                        <span class="pg-name notranslate" translate="no">ContractCode <small>string</small></span>
                        <FluentTextInput Value="@contractCode.Value" ValueChanged="contractCode.ValueChanged" />
                    </div>
                </SparseField>
                <SparseField Path="child.Path.Currency" Context="currency">
                    <div class="pg-row pg-session-field @(currency.IsChanged ? "pg-changed" : "")">
                        <span class="pg-name notranslate" translate="no">Currency <small>string</small></span>
                        <FluentTextInput Value="@currency.Value" ValueChanged="currency.ValueChanged" />
                    </div>
                </SparseField>
                <SparseField Path="child.Path.UnitPrice" Context="unitPrice">
                    <div class="pg-row pg-session-field @(unitPrice.IsChanged ? "pg-changed" : "")">
                        <span class="pg-name notranslate" translate="no">UnitPrice <small>decimal</small></span>
                        <FluentNumberInput TValue="decimal" Value="@unitPrice.Value" ValueChanged="unitPrice.ValueChanged" />
                    </div>
                </SparseField>
                <SparseField Path="child.Path.AnnualVolume" Context="annualVolume">
                    <div class="pg-row pg-session-field @(annualVolume.IsChanged ? "pg-changed" : "")">
                        <span class="pg-name notranslate" translate="no">AnnualVolume <small>int</small></span>
                        <FluentNumberInput TValue="int" Value="@annualVolume.Value" ValueChanged="annualVolume.ValueChanged" />
                    </div>
                </SparseField>
            </div>

            <div class="pg-catalog-list-section">
                <div class="pg-card-head">
                    <h4>Price tiers</h4>
                    <FluentButton Appearance="ButtonAppearance.Primary" @onclick="AddTier">Add price tier</FluentButton>
                </div>
                <div class="pg-roster-list">
                    <SparseCollection @ref="_tierCollection"
                        TModel="CatalogCommercialDetails" TElement="CatalogPriceTier"
                        Path="child.Path.PriceTiers">
                        <RowTemplate Context="tierRow">
                            <CatalogPriceTierEditor Code="@tierRow.Item.Code"
                                State="tierRow.RequireItemState()"
                                SectionDraftsEnabled="SectionDraftsEnabled"
                                OpenOnLoad="@(_tierToOpen == tierRow.Item.Code)"
                                OnOpened="ClearTierToOpen" OnRemove="() => RemoveTier(tierRow)"
                                OnChanged="ReportNestedStatus" />
                        </RowTemplate>
                    </SparseCollection>
                        @foreach (var removed in _tierCollection?.RemovedItems ?? [])
                        {
                            <div class="pg-roster-row pg-removed">
                                <div class="pg-catalog-inline-row">
                                    <span>@removed.Label</span>
                                    <span class="pg-change-remove">Removed</span>
                                </div>
                            </div>
                        }
                </div>
            </div>
            <div class="pg-legend pg-session-legend" aria-label="Edit highlight legend">
                <span class="pg-lg"><span class="pg-sw pg-sw-add"></span>added</span>
                <span class="pg-dot"></span>edited
            </div>
            <ChildSessionActions Context="child" SectionDraftsEnabled="SectionDraftsEnabled"
                OnFinished="NotifyChanged" OnStatusChanged="ReportStatus" />
        </FluentCard>
    </SparseChildEditDefault>
}

@code {
    [CascadingParameter]
    public ISparseEditSession<EnterpriseCatalogItem>? ParentSession { get; set; }

    [CascadingParameter]
    public SparseSessionScopeContext<EnterpriseCatalogItem>? ScopeContext { get; set; }

    [Parameter]
    public bool SectionDraftsEnabled { get; set; } = true;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private ISparseChildEditContext<CatalogCommercialDetails, SparseConflict>? _childSession;
    private CatalogCommercialDetails.EditSession _draftSession = null!;
    private SparseCollection<CatalogCommercialDetails, CatalogPriceTier>? _tierCollection;
    private string? _tierToOpen;
    private CatalogCommercialDetails.Observable Draft => _draftSession.Observable;
    private bool HasChanges => _childSession?.HasChanges == true;
    private bool IsSectionEdited => HasChanges;

    private Task ReportStatus(bool _) => UpdateStatus();

    private Task ReportNestedStatus(bool _)
    {
        return UpdateStatus();
    }

    private Task UpdateStatus()
    {
        return OnChanged.InvokeAsync();
    }

    private Task NotifyChanged() => OnChanged.InvokeAsync();

    private Task AddTier()
    {
        var tiers = _draftSession.EditCollection<CatalogPriceTier, string>(
            CatalogCommercialDetails.SparsePath.PriceTiers
        );
        if (!tiers.TryAdd(
            new CatalogPriceTier
            {
                Code = $"tier-{Guid.NewGuid():N}",
                Label = "New tier",
                MinimumQuantity = 1,
                UnitPrice = Draft.UnitPrice,
            },
            out var error
        ))
        {
            throw new InvalidOperationException($"Could not add the price tier ({error}).");
        }

        _tierToOpen = Draft.PriceTiers[^1].Code;
        return Task.CompletedTask;
    }

    private Task ClearTierToOpen()
    {
        _tierToOpen = null;
        return Task.CompletedTask;
    }

    private Task RemoveTier(
        SparseCollectionRow<CatalogCommercialDetails, CatalogPriceTier> row
    )
    {
        if (!row.TryRemove(out var error))
        {
            throw new InvalidOperationException($"Could not remove the price tier ({error}).");
        }

        return Task.CompletedTask;
    }
}
