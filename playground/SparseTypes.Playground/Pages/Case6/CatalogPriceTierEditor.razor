@using SparseTypes
@using SparseTypes.Blazor
@using SparseTypes.Playground.Models
@using CatalogPriceTierPaths = global::SparseTypes.Generated.SparseTypes_Playground_Models_CatalogPriceTier_A4E49A73.SparsePaths<global::SparseTypes.Playground.Models.CatalogPriceTier>;

@if (ParentSession is not null && ScopeContext is not null)
{
<SparseChildEdit TParent="CatalogCommercialDetails" TChild="CatalogPriceTier"
    TChildPaths="CatalogPriceTierPaths" TConflict="SparseConflict"
    TChildSession="CatalogPriceTier.EditSession"
    Path="CatalogCommercialDetails.SparsePath.PriceTiers.Key(Code)" Context="child">
    @{ CaptureChildContext(child); }
    <div class="@CatalogCollectionRowState.ClassFor(State, hasLocalChanges: IsTierEdited)">
        <div class="pg-catalog-inline-row">
            <div class="pg-catalog-tier-summary">
                <strong>@Draft.Label</strong>
                <span>From @Draft.MinimumQuantity units</span>
                <span>@Draft.UnitPrice.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</span>
                <span>@Draft.Discounts.Count discount bands</span>
            </div>
            <div class="pg-actions">
                <FluentButton Appearance="ButtonAppearance.Default" @onclick="OpenTier">Edit details</FluentButton>
                <FluentButton Appearance="ButtonAppearance.Default" Title="Remove tier" @onclick="RemoveTier">✕</FluentButton>
            </div>
        </div>
    </div>
    <CatalogDraftStatus HasChanges="IsTierEdited" OnChanged="ReportStatus" />
    <FluentDialog @ref="_tierDialog" Hidden="@_tierDialogHidden" Modal="true" TrapFocus="true"
        Class="pg-catalog-dialog" AriaLabel="Edit price tier">
        <div class="pg-dialog-heading">
            <h3>@Draft.Label</h3>
        </div>
        <div class="pg-dialog-body">
            <div class="pg-stack pg-edit-fields">
                <SparseField Path="child.Path.Label" Context="label">
                    <div class="pg-row pg-session-field @(IsTierFieldEdited(label) ? "pg-changed" : "")">
                        <span class="pg-name notranslate" translate="no">Label <small>string</small></span>
                        <FluentTextInput Value="@label.Value" ValueChanged="label.ValueChanged" />
                    </div>
                </SparseField>
                <SparseField Path="child.Path.MinimumQuantity" Context="minimumQuantity">
                    <div class="pg-row pg-session-field @(IsTierFieldEdited(minimumQuantity) ? "pg-changed" : "")">
                        <span class="pg-name notranslate" translate="no">MinimumQuantity <small>int</small></span>
                        <FluentNumberInput TValue="int" Value="@minimumQuantity.Value"
                            ValueChanged="minimumQuantity.ValueChanged" />
                    </div>
                </SparseField>
                <SparseField Path="child.Path.UnitPrice" Context="unitPrice">
                    <div class="pg-row pg-session-field @(IsTierFieldEdited(unitPrice) ? "pg-changed" : "")">
                        <span class="pg-name notranslate" translate="no">UnitPrice <small>decimal</small></span>
                        <FluentNumberInput TValue="decimal" Value="@unitPrice.Value"
                            ValueChanged="unitPrice.ValueChanged" />
                    </div>
                </SparseField>
            </div>
            @if (SectionDraftsEnabled)
            {
                <div class="pg-actions">
                    <FluentButton Appearance="ButtonAppearance.Default" Disabled="@(!CanUndo)" @onclick="Undo">
                        Undo tier
                    </FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Default" Disabled="@(!CanRedo)" @onclick="Redo">
                        Redo tier
                    </FluentButton>
                </div>
            }
            @if (_childSession?.AutoAcceptConflicts is not null)
            {
                <div class="pg-stack">
                    <FluentMessageBar Intent="MessageBarIntent.Error">
                        The latest tier edit could not be applied automatically. Correct the conflicting value or discard the draft.
                    </FluentMessageBar>
                    <FluentButton Appearance="ButtonAppearance.Default" @onclick="DiscardConflictingEdit">
                        Discard conflicting tier edit
                    </FluentButton>
                </div>
            }
            @if (_historyError is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Error">@_historyError</FluentMessageBar>
            }
            <div class="pg-catalog-list-section">
                <div class="pg-card-head">
                    <h4>Discount bands</h4>
                    <FluentButton Appearance="ButtonAppearance.Primary" @onclick="AddDiscountBand">Add band</FluentButton>
                </div>
                <div class="pg-roster-list">
                    <SparseCollection @ref="_discountCollection"
                        TModel="CatalogPriceTier" TElement="CatalogDiscountBand"
                        Path="child.Path.Discounts">
                        <RowTemplate Context="bandRow">
                            <div class="@CatalogCollectionRowState.ClassFor(bandRow.RequireItemState(), hasLocalChanges: IsBandRowChanged(bandRow))">
                                <div class="pg-catalog-discount-row">
                                    <SparseField Path="bandRow.Select(band => band.MinimumQuantity)" Context="minimum">
                                        <FluentNumberInput TValue="int" Value="@minimum.Value" ValueChanged="minimum.ValueChanged"
                                            aria-label="Discount minimum quantity" />
                                    </SparseField>
                                    <SparseField Path="bandRow.Select(band => band.DiscountPercent)" Context="percent">
                                        <FluentNumberInput TValue="decimal" Value="@percent.Value" ValueChanged="percent.ValueChanged"
                                            aria-label="Discount percent" />
                                    </SparseField>
                                    <SparseField Path="bandRow.Select(band => band.ApprovalRole)" Context="role">
                                        <FluentTextInput Value="@role.Value" ValueChanged="role.ValueChanged"
                                            aria-label="Approval role" />
                                    </SparseField>
                                    <FluentButton Appearance="ButtonAppearance.Default" Title="Remove discount band"
                                        @onclick="() => RemoveDiscountBand(bandRow)">✕</FluentButton>
                                </div>
                            </div>
                        </RowTemplate>
                    </SparseCollection>
                    @foreach (var removed in _discountCollection?.RemovedItems ?? [])
                    {
                        <div class="pg-roster-row pg-removed">
                            <div class="pg-catalog-inline-row">
                                <span>@removed.MinimumQuantity+ units · @removed.DiscountPercent% · @removed.ApprovalRole</span>
                                <span class="pg-change-remove">Removed</span>
                            </div>
                        </div>
                    }
                    @foreach (var record in Pending?.RemovedRows(BandsRootPath) ?? [])
                    {
                        if (record.Before is { IsPresent: true, Value: CatalogDiscountBand removedBand })
                        {
                            <div class="pg-roster-row pg-removed">
                                <div class="pg-catalog-inline-row">
                                    <span>@removedBand.MinimumQuantity+ units · @removedBand.DiscountPercent% · @removedBand.ApprovalRole</span>
                                    <span class="pg-change-remove">Removed</span>
                                </div>
                            </div>
                        }
                    }
                    @if (Draft.Discounts.Count == 0)
                    {
                        <p class="pg-hint">No discount bands. Add a quantity break to this tier.</p>
                    }
                </div>
            </div>
        </div>
        <div class="pg-dialog-footer">
            <FluentButton Appearance="ButtonAppearance.Primary" @onclick="CloseTierDialog">Done</FluentButton>
        </div>
    </FluentDialog>
    </SparseChildEdit>
}

@code {
    [CascadingParameter]
    public ISparseEditSession<CatalogCommercialDetails>? ParentSession { get; set; }

    [CascadingParameter]
    public SparseSessionScopeContext<CatalogCommercialDetails>? ScopeContext { get; set; }

    [Parameter, EditorRequired]
    public string Code { get; set; } = string.Empty;

    [Parameter]
    public SparseCollectionItemState State { get; set; }

    [Parameter]
    public bool SectionDraftsEnabled { get; set; } = true;

    [Parameter]
    public CatalogPendingChanges? Pending { get; set; }

    [Parameter]
    public bool OpenOnLoad { get; set; }

    [Parameter]
    public EventCallback OnOpened { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnRemove { get; set; }

    [Parameter]
    public EventCallback<bool> OnChanged { get; set; }

    private ISparseChildEditContext<CatalogPriceTier, SparseConflict>? _childSession;
    private CatalogPriceTier.EditSession _draftSession = null!;
    private SparseCollection<CatalogPriceTier, CatalogDiscountBand>? _discountCollection;
    private FluentDialog? _tierDialog;
    private bool _tierDialogHidden = true;
    private bool _openOnLoadHandled;
    private string? _historyError;
    private CatalogPriceTier.Observable Draft => _draftSession.Observable;
    private bool HasChanges => _childSession?.HasChanges == true;
    private bool CanUndo => _childSession?.CanUndo == true;
    private bool CanRedo => _childSession?.CanRedo == true;
    private SparsePath TierRowRoot =>
        EnterpriseCatalogItem.SparsePath.Commercial.UntypedPath.Append(
            CatalogCommercialDetails.SparsePath.PriceTiers.Key(Code).UntypedPath
        );
    private SparsePath BandsRootPath =>
        TierRowRoot.Append(CatalogPriceTier.SparsePath.Discounts.UntypedPath);

    // The tier row stays marked while its draft or its catalog-merged state
    // changed, with field precision from the shared root snapshot.
    private bool IsTierEdited
    {
        get
        {
            if (HasChanges || State is { IsEmpty: false })
            {
                return true;
            }

            var state = Pending?.RowState(TierRowRoot);
            return state?.IsChanged == true || state?.HasDescendantChange == true;
        }
    }

    private bool IsTierFieldEdited<TValue>(SparseFieldContext<CatalogPriceTier, TValue> field) =>
        field.IsChanged || Pending?.IsFieldChanged(TierRowRoot.Append(field.Path.UntypedPath)) == true;

    private bool IsBandRowChanged(
        SparseCollectionRow<CatalogPriceTier, CatalogDiscountBand> row
    )
    {
        if (row.ItemState is { IsEmpty: false })
        {
            return true;
        }

        var state = Pending?.RowState(TierRowRoot.Append(row.Path.Path));
        return state?.IsChanged == true || state?.HasDescendantChange == true;
    }

    private void CaptureChildContext(
        ISparseChildEditContext<CatalogPriceTier, SparseConflict> context
    )
    {
        if (ReferenceEquals(_childSession, context))
        {
            return;
        }

        _childSession = context;
        _draftSession = context.Session as CatalogPriceTier.EditSession
            ?? throw new InvalidOperationException("The price-tier edit session is unavailable.");
        _openOnLoadHandled = false;
        _tierDialogHidden = true;
        _historyError = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!OpenOnLoad || _openOnLoadHandled)
        {
            return;
        }

        _openOnLoadHandled = true;
        await OpenTier();
        await OnOpened.InvokeAsync();
    }

    private Task ReportStatus(bool _)
    {
        return OnChanged.InvokeAsync(HasChanges);
    }

    private async Task DiscardConflictingEdit()
    {
        _childSession!.DiscardChanges();
        await OnChanged.InvokeAsync(HasChanges);
    }

    private async Task OpenTier()
    {
        _tierDialogHidden = false;
        if (_tierDialog is null)
        {
            throw new InvalidOperationException("The price tier dialog is not initialized.");
        }

        await _tierDialog.ShowAsync();
    }

    private async Task CloseTierDialog()
    {
        _tierDialogHidden = true;
        if (_tierDialog is null)
        {
            throw new InvalidOperationException("The price tier dialog is not initialized.");
        }

        await _tierDialog.HideAsync();
    }

    private async Task RemoveTier()
    {
        if (!_tierDialogHidden)
        {
            await CloseTierDialog();
        }

        _childSession!.DiscardChanges();
        await OnRemove.InvokeAsync();
    }

    private async Task Undo()
    {
        try
        {
            _childSession!.Undo();
            _historyError = null;
        }
        catch (InvalidOperationException exception)
        {
            _historyError = exception.Message;
        }

        await OnChanged.InvokeAsync(HasChanges);
    }

    private async Task Redo()
    {
        try
        {
            _childSession!.Redo();
            _historyError = null;
        }
        catch (InvalidOperationException exception)
        {
            _historyError = exception.Message;
        }

        await OnChanged.InvokeAsync(HasChanges);
    }

    private void AddDiscountBand()
    {
        var discounts = _draftSession.EditCollection<CatalogDiscountBand, string>(
            CatalogPriceTier.SparsePath.Discounts
        );
        if (!discounts.TryAdd(
            new CatalogDiscountBand
            {
                Code = $"discount-{Guid.NewGuid():N}",
                MinimumQuantity = 100,
                DiscountPercent = 2,
                ApprovalRole = "Sales manager",
            },
            out var error
        ))
        {
            throw new InvalidOperationException($"Could not add the discount band ({error}).");
        }
    }

    private void RemoveDiscountBand(
        SparseCollectionRow<CatalogPriceTier, CatalogDiscountBand> row
    )
    {
        if (!row.TryRemove(out var error))
        {
            throw new InvalidOperationException($"Could not remove the discount band ({error}).");
        }
    }
}
