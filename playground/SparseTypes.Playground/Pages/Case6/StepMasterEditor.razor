@using SparseTypes
@using SparseTypes.Playground.Models
@implements IDisposable

@if (Step is not null && _childSession is not null && _draftSession is not null)
{
<FluentCard Class="pg-fluent-card">
    <div class="pg-card-head">
        <div>
            <h3>@Step.Name master</h3>
            <p class="pg-hint">Step key: <code>@Step.Id</code>, team: @Step.ResponsibleTeam</p>
        </div>
        <span class="pg-has-changes-badge @(HasChanges ? "pg-has-changes" : "pg-no-changes")">
            <span aria-hidden="true"></span>@(HasChanges ? "Edited" : "Current")
        </span>
    </div>
    <div class="pg-stack pg-edit-fields">
        <div class="pg-row pg-session-field @(IsChanged(_baseline.WorkCenter, Draft.WorkCenter) ? "pg-changed" : "")">
            <span class="pg-name notranslate" translate="no">WorkCenter <small>string</small></span>
            <FluentTextInput Value="@Draft.WorkCenter"
                ValueChanged="@(value => Update(() => Draft.WorkCenter = value ?? string.Empty))" />
        </div>
        <div class="pg-row pg-session-field @(IsChanged(_baseline.Equipment, Draft.Equipment) ? "pg-changed" : "")">
            <span class="pg-name notranslate" translate="no">Equipment <small>string</small></span>
            <FluentTextInput Value="@Draft.Equipment"
                ValueChanged="@(value => Update(() => Draft.Equipment = value ?? string.Empty))" />
        </div>
        <div class="pg-row pg-session-field @(_baseline.SetupMinutes != Draft.SetupMinutes ? "pg-changed" : "")">
            <span class="pg-name notranslate" translate="no">SetupMinutes <small>decimal</small></span>
            <FluentNumberInput TValue="decimal" Value="@Draft.SetupMinutes"
                ValueChanged="@(value => Update(() => Draft.SetupMinutes = value))" />
        </div>
        <div class="pg-row pg-session-field @(IsChanged(_baseline.Instruction, Draft.Instruction) ? "pg-changed" : "")">
            <span class="pg-name notranslate" translate="no">Instruction <small>string</small></span>
            <FluentTextInput Value="@Draft.Instruction"
                ValueChanged="@(value => Update(() => Draft.Instruction = value ?? string.Empty))" />
        </div>
        <div class="pg-row pg-session-field @(_baseline.SupervisorApproval != Draft.SupervisorApproval ? "pg-changed" : "")">
            <span class="pg-name notranslate" translate="no">SupervisorApproval <small>bool</small></span>
            <FluentCheckbox Value="@Draft.SupervisorApproval"
                ValueChanged="@(value => Update(() => Draft.SupervisorApproval = value))" />
        </div>
    </div>
    <ChildSessionActions @ref="_childSessionActions" HasChanges="GetHasChanges" HistoryProvider="GetHistory"
        Accept="TryAcceptChildSession" Discard="DiscardChildSession" OnFinished="RefreshBaseline" OnChanged="OnChanged" />
</FluentCard>
}

@code {
    [Parameter, EditorRequired]
    public CatalogWorkflow.EditSession Session { get; set; } = null!;

    [Parameter, EditorRequired]
    public CatalogWorkStep Step { get; set; } = null!;

    [Parameter, EditorRequired]
    public CatalogChildSessionCoordinator ChildSessions { get; set; } = null!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private CatalogWorkflow.EditSession? _parentSession;
    private CatalogChildSessionHandle<CatalogWorkMaster.EditSession> _childSession = null!;
    private CatalogWorkMaster.EditSession _draftSession = null!;
    private ISparseEditHistory _history = null!;
    private ChildSessionActions? _childSessionActions;
    private CatalogWorkMaster _baseline = null!;
    private IDisposable? _registration;
    public bool HasChanges => _childSession?.HasChanges == true;
    private CatalogWorkMaster.Observable Draft => _draftSession.Observable;

    protected override void OnInitialized()
    {
        OpenChildSession();
        _registration = ChildSessions.Register(
            CatalogChildSessionCoordinator.WorkMasterId(Step.Id),
            GetHasChanges,
            AcceptCurrentChildSession,
            DiscardChildSession
        );
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_parentSession, Session))
        {
            OpenChildSession();
        }
        else if (_childSession is not null && !_childSession.HasChanges)
        {
            _baseline = _draftSession.GetModelForFrameworkAccess().DeepClone();
        }
    }

    public void Dispose()
    {
        _registration?.Dispose();
        _draftSession?.DisableHistory();
        _childSession?.Dispose();
    }

    private void OpenChildSession()
    {
        _draftSession?.DisableHistory();
        _childSession?.Dispose();
        _parentSession = Session;
        _childSession = CatalogChildSessionHandle.From(
            Session.OpenChildSession(CatalogWorkflow.SparsePath.Steps.Key(Step.Id).Master)
        );
        _draftSession = _childSession.Session;
        _history = _draftSession.EnableHistory();
        _baseline = _draftSession.GetModelForFrameworkAccess().DeepClone();
    }

    private Task RefreshBaseline()
    {
        _baseline = _draftSession.GetModelForFrameworkAccess().DeepClone();
        return OnChanged.InvokeAsync();
    }

    private Task<bool> AcceptCurrentChildSession() =>
        _childSessionActions?.AcceptChildSessionAsync() ?? Task.FromResult(true);

    private bool GetHasChanges() => HasChanges;

    private (bool Accepted, IReadOnlyList<SparseConflict>? Conflicts) TryAcceptChildSession()
    {
        var accepted = _childSession.TryAcceptChanges(out var conflicts);
        return (accepted, conflicts);
    }

    private void DiscardChildSession()
    {
        _childSession.DiscardChanges();
        _baseline = _draftSession.GetModelForFrameworkAccess().DeepClone();
    }

    private ISparseEditHistory GetHistory() => _history;

    private Task Update(Action update)
    {
        update();
        return OnChanged.InvokeAsync();
    }

    private static bool IsChanged<TValue>(TValue before, TValue after) =>
        !EqualityComparer<TValue>.Default.Equals(before, after);
}
