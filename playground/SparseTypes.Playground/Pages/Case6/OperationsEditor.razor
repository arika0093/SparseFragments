@using SparseTypes
@using SparseTypes.Blazor
@using SparseTypes.Playground.Models
@using CatalogOperationsPaths = global::SparseTypes.Generated.SparseTypes_Playground_Models_CatalogOperationsDetails_3017232A.SparsePaths<global::SparseTypes.Playground.Models.CatalogOperationsDetails>;

@if (ParentSession is not null && ScopeContext is not null)
{
    <SparseChildEdit TParent="EnterpriseCatalogItem" TChild="CatalogOperationsDetails"
        TChildPaths="CatalogOperationsPaths" TConflict="SparseConflict"
        TChildSession="CatalogOperationsDetails.EditSession"
        Path="EnterpriseCatalogItem.SparsePath.Operations" Context="child">
        @{ CaptureChildContext(child); }
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>Operations details</h3>
                <span class="pg-has-changes-badge @(IsSectionEdited ? "pg-has-changes" : "pg-no-changes")">
                    <span aria-hidden="true"></span>@(IsSectionEdited ? "Edited" : "Current")
                </span>
            </div>
            <CatalogDraftStatus HasChanges="IsSectionEdited" OnChanged="ReportStatus" />
            <div class="pg-stack pg-edit-fields">
                <SparseField Path="child.Path.Facility" Context="facility">
                    <div class="pg-row pg-session-field @(IsEdited(facility) ? "pg-changed" : "")">
                        <span class="pg-name notranslate" translate="no">Facility <small>string</small></span>
                        <FluentTextInput Value="@facility.Value" ValueChanged="facility.ValueChanged" />
                    </div>
                </SparseField>
                <SparseField Path="child.Path.Warehouse" Context="warehouse">
                    <div class="pg-row pg-session-field @(IsEdited(warehouse) ? "pg-changed" : "")">
                        <span class="pg-name notranslate" translate="no">Warehouse <small>string</small></span>
                        <FluentTextInput Value="@warehouse.Value" ValueChanged="warehouse.ValueChanged" />
                    </div>
                </SparseField>
                <SparseField Path="child.Path.LeadTimeDays" Context="leadTime">
                    <div class="pg-row pg-session-field @(IsEdited(leadTime) ? "pg-changed" : "")">
                        <span class="pg-name notranslate" translate="no">LeadTimeDays <small>int</small></span>
                        <FluentNumberInput TValue="int" Value="@leadTime.Value" ValueChanged="leadTime.ValueChanged" />
                    </div>
                </SparseField>
                <SparseField Path="child.Path.QualityStandard" Context="qualityStandard">
                    <div class="pg-row pg-session-field @(IsEdited(qualityStandard) ? "pg-changed" : "")">
                        <span class="pg-name notranslate" translate="no">QualityStandard <small>string</small></span>
                        <FluentTextInput Value="@qualityStandard.Value" ValueChanged="qualityStandard.ValueChanged" />
                    </div>
                </SparseField>
                <SparseField Path="child.Path.InspectionRequired" Context="inspectionRequired">
                    <div class="pg-row pg-session-field @(IsEdited(inspectionRequired) ? "pg-changed" : "")">
                        <span class="pg-name notranslate" translate="no">InspectionRequired <small>bool</small></span>
                        <FluentCheckbox Value="@inspectionRequired.Value" ValueChanged="inspectionRequired.ValueChanged" />
                    </div>
                </SparseField>
                <SparseField Path="child.Path.PackagingInstruction" Context="packagingInstruction">
                    <div class="pg-row pg-session-field @(IsEdited(packagingInstruction) ? "pg-changed" : "")">
                        <span class="pg-name notranslate" translate="no">PackagingInstruction <small>string</small></span>
                        <FluentTextInput Value="@packagingInstruction.Value" ValueChanged="packagingInstruction.ValueChanged" />
                    </div>
                </SparseField>
            </div>

            <div class="pg-catalog-list-section">
                <div class="pg-card-head">
                    <h4>Operational documents</h4>
                    <FluentButton Appearance="ButtonAppearance.Primary" @onclick="AddDocument">Add document</FluentButton>
                </div>
                <div class="pg-roster-list">
                    <SparseCollection @ref="_documentCollection"
                        TModel="CatalogOperationsDetails" TElement="CatalogOperationDocument"
                        Path="child.Path.Documents">
                        <RowTemplate Context="documentRow">
                            <div class="@CatalogCollectionRowState.ClassFor(documentRow.RequireItemState(), hasLocalChanges: IsDocumentRowChanged(documentRow))">
                                <div class="pg-catalog-document-row">
                                    <SparseField Path="documentRow.Select(document => document.Title)" Context="title">
                                        <FluentTextInput Value="@title.Value" ValueChanged="title.ValueChanged"
                                            aria-label="Document title" />
                                    </SparseField>
                                    <SparseField Path="documentRow.Select(document => document.Owner)" Context="owner">
                                        <FluentTextInput Value="@owner.Value" ValueChanged="owner.ValueChanged"
                                            aria-label="Document owner" />
                                    </SparseField>
                                    <SparseField Path="documentRow.Select(document => document.Required)" Context="required">
                                        <FluentCheckbox Value="@required.Value" ValueChanged="required.ValueChanged">
                                            Required
                                        </FluentCheckbox>
                                    </SparseField>
                                    <FluentButton Appearance="ButtonAppearance.Default" Title="Remove document"
                                        @onclick="() => RemoveDocument(documentRow)">✕</FluentButton>
                                </div>
                            </div>
                        </RowTemplate>
                    </SparseCollection>
                    @foreach (var removed in _documentCollection?.RemovedItems ?? [])
                    {
                        <div class="pg-roster-row pg-removed">
                            <div class="pg-catalog-inline-row">
                                <span>@removed.Title</span>
                                <span class="pg-change-remove">Removed</span>
                            </div>
                        </div>
                    }
                    @foreach (var record in Pending?.RemovedRows(DocumentsRootPath) ?? [])
                    {
                        if (record.Before is { IsPresent: true, Value: CatalogOperationDocument removedDocument })
                        {
                            <div class="pg-roster-row pg-removed">
                                <div class="pg-catalog-inline-row">
                                    <span>@removedDocument.Title</span>
                                    <span class="pg-change-remove">Removed</span>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
            <div class="pg-legend pg-session-legend" aria-label="Edit highlight legend">
                <span class="pg-lg"><span class="pg-sw pg-sw-add"></span>added</span>
                <span class="pg-dot"></span>edited
            </div>
            <ChildSessionActions HasChanges="GetHasChanges" CanUndo="GetCanUndo" CanRedo="GetCanRedo"
                SectionDraftsEnabled="SectionDraftsEnabled"
                AutoAcceptConflicts="_childSession?.AutoAcceptConflicts"
                Undo="Undo" Redo="Redo" Accept="TryAcceptChildSession" Discard="DiscardChildSession"
                OnFinished="NotifyChanged" OnStatusChanged="ReportStatus" />
        </FluentCard>
    </SparseChildEdit>
}

@code {
    [CascadingParameter]
    public ISparseEditSession<EnterpriseCatalogItem>? ParentSession { get; set; }

    [CascadingParameter]
    public SparseSessionScopeContext<EnterpriseCatalogItem>? ScopeContext { get; set; }

    [Parameter]
    public bool SectionDraftsEnabled { get; set; } = true;

    [Parameter]
    public CatalogPendingChanges? Pending { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private ISparseChildEditContext<CatalogOperationsDetails, SparseConflict>? _childSession;
    private CatalogOperationsDetails.EditSession _draftSession = null!;
    private SparseCollection<CatalogOperationsDetails, CatalogOperationDocument>? _documentCollection;
    private int _newDocumentNumber;
    private CatalogOperationsDetails.Observable Draft => _draftSession.Observable;
    private bool HasChanges => _childSession?.HasChanges == true;
    private bool IsSectionEdited => HasChanges || RootSectionChanged;
    private bool RootSectionChanged =>
        Pending?.IsSubtreeChanged(EnterpriseCatalogItem.SparsePath.Operations.UntypedPath) == true;

    private bool IsEdited<TValue>(SparseFieldContext<CatalogOperationsDetails, TValue> field) =>
        field.IsChanged
        || Pending?.IsFieldChanged(
            EnterpriseCatalogItem.SparsePath.Operations.UntypedPath.Append(field.Path.UntypedPath)
        ) == true;

    private SparsePath DocumentsRootPath =>
        EnterpriseCatalogItem.SparsePath.Operations.UntypedPath.Append(
            CatalogOperationsDetails.SparsePath.Documents.UntypedPath
        );

    private bool IsDocumentRowChanged(
        SparseCollectionRow<CatalogOperationsDetails, CatalogOperationDocument> row
    )
    {
        if (row.ItemState is { IsEmpty: false })
        {
            return true;
        }

        var state = Pending?.RowState(
            EnterpriseCatalogItem.SparsePath.Operations.UntypedPath.Append(row.Path.Path)
        );
        return state?.IsChanged == true || state?.HasDescendantChange == true;
    }

    private void CaptureChildContext(
        ISparseChildEditContext<CatalogOperationsDetails, SparseConflict> context
    )
    {
        if (ReferenceEquals(_childSession, context))
        {
            return;
        }

        _childSession = context;
        _draftSession = context.Session as CatalogOperationsDetails.EditSession
            ?? throw new InvalidOperationException("The operations edit session is unavailable.");
    }

    private Task ReportStatus(bool _)
    {
        return OnChanged.InvokeAsync();
    }

    private Task NotifyChanged() => OnChanged.InvokeAsync();

    private bool GetHasChanges() => _childSession?.HasChanges == true;
    private bool GetCanUndo() => _childSession?.CanUndo == true;
    private bool GetCanRedo() => _childSession?.CanRedo == true;
    private void Undo() => _childSession?.Undo();
    private void Redo() => _childSession?.Redo();

    private (bool Accepted, IReadOnlyList<SparseConflict>? Conflicts) TryAcceptChildSession()
    {
        var accepted = _childSession!.TryAcceptChanges(out var conflicts);
        return (accepted, conflicts);
    }

    private void DiscardChildSession()
    {
        _childSession!.DiscardChanges();
    }

    private Task AddDocument()
    {
        var documents = _draftSession.EditCollection<CatalogOperationDocument, string>(
            CatalogOperationsDetails.SparsePath.Documents
        );
        if (!documents.TryAdd(
            new CatalogOperationDocument
            {
                Code = $"doc-{_newDocumentNumber++}-{Guid.NewGuid():N}",
                Title = "New operational document",
                Owner = "Operations",
                Required = false,
            },
            out var error
        ))
        {
            throw new InvalidOperationException($"Could not add the document ({error}).");
        }

        return Task.CompletedTask;
    }

    private Task RemoveDocument(
        SparseCollectionRow<CatalogOperationsDetails, CatalogOperationDocument> row
    )
    {
        if (!row.TryRemove(out var error))
        {
            throw new InvalidOperationException($"Could not remove the document ({error}).");
        }

        return Task.CompletedTask;
    }
}
