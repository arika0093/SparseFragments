@using SparseTypes
@using SparseTypes.Playground.Models
@using CatalogSession = global::SparseTypes.Playground.Models.EnterpriseCatalogItem.EditSession;
@implements IDisposable

<FluentCard Class="pg-fluent-card">
    <div class="pg-card-head">
        <h3>Overview</h3>
        <span class="pg-has-changes-badge @(HasChanges ? "pg-has-changes" : "pg-no-changes")">
            <span aria-hidden="true"></span>@(HasChanges ? "Edited" : "Current")
        </span>
    </div>
    <div class="pg-stack pg-edit-fields">
        <div class="pg-row pg-session-field @(IsChanged(_baseline.ItemCode, Draft.ItemCode) ? "pg-changed" : "")">
            <span class="pg-name notranslate" translate="no">ItemCode <small>string</small></span>
            <FluentTextInput Value="@Draft.ItemCode"
                ValueChanged="@(value => Update(() => Draft.ItemCode = value ?? string.Empty))" />
        </div>
        <div class="pg-row pg-session-field @(IsChanged(_baseline.Name, Draft.Name) ? "pg-changed" : "")">
            <span class="pg-name notranslate" translate="no">Name <small>string</small></span>
            <FluentTextInput Value="@Draft.Name"
                ValueChanged="@(value => Update(() => Draft.Name = value ?? string.Empty))" />
        </div>
        <div class="pg-row pg-session-field @(IsChanged(_baseline.Category, Draft.Category) ? "pg-changed" : "")">
            <span class="pg-name notranslate" translate="no">Category <small>string</small></span>
            <FluentTextInput Value="@Draft.Category"
                ValueChanged="@(value => Update(() => Draft.Category = value ?? string.Empty))" />
        </div>
        <div class="pg-row pg-session-field @(IsChanged(_baseline.Owner, Draft.Owner) ? "pg-changed" : "")">
            <span class="pg-name notranslate" translate="no">Owner <small>string</small></span>
            <FluentTextInput Value="@Draft.Owner"
                ValueChanged="@(value => Update(() => Draft.Owner = value ?? string.Empty))" />
        </div>
        <div class="pg-row pg-session-field @(_baseline.Active != Draft.Active ? "pg-changed" : "")">
            <span class="pg-name notranslate" translate="no">Active <small>bool</small></span>
            <FluentCheckbox Value="@Draft.Active"
                ValueChanged="@(value => Update(() => Draft.Active = value))" />
        </div>
    </div>

    <div class="pg-catalog-list-section">
        <div class="pg-card-head">
            <h4>Alternate codes</h4>
            <div class="pg-actions">
                <FluentTextInput Placeholder="New code" Value="@_newAlias"
                    ValueChanged="@(value => _newAlias = value ?? string.Empty)" />
                <FluentButton Appearance="ButtonAppearance.Primary" @onclick="AddAlias">Add</FluentButton>
            </div>
        </div>
        <div class="pg-roster-list">
            @foreach (var alias in Draft.AlternateCodes)
            {
                <div class="@CatalogRowState.ClassFor(_baseline.AlternateCodes, Draft.AlternateCodes, alias, static value => value)">
                    <div class="pg-catalog-inline-row">
                        <span>@alias</span>
                        <FluentButton Appearance="ButtonAppearance.Default" Title="Remove code"
                            @onclick="() => RemoveAlias(alias)">✕</FluentButton>
                    </div>
                </div>
            }
            @foreach (var removed in _baseline.AlternateCodes.Where(alias =>
                !Draft.AlternateCodes.Contains(alias, StringComparer.OrdinalIgnoreCase)))
            {
                <div class="pg-roster-row pg-removed">
                    <div class="pg-catalog-inline-row">
                        <span>@removed</span>
                        <span class="pg-change-remove">Removed</span>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="pg-legend pg-session-legend" aria-label="Edit highlight legend">
        <span class="pg-lg"><span class="pg-sw pg-sw-add"></span>added</span>
        <span class="pg-lg"><span class="pg-dot"></span>edited</span>
    </div>
    <ChildSessionActions @ref="_childSessionActions" HasChanges="GetHasChanges" HistoryProvider="GetHistory"
        Accept="TryAcceptChildSession" Discard="DiscardChildSession" OnFinished="RefreshBaseline" OnChanged="OnChanged" />
</FluentCard>

@code {
    [Parameter, EditorRequired]
    public CatalogSession Session { get; set; } = null!;

    [Parameter, EditorRequired]
    public CatalogChildSessionCoordinator ChildSessions { get; set; } = null!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private CatalogSession? _parentSession;
    private CatalogChildSessionHandle<CatalogOverview.EditSession> _childSession = null!;
    private CatalogOverview.EditSession _draftSession = null!;
    private ISparseEditHistory _history = null!;
    private ChildSessionActions? _childSessionActions;
    private CatalogOverview _baseline = null!;
    private IDisposable? _registration;
    private string _newAlias = string.Empty;
    public bool HasChanges => _childSession?.HasChanges == true;
    private CatalogOverview.Observable Draft => _draftSession.Observable;

    protected override void OnInitialized()
    {
        OpenChildSession();
        _registration = ChildSessions.Register(
            CatalogChildSessionCoordinator.OverviewId,
            GetHasChanges,
            AcceptCurrentChildSession,
            DiscardChildSession
        );
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_parentSession, Session))
        {
            OpenChildSession();
        }
    }

    public void Dispose()
    {
        _registration?.Dispose();
        _draftSession?.DisableHistory();
        _childSession?.Dispose();
    }

    private void OpenChildSession()
    {
        _draftSession?.DisableHistory();
        _childSession?.Dispose();
        _parentSession = Session;
        _childSession = CatalogChildSessionHandle.From(
            Session.OpenChildSession(EnterpriseCatalogItem.SparsePath.Overview)
        );
        _draftSession = _childSession.Session;
        _history = _draftSession.EnableHistory();
        _baseline = _draftSession.GetModelForFrameworkAccess().DeepClone();
    }

    private Task RefreshBaseline()
    {
        _baseline = _draftSession.GetModelForFrameworkAccess().DeepClone();
        return OnChanged.InvokeAsync();
    }

    private Task<bool> AcceptCurrentChildSession() =>
        _childSessionActions?.AcceptChildSessionAsync() ?? Task.FromResult(true);

    private bool GetHasChanges() => HasChanges;

    private (bool Accepted, IReadOnlyList<SparseConflict>? Conflicts) TryAcceptChildSession()
    {
        var accepted = _childSession.TryAcceptChanges(out var conflicts);
        return (accepted, conflicts);
    }

    private void DiscardChildSession()
    {
        _childSession.DiscardChanges();
        _baseline = _draftSession.GetModelForFrameworkAccess().DeepClone();
    }

    private ISparseEditHistory GetHistory() => _history;

    private Task Update(Action update)
    {
        update();
        return OnChanged.InvokeAsync();
    }

    private async Task AddAlias()
    {
        var alias = _newAlias.Trim();
        if (alias.Length == 0 || Draft.AlternateCodes.Contains(alias, StringComparer.OrdinalIgnoreCase))
        {
            return;
        }

        Draft.AlternateCodes.Add(alias);
        _newAlias = string.Empty;
        await OnChanged.InvokeAsync();
    }

    private Task RemoveAlias(string alias)
    {
        Draft.AlternateCodes.Remove(alias);
        return OnChanged.InvokeAsync();
    }

    private static bool IsChanged<TValue>(TValue before, TValue after) =>
        !EqualityComparer<TValue>.Default.Equals(before, after);
}
