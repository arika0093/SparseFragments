@using SparseTypes
@using SparseTypes.Blazor
@using SparseTypes.Playground.Models

@if (ParentSession is not null && ScopeContext is not null)
{
    <SparseChildEditDefault Path="EnterpriseCatalogItem.SparsePath.Overview" Context="child">
        @{
            if (!ReferenceEquals(_childSession, child))
            {
                _childSession = child;
                _draftSession = child.Session;
            }
        }
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>Overview</h3>
                <span class="pg-has-changes-badge @(IsSectionEdited ? "pg-has-changes" : "pg-no-changes")">
                    <span aria-hidden="true"></span>@(IsSectionEdited ? "Edited" : "Current")
                </span>
            </div>
            <CatalogDraftStatus HasChanges="IsSectionEdited" OnChanged="ReportStatus" />
            <div class="pg-stack pg-edit-fields">
                <SparseField Path="child.Path.ItemCode" Context="itemCode">
                    <div class="pg-row pg-session-field @(itemCode.IsChanged ? "pg-changed" : "")">
                        <span class="pg-name notranslate" translate="no">ItemCode <small>string</small></span>
                        <FluentTextInput Value="@itemCode.Value" ValueChanged="itemCode.ValueChanged" />
                    </div>
                </SparseField>
                <SparseField Path="child.Path.Name" Context="name">
                    <div class="pg-row pg-session-field @(name.IsChanged ? "pg-changed" : "")">
                        <span class="pg-name notranslate" translate="no">Name <small>string</small></span>
                        <FluentTextInput Value="@name.Value" ValueChanged="name.ValueChanged" />
                    </div>
                </SparseField>
                <SparseField Path="child.Path.Category" Context="category">
                    <div class="pg-row pg-session-field @(category.IsChanged ? "pg-changed" : "")">
                        <span class="pg-name notranslate" translate="no">Category <small>string</small></span>
                        <FluentTextInput Value="@category.Value" ValueChanged="category.ValueChanged" />
                    </div>
                </SparseField>
                <SparseField Path="child.Path.Owner" Context="owner">
                    <div class="pg-row pg-session-field @(owner.IsChanged ? "pg-changed" : "")">
                        <span class="pg-name notranslate" translate="no">Owner <small>string</small></span>
                        <FluentTextInput Value="@owner.Value" ValueChanged="owner.ValueChanged" />
                    </div>
                </SparseField>
                <SparseField Path="child.Path.Active" Context="active">
                    <div class="pg-row pg-session-field @(active.IsChanged ? "pg-changed" : "")">
                        <span class="pg-name notranslate" translate="no">Active <small>bool</small></span>
                        <FluentCheckbox Value="@active.Value" ValueChanged="active.ValueChanged" />
                    </div>
                </SparseField>
            </div>

            <div class="pg-catalog-list-section">
                <div class="pg-card-head">
                    <h4>Alternate codes</h4>
                    <div class="pg-actions">
                        <FluentTextInput Placeholder="New code" @bind-Value="_newAlias" />
                        <FluentButton Appearance="ButtonAppearance.Primary" @onclick="AddAlias">Add</FluentButton>
                    </div>
                </div>
                <div class="pg-roster-list">
                    @{ var aliasMarking = AliasMarking(); }
                    @foreach (var alias in Draft.AlternateCodes)
                    {
                        <div class="@(aliasMarking.Added.Contains(alias) ? "pg-roster-row pg-added" : "pg-roster-row")">
                            <div class="pg-catalog-inline-row">
                                <span>@alias</span>
                                <FluentButton Appearance="ButtonAppearance.Default" Title="Remove code"
                                    @onclick="() => RemoveAlias(alias)">✕</FluentButton>
                            </div>
                        </div>
                    }
                    @foreach (var removed in aliasMarking.Removed)
                    {
                        <div class="pg-roster-row pg-removed">
                            <div class="pg-catalog-inline-row">
                                <span>@removed</span>
                                <span class="pg-change-remove">Removed</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="pg-legend pg-session-legend" aria-label="Edit highlight legend">
                <span class="pg-lg"><span class="pg-sw pg-sw-add"></span>added</span>
                <span class="pg-lg"><span class="pg-dot"></span>edited</span>
            </div>
            <ChildSessionActions Context="child" SectionDraftsEnabled="SectionDraftsEnabled"
                OnFinished="RefreshBaseline" OnStatusChanged="ReportStatus" />
        </FluentCard>
    </SparseChildEditDefault>
}

@code {
    [CascadingParameter]
    public ISparseEditSession<EnterpriseCatalogItem>? ParentSession { get; set; }

    [CascadingParameter]
    public SparseSessionScopeContext<EnterpriseCatalogItem>? ScopeContext { get; set; }

    [Parameter]
    public bool SectionDraftsEnabled { get; set; } = true;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private ISparseChildEditContext<CatalogOverview, SparseConflict>? _childSession;
    private CatalogOverview.EditSession _draftSession = null!;
    private string _newAlias = string.Empty;
    private CatalogOverview.Observable Draft => _draftSession.Observable;
    private bool HasChanges => _childSession?.HasChanges == true;
    private bool IsSectionEdited => HasChanges;

    // Alias marking reads the child draft so section acceptance clears its
    // markers while the root change set remains available to the save preview.
    private (HashSet<string> Added, HashSet<string> Removed) AliasMarking()
    {
        var added = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        var removed = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        if (DraftAliasEndpoints(out var before, out var after))
        {
            CollectAliasMarking(before, after, added, removed);
        }

        return (added, removed);
    }

    private void CollectAliasMarking(
        IReadOnlyList<string> before,
        IReadOnlyList<string> after,
        HashSet<string> added,
        HashSet<string> removed
    )
    {
        var beforeCounts = CountByValue(before);
        var afterCounts = CountByValue(after);
        var currentCounts = CountByValue(Draft.AlternateCodes);
        foreach (var (value, beforeCount) in beforeCounts)
        {
            afterCounts.TryGetValue(value, out var afterCount);
            currentCounts.TryGetValue(value, out var currentCount);
            if (afterCount < beforeCount && currentCount == 0)
            {
                removed.Add(value);
            }
        }

        foreach (var (value, afterCount) in afterCounts)
        {
            beforeCounts.TryGetValue(value, out var beforeCount);
            if (afterCount > beforeCount && currentCounts.ContainsKey(value))
            {
                added.Add(value);
            }
        }
    }

    private bool DraftAliasEndpoints(
        out IReadOnlyList<string> before,
        out IReadOnlyList<string> after
    )
    {
        before = [];
        after = [];
        try
        {
            var view = ((ISparseChangeSet)_draftSession.PreviewChangeSet()).CaptureQueryView();
            return TryGetStringListEndpoints(
                view,
                CatalogOverview.SparsePath.AlternateCodes.UntypedPath,
                out before,
                out after
            );
        }
        catch (Exception exception)
            when (exception is InvalidOperationException
                or ArgumentException
                or ObjectDisposedException
            )
        {
            return false;
        }
    }

    private static bool TryGetStringListEndpoints(
        SparseChangeSetQueryView view,
        SparsePath collectionPath,
        out IReadOnlyList<string> before,
        out IReadOnlyList<string> after
    )
    {
        before = [];
        after = [];
        var state = view.FieldState(collectionPath);
        if (!state.IsChanged || !state.Before.IsPresent || !state.After.IsPresent)
        {
            return false;
        }

        if (
            state.Before.Value is not System.Collections.IEnumerable beforeValues
            || state.After.Value is not System.Collections.IEnumerable afterValues
        )
        {
            return false;
        }

        before = beforeValues
            .Cast<object?>()
            .Select(static value => value?.ToString() ?? string.Empty)
            .ToArray();
        after = afterValues
            .Cast<object?>()
            .Select(static value => value?.ToString() ?? string.Empty)
            .ToArray();
        return true;
    }

    private static Dictionary<string, int> CountByValue(IEnumerable<string> values)
    {
        var counts = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        foreach (var value in values)
        {
            counts[value] = counts.TryGetValue(value, out var count) ? count + 1 : 1;
        }

        return counts;
    }

    private Task ReportStatus(bool _)
    {
        return OnChanged.InvokeAsync();
    }

    private Task RefreshBaseline()
    {
        return OnChanged.InvokeAsync();
    }

    private Task AddAlias()
    {
        var alias = _newAlias.Trim();
        if (alias.Length == 0 || Draft.AlternateCodes.Contains(alias, StringComparer.OrdinalIgnoreCase))
        {
            return Task.CompletedTask;
        }

        Draft.AlternateCodes.Add(alias);
        _newAlias = string.Empty;
        return Task.CompletedTask;
    }

    private Task RemoveAlias(string alias)
    {
        Draft.AlternateCodes.Remove(alias);
        return Task.CompletedTask;
    }
}
