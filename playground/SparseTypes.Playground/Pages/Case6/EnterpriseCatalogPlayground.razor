@using SparseTypes
@using SparseTypes.Blazor
@using SparseTypes.Playground.Models
@using SparseTypes.Playground.Components
@implements IDisposable

<SparseSessionScope @key="_session" Session="_session" AutoAccept="@(!_sectionDraftsEnabled)">
<div class="pg-stack">
    <FluentCard Class="pg-fluent-card pg-catalog-header" Shadow="CardShadow.None">
        <div class="pg-catalog-header-main">
            <h3>Catalog editor</h3>
            <div class="pg-catalog-header-controls">
                <span class="pg-has-changes-badge @(HasChanges ? "pg-has-changes" : "pg-no-changes")">
                    <span aria-hidden="true"></span>@(HasChanges ? "Changes pending" : "No committed changes")
                </span>
                <div class="pg-actions pg-catalog-header-actions">
                    @if (!_sectionDraftsEnabled)
                    {
                        <FluentButton Appearance="ButtonAppearance.Default" Disabled="@(!_history.CanUndo)"
                            @onclick="UndoCatalog">Undo</FluentButton>
                        <FluentButton Appearance="ButtonAppearance.Default" Disabled="@(!_history.CanRedo)"
                            @onclick="RedoCatalog">Redo</FluentButton>
                    }
                    <FluentButton Appearance="ButtonAppearance.Default" Disabled="@(!HasChanges)" @onclick="Reset">
                        Reset
                    </FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Primary" Class="pg-submit-button"
                        Disabled="@(!HasChanges)" @onclick="OpenSavePreview">
                        Save
                    </FluentButton>
                </div>
            </div>
        </div>
        @if (_error is not null)
        {
            <FluentMessageBar Intent="MessageBarIntent.Error">@_error</FluentMessageBar>
        }
    </FluentCard>

    <FluentTabs ActiveTabId="@_activeSectionTab" ActiveTabIdChanged="OnSectionTabChanged"
        Orientation="Orientation.Horizontal" Class="pg-section-tabs-inline pg-catalog-section-tabs">
        <FluentTab Id="case-6-overview">
            <HeaderTemplate>
                <span class="pg-catalog-tab-label">1. Overview</span>
                @if (_childSessions.HasChangesFor(CatalogChildSessionCoordinator.OverviewId))
                {
                    <span class="pg-catalog-tab-badge">Edited</span>
                }
            </HeaderTemplate>
            <ChildContent>
                <div class="pg-section-content">
                    <OverviewEditor ChildSessions="_childSessions" SectionDraftsEnabled="_sectionDraftsEnabled"
                        OnChanged="Refresh" />
                </div>
            </ChildContent>
        </FluentTab>
        <FluentTab Id="case-6-commercial">
            <HeaderTemplate>
                <span class="pg-catalog-tab-label">2. Commercial</span>
                @if (_childSessions.HasChangesFor(CatalogChildSessionCoordinator.CommercialId))
                {
                    <span class="pg-catalog-tab-badge">Edited</span>
                }
            </HeaderTemplate>
            <ChildContent>
                <div class="pg-section-content">
                    <CommercialEditor ChildSessions="_childSessions" SectionDraftsEnabled="_sectionDraftsEnabled"
                        OnChanged="Refresh" />
                </div>
            </ChildContent>
        </FluentTab>
        <FluentTab Id="case-6-operations">
            <HeaderTemplate>
                <span class="pg-catalog-tab-label">3. Operations</span>
                @if (_childSessions.HasChangesFor(CatalogChildSessionCoordinator.OperationsId))
                {
                    <span class="pg-catalog-tab-badge">Edited</span>
                }
            </HeaderTemplate>
            <ChildContent>
                <div class="pg-section-content">
                    <OperationsEditor ChildSessions="_childSessions" SectionDraftsEnabled="_sectionDraftsEnabled"
                        OnChanged="Refresh" />
                </div>
            </ChildContent>
        </FluentTab>
        <FluentTab Id="case-6-workflow">
            <HeaderTemplate>
                <span class="pg-catalog-tab-label">4. Workflow</span>
                @if (_childSessions.HasChangesFor(CatalogChildSessionCoordinator.WorkflowId))
                {
                    <span class="pg-catalog-tab-badge">Edited</span>
                }
            </HeaderTemplate>
            <ChildContent>
                <div class="pg-section-content">
                    <WorkflowEditor @ref="_workflowEditor" ChildSessions="_childSessions"
                        SectionDraftsEnabled="_sectionDraftsEnabled"
                        SavedWorkflow="_savedWorkflow" OnAccepted="EnsureAcceptedWorkMasters"
                        BaselineVersion="_baselineVersion" OnChanged="Refresh" />
                </div>
            </ChildContent>
        </FluentTab>
        <FluentTab Id="case-6-work-masters">
            <HeaderTemplate>
                <span class="pg-catalog-tab-label">5. Work masters</span>
                @if (AcceptedWorkflow.Steps.Any(step =>
                    _childSessions.HasChangesFor(CatalogChildSessionCoordinator.WorkMasterId(step.Id))))
                {
                    <span class="pg-catalog-tab-badge">Edited</span>
                }
            </HeaderTemplate>
            <ChildContent>
                <div class="pg-section-content">
                    @if (AcceptedWorkflow.Steps.Count == 0)
                    {
                        <p class="pg-hint">Save the workflow section draft to update the work-master tabs.</p>
                    }
                    else
                    {
                        <FluentTabs ActiveTabId="@ActiveMasterTabId" ActiveTabIdChanged="OnMasterTabChanged"
                            Orientation="Orientation.Vertical">
                            @foreach (var step in AcceptedWorkflow.Steps)
                            {
                                <FluentTab @key="step.Id" Id="@MasterTabId(step.Id)">
                                    <HeaderTemplate>
                                        <span class="pg-catalog-tab-label">@step.Name</span>
                                        @if (_childSessions.HasChangesFor(CatalogChildSessionCoordinator.WorkMasterId(step.Id)))
                                        {
                                            <span class="pg-catalog-tab-badge">Edited</span>
                                        }
                                    </HeaderTemplate>
                                    <ChildContent>
                                        <SparseSessionScope Session="_session">
                                            <StepMasterEditor @key="step.Id" Step="step"
                                                ChildSessions="_childSessions" SectionDraftsEnabled="_sectionDraftsEnabled"
                                                OnChanged="Refresh" />
                                        </SparseSessionScope>
                                    </ChildContent>
                                </FluentTab>
                            }
                        </FluentTabs>
                    }
                </div>
            </ChildContent>
        </FluentTab>
    </FluentTabs>
    <div class="pg-catalog-draft-mode">
        <FluentCheckbox Value="@_sectionDraftsEnabled" ValueChanged="OnSectionDraftsEnabledChanged"
            Disabled="@_session.HasPendingChildSessions">
            Enable section drafts
        </FluentCheckbox>
        <p class="pg-hint">When enabled, section edits stay in drafts until saved. Turn it off to apply each edit to the catalog immediately.</p>
        @if (_session.HasPendingChildSessions)
        {
            <p class="pg-hint">Save or discard every section draft before changing this setting.</p>
        }
    </div>
</div>
</SparseSessionScope>

<FluentDialog @ref="_saveDialog" Hidden="@_saveDialogHidden" Modal="true" TrapFocus="true"
    Size="@DialogSize.Full" Class="pg-catalog-review-dialog" AriaLabel="Review catalog changes">
    <div class="pg-dialog-heading">
        <h3>Review changes</h3>
    </div>
    <div class="pg-dialog-body">
        <p class="pg-hint">Review the ChangeSet before saving.</p>
        @if (_changeRows.Count == 0)
        {
            <p class="pg-hint">No changes.</p>
        }
        else
        {
            <ChangePreviewTable Rows="_changeRows" TargetHeader="Path" AriaLabel="Catalog ChangeSet" />
        }
    </div>
    <div class="pg-dialog-footer">
        <FluentButton Appearance="ButtonAppearance.Primary" @onclick="ConfirmSave">Save</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Default" @onclick="CloseSavePreview">Cancel</FluentButton>
    </div>
</FluentDialog>

@code {
    private const string MasterTabPrefix = "case-6-master-";

    private EnterpriseCatalogItem _model = null!;
    private EnterpriseCatalogItem _savedModel = null!;
    private EnterpriseCatalogItem.EditSession _session = null!;
    private ISparseEditHistory _history = null!;
    private readonly CatalogChildSessionCoordinator _childSessions = new();
    private FluentDialog? _saveDialog;
    private WorkflowEditor? _workflowEditor;
    private bool _saveDialogHidden = true;
    private bool _hasChanges;
    private bool _sectionDraftsEnabled = true;
    private IReadOnlyList<ChangePreviewRow> _changeRows = [];
    private string? _error;
    private int _baselineVersion;
    private CatalogWorkflow _savedWorkflow = null!;
    private CatalogWorkflow _acceptedWorkflow = null!;
    private string _activeSectionTab = "case-6-overview";
    private string _activeMasterTab = string.Empty;

    private bool HasChanges => _hasChanges;
    private CatalogWorkflow AcceptedWorkflow => _acceptedWorkflow;
    private string ActiveMasterTabId =>
        AcceptedWorkflow.Steps.Count == 0
            ? string.Empty
            : AcceptedWorkflow.Steps.Any(step => MasterTabId(step.Id) == _activeMasterTab)
                ? _activeMasterTab
                : MasterTabId(AcceptedWorkflow.Steps[0].Id);

    protected override void OnInitialized()
    {
        _childSessions.Changed += Refresh;
        _model = CreateSample();
        _savedModel = _model.DeepClone();
        CreateSession();
        _savedWorkflow = _model.Workflow.DeepClone();
        _acceptedWorkflow = _model.Workflow.DeepClone();
    }

    public void Dispose()
    {
        _childSessions.Changed -= Refresh;
    }

    private static EnterpriseCatalogItem CreateSample() =>
        new()
        {
            Overview = new CatalogOverview
            {
                ItemCode = "EQ-2048",
                Name = "Modular Drive Unit",
                Category = "Industrial equipment",
                Owner = "M. Tanaka",
                Active = true,
                AlternateCodes = ["MDU-2048", "MDU-2048-AP"],
            },
            Commercial = new CatalogCommercialDetails
            {
                Customer = "Northwind Manufacturing",
                Region = "APAC",
                ContractCode = "NW-2026-041",
                Currency = "USD",
                UnitPrice = 2480.00m,
                AnnualVolume = 1200,
                PriceTiers =
                [
                    new CatalogPriceTier
                    {
                        Code = "standard",
                        Label = "Standard",
                        MinimumQuantity = 1,
                        UnitPrice = 2480m,
                        Discounts =
                        [
                            new CatalogDiscountBand
                            {
                                Code = "annual",
                                MinimumQuantity = 100,
                                DiscountPercent = 3,
                                ApprovalRole = "Sales manager",
                            },
                        ],
                    },
                    new CatalogPriceTier
                    {
                        Code = "volume",
                        Label = "Volume",
                        MinimumQuantity = 500,
                        UnitPrice = 2290m,
                        Discounts =
                        [
                            new CatalogDiscountBand
                            {
                                Code = "strategic",
                                MinimumQuantity = 1000,
                                DiscountPercent = 5,
                                ApprovalRole = "Commercial director",
                            },
                        ],
                    },
                ],
            },
            Operations = new CatalogOperationsDetails
            {
                Facility = "Nagoya Plant",
                Warehouse = "WH-A3",
                LeadTimeDays = 18,
                QualityStandard = "ISO 9001",
                InspectionRequired = true,
                PackagingInstruction = "Moisture barrier, export pallet",
                Documents =
                [
                    new CatalogOperationDocument
                    {
                        Code = "spec",
                        Title = "Product specification",
                        Owner = "Engineering",
                        Required = true,
                    },
                    new CatalogOperationDocument
                    {
                        Code = "inspection",
                        Title = "Inspection checklist",
                        Owner = "Quality",
                        Required = true,
                    },
                ],
            },
            Workflow = new CatalogWorkflow
            {
                Steps =
                [
                    new CatalogWorkStep
                    {
                        Id = "cut",
                        Name = "Cutting",
                        ResponsibleTeam = "Machining",
                        StandardHours = 1.5m,
                    },
                    new CatalogWorkStep
                    {
                        Id = "assemble",
                        Name = "Assembly",
                        ResponsibleTeam = "Assembly",
                        StandardHours = 2.25m,
                    },
                    new CatalogWorkStep
                    {
                        Id = "inspect",
                        Name = "Final inspection",
                        ResponsibleTeam = "Quality",
                        StandardHours = 0.75m,
                    },
                ],
            },
            WorkMasters =
            [
                new CatalogWorkMaster
                {
                    StepId = "cut",
                    WorkCenter = "WC-12",
                    Equipment = "CNC Lathe 04",
                    SetupMinutes = 20,
                    Instruction = "Verify stock diameter before the first cut.",
                },
                new CatalogWorkMaster
                {
                    StepId = "assemble",
                    WorkCenter = "WC-31",
                    Equipment = "Press Station 02",
                    SetupMinutes = 15,
                    Instruction = "Apply the specified torque sequence.",
                    SupervisorApproval = true,
                },
                new CatalogWorkMaster
                {
                    StepId = "inspect",
                    WorkCenter = "QC-08",
                    Equipment = "CMM 01",
                    SetupMinutes = 10,
                    Instruction = "Record dimensional results against the drawing.",
                },
            ],
        };

    private async Task OpenSavePreview()
    {
        if (_session.HasPendingChildSessions)
        {
            _error = "Save or discard each edited section draft before saving the catalog.";
            return;
        }

        if (!HasChanges)
        {
            return;
        }

        _error = null;
        if (!_session.TryCreateChangeSet(out var changes, out var conflicts))
        {
            _error = conflicts is null
                ? "A child edit session target is no longer available."
                : "Resolve the child-session conflict before saving.";
            return;
        }

        _changeRows = SparseChangeRowProjection.Project(
            changes!,
            new SparseChangeRowOptions
            {
                FormatOperation = PlaygroundPageHelper.ChangeOperation,
                FormatValue = static value => PlaygroundJson.FormatChangeValue(value),
            }
        )
            .Select(static row => new ChangePreviewRow
            {
                Target = row.PathText,
                Operation = row.Operation,
                Before = row.BeforeText,
                After = row.AfterText,
            })
            .ToArray();
        if (_saveDialog is null)
        {
            throw new InvalidOperationException("The catalog save dialog is not initialized.");
        }

        _saveDialogHidden = false;
        await _saveDialog.ShowAsync();
    }

    private async Task CloseSavePreview()
    {
        _saveDialogHidden = true;
        if (_saveDialog is null)
        {
            throw new InvalidOperationException("The catalog save dialog is not initialized.");
        }

        await _saveDialog.HideAsync();
    }

    private async Task ConfirmSave()
    {
        await CloseSavePreview();
        try
        {
            _session.DiscardChildSessions();
            _session.AcceptChanges();
            _savedModel = _model.DeepClone();
            _hasChanges = false;
            _savedWorkflow = _model.Workflow.DeepClone();
            _acceptedWorkflow = _model.Workflow.DeepClone();
            _baselineVersion++;
            CreateSession();
            _childSessions.Clear();
            _error = null;
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }
    }

    private void EnsureAcceptedWorkMasters()
    {
        _acceptedWorkflow = _model.Workflow.DeepClone();
        var activeStepIds = AcceptedWorkflow.Steps.Select(static step => step.Id).ToHashSet(StringComparer.Ordinal);
        var workMasters = _session.EditCollection<CatalogWorkMaster, string>(
            EnterpriseCatalogItem.SparsePath.WorkMasters
        );

        foreach (var step in AcceptedWorkflow.Steps)
        {
            if (_model.WorkMasters.Any(master => master.StepId == step.Id))
            {
                continue;
            }

            var master = _workflowEditor?.GetMasterDefaults(step.Id);
            if (master is null)
            {
                throw new InvalidOperationException($"Work-master defaults for step '{step.Id}' are unavailable.");
            }

            master.StepId = step.Id;
            if (!workMasters.TryInsert(workMasters.Count, master, out var error))
            {
                _error = $"Could not create the work master for '{step.Name}' ({error}).";
                return;
            }
        }

        foreach (var master in _model.WorkMasters.Where(master => !activeStepIds.Contains(master.StepId)).ToArray())
        {
            if (!workMasters.TryRemoveByKey(master.StepId, out var error))
            {
                _error = $"Could not remove the work master for '{master.StepId}' ({error}).";
                return;
            }
        }
    }

    private static string MasterTabId(string stepId) => $"{MasterTabPrefix}{stepId}";

    private Task OnSectionTabChanged(string? tabId)
    {
        if (!string.IsNullOrWhiteSpace(tabId))
        {
            _activeSectionTab = tabId;
        }

        return Task.CompletedTask;
    }

    private Task OnMasterTabChanged(string? tabId)
    {
        if (!string.IsNullOrWhiteSpace(tabId))
        {
            _activeMasterTab = tabId;
        }

        return Task.CompletedTask;
    }

    private Task OnSectionDraftsEnabledChanged(bool enabled)
    {
        if (_session.HasPendingChildSessions)
        {
            return Task.CompletedTask;
        }

        _sectionDraftsEnabled = enabled;
        return Task.CompletedTask;
    }

    private Task Reset()
    {
        try
        {
            _session.DiscardChildSessions();
            _session.RevertChanges();
            _savedModel = _model.DeepClone();
            _hasChanges = false;
            _savedWorkflow = _model.Workflow.DeepClone();
            _acceptedWorkflow = _model.Workflow.DeepClone();
            _baselineVersion++;
            CreateSession();
            _childSessions.Clear();
            _error = null;
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }

        return Task.CompletedTask;
    }

    private void Refresh()
    {
        _hasChanges = !EnterpriseCatalogItem.ChangeSet.Between(_savedModel, _model).IsEmpty;
        StateHasChanged();
    }

    private void CreateSession()
    {
        _session = _model.CreateEditSession();
        _history = _session.EnableHistory();
    }

    private Task UndoCatalog() => ApplyHistory(_history.Undo);

    private Task RedoCatalog() => ApplyHistory(_history.Redo);

    private Task ApplyHistory(Action apply)
    {
        try
        {
            apply();
            _error = null;
        }
        catch (InvalidOperationException exception)
        {
            _error = exception.Message;
        }

        Refresh();
        return Task.CompletedTask;
    }

}
