@using SparseTypes.Playground.Models
@using SparseTypes.Playground.Components
@using CatalogSession = global::SparseTypes.Playground.Models.EnterpriseCatalogItem.EditSession;
@implements IDisposable

<FluentCard Class="pg-fluent-card">
    <div class="pg-card-head">
        <h3>Workflow and work-step order</h3>
        <span class="pg-has-changes-badge @(_scope.HasChanges ? "pg-has-changes" : "pg-no-changes")">
            <span aria-hidden="true"></span>@(_scope.HasChanges ? "Edited" : "Current")
        </span>
    </div>
    <div class="pg-catalog-workflow-layout">
        <div class="pg-stack">
            <div class="pg-card-head">
                <h4>Current workflow</h4>
                <span class="pg-hint">Drag the handle to reorder. Drop a template here to add it.</span>
            </div>
            <div class="pg-catalog-workflow-dropzone">
                <FluentSortableList @key="_sortableListsVersion" TItem="CatalogWorkStep" Id="case6-workflow" Group="case6-work-steps"
                    Items="_scope.Observable.Steps" Handle="true" Class="pg-roster-list"
                    OnUpdate="OnSortableUpdate" OnAdd="OnTemplateAdded">
                    <ItemTemplate Context="step">
                        <div class="@CatalogRowState.ClassFor(_displayBaseline.Steps, _scope.Observable.Steps, step, static item => item.Id, detectReorder: true)">
                            <div class="pg-case6-step-line">
                                <span class="pg-drag sortable-grab" title="Drag to reorder">⠿</span>
                                <div class="pg-roster-field">
                                    <span class="pg-mini notranslate" translate="no">Step</span>
                                    <strong>@step.Name</strong>
                                </div>
                                <div class="pg-roster-field">
                                    <span class="pg-mini notranslate" translate="no">Team</span>
                                    <span>@step.ResponsibleTeam</span>
                                </div>
                                <div class="pg-roster-field">
                                    <span class="pg-mini notranslate" translate="no">Hours</span>
                                    <span>@step.StandardHours</span>
                                </div>
                                <div class="pg-roster-actions pg-task-actions">
                                    <FluentButton Appearance="ButtonAppearance.Default" Title="Move up"
                                        Disabled="@(IndexOf(step.Id) == 0)" @onclick="() => MoveStep(step.Id, -1)">↑</FluentButton>
                                    <FluentButton Appearance="ButtonAppearance.Default" Title="Move down"
                                        Disabled="@(IndexOf(step.Id) == _scope.Observable.Steps.Count - 1)"
                                        @onclick="() => MoveStep(step.Id, 1)">↓</FluentButton>
                                    <FluentButton Appearance="ButtonAppearance.Default" Title="Remove step"
                                        @onclick="() => RemoveStep(step.Id)">✕</FluentButton>
                                </div>
                            </div>
                        </div>
                    </ItemTemplate>
                </FluentSortableList>
                @if (_scope.Observable.Steps.Count == 0)
                {
                    <p class="pg-hint">Drop a prepared step here or add one from the list.</p>
                }
            </div>
            @foreach (var removed in _displayBaseline.Steps.Where(step =>
                !_scope.Observable.Steps.Any(current => current.Id == step.Id)))
            {
                <div class="pg-roster-row pg-removed">
                    <div class="pg-case6-step-line">
                        <span aria-hidden="true"></span>
                        <span>@removed.Name</span>
                        <span>@removed.ResponsibleTeam</span>
                        <span class="pg-change-remove">Removed</span>
                        <FluentButton Appearance="ButtonAppearance.Default" @onclick="() => RestoreStep(removed.Id)">Restore</FluentButton>
                    </div>
                </div>
            }
        </div>

        <div class="pg-stack">
            <div class="pg-card-head">
                <h4>Prepared work steps</h4>
                <span class="pg-hint">20 templates</span>
            </div>
            <FluentSortableList @key="_sortableListsVersion" TItem="CatalogWorkStep" Id="case6-work-step-templates"
                Group="case6-work-steps" Items="AvailableTemplates" Handle="true" Clone="true"
                Drop="false" Sort="false" Class="pg-catalog-palette" OnAdd="OnTemplateAdded"
                aria-label="Prepared work-step templates">
                <ItemTemplate Context="template">
                    <div class="pg-catalog-template">
                        <span class="pg-drag sortable-grab" aria-hidden="true">⠿</span>
                        <div>
                            <strong>@template.Name</strong>
                            <small>@template.ResponsibleTeam · @template.Master.WorkCenter</small>
                        </div>
                        <FluentButton Appearance="ButtonAppearance.Default" Title="Add step"
                            @onclick="() => AddStep(template)">+</FluentButton>
                    </div>
                </ItemTemplate>
            </FluentSortableList>
        </div>
    </div>
    @if (_error is not null)
    {
        <FluentMessageBar Intent="MessageBarIntent.Error">@_error</FluentMessageBar>
    }
    <div class="pg-workflow-scope-actions">
        <ScopeActions @ref="_scopeActions" TModel="CatalogWorkflow" Scope="_scope" HistoryProvider="GetHistory"
            BeforeCommit="PrepareCommit" BeforeCommitFailureMessage="Resolve work-master drafts before saving the workflow."
            OnCommitAttemptFinished="ReopenWorkMasterScopes" OnFinished="ReopenScope" OnChanged="OnHistoryChanged" />
    </div>
</FluentCard>

@code {
    private static readonly CatalogWorkStep[] Templates =
    [
        CreateTemplate("turn", "Turning", "Machining", 1.5m, "WC-12", "CNC Lathe"),
        CreateTemplate("bore", "Boring", "Machining", 1.1m, "WC-14", "Horizontal Borer"),
        CreateTemplate("mill", "Milling", "Machining", 1.8m, "WC-16", "CNC Mill"),
        CreateTemplate("drill", "Drilling", "Machining", 0.7m, "WC-18", "Radial Drill"),
        CreateTemplate("deburr", "Deburring", "Finishing", 0.5m, "WC-22", "Deburring Bench"),
        CreateTemplate("heat", "Heat treatment", "Process", 2.4m, "WC-25", "Batch Furnace"),
        CreateTemplate("grind", "Grinding", "Finishing", 1.2m, "WC-28", "Surface Grinder"),
        CreateTemplate("clean", "Parts cleaning", "Process", 0.6m, "WC-29", "Ultrasonic Cleaner"),
        CreateTemplate("paint", "Coating", "Finishing", 1.4m, "WC-30", "Spray Booth"),
        CreateTemplate("subassembly", "Subassembly", "Assembly", 1.3m, "WC-31", "Assembly Bench"),
        CreateTemplate("seal", "Seal installation", "Assembly", 0.8m, "WC-32", "Seal Press"),
        CreateTemplate("electrical", "Electrical test", "Test", 0.9m, "WC-35", "Electrical Test Rig"),
        CreateTemplate("balance", "Rotor balancing", "Test", 1.0m, "WC-37", "Balancing Machine"),
        CreateTemplate("pressure", "Pressure test", "Test", 1.2m, "WC-40", "Hydrostatic Rig"),
        CreateTemplate("calibrate", "Calibration", "Engineering", 0.8m, "WC-42", "Calibration Stand"),
        CreateTemplate("visual", "Visual inspection", "Quality", 0.5m, "QC-04", "Inspection Station"),
        CreateTemplate("final", "Final inspection", "Quality", 0.75m, "QC-08", "CMM"),
        CreateTemplate("pack", "Export packaging", "Shipping", 0.6m, "WH-02", "Packing Station"),
        CreateTemplate("label", "Labeling", "Shipping", 0.3m, "WH-04", "Label Printer"),
        CreateTemplate("dispatch", "Dispatch", "Shipping", 0.4m, "WH-07", "Loading Bay"),
    ];

    private const string TemplateListId = "case6-work-step-templates";

    [Parameter, EditorRequired]
    public CatalogSession Session { get; set; } = null!;

    [Parameter, EditorRequired]
    public CatalogScopeCoordinator Scopes { get; set; } = null!;

    [Parameter]
    public int BaselineVersion { get; set; }

    [Parameter, EditorRequired]
    public CatalogWorkflow SavedWorkflow { get; set; } = null!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private CatalogSession.Scope<CatalogWorkflow> _scope = null!;
    private CatalogWorkflow.EditSession _draftSession = null!;
    private ISparseEditHistory _history = null!;
    private ScopeActions<CatalogWorkflow>? _scopeActions;
    private CatalogWorkflow _baseline = null!;
    private CatalogWorkflow _displayBaseline = null!;
    private int _seenBaselineVersion;
    private int _sortableListsVersion;
    private readonly Dictionary<string, string> _templateIdByStepId = new(StringComparer.Ordinal);
    private IDisposable? _registration;
    private string? _error;
    private CatalogWorkStep[] AvailableTemplates =>
        Templates.Where(IsTemplateAvailable).ToArray();

    public CatalogWorkflow? CurrentWorkflow => _scope?.Observable;
    public bool HasChanges => _scope?.HasChanges == true;

    protected override void OnInitialized()
    {
        OpenScope();
        _displayBaseline = SavedWorkflow.DeepClone();
        _seenBaselineVersion = BaselineVersion;
        _registration = Scopes.Register(
            CatalogScopeCoordinator.WorkflowId,
            () => _scope?.HasChanges == true,
            CommitCurrentScope,
            CancelScope,
            ReopenScopeSilently
        );
    }

    protected override void OnParametersSet()
    {
        if (_seenBaselineVersion == BaselineVersion || _scope is null)
        {
            return;
        }

        _displayBaseline = SavedWorkflow.DeepClone();
        var savedStepIds = SavedWorkflow.Steps.Select(static step => step.Id).ToHashSet(StringComparer.Ordinal);
        foreach (var stepId in _templateIdByStepId.Keys.Where(stepId => !savedStepIds.Contains(stepId)).ToArray())
        {
            _templateIdByStepId.Remove(stepId);
        }

        _seenBaselineVersion = BaselineVersion;
    }

    public void Dispose()
    {
        _registration?.Dispose();
        _draftSession?.DisableHistory();
        _scope?.Dispose();
    }

    private void OpenScope()
    {
        _draftSession?.DisableHistory();
        _scope?.Dispose();
        _scope = Session.OpenScope(EnterpriseCatalogItem.SparsePath.Workflow);
        _draftSession = _scope.Observable.CreateEditSession();
        _history = _draftSession.EnableHistory();
        _baseline = _scope.Observable.DeepClone();
        _sortableListsVersion++;
    }

    private Task ReopenScope()
    {
        OpenScope();
        _displayBaseline = _scope.Observable.DeepClone();
        return OnChanged.InvokeAsync();
    }

    private Task ReopenScopeSilently()
    {
        OpenScope();
        _displayBaseline = _scope.Observable.DeepClone();
        return Task.CompletedTask;
    }

    private void CancelScope()
    {
        _draftSession?.DisableHistory();
        _scope?.Cancel();
        _scope = null!;
    }

    private Task<bool> CommitCurrentScope() =>
        _scopeActions?.CommitScopeAsync() ?? Task.FromResult(true);

    private async Task<bool> PrepareCommit()
    {
        if (!await Scopes.CommitWorkMastersAsync())
        {
            return false;
        }

        Scopes.CancelWorkMasters();
        return true;
    }

    private Task ReopenWorkMasterScopes() => Scopes.ReopenWorkMastersAsync();

    private ISparseEditHistory GetHistory() => _history;

    private bool IsTemplateAvailable(CatalogWorkStep template) =>
        !_templateIdByStepId.Any(mapping =>
            mapping.Value == template.Id && _scope.Observable.Steps.Any(step => step.Id == mapping.Key)
        );

    private int IndexOf(string id) => _scope.Observable.Steps.FindIndex(step => step.Id == id);

    private static CatalogWorkStep CreateTemplate(
        string id,
        string name,
        string team,
        decimal hours,
        string workCenter,
        string equipment
    ) =>
        new()
        {
            Id = $"template-{id}",
            Name = name,
            ResponsibleTeam = team,
            StandardHours = hours,
            Master = new CatalogWorkMaster
            {
                WorkCenter = workCenter,
                Equipment = equipment,
                SetupMinutes = 15,
                Instruction = $"Follow the standard {name.ToLowerInvariant()} procedure.",
            },
        };

    private async Task OnTemplateAdded(FluentSortableListEventArgs args)
    {
        var availableTemplates = AvailableTemplates;
        if (args.FromListId != TemplateListId || args.OldIndex < 0 || args.OldIndex >= availableTemplates.Length)
        {
            return;
        }

        await AddStepAt(availableTemplates[args.OldIndex], args.NewIndex);
    }

    private Task AddStep(CatalogWorkStep template) => AddStepAt(template, _scope.Observable.Steps.Count);

    private async Task AddStepAt(CatalogWorkStep template, int insertAt)
    {
        if (!IsTemplateAvailable(template))
        {
            _error = $"{template.Name} is already in the workflow.";
            await NotifyWorkflowChanged();
            return;
        }

        var step = new CatalogWorkStep
        {
            Id = $"step-{Guid.NewGuid():N}",
            Name = template.Name,
            ResponsibleTeam = template.ResponsibleTeam,
            StandardHours = template.StandardHours,
            Master = template.Master.DeepClone(),
        };

        var steps = _draftSession.EditCollection<CatalogWorkStep, string>(CatalogWorkflow.SparsePath.Steps);
        var targetIndex = Math.Clamp(insertAt, 0, steps.Count);
        if (!steps.TryInsert(steps.Count, step, out var error))
        {
            _error = $"Could not add the step ({error}).";
            return;
        }

        _templateIdByStepId.Add(step.Id, template.Id);
        _error = null;
        if (_scopeActions is null)
        {
            _error = "The workflow section draft is not ready to save.";
            await NotifyWorkflowChanged();
            return;
        }

        if (!await _scopeActions.CommitScopeAsync())
        {
            return;
        }

        var currentIndex = IndexOf(step.Id);
        if (targetIndex >= currentIndex)
        {
            return;
        }

        steps = _draftSession.EditCollection<CatalogWorkStep, string>(CatalogWorkflow.SparsePath.Steps);
        if (!steps.TryMove(currentIndex, targetIndex, out error))
        {
            _error = $"The step was added, but could not be moved to its drop position ({error}).";
            await NotifyWorkflowChanged();
            return;
        }

        _error = null;
        await NotifyWorkflowChanged();
        await _scopeActions.CommitScopeAsync();
    }

    private async Task RemoveStep(string id)
    {
        var steps = _draftSession.EditCollection<CatalogWorkStep, string>(CatalogWorkflow.SparsePath.Steps);
        if (steps.TryRemoveByKey(id, out var error))
        {
            _error = null;
            await NotifyWorkflowChanged();
        }
        else
        {
            _error = $"Could not remove the step ({error}).";
        }
    }

    private async Task RestoreStep(string id)
    {
        var step = _baseline.Steps.FirstOrDefault(item => item.Id == id);
        if (step is null || _scope.Observable.Steps.Any(item => item.Id == id))
        {
            return;
        }

        var steps = _draftSession.EditCollection<CatalogWorkStep, string>(CatalogWorkflow.SparsePath.Steps);
        var index = _baseline.Steps.FindIndex(item => item.Id == id);
        if (!steps.TryInsert(Math.Clamp(index, 0, steps.Count), step.DeepClone(), out var error))
        {
            _error = $"Could not restore the step ({error}).";
            return;
        }

        _error = null;
        await NotifyWorkflowChanged();
    }

    private async Task MoveStep(string id, int delta)
    {
        var oldIndex = IndexOf(id);
        var target = oldIndex + delta;
        var steps = _draftSession.EditCollection<CatalogWorkStep, string>(CatalogWorkflow.SparsePath.Steps);
        if (oldIndex < 0 || target < 0 || target >= steps.Count)
        {
            return;
        }

        if (!steps.TryMove(oldIndex, target, out var error))
        {
            _error = $"Could not move the step ({error}).";
            return;
        }

        _error = null;
        await NotifyWorkflowChanged();
    }

    private Task OnSortableUpdate(FluentSortableListEventArgs args)
    {
        if (args.FromListId != "case6-workflow" || args.ToListId != "case6-workflow")
        {
            return Task.CompletedTask;
        }

        var count = _draftSession.Observable.Steps.Count;
        var oldIndex = args.OldIndex;
        var newIndex = Math.Min(args.NewIndex, count - 1);
        if (oldIndex == newIndex || oldIndex < 0 || oldIndex >= count || newIndex < 0)
        {
            return Task.CompletedTask;
        }

        var steps = _draftSession.EditCollection<CatalogWorkStep, string>(CatalogWorkflow.SparsePath.Steps);
        if (!steps.TryMove(oldIndex, newIndex, out var error))
        {
            _error = $"Could not reorder the steps ({error}).";
            return Task.CompletedTask;
        }

        _error = null;
        return NotifyWorkflowChanged();
    }

    private Task OnHistoryChanged() => NotifyWorkflowChanged();

    private Task NotifyWorkflowChanged()
    {
        _sortableListsVersion++;
        return OnChanged.InvokeAsync();
    }
}
