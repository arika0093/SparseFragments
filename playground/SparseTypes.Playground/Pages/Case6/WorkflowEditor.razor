@using SparseTypes
@using SparseTypes.Blazor
@using SparseTypes.Playground.Models
@using CatalogSession = global::SparseTypes.Playground.Models.EnterpriseCatalogItem.EditSession;
@implements IDisposable

@if (ParentSession is not null && ScopeContext is not null)
{
    <SparseChildEditDefault Path="EnterpriseCatalogItem.SparsePath.Workflow" Context="child">
        @{
            if (!ReferenceEquals(_childSession, child))
            {
                if (_childSession is not null)
                {
                    _childSession.AutoAccepted -= OnChildAutoAccepted;
                }

                _childSession = child;
                _childSession.AutoAccepted += OnChildAutoAccepted;
                _draftSession = child.Session;
                _sortableListsVersion++;
            }
        }
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>Workflow and work-step order</h3>
                <span class="pg-has-changes-badge @(IsSectionEdited ? "pg-has-changes" : "pg-no-changes")">
                    <span aria-hidden="true"></span>@(IsSectionEdited ? "Edited" : "Current")
                </span>
            </div>
            <CatalogDraftStatus HasChanges="IsSectionEdited" OnChanged="ReportStatus" />
            <div class="pg-catalog-workflow-layout">
                <div class="pg-stack">
                    <div class="pg-card-head">
                        <h4>Current workflow</h4>
                        <span class="pg-hint">Drag the handle to reorder. Drop a template here to add it.</span>
                    </div>
                    <div class="pg-catalog-workflow-dropzone">
                        <SparseField Path="_draftSession.Paths.Steps" Context="steps">
                            @{ var roster = steps.TryGetCollectionState(out var state) ? state : null; }
                            <FluentSortableList @key="(CurrentWorkflow!.Steps.Count, _sortableListsVersion)" TItem="CatalogWorkStep"
                                Id="case6-workflow" Group="case6-work-steps" Items="CurrentWorkflow!.Steps"
                                Handle="true" Class="pg-roster-list" OnUpdate="OnSortableUpdate"
                                OnAdd="OnTemplateAdded">
                                <ItemTemplate Context="step">
                                    <div @key="step.Id" class="@StepRowClass(roster?.GetItemState(step.Id) ?? default)">
                                        <div class="pg-case6-step-line">
                                            <span class="pg-drag sortable-grab" title="Drag to reorder">⠿</span>
                                            <div class="pg-roster-field">
                                                <span class="pg-mini notranslate" translate="no">Step</span>
                                                <strong>@step.Name</strong>
                                            </div>
                                            <div class="pg-roster-field">
                                                <span class="pg-mini notranslate" translate="no">Team</span>
                                                <span>@step.ResponsibleTeam</span>
                                            </div>
                                            <div class="pg-roster-field">
                                                <span class="pg-mini notranslate" translate="no">Hours</span>
                                                <span>@step.StandardHours</span>
                                            </div>
                                            <div class="pg-roster-actions pg-task-actions">
                                                <FluentButton Appearance="ButtonAppearance.Default" Title="Move up"
                                                    Disabled="@(IndexOf(step.Id) == 0)" @onclick="() => MoveStep(step.Id, -1)">↑</FluentButton>
                                                <FluentButton Appearance="ButtonAppearance.Default" Title="Move down"
                                                    Disabled="@(IndexOf(step.Id) == _draftSession.Observable.Steps.Count - 1)"
                                                    @onclick="() => MoveStep(step.Id, 1)">↓</FluentButton>
                                                <FluentButton Appearance="ButtonAppearance.Default" Title="Remove step"
                                                    @onclick="() => RemoveStep(step.Id)">✕</FluentButton>
                                            </div>
                                        </div>
                                    </div>
                                </ItemTemplate>
                            </FluentSortableList>
                            @foreach (var change in roster?.ChangedItems ?? [])
                            {
                                if (change is { IsRemoved: true, Before: { IsPresent: true, Value: CatalogWorkStep removedDraftStep } })
                                {
                                    <div class="pg-roster-row pg-removed">
                                        <div class="pg-catalog-inline-row">
                                            <span>@removedDraftStep.Name</span>
                                            <span class="pg-change-remove">Removed</span>
                                        </div>
                                    </div>
                                }
                            }
                        </SparseField>
                        @if (_draftSession.Observable.Steps.Count == 0)
                        {
                            <p class="pg-hint">Drop a prepared step here or add one from the list.</p>
                        }
                    </div>
                </div>

                <div class="pg-stack">
                    <div class="pg-card-head">
                        <h4>Prepared work steps</h4>
                        <span class="pg-hint">20 templates</span>
                    </div>
                    <FluentSortableList @key="_sortableListsVersion" TItem="CatalogWorkStep"
                        Id="case6-work-step-templates" Group="case6-work-steps" Items="AvailableTemplates"
                        Handle="true" Clone="true" Drop="false" Sort="false" Class="pg-catalog-palette"
                        OnAdd="OnTemplateAdded" aria-label="Prepared work-step templates">
                        <ItemTemplate Context="template">
                            <div class="pg-catalog-template">
                                <span class="pg-drag sortable-grab" aria-hidden="true">⠿</span>
                                <div>
                                    <strong>@template.Name</strong>
                                    <small>@template.ResponsibleTeam · @GetTemplateMaster(template.Id).WorkCenter</small>
                                </div>
                                <FluentButton Appearance="ButtonAppearance.Default" Title="Add step"
                                    @onclick="() => AddStep(template)">+</FluentButton>
                            </div>
                        </ItemTemplate>
                    </FluentSortableList>
                </div>
            </div>
            @if (_error is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Error">@_error</FluentMessageBar>
            }
            <div class="pg-workflow-scope-actions">
                <ChildSessionActions Context="child" SectionDraftsEnabled="SectionDraftsEnabled"
                    AcceptanceBatchSession="AcceptanceBatchSession"
                    OnAccepted="OnAccepted" OnFinished="RefreshWorkflow"
                    OnChanged="OnHistoryChanged"
                    OnStatusChanged="ReportStatus" />
            </div>
        </FluentCard>
    </SparseChildEditDefault>
}

@code {
    private static readonly WorkflowStepTemplate[] Templates =
    [
        CreateTemplate("turn", "Turning", "Machining", 1.5m, "WC-12", "CNC Lathe"),
        CreateTemplate("bore", "Boring", "Machining", 1.1m, "WC-14", "Horizontal Borer"),
        CreateTemplate("mill", "Milling", "Machining", 1.8m, "WC-16", "CNC Mill"),
        CreateTemplate("drill", "Drilling", "Machining", 0.7m, "WC-18", "Radial Drill"),
        CreateTemplate("deburr", "Deburring", "Finishing", 0.5m, "WC-22", "Deburring Bench"),
        CreateTemplate("heat", "Heat treatment", "Process", 2.4m, "WC-25", "Batch Furnace"),
        CreateTemplate("grind", "Grinding", "Finishing", 1.2m, "WC-28", "Surface Grinder"),
        CreateTemplate("clean", "Parts cleaning", "Process", 0.6m, "WC-29", "Ultrasonic Cleaner"),
        CreateTemplate("paint", "Coating", "Finishing", 1.4m, "WC-30", "Spray Booth"),
        CreateTemplate("subassembly", "Subassembly", "Assembly", 1.3m, "WC-31", "Assembly Bench"),
        CreateTemplate("seal", "Seal installation", "Assembly", 0.8m, "WC-32", "Seal Press"),
        CreateTemplate("electrical", "Electrical test", "Test", 0.9m, "WC-35", "Electrical Test Rig"),
        CreateTemplate("balance", "Rotor balancing", "Test", 1.0m, "WC-37", "Balancing Machine"),
        CreateTemplate("pressure", "Pressure test", "Test", 1.2m, "WC-40", "Hydrostatic Rig"),
        CreateTemplate("calibrate", "Calibration", "Engineering", 0.8m, "WC-42", "Calibration Stand"),
        CreateTemplate("visual", "Visual inspection", "Quality", 0.5m, "QC-04", "Inspection Station"),
        CreateTemplate("final", "Final inspection", "Quality", 0.75m, "QC-08", "CMM"),
        CreateTemplate("pack", "Export packaging", "Shipping", 0.6m, "WH-02", "Packing Station"),
        CreateTemplate("label", "Labeling", "Shipping", 0.3m, "WH-04", "Label Printer"),
        CreateTemplate("dispatch", "Dispatch", "Shipping", 0.4m, "WH-07", "Loading Bay"),
    ];

    private const string TemplateListId = "case6-work-step-templates";

    [CascadingParameter]
    public ISparseEditSession<EnterpriseCatalogItem>? ParentSession { get; set; }

    [CascadingParameter]
    public SparseSessionScopeContext<EnterpriseCatalogItem>? ScopeContext { get; set; }

    [Parameter]
    public bool SectionDraftsEnabled { get; set; } = true;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public Action? OnAccepted { get; set; }

    private ISparseChildEditContext<CatalogWorkflow, SparseConflict>? _childSession;
    private CatalogWorkflow.EditSession _draftSession = null!;
    private int _sortableListsVersion;
    private readonly Dictionary<string, string> _templateIdByStepId = new(StringComparer.Ordinal);
    private string? _error;
    private ISparseEditSessionWithBatchEdit? AcceptanceBatchSession =>
        ParentSession as ISparseEditSessionWithBatchEdit;
    private CatalogWorkStep[] AvailableTemplates =>
        Templates.Select(static template => template.Step).Where(IsTemplateAvailable).ToArray();

    public CatalogWorkflow? CurrentWorkflow => _draftSession?.GetModelForFrameworkAccess();
    public bool HasChanges => _childSession?.HasChanges == true;
    private bool IsSectionEdited => HasChanges;

    // Item state compares surviving keyed rows, so index shifts from add/remove
    // do not mark unrelated steps as moved.
    private static string StepRowClass(SparseCollectionItemState local)
    {
        if (local.IsAdded)
        {
            return "pg-roster-row pg-added";
        }

        if (local.IsReordered)
        {
            return "pg-roster-row pg-moved";
        }

        if (local.IsChanged)
        {
            return "pg-roster-row pg-changed";
        }

        return "pg-roster-row";
    }

    public CatalogWorkMaster? GetMasterDefaults(string stepId)
    {
        if (!_templateIdByStepId.TryGetValue(stepId, out var templateId))
        {
            return null;
        }

        return Templates.FirstOrDefault(template => template.Step.Id == templateId)?.Master.DeepClone();
    }

    protected override void OnParametersSet()
    {
        _ = ParentSession as CatalogSession
            ?? throw new InvalidOperationException("The catalog edit session is unavailable.");
        _ = ScopeContext
            ?? throw new InvalidOperationException("The catalog session scope is unavailable.");
    }

    private Task ReportStatus(bool _)
    {
        return OnChanged.InvokeAsync();
    }

    private Task RefreshWorkflow()
    {
        _sortableListsVersion++;
        return OnChanged.InvokeAsync();
    }

    private void OnChildAutoAccepted() => OnAccepted?.Invoke();

    private void RunInCatalogBatch(Action edit)
    {
        if (AcceptanceBatchSession is null)
        {
            edit();
            return;
        }

        AcceptanceBatchSession.BatchEdit(edit);
    }

    public void Dispose()
    {
        if (_childSession is not null)
        {
            _childSession.AutoAccepted -= OnChildAutoAccepted;
        }
    }

    private bool IsTemplateAvailable(CatalogWorkStep template) =>
        !_templateIdByStepId.Any(mapping =>
            mapping.Value == template.Id && _draftSession.Observable.Steps.Any(step => step.Id == mapping.Key)
        );

    private int IndexOf(string id)
    {
        for (var index = 0; index < _draftSession.Observable.Steps.Count; index++)
        {
            if (_draftSession.Observable.Steps[index].Id == id)
            {
                return index;
            }
        }

        return -1;
    }

    private static WorkflowStepTemplate CreateTemplate(
        string id,
        string name,
        string team,
        decimal hours,
        string workCenter,
        string equipment
    ) =>
        new WorkflowStepTemplate
        {
            Step = new CatalogWorkStep
            {
                Id = $"template-{id}",
                Name = name,
                ResponsibleTeam = team,
                StandardHours = hours,
            },
            Master = new CatalogWorkMaster
            {
                WorkCenter = workCenter,
                Equipment = equipment,
                SetupMinutes = 15,
                Instruction = $"Follow the standard {name.ToLowerInvariant()} procedure.",
            },
        };

    private static CatalogWorkMaster GetTemplateMaster(string templateId) =>
        Templates.First(template => template.Step.Id == templateId).Master;

    private async Task OnTemplateAdded(FluentSortableListEventArgs args)
    {
        var availableTemplates = AvailableTemplates;
        if (args.FromListId != TemplateListId || args.OldIndex < 0 || args.OldIndex >= availableTemplates.Length)
        {
            return;
        }

        await AddStepAt(availableTemplates[args.OldIndex], args.NewIndex);
    }

    private Task AddStep(CatalogWorkStep template) => AddStepAt(template, _draftSession.Observable.Steps.Count);

    private async Task AddStepAt(CatalogWorkStep template, int insertAt)
    {
        if (!IsTemplateAvailable(template))
        {
            _error = $"{template.Name} is already in the workflow.";
            await NotifyWorkflowChanged();
            return;
        }

        var step = new CatalogWorkStep
        {
            Id = $"step-{Guid.NewGuid():N}",
            Name = template.Name,
            ResponsibleTeam = template.ResponsibleTeam,
            StandardHours = template.StandardHours,
        };

        _templateIdByStepId.Add(step.Id, template.Id);
        var steps = _draftSession.EditCollection<CatalogWorkStep, string>(CatalogWorkflow.SparsePath.Steps);
        var targetIndex = Math.Clamp(insertAt, 0, steps.Count);
        var inserted = false;
        var error = SparseCollectionEditError.None;
        RunInCatalogBatch(() => inserted = steps.TryInsert(targetIndex, step, out error));
        if (!inserted)
        {
            _templateIdByStepId.Remove(step.Id);
            _error = $"Could not add the step ({error}).";
            return;
        }

        _error = null;
        await NotifyWorkflowChanged();
    }

    private async Task RemoveStep(string id)
    {
        var steps = _draftSession.EditCollection<CatalogWorkStep, string>(CatalogWorkflow.SparsePath.Steps);
        var removed = false;
        var error = SparseCollectionEditError.None;
        RunInCatalogBatch(() => removed = steps.TryRemoveByKey(id, out error));
        if (removed)
        {
            _error = null;
            await NotifyWorkflowChanged();
        }
        else
        {
            _error = $"Could not remove the step ({error}).";
        }
    }

    private async Task MoveStep(string id, int delta)
    {
        var oldIndex = IndexOf(id);
        var target = oldIndex + delta;
        var steps = _draftSession.EditCollection<CatalogWorkStep, string>(CatalogWorkflow.SparsePath.Steps);
        if (oldIndex < 0 || target < 0 || target >= steps.Count)
        {
            return;
        }

        var moved = false;
        var error = SparseCollectionEditError.None;
        RunInCatalogBatch(() => moved = steps.TryMove(oldIndex, target, out error));
        if (!moved)
        {
            _error = $"Could not move the step ({error}).";
            return;
        }

        _error = null;
        await NotifyWorkflowChanged();
    }

    private Task OnSortableUpdate(FluentSortableListEventArgs args)
    {
        if (args.FromListId != "case6-workflow" || args.ToListId != "case6-workflow")
        {
            return Task.CompletedTask;
        }

        var count = _draftSession.Observable.Steps.Count;
        var oldIndex = args.OldIndex;
        var newIndex = Math.Min(args.NewIndex, count - 1);
        if (oldIndex == newIndex || oldIndex < 0 || oldIndex >= count || newIndex < 0)
        {
            return Task.CompletedTask;
        }

        var steps = _draftSession.EditCollection<CatalogWorkStep, string>(CatalogWorkflow.SparsePath.Steps);
        var moved = false;
        var error = SparseCollectionEditError.None;
        RunInCatalogBatch(() => moved = steps.TryMove(oldIndex, newIndex, out error));
        if (!moved)
        {
            _error = $"Could not reorder the steps ({error}).";
            return Task.CompletedTask;
        }

        _error = null;
        return NotifyWorkflowChanged();
    }

    private Task OnHistoryChanged() => NotifyWorkflowChanged();

    private Task NotifyWorkflowChanged()
    {
        _sortableListsVersion++;
        return OnChanged.InvokeAsync();
    }

    private sealed class WorkflowStepTemplate
    {
        public CatalogWorkStep Step { get; init; } = null!;
        public CatalogWorkMaster Master { get; init; } = null!;
    }
}
