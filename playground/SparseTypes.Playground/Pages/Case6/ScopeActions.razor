@using SparseTypes
@using SparseTypes.Playground.Models
@typeparam TModel where TModel : class

<div class="pg-stack">
    <div class="pg-actions">
        <FluentButton Appearance="ButtonAppearance.Default" Disabled="@(!CurrentHistory.CanUndo)" @onclick="Undo">
            Undo (@CurrentHistory.UndoCount)
        </FluentButton>
        <FluentButton Appearance="ButtonAppearance.Default" Disabled="@(!CurrentHistory.CanRedo)" @onclick="Redo">
            Redo (@CurrentHistory.RedoCount)
        </FluentButton>
        <FluentButton Appearance="ButtonAppearance.Primary" Class="pg-submit-button"
            Disabled="@(!Scope.HasChanges)" @onclick="CommitScopeAsync">Save section draft</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Default" Disabled="@(!Scope.HasChanges)"
            @onclick="Cancel">Cancel scope</FluentButton>
    </div>
    @if (_message is not null)
    {
        <p class="pg-hint">@_message</p>
    }
    @if (_conflicts.Count > 0)
    {
        <div class="pg-change-table-wrap">
            <table class="pg-change-table" aria-label="Scope conflicts">
                <thead><tr><th>Path</th><th>Current value</th><th>Draft value</th><th>Kind</th></tr></thead>
                <tbody>
                    @foreach (var conflict in _conflicts)
                    {
                        <tr>
                            <td><span class="pg-change-value">@conflict.PathText</span></td>
                            <td><span class="pg-change-value">@PlaygroundJson.FormatChangeValue(conflict.CurrentValue)</span></td>
                            <td><span class="pg-change-value">@PlaygroundJson.FormatChangeValue(conflict.LocalValue)</span></td>
                            <td>@conflict.Kind</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public EnterpriseCatalogItem.EditSession.Scope<TModel> Scope { get; set; } = null!;

    [Parameter, EditorRequired]
    public Func<ISparseEditHistory> HistoryProvider { get; set; } = null!;

    [Parameter]
    public EventCallback OnFinished { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public Func<Task<bool>>? BeforeCommit { get; set; }

    [Parameter]
    public EventCallback OnCommitAttemptFinished { get; set; }

    [Parameter]
    public string BeforeCommitFailureMessage { get; set; } = "Resolve related drafts before saving this section.";

    private IReadOnlyList<SparseConflict> _conflicts = [];
    private string? _message;
    private ISparseEditHistory CurrentHistory => HistoryProvider();

    public async Task<bool> CommitScopeAsync()
    {
        if (!Scope.HasChanges)
        {
            return true;
        }

        if (BeforeCommit is not null && !await BeforeCommit())
        {
            _message = BeforeCommitFailureMessage;
            return false;
        }

        try
        {
            if (Scope.TryCommit(out var conflicts))
            {
                _conflicts = [];
                _message = "Section draft saved to the catalog session.";
                await OnFinished.InvokeAsync();
                return true;
            }

            _conflicts = conflicts ?? [];
            _message = "The scope overlaps newer session edits. Cancel it to reload the current section, then reapply the intended changes.";
            return false;
        }
        finally
        {
            await OnCommitAttemptFinished.InvokeAsync();
        }
    }

    private async Task Cancel()
    {
        Scope.Cancel();
        _conflicts = [];
        _message = "Scope canceled. The section is ready for more edits.";
        await OnFinished.InvokeAsync();
    }

    private async Task Undo()
    {
        try
        {
            CurrentHistory.Undo();
            _message = null;
            await OnChanged.InvokeAsync();
        }
        catch (InvalidOperationException exception)
        {
            _message = exception.Message;
        }
    }

    private async Task Redo()
    {
        try
        {
            CurrentHistory.Redo();
            _message = null;
            await OnChanged.InvokeAsync();
        }
        catch (InvalidOperationException exception)
        {
            _message = exception.Message;
        }
    }
}
