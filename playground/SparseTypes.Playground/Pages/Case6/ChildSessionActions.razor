@using SparseTypes
@using SparseTypes.Playground.Models
@using SparseTypes.Blazor
@typeparam TModel where TModel : class

<div class="pg-stack">
    @if (SectionDraftsEnabled)
    {
        <div class="pg-actions">
            <FluentButton Appearance="ButtonAppearance.Default" Disabled="@(!Context.CanUndo)" @onclick="UndoDraft">
                Undo
            </FluentButton>
            <FluentButton Appearance="ButtonAppearance.Default" Disabled="@(!Context.CanRedo)" @onclick="RedoDraft">
                Redo
            </FluentButton>
            <FluentButton Appearance="ButtonAppearance.Primary" Class="pg-submit-button"
                Disabled="@(!Context.HasChanges)" @onclick="AcceptChildSessionAsync">Save section draft</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Default" Disabled="@(!Context.HasChanges)"
                @onclick="DiscardChildSessionAsync">Discard section draft</FluentButton>
        </div>
    }
    @if (Context.Conflicts is not null)
    {
        <p class="pg-hint">The latest edit could not be merged. Correct the conflicting value or discard the draft.</p>
        <FluentButton Appearance="ButtonAppearance.Default" @onclick="DiscardChildSessionAsync">
            Discard conflicting edit
        </FluentButton>
    }
    else if (_message is not null)
    {
        <p class="pg-hint">@_message</p>
    }
    @if (DisplayedConflicts.Count > 0)
    {
        <div class="pg-change-table-wrap">
            <table class="pg-change-table" aria-label="Child-session conflicts">
                <thead><tr><th>Path</th><th>Current value</th><th>Draft value</th><th>Kind</th></tr></thead>
                <tbody>
                    @foreach (var conflict in DisplayedConflicts)
                    {
                        <tr>
                            <td><span class="pg-change-value">@conflict.PathText</span></td>
                            <td><span class="pg-change-value">@PlaygroundJson.FormatChangeValue(conflict.CurrentValue)</span></td>
                            <td><span class="pg-change-value">@PlaygroundJson.FormatChangeValue(conflict.LocalValue)</span></td>
                            <td>@conflict.Kind</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public ISparseChildEditContext<TModel, SparseConflict> Context { get; set; } = null!;

    [Parameter]
    public bool SectionDraftsEnabled { get; set; } = true;

    [Parameter]
    public ISparseEditSessionWithBatchEdit? AcceptanceBatchSession { get; set; }

    [Parameter]
    public EventCallback OnFinished { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public EventCallback<bool> OnStatusChanged { get; set; }

    private IReadOnlyList<SparseConflict> _conflicts = [];
    private string? _message;
    private IReadOnlyList<SparseConflict> DisplayedConflicts =>
        _conflicts.Count > 0 ? _conflicts : Context.Conflicts ?? [];

    public async Task<bool> AcceptChildSessionAsync()
    {
        if (!Context.HasChanges)
        {
            return true;
        }

        var accepted = false;
        IReadOnlyList<SparseConflict>? conflicts = null;
        void Accept()
        {
            accepted = Context.TryAcceptChanges(out conflicts);
        }

        try
        {
            if (AcceptanceBatchSession is null)
            {
                Accept();
            }
            else
            {
                AcceptanceBatchSession.BatchEdit(Accept);
            }
        }
        catch (InvalidOperationException exception)
        {
            _message = exception.Message;
            return false;
        }

        if (accepted)
        {
            _conflicts = [];
            _message = "Section draft saved to the catalog session.";
            await OnFinished.InvokeAsync();
            return true;
        }

        _conflicts = conflicts ?? [];
        _message = "The child session overlaps newer parent-session edits. Discard it to reload the current section, then reapply the intended changes.";
        return false;
    }

    private async Task DiscardChildSessionAsync()
    {
        Context.DiscardChanges();
        _conflicts = [];
        _message = "Section draft discarded. The section is ready for more edits.";
        await OnFinished.InvokeAsync();
    }

    private async Task UndoDraft()
    {
        try
        {
            Context.Undo();
            _message = null;
            await OnStatusChanged.InvokeAsync(Context.HasChanges);
            await OnChanged.InvokeAsync();
        }
        catch (InvalidOperationException exception)
        {
            _message = exception.Message;
        }
    }

    private async Task RedoDraft()
    {
        try
        {
            Context.Redo();
            _message = null;
            await OnStatusChanged.InvokeAsync(Context.HasChanges);
            await OnChanged.InvokeAsync();
        }
        catch (InvalidOperationException exception)
        {
            _message = exception.Message;
        }
    }
}
