@using SparseTypes.Playground.Components

<div class="pg-code-samples">
    <p class="pg-hint">Origins show which layer supplied each effective value without changing the fragment data.</p>
    <FluentTabs Orientation="Orientation.Vertical">
        <FluentTab Header="Merge and inspect a value" Id="code-1-merge">
            <MonacoView Content="@MergeCode" Language="csharp" Height="450px" />
        </FluentTab>
        <FluentTab Header="Enumerate origins" Id="code-1-origins">
            <MonacoView Content="@OriginsCode" Language="csharp" Height="350px" />
        </FluentTab>
    </FluentTabs>
</div>

@code {
    private const string MergeCode = """
        using System;
        using System.Collections.Generic;
        using SparseTypes;

        var lower = new PlaygroundSettings.Fragment("lower")
        {
            Enabled = true,
            RetryCount = 3,
            Label = "base",
            Nested = new PlaygroundNested.Fragment { Host = "localhost", Port = 5432 },
            Plugins = ["base-plugin"],
            Tags = new HashSet<string> { "shared", "base-tag" }
        };

        var higher = new PlaygroundSettings.Fragment("higher")
        {
            Label = (string?)null,
            Nested = new PlaygroundNested.Fragment { Port = 8080 },
            Plugins = ["extra-plugin"],
            Tags = new HashSet<string> { "shared", "tenant-tag" }
        };

        var merged = lower.Merge(higher);
        var model = merged.ToModel();
        var pluginSource = merged.GetOrigin(
            SparsePath.Root<PlaygroundSettings>().Member("Plugins").At(1));
        // Plugin origin is "higher"; the overlapping "shared" tag remains "lower".
        // Enabled, RetryCount and Nested.Host come from lower; Label and Nested.Port come from higher.

        [SparseModel]
        partial class PlaygroundSettings
        {
            [SparseMerge(MergeMode.Append)]
            public IReadOnlyList<string> Plugins { get; set; } = [];

            [SparseMerge(MergeMode.SetUnion)]
            public HashSet<string> Tags { get; set; } = new(StringComparer.Ordinal);
        }
        """;

    private const string OriginsCode = """
        using System;

        foreach (var entry in merged.EnumerateOrigins())
        {
            Console.WriteLine($"{entry.Path}: {entry.Origin ?? "Unknown"}");
        }
        """;
}
