@using SparseTypes.Playground.Components

<div class="pg-code-samples">
    <p class="pg-hint">Create an EditSession to track model changes, edit through the headless Blazor components over the session paths, and rely on opt-in history plus the edit root for undo, redo, and refresh.</p>
    <FluentTabs Orientation="Orientation.Vertical">
        <FluentTab Header="Session / Bind" Id="code-4-session">
            <MonacoView Content="@SessionCode" Language="csharp" Height="390px" />
        </FluentTab>
        <FluentTab Header="Monitor / Undo / Redo" Id="code-4-history">
            <h3 class="pg-code-sample-subheading">Monitor changes</h3>
            <MonacoView Content="@MonitorCode" Language="csharp" Height="310px" />
            <h3 class="pg-code-sample-subheading">Undo and redo</h3>
            <MonacoView Content="@HistoryCode" Language="csharp" Height="370px" />
        </FluentTab>
        <FluentTab Header="Password redaction" Id="code-4-redaction">
            <MonacoView Content="@RedactionCode" Language="csharp" Height="500px" />
        </FluentTab>
    </FluentTabs>
</div>

@code {
    private const string SessionCode = """
        var baseline = model.DeepClone(); // Independent snapshot for presentation.
        var session = model.CreateEditSession();
        session.EnableHistory(); // Opt-in session-owned history; the edit root only observes it.

        // Razor context: `edit` exists only inside this SparseEdit subtree.
        // <SparseEdit Session="@session" Context="edit">
        //     <SparseField Path="edit.Path.RetryCount" Context="retryCount">
        //         <FluentNumberInput TValue="int" @bind-Value="retryCount.Value" />
        //     </SparseField>
        //     <SparseField Path="edit.Path.Password" Context="password">
        //         <input type="password" @bind="password.Value" />
        //     </SparseField>
        //     <button @onclick="() => Submit(edit)">Submit</button>
        // </SparseEdit>

        void Submit<TPaths>(SparseEditContext<PlaygroundSettings, TPaths> edit)
            where TPaths : ISparseTypedPath<PlaygroundSettings, PlaygroundSettings>
        {
            if (edit.HasChanges)
            {
                var pending = edit.Session.CreateChangeSet();
                edit.Session.AcceptChanges(edit.EditContext);
            }
        }

        void Reset<TPaths>(SparseEditContext<PlaygroundSettings, TPaths> edit)
            where TPaths : ISparseTypedPath<PlaygroundSettings, PlaygroundSettings>
        {
            session.RevertChanges();
            edit.EditContext.MarkAsUnmodified();
        }
        """;

    private const string MonitorCode = """
        // TransitionObserved is for custom observers such as logging. It
        // works with or without a history; creating a history never
        // requires subscribing here.
        session.TransitionObserved += transition =>
        {
            logger.LogInformation(
                "Observed edit: {ChangedPaths}",
                string.Join(", ", transition.EnumerateChangedPaths()));
        };
        // Unsubscribe with the owner lifetime.
        // session.TransitionObserved -= handler;
        
        // Appearance-free refresh: the SparseEdit root cascades the session
        // and re-renders its subtree once per session notification.
        // <SparseEdit Session="@session" Context="edit"> ... </SparseEdit>
        """;

    private const string HistoryCode = """
        // Opt-in history: without EnableHistory the session retains nothing.
        // Enabling subscribes the session-owned history automatically, so Undo
        // and Redo work with no further wiring. Keep it as a field alongside
        // the session.
        private ISparseEditHistory _history = null!;

        void Setup()
        {
            _history = session.EnableHistory();
            // Bound retention: keep only the newest entries (default 50).
            // _history = session.EnableHistory(new EditHistoryOptions { MaxEntries = 20 });
        }

        void ApplyPreset()
        {
            session.BatchEdit(() =>
            {
                session.Observable.Enabled = false;
                session.Observable.RetryCount = 8;
                session.Observable.Label = "Batch preset";
            });
            // The whole preset is one history entry, so one Undo restores every field.
        }

        void Undo()
        {
            _history.Undo(); // Applies the inverted ChangeSet; throws when empty or conflicting.
        }

        void Redo()
        {
            _history.Redo(); // Reapplies the undone ChangeSet.
        }

        // The session owns the history: it unsubscribes and releases retention.
        // Disable it with its owner, for example in the component Dispose method.
        public void Dispose()
        {
            session.DisableHistory();
        }

        // Accept/revert clear registered histories on success, so submit and
        // reset need no manual stack handling. Replayed operations are never
        // re-recorded, and BatchEdit stores one entry per action.
        """;

    private const string RedactionCode = """
        using System.Text.Json;
        using SparseTypes;

        [SparseModel]
        public partial class PlaygroundSettings
        {
            [SparseRedactBefore]
            public string? Password { get; set; }
        }

        var changes = session.CreateChangeSet();
        var payload = changes.ToPayload();
        var json = JsonSerializer.Serialize(payload);
        var imported = JsonSerializer.Deserialize<PlaygroundSettings.ChangePayload>(json)!;

        // Redaction applies to the before-value in transport, not local models or complete local history.
        // The after-value is transmitted. This is not encryption or credential storage.
        // A redacted payload cannot reconstruct a complete ChangeSet through ToChangeSet() or FromPayload().
        var baselineFreePatch = imported.ToPatch();
        var blindUpdate = baselineFreePatch.ApplyTo(current);

        // Use mixed apply when ordinary members still need rebase/conflict checks.
        if (imported.TryApplyMixedTo(current, out var updated, out var result))
        {
            // A conflict in an ordinary member commits none of the mixed changes.
        }

        var reversible = imported.InvertReversibleChanges(out var skipped);
        // Write-only paths are omitted from the inverse and listed in skipped; this is not a full inverse.
        """;
}
