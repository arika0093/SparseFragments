@using SparseTypes
@using SparseTypes.Blazor
@using SparseTypes.Playground.Models
@using SparseTypes.Playground.Components
@using SettingsSession = global::SparseTypes.Playground.Models.PlaygroundSettings.EditSession;

<div class="pg-row pg-session-field pg-task-field">
    <span class="pg-name notranslate" translate="no">Tasks <small>List&lt;Task&gt;</small></span>
    <FluentButton Appearance="ButtonAppearance.Primary" @onclick="AddTask">Add task</FluentButton>
</div>
<SparseField Path="Session.Paths.Tasks" Context="tasks">
    @* One collection view per render, shared by all rows: capturing the
    snapshot here diffs once, and row lookups below only probe it. Unknown
    keys report the empty state, so stale rows render clean. *@
    @{ var roster = tasks.TryGetCollectionState(out var view) ? view : null; }
    <SortableList @key="Session.Observable.Tasks.Count" Items="Session.Observable.Tasks" Handle=".pg-drag" Class="pg-roster-list"
        OnUpdate="OnSortableUpdate" Context="task">
        <SortableItemTemplate>
            <TaskRow @key="task.Id" Task="task" Session="Session" RowState="roster?.GetItemState(task.Id) ?? default" OnError="SetTaskError" />
        </SortableItemTemplate>
    </SortableList>
</SparseField>
@if (_taskError is not null)
{
    <FluentMessageBar Intent="MessageBarIntent.Error">@_taskError</FluentMessageBar>
}

@code {
    private static readonly string[] TaskTitles =
        ["Raid", "Arena", "Trial", "Hunt", "Siege", "Expedition", "Duel", "Patrol"];

    [Parameter, EditorRequired]
    public SettingsSession Session { get; set; } = null!;

    /// <summary>Gets or sets the submitted baseline task IDs reserved against reuse.</summary>
    /// <remarks>Kept even for rows removed from the draft, so an addition never reads as an edit of a removed identity. Rebuilt when the submitted baseline advances.</remarks>
    [Parameter, EditorRequired]
    public IReadOnlyCollection<string> BaselineTaskIds { get; set; } = [];

    private string? _taskError;

    private void AddTask()
    {
        // Deterministic allocation over the draft plus the reserved baseline
        // IDs: always terminates, unlike the previous random retry loop.
        var id = PlaygroundIds.Allocate(
            "t",
            Session.Observable.Tasks
                .Select(static task => task.Id)
                .Concat(BaselineTaskIds)
        );

        // Path-addressed add: one batched transition with keyed duplicate
        // rejection, instead of a handwritten BatchEdit plus AddModel call.
        var tasks = Session.EditCollection<PlaygroundTask, string>(
            PlaygroundSettings.SparsePath.Tasks
        );
        if (
            !tasks.TryAdd(
                new PlaygroundTask
                {
                    Id = id,
                    Title = TaskTitles[Random.Shared.Next(TaskTitles.Length)],
                    Points = Random.Shared.Next(1, 100),
                },
                out var error
            )
        )
        {
            _taskError = DescribeError("add", error);
        }
    }

    private Task OnSortableUpdate((int oldIndex, int newIndex) indices)
    {
        var (oldIndex, newIndex) = indices;
        // The facade re-resolves the live collection per operation, so the
        // drag never acts on a retained list instance.
        var tasks = Session.EditCollection<PlaygroundTask, string>(
            PlaygroundSettings.SparsePath.Tasks
        );
        var count = tasks.Count;
        if (oldIndex == newIndex || oldIndex < 0 || oldIndex >= count || newIndex < 0 || newIndex > count)
        {
            return Task.CompletedTask;
        }

        // SortableList names the drop position in pre-move coordinates.
        var target = Math.Min(newIndex, count - 1);
        if (oldIndex == target)
        {
            return Task.CompletedTask;
        }

        if (!tasks.TryMove(oldIndex, target, out var error))
        {
            _taskError = DescribeError("move", error);
        }

        return Task.CompletedTask;
    }

    private void SetTaskError(string? error) => _taskError = error;

    private static string DescribeError(string action, SparseCollectionEditError error) =>
        error == SparseCollectionEditError.DuplicateKey
            ? "Task IDs must be non-empty and unique."
            : $"Could not {action} the task ({error}).";
}
