@using System.Diagnostics.CodeAnalysis
@typeparam T

<FluentSortableList @key="_version" TItem="T" Items="@Items"
    Handle="@(!string.IsNullOrWhiteSpace(Handle))"
    Fallback="@ForceFallback"
    Class="@Class"
    OnUpdate="HandleUpdate">
    <ItemTemplate Context="item">
        @if (SortableItemTemplate is not null)
        {
            @SortableItemTemplate(item)
        }
    </ItemTemplate>
</FluentSortableList>

@code {
    [Parameter, AllowNull]
    public IList<T> Items { get; set; }

    [Parameter]
    public RenderFragment<T>? SortableItemTemplate { get; set; }

    [Parameter]
    public EventCallback<(int oldIndex, int newIndex)> OnUpdate { get; set; }

    [Parameter]
    public string Handle { get; set; } = string.Empty;

    [Parameter]
    public bool ForceFallback { get; set; } = true;

    [Parameter]
    public string? Class { get; set; }

    private int _version;

    private async Task HandleUpdate(FluentSortableListEventArgs args)
    {
        await OnUpdate.InvokeAsync((args.OldIndex, args.NewIndex));
        _version++;
    }
}
