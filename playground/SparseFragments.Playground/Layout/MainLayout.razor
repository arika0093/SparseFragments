@inherits LayoutComponentBase
@using Microsoft.FluentUI.AspNetCore.Components
@using SparseFragments.Playground.Models
@inject PlaygroundThemeState ThemeState
@inject IThemeService FluentThemeService
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="pg-shell">
    @Body
</div>
<FluentToastProvider />
<FluentDialogProvider />
<FluentTooltipProvider />

@code {
    protected override void OnInitialized() => ThemeState.Changed += OnThemeStateChanged;

    private IJSObjectReference? _themeModule;
    private DotNetObjectReference<MainLayout>? _selfReference;
    private bool _initializingTheme;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _themeModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/playgroundTheme.js");
        _selfReference = DotNetObjectReference.Create(this);
        var storedMode = await _themeModule.InvokeAsync<string>("initialize", _selfReference);
        _initializingTheme = true;
        if (Enum.TryParse<PlaygroundThemeMode>(storedMode, out var mode))
        {
            ThemeState.SetMode(mode);
        }

        await ApplyThemeAsync();
        _initializingTheme = false;
    }

    private void OnThemeStateChanged()
    {
        if (_initializingTheme)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            StateHasChanged();
            await ApplyThemeAsync();
        });
    }

    private async Task ApplyThemeAsync()
    {
        if (_themeModule is null)
        {
            throw new InvalidOperationException("The theme module is not initialized.");
        }

        var isDark = await _themeModule.InvokeAsync<bool>("apply", ThemeState.Mode.ToString());
        var mode = ThemeState.Mode switch
        {
            PlaygroundThemeMode.Light => ThemeMode.Light,
            PlaygroundThemeMode.Dark => ThemeMode.Dark,
            _ => ThemeMode.System,
        };
        await FluentThemeService.SetThemeAsync(mode);
        var theme = await FluentThemeService.CreateCustomThemeAsync(new ThemeSettings
        {
            Color = await FluentThemeService.GetBrandColorAsync(),
            Mode = mode,
        });
        theme.Spacings.Vertical.S = "6px";
        theme.Spacings.Vertical.M = "8px";
        theme.Spacings.Vertical.L = "12px";
        theme.Spacings.Vertical.XL = "16px";
        theme.Spacings.Vertical.XXL = "20px";
        theme.Spacings.Vertical.XXXL = "24px";
        await FluentThemeService.SetThemeAsync(theme);
        ThemeState.SetSystemTheme(isDark);
    }

    [JSInvokable]
    public void OnSystemThemeChanged(bool isDark) => ThemeState.SetSystemTheme(isDark);

    public async ValueTask DisposeAsync()
    {
        ThemeState.Changed -= OnThemeStateChanged;
        if (_themeModule is not null)
        {
            await _themeModule.InvokeVoidAsync("dispose");
            await _themeModule.DisposeAsync();
        }

        _selfReference?.Dispose();
    }
}
