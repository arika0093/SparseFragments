<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- No public API surface to document. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Demo app only: never ship as a NuGet package via slnx pack. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BlazorMonaco" Version="3.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference
      Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer"
      Version="10.0.12"
      PrivateAssets="all"
    />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="4.14.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SparseFragments/SparseFragments.csproj" />
    <ProjectReference
      Include="../../src/SparseFragments.Generator/SparseFragments.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
</Project>
