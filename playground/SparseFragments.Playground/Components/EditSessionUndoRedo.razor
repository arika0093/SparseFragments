@using System.Text.Json
@using SparseFragments
@using SparseFragments.Playground.Models
@using SettingsSession = global::SparseFragments.Generated.SparseFragments_Playground_Models_PlaygroundSettings_544C47B3.EditSession;
@using TaskObservable = global::SparseFragments.Generated.SparseFragments_Playground_Models_PlaygroundTask_E6C8F7DB.Observable;
@implements IDisposable
<div class="pg-grid pg-two-pane">
    <FluentCard Class="pg-fluent-card">
        <div class="pg-card-head">
            <h3>Edit</h3>
            <div class="pg-actions pg-edit-history">
            <FluentButton Appearance="ButtonAppearance.Default" Class="pg-history-button" Title="Undo"
                    Disabled="@(_undo.Count == 0)" @onclick="Undo">
                    <svg class="pg-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.5 8c-2.65 0-5.05 1.03-6.8 2.7L2 7v9h9l-3.65-3.65c1.32-1.25 3.12-2.02 5.15-2.02 3.23 0 5.96 2.07 6.94 4.95l2.4-.8C20.5 10.6 16.82 8 12.5 8Z" /></svg>
                    Undo (@_undo.Count)
            </FluentButton>
            <FluentButton Appearance="ButtonAppearance.Default" Class="pg-history-button" Title="Redo"
                    Disabled="@(_redo.Count == 0)" @onclick="Redo">
                    <svg class="pg-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12.5 8c2.65 0 5.05 1.03 6.8 2.7L23 7v9h-9l3.65-3.65c-1.32-1.25-3.12-2.02-5.15-2.02-3.23 0-5.96 2.07-6.94 4.95l-2.4-.8C4.5 10.6 8.18 8 12.5 8Z" /></svg>
                    Redo (@_redo.Count)
            </FluentButton>
            </div>
        </div>

        <div class="pg-stack pg-edit-fields">
            <div class="pg-row pg-session-field @(IsChanged(nameof(PlaygroundSettings.Enabled)) ? "pg-changed" : "")">
                <span class="pg-name notranslate" translate="no">@ChangedDot(IsChanged(nameof(PlaygroundSettings.Enabled)))Enabled <small>bool</small></span>
                <FluentCheckbox Value="@_session.Observable.Enabled"
                    ValueChanged="@(value => Edit(() => _session.Observable.Enabled = value))" />
            </div>
            <div class="pg-row pg-session-field @(IsChanged(nameof(PlaygroundSettings.RetryCount)) ? "pg-changed" : "")">
                <span class="pg-name notranslate" translate="no">@ChangedDot(IsChanged(nameof(PlaygroundSettings.RetryCount)))RetryCount <small>int</small></span>
                <FluentNumberInput TValue="int" Style="width: 10rem;"
                    Value="@_retryDraft" ValueChanged="UpdateRetryCount" />
            </div>
            <div class="pg-row pg-session-field @(IsChanged(nameof(PlaygroundSettings.Label)) ? "pg-changed" : "")">
                <span class="pg-name notranslate" translate="no">@ChangedDot(IsChanged(nameof(PlaygroundSettings.Label)))Label <small>string</small></span>
                <FluentTextInput Placeholder="label" Style="flex: 1 1 12rem;"
                    Value="@_session.Observable.Label"
                    ValueChanged="@(value => Edit(() => _session.Observable.Label = value ?? string.Empty))" />
            </div>
            <div class="pg-row pg-session-field @(IsNestedChanged(nameof(PlaygroundNested.Host)) ? "pg-changed" : "")">
                <span class="pg-name notranslate" translate="no">@ChangedDot(IsNestedChanged(nameof(PlaygroundNested.Host)))Nested.Host <small>string</small></span>
                <FluentTextInput Placeholder="host" Style="flex: 1 1 12rem;"
                    Value="@_session.Observable.Nested!.Host"
                    ValueChanged="@(value => Edit(() => _session.Observable.Nested!.Host = value ?? string.Empty))" />
            </div>
            <div class="pg-row pg-session-field @(IsNestedChanged(nameof(PlaygroundNested.Port)) ? "pg-changed" : "")">
                <span class="pg-name notranslate" translate="no">@ChangedDot(IsNestedChanged(nameof(PlaygroundNested.Port)))Nested.Port <small>int</small></span>
                <FluentNumberInput TValue="int" Style="width: 10rem;"
                    Value="@_portDraft" ValueChanged="UpdatePort" />
            </div>
        </div>

        <div class="pg-row pg-session-field pg-task-field">
            <span class="pg-name notranslate" translate="no">Tasks <small>List&lt;Task&gt;</small></span>
            <FluentButton Appearance="ButtonAppearance.Primary" @onclick="AddTask">Add task</FluentButton>
        </div>
        <SortableList Items="_session.Observable.Tasks" Handle=".pg-drag" Class="pg-roster-list"
            OnUpdate="OnSortableUpdate" Context="task">
            <SortableItemTemplate>
                @TaskRow((task, _session.Observable.Tasks.IndexOf(task)))
            </SortableItemTemplate>
        </SortableList>
        <div class="pg-legend pg-session-legend" aria-label="Edit highlight legend">
            <span class="pg-lg"><span class="pg-sw pg-sw-add"></span>added</span>
            <span class="pg-lg"><span class="pg-sw pg-sw-move"></span>moved</span>
            <span class="pg-lg"><span class="pg-dot"></span>edited</span>
        </div>
        @if (_editError is not null)
        {
            <FluentMessageBar Intent="MessageBarIntent.Error">@_editError</FluentMessageBar>
        }
        <div class="pg-actions pg-session-actions">
            <FluentButton Appearance="ButtonAppearance.Default" Disabled="@(!_session.HasChanges)"
                @onclick="Reset">Reset</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Primary" Class="pg-submit-button"
                Disabled="@(!_session.HasChanges)" @onclick="RequestSubmit">Submit</FluentButton>
        </div>
    </FluentCard>

    <div class="pg-stack">
        <FluentCard Class="pg-fluent-card pg-session-result">
            <div class="pg-card-head">
                <h3>Result</h3>
                <span class="pg-has-changes-badge @(_session.HasChanges ? "pg-has-changes" : "pg-no-changes")">
                    <span aria-hidden="true"></span>@(_session.HasChanges ? "Changes" : "No changes")
                </span>
            </div>
            <FluentTabs ActiveTabId="@_activeTab" ActiveTabIdChanged="@(id => _activeTab = id ?? "current")">
                <FluentTab Header="Diff" Id="diff">
                    <MonacoDiffView Original="@_baselineJson" Modified="@CurrentJson" Language="json" Height="320px" />
                </FluentTab>
                <FluentTab Header="Current" Id="current">
                    <MonacoView Content="@CurrentJson" Language="json" Height="320px" />
                </FluentTab>
                <FluentTab Header="Baseline" Id="baseline">
                    <MonacoView Content="@_baselineJson" Language="json" Height="320px" />
                </FluentTab>
            </FluentTabs>
        </FluentCard>
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head"><h3>Changelog</h3></div>
            <ol class="pg-edit-log">
                @foreach (var entry in _log)
                {
                    <li><time>@entry.Time</time><code>@entry.Change</code></li>
                }
                @if (_log.Count == 0)
                {
                    <li class="pg-edit-log-empty pg-hint">No changes yet</li>
                }
            </ol>
        </FluentCard>
    </div>
</div>

<FluentDialog @ref="_submitDialog" Hidden="@_submitDialogHidden" Modal="true" TrapFocus="true"
    Class="pg-submit-preview-dialog" AriaLabel="Confirm submit changes">
    <div class="pg-dialog-heading">
        <h3>Confirm submit</h3>
    </div>
    <div class="pg-dialog-body">
        <p>The following changes will be submitted. Continue?</p>
        @if (_submitChanges.Count == 0)
        {
            <p class="pg-hint">No changes to submit.</p>
        }
        else
        {
            <div class="pg-change-table-wrap pg-submit-change-table-wrap">
                <table class="pg-change-table pg-submit-change-table" aria-label="Changes to submit">
                    <thead>
                        <tr><th>Operation</th><th>Property</th><th>Before</th><th>After</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var change in _submitChanges)
                        {
                            <tr>
                                <td><span class="@ChangeOperationClass(change.Operation)">@change.Operation</span></td>
                                <td>@change.Target</td>
                                <td><span class="pg-change-value">@change.Before</span></td>
                                <td><span class="pg-change-value">@change.After</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="pg-dialog-footer">
        <FluentButton Appearance="ButtonAppearance.Default" @onclick="CancelSubmit">Cancel</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Primary" @onclick="ConfirmSubmit">Submit</FluentButton>
    </div>
</FluentDialog>

<FluentDialog @ref="_completionDialog" Hidden="@_completionHidden" Modal="true" TrapFocus="true"
    AriaLabel="Edit session action completed">
    <div class="pg-dialog-heading">
        <h3>@_completionTitle</h3>
    </div>
    <div class="pg-dialog-body">
        <p>@_completionMessage</p>
    </div>
    <div class="pg-dialog-footer">
        <FluentButton Appearance="ButtonAppearance.Primary" @onclick="CloseCompletion">Close</FluentButton>
    </div>
</FluentDialog>

@code {
    private const int MaximumLogEntries = 20;
    private static readonly string[] TaskTitles =
        ["Raid", "Arena", "Trial", "Hunt", "Siege", "Expedition", "Duel", "Patrol"];
    private readonly Stack<PlaygroundSettings.ChangeSet> _undo = new();
    private readonly Stack<PlaygroundSettings.ChangeSet> _redo = new();
    private readonly List<LogEntry> _log = [];
    private readonly Dictionary<TaskObservable, int> _pointsDrafts = [];
    private readonly Dictionary<TaskObservable, string> _idDrafts = [];
    private readonly PlaygroundSettings _model = new()
    {
        Enabled = true,
        RetryCount = 3,
        Label = "Draft",
        Nested = new PlaygroundNested { Host = "localhost", Port = 5432 },
        Plugins = ["base-plugin"],
        Tasks =
        [
            new PlaygroundTask { Id = "t1", Title = "Find the key", Points = 10 },
            new PlaygroundTask { Id = "t2", Title = "Open the gate", Points = 25 },
            new PlaygroundTask { Id = "t3", Title = "Clear the trial", Points = 40 },
            new PlaygroundTask { Id = "t4", Title = "Return to camp", Points = 5 },
        ],
    };

    private SettingsSession _session = null!;
    private List<PlaygroundTask> _baselineTasks = [];
    private string _baselineJson = string.Empty;
    private string _activeTab = "diff";
    private string? _editError;
    private int _retryDraft;
    private int _portDraft;
    private bool _submitDialogHidden = true;
    private bool _completionHidden = true;
    private bool _applyingHistory;
    private string _completionTitle = string.Empty;
    private string _completionMessage = string.Empty;
    private readonly List<(string Target, string Operation, string Before, string After)> _submitChanges = [];
    private FluentDialog? _submitDialog;
    private FluentDialog? _completionDialog;

    private string CurrentJson => PlaygroundJson.WriteModel(_model);

    private RenderFragment<(TaskObservable Task, int Index)> TaskRow => item =>
        @<div class="@TaskRowClass(item.Task, item.Index) pg-task-row">
            <div class="pg-task-line">
                <div class="pg-roster-field @(IsTaskIdChanged(item.Task) ? "pg-changed" : "")">
                    <span class="pg-mini notranslate" translate="no">@ChangedDot(IsTaskIdChanged(item.Task))Id</span>
                    @* focusout (not blur): blur doesn't bubble out of Fluent's inner input, so blur never commits. *@
                    <FluentTextInput Value="@GetIdDraft(item.Task)"
                        ValueChanged="@(value => _idDrafts[item.Task] = value ?? string.Empty)"
                        @onfocusout="() => CommitTaskId(item.Task)" />
                </div>
                <div class="pg-roster-field @(IsTaskFieldChanged(item.Task, nameof(PlaygroundTask.Title)) ? "pg-changed" : "")">
                    <span class="pg-mini notranslate" translate="no">@ChangedDot(IsTaskFieldChanged(item.Task, nameof(PlaygroundTask.Title)))Title</span>
                    <FluentTextInput Value="@item.Task.Title"
                        ValueChanged="@(value => Edit(() => item.Task.Title = value ?? string.Empty))" />
                </div>
                <div class="pg-roster-field @(IsTaskFieldChanged(item.Task, nameof(PlaygroundTask.Points)) ? "pg-changed" : "")">
                    <span class="pg-mini notranslate" translate="no">@ChangedDot(IsTaskFieldChanged(item.Task, nameof(PlaygroundTask.Points)))Points</span>
                    <FluentNumberInput TValue="int" Style="width: 100%;" Value="@GetPointsDraft(item.Task)"
                        ValueChanged="@(value => UpdatePoints(item.Task, value))" />
                </div>
                <div class="pg-roster-actions pg-task-actions">
                    <span class="pg-drag sortable-grab" title="Drag to reorder">⠿</span>
                    <FluentButton Appearance="ButtonAppearance.Default" Title="Move up"
                        Disabled="@(item.Index == 0)" @onclick="() => MoveTask(item.Index, -1)">↑</FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Default" Title="Move down"
                        Disabled="@(item.Index == _session.Observable.Tasks.Count - 1)"
                        @onclick="() => MoveTask(item.Index, 1)">↓</FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Default" Title="Remove"
                        @onclick="() => RemoveTask(item.Index)">✕</FluentButton>
                </div>
            </div>
        </div>;

    protected override void OnInitialized()
    {
        _session = _model.CreateEditSession();
        _session.TransitionObserved += OnTransitionObserved;
        _retryDraft = _model.RetryCount;
        _portDraft = _model.Nested!.Port;
        CaptureBaseline();
    }

    private void Edit(Action edit)
    {
        _editError = null;
        _session.BatchEdit(edit);
    }

    private void OnTransitionObserved(PlaygroundSettings.ChangeSet transition)
    {
        RecordTransition(transition);
    }

    private void RecordTransition(PlaygroundSettings.ChangeSet changes)
    {
        if (changes.IsEmpty)
        {
            return;
        }

        if (!_applyingHistory)
        {
            _undo.Push(changes);
            _redo.Clear();
        }

        AppendChanges(changes);
    }

    private void UpdateRetryCount(int value)
    {
        _retryDraft = value;
        if (value != _model.RetryCount) Edit(() => _session.Observable.RetryCount = value);
    }

    private void UpdatePort(int value)
    {
        _portDraft = value;
        if (value != _model.Nested!.Port) Edit(() => _session.Observable.Nested!.Port = value);
    }

    private void UpdatePoints(TaskObservable task, int value)
    {
        _pointsDrafts[task] = value;
        if (value != task.Points) Edit(() => task.Points = value);
    }

    private void CommitTaskId(TaskObservable task)
    {
        var value = GetIdDraft(task).Trim();
        var index = _session.Observable.Tasks.IndexOf(task);
        if (index < 0)
        {
            _idDrafts.Remove(task);
            _pointsDrafts.Remove(task);
            _taskBaselines.Remove(task);
            return;
        }

        if (string.IsNullOrWhiteSpace(value)
            || _model.Tasks.Any(item => !ReferenceEquals(item, task.Model) && item.Id == value))
        {
            _editError = "Task IDs must be non-empty and unique.";
            _idDrafts[task] = task.Id;
            return;
        }

        if (value != task.Id)
        {
            // The Id is the stable key, so a rename is remove-old plus add-new
            // (never an in-place key mutation): drop the old element and insert
            // its successor with the same values at the same position.
            var title = task.Title;
            var points = task.Points;
            Edit(() =>
            {
                _session.Observable.Tasks.RemoveAt(index);
                _session.Observable.Tasks.InsertModel(index, new PlaygroundTask
                {
                    Id = value,
                    Title = title,
                    Points = points,
                });
            });
            _idDrafts.Remove(task);
            _pointsDrafts.Remove(task);
            _taskBaselines.Remove(task);
        }
    }

    private string GetIdDraft(TaskObservable task) =>
        _idDrafts.TryGetValue(task, out var value) ? value : task.Id;

    private int GetPointsDraft(TaskObservable task) =>
        _pointsDrafts.TryGetValue(task, out var value) ? value : task.Points;

    private void AddTask()
    {
        var existing = _model.Tasks.Select(task => task.Id)
            .Concat(_baselineTasks.Select(task => task.Id))
            .ToHashSet(StringComparer.Ordinal);
        string id;
        do
        {
            id = $"t{Random.Shared.Next(1, 1000)}";
        }
        while (!existing.Add(id));

        Edit(() => _session.Observable.Tasks.AddModel(new PlaygroundTask
        {
            Id = id,
            Title = TaskTitles[Random.Shared.Next(TaskTitles.Length)],
            Points = Random.Shared.Next(1, 100),
        }));
    }

    private void RemoveTask(int index) => Edit(() => _session.Observable.Tasks.RemoveAt(index));

    private void MoveTask(int index, int delta)
    {
        var tasks = _session.Observable.Tasks;
        var target = index + delta;
        if (target < 0 || target >= tasks.Count) return;

        Edit(() =>
        {
            var task = tasks[index];
            tasks.RemoveAt(index);
            tasks.Insert(target, task);
        });
    }

    private Task OnSortableUpdate((int oldIndex, int newIndex) indices)
    {
        var (oldIndex, newIndex) = indices;
        var tasks = _session.Observable.Tasks;
        if (oldIndex == newIndex || oldIndex < 0 || oldIndex >= tasks.Count || newIndex < 0 || newIndex > tasks.Count)
        {
            return Task.CompletedTask;
        }

        Edit(() =>
        {
            var task = tasks[oldIndex];
            tasks.RemoveAt(oldIndex);
            tasks.Insert(Math.Min(newIndex, tasks.Count), task);
        });
        return Task.CompletedTask;
    }

    private bool IsChanged(string property) => property switch
    {
        nameof(PlaygroundSettings.Enabled) => _model.Enabled != _baselineModel.Enabled,
        nameof(PlaygroundSettings.RetryCount) => _model.RetryCount != _baselineModel.RetryCount,
        nameof(PlaygroundSettings.Label) => _model.Label != _baselineModel.Label,
        _ => false,
    };

    private bool IsNestedChanged(string property) => property switch
    {
        nameof(PlaygroundNested.Host) => _model.Nested?.Host != _baselineModel.Nested?.Host,
        nameof(PlaygroundNested.Port) => _model.Nested?.Port != _baselineModel.Nested?.Port,
        _ => false,
    };

    private static RenderFragment ChangedDot(bool changed) => builder =>
    {
        if (changed)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "pg-dot");
            builder.AddAttribute(2, "title", "edited");
            builder.CloseElement();
        }
    };

    private bool IsTaskIdChanged(TaskObservable task) =>
        IsTaskFieldChanged(task, nameof(PlaygroundTask.Id));

    private bool IsTaskFieldChanged(TaskObservable task, string property)
    {
        var baseline = GetTaskBaseline(task);
        if (baseline is null)
        {
            return false;
        }

        return property switch
        {
            nameof(PlaygroundTask.Id) => task.Id != baseline.Id,
            nameof(PlaygroundTask.Title) => task.Title != baseline.Title,
            nameof(PlaygroundTask.Points) => task.Points != baseline.Points,
            _ => false,
        };
    }

    private string TaskRowClass(TaskObservable task, int index)
    {
        var baseline = GetTaskBaseline(task);
        if (baseline is null)
        {
            return "pg-roster-row pg-added";
        }

        return IsTaskMoved(baseline, index) ? "pg-roster-row pg-moved" : "pg-roster-row";
    }

    private PlaygroundTask? GetTaskBaseline(TaskObservable task)
    {
        // Keyed diff is by Id (see docs/keyed-collections.md "Changing an element's
        // identity is remove-old plus add-new"). A cached entry whose Id no longer
        // matches the live task is a renamed identity, so re-resolve by current Id:
        // unknown Id => new item (null), known Id => edit against that key's baseline
        // (covers swap/reuse of a freed Id).
        if (_taskBaselines.TryGetValue(task, out var cached))
        {
            if (string.Equals(cached.Id, task.Id, StringComparison.Ordinal))
            {
                return cached;
            }

            var rebound = _baselineTasks.FirstOrDefault(item => item.Id == task.Id);
            if (rebound is not null)
            {
                _taskBaselines[task] = rebound;
            }
            else
            {
                _taskBaselines.Remove(task);
            }

            return rebound;
        }

        var baseline = _baselineTasks.FirstOrDefault(item => item.Id == task.Id);
        if (baseline is not null)
        {
            _taskBaselines[task] = baseline;
        }

        return baseline;
    }

    private bool IsTaskMoved(PlaygroundTask baseline, int index)
    {
        var baselineIndex = _baselineTasks.IndexOf(baseline);
        if (baselineIndex < 0)
        {
            return false;
        }

        var currentRank = 0;
        for (var i = 0; i < index; i++)
        {
            if (GetTaskBaseline(_session.Observable.Tasks[i]) is not null)
            {
                currentRank++;
            }
        }

        var baselineRank = 0;
        for (var i = 0; i < baselineIndex; i++)
        {
            foreach (var currentTask in _session.Observable.Tasks)
            {
                if (ReferenceEquals(GetTaskBaseline(currentTask), _baselineTasks[i]))
                {
                    baselineRank++;
                    break;
                }
            }
        }

        return currentRank != baselineRank;
    }

    private PlaygroundSettings _baselineModel = null!;
    private readonly Dictionary<TaskObservable, PlaygroundTask> _taskBaselines = [];

    private PlaygroundSettings CloneModel() =>
        JsonSerializer.Deserialize(CurrentJson, PlaygroundJsonContext.Default.PlaygroundSettings)
        ?? throw new JsonException("The current model JSON deserialized to null.");

    private void CaptureBaseline()
    {
        _baselineModel = CloneModel();
        _baselineTasks = _baselineModel.Tasks;
        _taskBaselines.Clear();
        foreach (var task in _session.Observable.Tasks)
        {
            var baselineTask = _baselineTasks.FirstOrDefault(item => item.Id == task.Id);
            if (baselineTask is not null)
            {
                _taskBaselines[task] = baselineTask;
            }
        }

        _baselineJson = PlaygroundJson.WriteModel(_baselineModel);
    }

    private async Task RequestSubmit()
    {
        if (!_session.HasChanges)
        {
            return;
        }

        _submitChanges.Clear();
        _submitChanges.AddRange(BuildSubmitChanges());
        if (_submitDialog is null)
        {
            throw new InvalidOperationException("The submit confirmation dialog is not initialized.");
        }

        _submitDialogHidden = false;
        await _submitDialog.ShowAsync();
    }

    private List<(string Target, string Operation, string Before, string After)> BuildSubmitChanges()
    {
        var changes = new List<(string Target, string Operation, string Before, string After)>();
        var current = _model;
        AddSubmitChange(changes, nameof(PlaygroundSettings.Enabled), "Edit", _baselineModel.Enabled, current.Enabled);
        AddSubmitChange(changes, nameof(PlaygroundSettings.RetryCount), "Edit", _baselineModel.RetryCount, current.RetryCount);
        AddSubmitChange(changes, nameof(PlaygroundSettings.Label), "Edit", _baselineModel.Label, current.Label);
        AddSubmitChange(
            changes,
            $"{nameof(PlaygroundSettings.Nested)}.{nameof(PlaygroundNested.Host)}",
            "Edit",
            _baselineModel.Nested?.Host,
            current.Nested?.Host
        );
        AddSubmitChange(
            changes,
            $"{nameof(PlaygroundSettings.Nested)}.{nameof(PlaygroundNested.Port)}",
            "Edit",
            _baselineModel.Nested?.Port,
            current.Nested?.Port
        );

        var presentBaselines = new HashSet<PlaygroundTask>();
        foreach (var task in _session.Observable.Tasks)
        {
            var currentTask = task.Model;
            var baselineTask = GetTaskBaseline(task);
            if (baselineTask is null)
            {
                changes.Add(($"Tasks[{currentTask.Id}]", "Add", "—", FormatTask(currentTask)));
                continue;
            }

            presentBaselines.Add(baselineTask);
            var target = $"Tasks[{baselineTask.Id}]";
            AddSubmitChange(changes, $"{target}.Id", "Edit", baselineTask.Id, currentTask.Id);
            AddSubmitChange(changes, $"{target}.Title", "Edit", baselineTask.Title, currentTask.Title);
            AddSubmitChange(changes, $"{target}.Points", "Edit", baselineTask.Points, currentTask.Points);
        }

        foreach (var task in _baselineTasks)
        {
            if (!presentBaselines.Contains(task))
            {
                changes.Add(($"Tasks[{task.Id}]", "Remove", FormatTask(task), "—"));
            }
        }

        var beforeOrder = _baselineTasks.Select(static task => task.Id).ToArray();
        var currentTasks = _session.Observable.Tasks;
        var afterOrderIdentity = currentTasks
            .Select(task => GetTaskBaseline(task)?.Id ?? task.Id)
            .ToArray();
        if (!beforeOrder.SequenceEqual(afterOrderIdentity, StringComparer.Ordinal))
        {
            var afterOrder = currentTasks.Select(static task => task.Id);
            changes.Add(("Tasks", "Order", FormatOrder(beforeOrder), FormatOrder(afterOrder)));
        }

        return changes.OrderBy(change => SubmitOperationOrder(change.Operation)).ToList();
    }

    private static int SubmitOperationOrder(string operation) => operation switch
    {
        "Add" => 0,
        "Remove" => 1,
        "Edit" => 2,
        "Order" => 3,
        _ => 4,
    };

    private static void AddSubmitChange<T>(
        List<(string Target, string Operation, string Before, string After)> changes,
        string target,
        string operation,
        T before,
        T after
    )
    {
        if (!EqualityComparer<T>.Default.Equals(before, after))
        {
            changes.Add((target, operation, JsonSerializer.Serialize(before), JsonSerializer.Serialize(after)));
        }
    }

    private static string FormatTask(PlaygroundTask task) =>
        $"{{ Title = {JsonSerializer.Serialize(task.Title)}, Points = {task.Points} }}";

    private static string FormatOrder(IEnumerable<string> ids) => $"[{string.Join(", ", ids)}]";

    private static string ChangeOperationClass(string operation) =>
        $"pg-change-operation pg-change-{operation.ToLowerInvariant()}";

    private async Task CancelSubmit()
    {
        if (_submitDialog is null)
        {
            throw new InvalidOperationException("The submit confirmation dialog is not initialized.");
        }

        _submitDialogHidden = true;
        await _submitDialog.HideAsync();
    }

    private async Task ConfirmSubmit()
    {
        await CancelSubmit();
        try
        {
            _session.AcceptChanges();
            CaptureBaseline();
            ClearHistory();
            _editError = null;
        }
        catch (InvalidOperationException exception)
        {
            _editError = exception.Message;
            return;
        }

        await ShowCompletion("Changes submitted", "The current state is now the baseline. The change history was cleared.");
    }

    private async Task ShowCompletion(string title, string message)
    {
        if (_completionDialog is null)
        {
            throw new InvalidOperationException("The completion dialog is not initialized.");
        }

        _completionTitle = title;
        _completionMessage = message;
        _completionHidden = false;
        await _completionDialog.ShowAsync();
    }

    private async Task CloseCompletion()
    {
        _completionHidden = true;
        if (_completionDialog is null)
        {
            throw new InvalidOperationException("The completion dialog is not initialized.");
        }

        await _completionDialog.HideAsync();
    }

    private async Task Reset()
    {
        try
        {
            _session.RevertChanges();
            _retryDraft = _model.RetryCount;
            _portDraft = _model.Nested!.Port;
            _pointsDrafts.Clear();
            _idDrafts.Clear();
            ClearHistory();
            _editError = null;
        }
        catch (InvalidOperationException exception)
        {
            _editError = exception.Message;
            return;
        }

        await ShowCompletion("Changes reset", "All unsubmitted changes were reverted to the current baseline.");
    }

    private void ClearHistory()
    {
        _undo.Clear();
        _redo.Clear();
        _log.Clear();
    }

    private void Undo()
    {
        if (_undo.Count == 0)
        {
            return;
        }

        var changes = _undo.Peek();
        _applyingHistory = true;
        try { _session.ApplyInPlace(changes.Invert()); }
        finally { _applyingHistory = false; }

        _undo.Pop();
        _redo.Push(changes);
        SyncNumericDrafts();
    }

    private void Redo()
    {
        if (_redo.Count == 0)
        {
            return;
        }

        var changes = _redo.Peek();
        _applyingHistory = true;
        try { _session.ApplyInPlace(changes); }
        finally { _applyingHistory = false; }

        _redo.Pop();
        _undo.Push(changes);
        SyncNumericDrafts();
    }

    private void SyncNumericDrafts()
    {
        _retryDraft = _model.RetryCount;
        _portDraft = _model.Nested!.Port;
        _pointsDrafts.Clear();
        _idDrafts.Clear();
    }

    private void AppendChanges(PlaygroundSettings.ChangeSet changes)
    {
        var entries = changes.EnumerateChanges()
            .Select(static entry => (
                Path: entry.PathText,
                Before: OneLine(FormatValue(entry.Before)),
                After: OneLine(FormatValue(entry.After))
            ))
            .OrderBy(static entry => entry.Path, StringComparer.Ordinal)
            .ToArray();
        if (entries.Length == 0) return;

        var change = string.Join(
            "\n",
            entries.Select(static entry => $"{entry.Path}: {entry.Before} → {entry.After}")
        );
        _log.Insert(0, new LogEntry(DateTimeOffset.Now.ToString("HH:mm:ss"), change));
        if (_log.Count > MaximumLogEntries) _log.RemoveRange(MaximumLogEntries, _log.Count - MaximumLogEntries);
    }

    public void Dispose()
    {
        if (_session is not null)
        {
            _session.TransitionObserved -= OnTransitionObserved;
        }
    }

    private static string OneLine(string value) =>
        value.Replace("\r", "\\r", StringComparison.Ordinal)
            .Replace("\n", "\\n", StringComparison.Ordinal)
            .Replace("\t", "\\t", StringComparison.Ordinal);

    private static string FormatValue(Optional<object?> value)
    {
        if (!value.IsPresent)
        {
            return "(missing)";
        }

        return PlaygroundJson.FormatChangeValue(value.Value);
    }

    private sealed record LogEntry(string Time, string Change);
}
