@using SparseFragments.Playground.Models

<FluentCard Class="pg-fluent-card">
    <div class="pg-card-head">
        <h3>@Title</h3>
        <FluentButton Appearance="Appearance.Accent" Size="Size.Small" @onclick="HandleReset">Reset</FluentButton>
    </div>

    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
        <div class="pg-row">
            <span class="pg-name">Enabled <small>bool</small></span>
            <FluentCheckbox Label="present"
                Value="@State.EnabledPresent"
                ValueChanged="@(async v => { State.EnabledPresent = v; await NotifyAsync(); })" />
            <FluentCheckbox Label="true"
                Value="@State.EnabledValue"
                ValueChanged="@(async v => { State.EnabledValue = v; await NotifyAsync(); })"
                Disabled="@(!State.EnabledPresent)" />
        </div>

        <div class="pg-row">
            <span class="pg-name">RetryCount <small>int</small></span>
            <FluentCheckbox Label="present"
                Value="@State.RetryPresent"
                ValueChanged="@(async v => { State.RetryPresent = v; await NotifyAsync(); })" />
            <FluentNumberField TValue="int"
                Value="@State.RetryValue"
                ValueChanged="@(async v => { State.RetryValue = v; await NotifyAsync(); })"
                Disabled="@(!State.RetryPresent)" />
        </div>

        <div class="pg-row">
            <span class="pg-name">Label <small>string?</small></span>
            <FluentSelect TOption="string"
                Items="@NullPresenceNames"
                OptionValue="@(v => v)"
                OptionText="@(v => LabelText(v))"
                Value="@State.LabelMode.ToString()"
                ValueChanged="@OnLabelModeChanged" />
            <FluentTextField Placeholder="label text"
                Value="@State.LabelValue"
                ValueChanged="@(async v => { State.LabelValue = v; await NotifyAsync(); })"
                Disabled="@(State.LabelMode != NullPresence.Value)" />
        </div>

        <div class="pg-row">
            <span class="pg-name">Nested <small>nested model?</small></span>
            <FluentSelect TOption="string"
                Items="@NullPresenceNames"
                OptionValue="@(v => v)"
                OptionText="@(v => LabelText(v))"
                Value="@State.NestedMode.ToString()"
                ValueChanged="@OnNestedModeChanged" />
        </div>

        @if (State.NestedMode == NullPresence.Value)
        {
            <div class="pg-nested">
                <div class="pg-row">
                    <span class="pg-name">Nested.Host <small>string</small></span>
                    <FluentCheckbox Label="present"
                        Value="@State.HostPresent"
                        ValueChanged="@(async v => { State.HostPresent = v; await NotifyAsync(); })" />
                    <FluentTextField Placeholder="host"
                        Value="@State.HostValue"
                        ValueChanged="@(async v => { State.HostValue = v; await NotifyAsync(); })"
                        Disabled="@(!State.HostPresent)" />
                </div>
                <div class="pg-row">
                    <span class="pg-name">Nested.Port <small>int</small></span>
                    <FluentCheckbox Label="present"
                        Value="@State.PortPresent"
                        ValueChanged="@(async v => { State.PortPresent = v; await NotifyAsync(); })" />
                    <FluentNumberField TValue="int"
                        Value="@State.PortValue"
                        ValueChanged="@(async v => { State.PortValue = v; await NotifyAsync(); })"
                        Disabled="@(!State.PortPresent)" />
                </div>
            </div>
        }

        <div class="pg-row">
            <span class="pg-name">Plugins <small>append list</small></span>
            <FluentCheckbox Label="present"
                Value="@State.PluginsPresent"
                ValueChanged="@(async v => { State.PluginsPresent = v; await NotifyAsync(); })" />
            <FluentTextField Placeholder="comma separated"
                Value="@State.PluginsText"
                ValueChanged="@(async v => { State.PluginsText = v; await NotifyAsync(); })"
                Disabled="@(!State.PluginsPresent)" />
        </div>
    </FluentStack>
</FluentCard>

@code {
    private static readonly List<string> NullPresenceNames = Enum.GetNames<NullPresence>().ToList();

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public FragmentEditState State { get; set; } = null!;

    [Parameter]
    public EventCallback OnReset { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private static string LabelText(string name) => name switch
    {
        nameof(NullPresence.Missing) => "missing (fall through)",
        nameof(NullPresence.Null) => "null (explicit)",
        nameof(NullPresence.Value) => "value",
        _ => name,
    };

    private async Task OnLabelModeChanged(string value)
    {
        if (Enum.TryParse<NullPresence>(value, out var parsed))
        {
            State.LabelMode = parsed;
            await NotifyAsync();
        }
    }

    private async Task OnNestedModeChanged(string value)
    {
        if (Enum.TryParse<NullPresence>(value, out var parsed))
        {
            State.NestedMode = parsed;
            await NotifyAsync();
        }
    }

    private async Task HandleReset()
    {
        await OnReset.InvokeAsync();
        await NotifyAsync();
    }

    private Task NotifyAsync() => OnChanged.InvokeAsync();
}
