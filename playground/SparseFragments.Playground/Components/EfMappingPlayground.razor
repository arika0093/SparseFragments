@using System.Globalization
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@using SparseFragments
@using SparseFragments.EntityFrameworkCore
@using SparseFragments.Playground.Models
@implements IDisposable

<div class="pg-stack">
    <p class="pg-hint">Entity → DTO → edit → ChangeSet → tracked-entity Apply (watch which EF properties turn modified) → SaveChanges → fresh-context re-fetch. The store is EF Core InMemory; integer keys are generated on save, while constraint checks stay covered by the test suite.</p>
    <div class="pg-grid pg-grid-trio pg-grid-trio-wide">
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>1. Entity (tracked)</h3>
                <FluentButton Appearance="ButtonAppearance.Primary" @onclick="Reset">Reseed</FluentButton>
            </div>
            <MonacoView Content="@EntityJson" Language="json" Height="270px" />
        </FluentCard>
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>2. DTO projection</h3>
            </div>
            <MonacoView Content="@BaselineJson" Language="json" Height="270px" />
        </FluentCard>
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>3. Edit draft</h3>
                <FluentButton Appearance="ButtonAppearance.Primary" @onclick="ResetDraft">Reset draft</FluentButton>
            </div>
            <div class="pg-stack pg-edit-fields">
                <div class="pg-row pg-session-field @(IsScalarChanged(nameof(PlaygroundOrderDto.Customer)) ? "pg-changed" : "")">
                    <span class="pg-name notranslate" translate="no">@ChangedDot(IsScalarChanged(nameof(PlaygroundOrderDto.Customer)))Customer <small>string</small></span>
                    <FluentTextInput Style="flex: 1 1 12rem;"
                        Value="@_draft.Customer"
                        ValueChanged="@(v => EditDraft(d => d.Customer = v ?? string.Empty))" />
                </div>
                <div class="pg-row pg-session-field @(IsScalarChanged(nameof(PlaygroundOrderDto.Notes)) ? "pg-changed" : "")">
                    <span class="pg-name notranslate" translate="no">@ChangedDot(IsScalarChanged(nameof(PlaygroundOrderDto.Notes)))Notes <small>string</small></span>
                    <FluentTextInput Style="flex: 1 1 12rem;"
                        Value="@_draft.Notes"
                        ValueChanged="@(v => EditDraft(d => d.Notes = v ?? string.Empty))" />
                </div>
                <div class="pg-row pg-session-field @(IsScalarChanged(nameof(PlaygroundOrderDto.Total)) ? "pg-changed" : "")">
                    <span class="pg-name notranslate" translate="no">@ChangedDot(IsScalarChanged(nameof(PlaygroundOrderDto.Total)))Total <small>decimal</small></span>
                    <FluentNumberInput TValue="decimal" Style="width: 10rem;"
                        Value="@_draft.Total"
                        ValueChanged="@(v => EditDraft(d => d.Total = v))" />
                </div>
            </div>
            <div class="pg-row pg-session-field pg-task-field">
                <span class="pg-name notranslate" translate="no">Lines <small>List&lt;Line&gt;</small></span>
                <FluentButton Appearance="ButtonAppearance.Primary" @onclick="AddLine">Add line</FluentButton>
            </div>
            <div class="pg-task-line-ef" aria-label="New line">
                <div class="pg-roster-field">
                    <span class="pg-mini notranslate" translate="no">Id <small>new</small></span>
                    <FluentTextInput Placeholder="(auto)" Style="width: 100%;" Disabled="true" />
                </div>
                <div class="pg-roster-field">
                    <span class="pg-mini notranslate" translate="no">Sku</span>
                    <FluentTextInput Placeholder="sku" Style="width: 100%;"
                        Value="@_newSku" ValueChanged="@(v => _newSku = v ?? string.Empty)" />
                </div>
                <div class="pg-roster-field">
                    <span class="pg-mini notranslate" translate="no">Product</span>
                    <FluentTextInput Placeholder="product" Style="width: 100%;"
                        Value="@_newProduct" ValueChanged="@(v => _newProduct = v ?? string.Empty)" />
                </div>
                <div class="pg-roster-field">
                    <span class="pg-mini notranslate" translate="no">Qty</span>
                    <FluentNumberInput TValue="int" Style="width: 100%;"
                        Value="@_newQty" ValueChanged="@(v => _newQty = v)" />
                </div>
            </div>
            <SortableList Items="_draft.Lines" Handle=".pg-drag" Class="pg-roster-list"
                OnUpdate="OnLinesReordered" Context="line">
                <SortableItemTemplate>
                    <div class="@LineRowClass(line, _draft.Lines.IndexOf(line)) pg-task-row">
                        <div class="pg-task-line-ef">
                            <div class="pg-roster-field @(IsLineFieldChanged(line, nameof(PlaygroundOrderLineDto.Id)) ? "pg-changed" : "")">
                                <span class="pg-mini notranslate" translate="no">@ChangedDot(IsLineFieldChanged(line, nameof(PlaygroundOrderLineDto.Id)))Id <small>int?</small></span>
                                <FluentNumberInput TValue="int?"
                                    Value="@line.Id"
                                    ValueChanged="@(v => EditDraft(_ => line.Id = v))" />
                            </div>
                            <div class="pg-roster-field @(IsLineFieldChanged(line, nameof(PlaygroundOrderLineDto.Sku)) ? "pg-changed" : "")">
                                <span class="pg-mini notranslate" translate="no">@ChangedDot(IsLineFieldChanged(line, nameof(PlaygroundOrderLineDto.Sku)))Sku</span>
                                <FluentTextInput
                                    Value="@line.Sku"
                                    ValueChanged="@(v => EditDraft(_ => line.Sku = v ?? string.Empty))" />
                            </div>
                            <div class="pg-roster-field @(IsLineFieldChanged(line, nameof(PlaygroundOrderLineDto.Product)) ? "pg-changed" : "")">
                                <span class="pg-mini notranslate" translate="no">@ChangedDot(IsLineFieldChanged(line, nameof(PlaygroundOrderLineDto.Product)))Product</span>
                                <FluentTextInput
                                    Value="@line.Product"
                                    ValueChanged="@(v => EditDraft(_ => line.Product = v ?? string.Empty))" />
                            </div>
                            <div class="pg-roster-field @(IsLineFieldChanged(line, nameof(PlaygroundOrderLineDto.Qty)) ? "pg-changed" : "")">
                                <span class="pg-mini notranslate" translate="no">@ChangedDot(IsLineFieldChanged(line, nameof(PlaygroundOrderLineDto.Qty)))Qty</span>
                                <FluentNumberInput TValue="int"
                                    Value="@line.Qty"
                                    ValueChanged="@(v => EditDraft(_ => line.Qty = v))" />
                            </div>
                            <div class="pg-roster-actions pg-task-actions">
                                <span class="pg-drag sortable-grab" title="Drag to reorder">⠿</span>
                                <FluentButton Appearance="ButtonAppearance.Default" Title="Move up"
                                    Disabled="@(_draft.Lines.IndexOf(line) == 0)"
                                    @onclick="@(() => MoveLine(_draft.Lines.IndexOf(line), -1))">↑</FluentButton>
                                <FluentButton Appearance="ButtonAppearance.Default" Title="Move down"
                                    Disabled="@(_draft.Lines.IndexOf(line) == _draft.Lines.Count - 1)"
                                    @onclick="@(() => MoveLine(_draft.Lines.IndexOf(line), 1))">↓</FluentButton>
                                <FluentButton Appearance="ButtonAppearance.Default" Title="Remove"
                                    @onclick="@(() => EditDraft(d => d.Lines.Remove(line)))">✕</FluentButton>
                            </div>
                        </div>
                    </div>
                </SortableItemTemplate>
            </SortableList>
            <div class="pg-legend pg-session-legend" aria-label="Edit highlight legend">
                <span class="pg-lg"><span class="pg-sw pg-sw-add"></span>added</span>
                <span class="pg-lg"><span class="pg-sw pg-sw-move"></span>moved</span>
                <span class="pg-lg"><span class="pg-dot"></span>edited</span>
            </div>
            <MonacoView Content="@DraftJson" Language="json" Height="200px" />
        </FluentCard>
    </div>
    <div class="pg-grid pg-grid-trio pg-grid-trio-wide">
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>4. ChangeSet</h3>
                <span class="pg-has-changes-badge @(_changes?.IsChanged == true ? "pg-has-changes" : "pg-no-changes")">
                    <span aria-hidden="true"></span>@(_changes?.IsChanged == true ? "Changes" : "No changes")
                </span>
            </div>
            @if (_changesError is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Error">@_changesError</FluentMessageBar>
            }
            else if (_changeRows.Count == 0)
            {
                <p class="pg-hint">No changes.</p>
            }
            else
            {
                <div class="pg-change-table-wrap">
                    <table class="pg-change-table" aria-label="Order ChangeSet">
                        <thead>
                            <tr><th>Operation</th><th>Path</th><th>Before</th><th>After</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _changeRows)
                            {
                                <tr>
                                    <td><span class="@ChangeOperationClass(row.Operation)">@row.Operation</span></td>
                                    <td><span class="pg-change-value">@row.Path</span></td>
                                    <td><span class="pg-change-value">@row.Before</span></td>
                                    <td><span class="pg-change-value">@row.After</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </FluentCard>
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>5. Apply, save &amp; re-fetch</h3>
                <FluentButton Appearance="ButtonAppearance.Primary" Class="pg-submit-button"
                    Disabled="@(_changes?.IsChanged != true)" @onclick="ApplyAndSave">Apply &amp; Save</FluentButton>
            </div>
            @if (_applyError is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Error">@_applyError</FluentMessageBar>
            }
            else if (!_applied)
            {
                <p class="pg-hint">Applies the ChangeSet to the tracked entity, persists with <em>SaveChanges</em>, then re-reads from a fresh context. Untouched properties stay unmodified.</p>
            }
            else
            {
                <div class="pg-change-table-wrap">
                    <table class="pg-change-table" aria-label="Modified EF properties">
                        <thead>
                            <tr><th>Entity</th><th>Operation</th><th>Property</th><th>Before</th><th>After</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _modifiedRows)
                            {
                                <tr>
                                    <td><span class="pg-change-value">@row.Entity</span></td>
                                    <td><span class="@ChangeOperationClass(EfStateOperation(row.State))">@EfStateOperation(row.State)</span></td>
                                    <td><span class="pg-change-value">@row.Property</span></td>
                                    <td><span class="pg-change-value">@row.Before</span></td>
                                    <td><span class="pg-change-value">@row.After</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <MonacoDiffView Original="@_entityJsonBeforeApply" Modified="@EntityJson" Language="json" Height="240px" />
                @if (_saveError is not null)
                {
                    <FluentMessageBar Intent="MessageBarIntent.Error">@_saveError</FluentMessageBar>
                }
                else if (_refetchedJson is not null)
                {
                    <p class="pg-hint">Fresh context, re-read after <em>SaveChanges</em>. Matches the applied state above.</p>
                    <MonacoView Content="@_refetchedJson" Language="json" Height="270px" />
                }
            }
        </FluentCard>
    </div>
</div>

@code {
    private static readonly DbContextOptions<PlaygroundEfContext> SharedOptions =
        new DbContextOptionsBuilder<PlaygroundEfContext>()
            .UseInMemoryDatabase("pg-ef-demo")
            .Options;

    private PlaygroundEfContext? _db;
    private PlaygroundOrderEntity? _tracked;
    private SparseEntityMapper<PlaygroundOrderEntity, PlaygroundOrderDto>? _mapper;
    private PlaygroundOrderDto _baseline = new();
    private PlaygroundOrderDto _draft = new();
    private PlaygroundOrderDto.ChangeSet? _changes;
    private string? _changesError;
    private string? _applyError;
    private string? _saveError;
    private string _newSku = string.Empty;
    private string _newProduct = string.Empty;
    private int _newQty = 1;
    private bool _applied;
    private string _entityJsonBeforeApply = string.Empty;
    private string? _refetchedJson;
    private List<(string Operation, string Path, string Before, string After)> _changeRows = [];
    private List<(string Entity, string State, string Property, string Before, string After)> _modifiedRows = [];

    private string EntityJson => Try(() => _tracked is null ? "{}" : WriteOrderEntity(_tracked));
    private string BaselineJson => Try(WriteBaselineJson);
    private string DraftJson => Try(WriteDraftJson);

    /// <summary>Reseeds the store and resets the whole pipeline. Called by the page too.</summary>
    public void Reset() => Seed();

    protected override void OnInitialized() => Seed();

    public void Dispose() => _db?.Dispose();

    private void Seed()
    {
        _db?.Dispose();
        _db = new PlaygroundEfContext(SharedOptions);
        _db.Database.EnsureDeleted();
        _db.Database.EnsureCreated();
        var seeded = _db.Orders.Add(
            new PlaygroundOrderEntity
            {
                CustomerName = "Cafe Vienna",
                Notes = "first order",
                Total = 13.75m,
                Lines =
                [
                    new PlaygroundOrderLineEntity
                    {
                        Sku = "espresso",
                        Product = "Espresso",
                        Qty = 2,
                        SortOrder = 0,
                    },
                    new PlaygroundOrderLineEntity
                    {
                        Sku = "croissant",
                        Product = "Croissant",
                        Qty = 3,
                        SortOrder = 1,
                    },
                ],
            }
        ).Entity;
        _db.SaveChanges();
        _db.Entry(seeded).Collection(static order => order.Lines).Load();
        _tracked = seeded;
        _mapper = SparseEntityMapper<PlaygroundOrderEntity, PlaygroundOrderDto>.Create(
            new PlaygroundOrderMapper(),
            _db.Model);
        _baseline = Project(_tracked);
        _draft = Clone(_baseline);
        _applied = false;
        _refetchedJson = null;
        _modifiedRows = [];
        _newSku = string.Empty;
        _newProduct = string.Empty;
        _newQty = 1;
        RefreshChanges();
    }

    private void ResetDraft()
    {
        _draft = Clone(_baseline);
        _applied = false;
        _refetchedJson = null;
        _modifiedRows = [];
        RefreshChanges();
    }

    private void EditDraft(Action<PlaygroundOrderDto> edit)
    {
        edit(_draft);
        _applied = false;
        _refetchedJson = null;
        _modifiedRows = [];
        RefreshChanges();
    }

    private void AddLine()
    {
        EditDraft(draft => draft.Lines.Add(
            new PlaygroundOrderLineDto
            {
                Sku = _newSku.Trim(),
                Product = _newProduct.Trim(),
                Qty = _newQty,
                TemporaryId = Guid.NewGuid(),
            }));
        _newSku = string.Empty;
        _newProduct = string.Empty;
        _newQty = 1;
    }

    private void MoveLine(int index, int direction)
    {
        var other = index + direction;
        if (index < 0 || other < 0 || other >= _draft.Lines.Count)
        {
            return;
        }

        EditDraft(draft =>
        {
            (draft.Lines[index], draft.Lines[other]) = (draft.Lines[other], draft.Lines[index]);
        });
    }

    private Task OnLinesReordered((int oldIndex, int newIndex) indices)
    {
        var (oldIndex, newIndex) = indices;
        var lines = _draft.Lines;
        if (oldIndex == newIndex || oldIndex < 0 || oldIndex >= lines.Count || newIndex < 0 || newIndex > lines.Count)
        {
            return Task.CompletedTask;
        }

        EditDraft(draft =>
        {
            var line = draft.Lines[oldIndex];
            draft.Lines.RemoveAt(oldIndex);
            draft.Lines.Insert(Math.Min(newIndex, draft.Lines.Count), line);
        });
        return Task.CompletedTask;
    }

    private static RenderFragment ChangedDot(bool changed) => builder =>
    {
        if (changed)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "pg-dot");
            builder.AddAttribute(2, "title", "edited");
            builder.CloseElement();
        }
    };

    private bool IsScalarChanged(string property) => property switch
    {
        nameof(PlaygroundOrderDto.Customer) => _draft.Customer != _baseline.Customer,
        nameof(PlaygroundOrderDto.Notes) => _draft.Notes != _baseline.Notes,
        nameof(PlaygroundOrderDto.Total) => _draft.Total != _baseline.Total,
        _ => false,
    };

    private PlaygroundOrderLineDto? GetLineBaseline(PlaygroundOrderLineDto line) =>
        line.Id.HasValue
            ? _baseline.Lines.FirstOrDefault(item => item.Id == line.Id)
            : null;

    private bool IsLineFieldChanged(PlaygroundOrderLineDto line, string property)
    {
        var baseline = GetLineBaseline(line);
        if (baseline is null)
        {
            return false;
        }

        return property switch
        {
            nameof(PlaygroundOrderLineDto.Id) => line.Id != baseline.Id,
            nameof(PlaygroundOrderLineDto.Sku) => line.Sku != baseline.Sku,
            nameof(PlaygroundOrderLineDto.Product) => line.Product != baseline.Product,
            nameof(PlaygroundOrderLineDto.Qty) => line.Qty != baseline.Qty,
            _ => false,
        };
    }

    private string LineRowClass(PlaygroundOrderLineDto line, int index)
    {
        var baseline = GetLineBaseline(line);
        if (baseline is null)
        {
            return "pg-roster-row pg-added";
        }

        return IsLineMoved(baseline, index) ? "pg-roster-row pg-moved" : "pg-roster-row";
    }

    private bool IsLineMoved(PlaygroundOrderLineDto baseline, int index)
    {
        var baselineIndex = _baseline.Lines.IndexOf(baseline);
        if (baselineIndex < 0)
        {
            return false;
        }

        var currentRank = 0;
        for (var i = 0; i < index; i++)
        {
            if (GetLineBaseline(_draft.Lines[i]) is not null)
            {
                currentRank++;
            }
        }

        var baselineRank = 0;
        for (var i = 0; i < baselineIndex; i++)
        {
            foreach (var currentLine in _draft.Lines)
            {
                if (ReferenceEquals(GetLineBaseline(currentLine), _baseline.Lines[i]))
                {
                    baselineRank++;
                    break;
                }
            }
        }

        return currentRank != baselineRank;
    }

    private void RefreshChanges()
    {
        _changesError = null;
        _applyError = null;
        _saveError = null;
        var duplicates = _draft
            .Lines.Where(static line => line.Id.HasValue)
            .GroupBy(static line => line.Id!.Value)
            .Where(static group => group.Count() > 1)
            .Select(static group => group.Key.ToString(CultureInfo.InvariantCulture))
            .ToList();
        if (duplicates.Count > 0)
        {
            _changes = null;
            _changeRows = [];
            _changesError = $"Duplicate line Id: {string.Join(", ", duplicates)}. Give each row a unique Id or clear it for a new row.";
            return;
        }

        try
        {
            _changes = _baseline.CreateChangeSet(_draft);
            _changeRows = _changes
                .EnumerateChanges()
                .Select(static change => (
                    Operation: ChangeOperation(change.Kind),
                    Path: change.PathText,
                    Before: FormatChangeValue(change.Before),
                    After: FormatChangeValue(change.After)))
                .ToList();
        }
        catch (Exception ex)
        {
            _changes = null;
            _changeRows = [];
            _changesError = $"{ex.GetType().Name}: {ex.Message}";
        }
    }

    private void ApplyAndSave()
    {
        ApplyChanges();
        if (_applied)
        {
            SaveAndRefetch();
        }
    }

    private void ApplyChanges()
    {
        _applyError = null;
        if (_db is null || _tracked is null || _mapper is null || _changes is null)
        {
            return;
        }

        _entityJsonBeforeApply = EntityJson;
        try
        {
            _mapper.Apply(_db, _tracked, _changes);
            _modifiedRows = CollectModifiedRows(_db);
            // The entity now matches the draft: rebase the pipeline baseline.
            _baseline = Clone(_draft);
            _applied = true;
            RefreshChanges();
        }
        catch (Exception ex)
        {
            _applyError = $"{ex.GetType().Name}: {ex.Message}";
            _applied = false;
            _modifiedRows = [];
        }
    }

    private void SaveAndRefetch()
    {
        _saveError = null;
        if (_db is null || _tracked is null)
        {
            return;
        }

        try
        {
            _db.SaveChanges();
            using var fresh = new PlaygroundEfContext(SharedOptions);
            var reloaded = fresh.Orders
                .Include(static order => order.Lines)
                .Single(order => order.Id == _tracked.Id);
            _refetchedJson = WriteOrderEntity(reloaded);
        }
        catch (Exception ex)
        {
            _saveError = $"{ex.GetType().Name}: {ex.Message}. The tracked graph is left as-is; fix the draft or reseed to recover.";
            _refetchedJson = null;
        }
    }

    private static PlaygroundOrderDto Project(PlaygroundOrderEntity order) =>
        new()
        {
            Customer = order.CustomerName,
            Notes = order.Notes,
            Total = order.Total,
            Lines = order
                .Lines.OrderBy(static line => line.SortOrder)
                .Select(static line => new PlaygroundOrderLineDto
                {
                    Id = line.Id,
                    Sku = line.Sku,
                    Product = line.Product,
                    Qty = line.Qty,
                })
                .ToList(),
        };

    private static PlaygroundOrderDto Clone(PlaygroundOrderDto source) =>
        new()
        {
            Customer = source.Customer,
            Notes = source.Notes,
            Total = source.Total,
            Lines = source
                .Lines.Select(static line => new PlaygroundOrderLineDto
                {
                    Id = line.Id,
                    TemporaryId = line.TemporaryId,
                    Sku = line.Sku,
                    Product = line.Product,
                    Qty = line.Qty,
                })
                .ToList(),
        };

    private static List<(string Entity, string State, string Property, string Before, string After)> CollectModifiedRows(
        PlaygroundEfContext db)
    {
        var rows = new List<(string Entity, string State, string Property, string Before, string After)>();
        foreach (var entry in db.ChangeTracker.Entries())
        {
            if (entry.State is not (EntityState.Added or EntityState.Modified or EntityState.Deleted))
            {
                continue;
            }

            var name = entry.Entity.GetType().Name;
            var key = string.Join(
                ",",
                entry.Properties
                    .Where(static property => property.Metadata.IsPrimaryKey())
                    .Select(static property => FormatValue(property.CurrentValue)));
            if (entry.State == EntityState.Added)
            {
                var values = string.Join(
                    ", ",
                    entry.Properties.Select(static property =>
                        $"{property.Metadata.Name}={FormatValue(property.CurrentValue)}"));
                rows.Add((name, "Added", $"#{key}", "—", values));
                continue;
            }

            if (entry.State == EntityState.Deleted)
            {
                rows.Add((name, "Deleted", $"#{key}", $"#{key}", "—"));
                continue;
            }

            foreach (var property in entry.Properties.Where(static property => property.IsModified))
            {
                rows.Add((
                    name,
                    "Modified",
                    property.Metadata.Name,
                    FormatValue(property.OriginalValue),
                    FormatValue(property.CurrentValue)));
            }
        }

        return rows;
    }

    private string WriteBaselineJson() => WriteOrderDto(_baseline);

    private string WriteDraftJson() => WriteOrderDto(_draft);

    private static string WriteOrderDto(PlaygroundOrderDto dto)
    {
        using var stream = new MemoryStream();
        using (var writer = new Utf8JsonWriter(stream, new JsonWriterOptions { Indented = true }))
        {
            writer.WriteStartObject();
            writer.WriteString("Customer", dto.Customer);
            writer.WriteString("Notes", dto.Notes);
            writer.WriteNumber("Total", dto.Total);
            writer.WriteStartArray("Lines");
            foreach (var line in dto.Lines)
            {
                WriteLineJson(writer, line);
            }

            writer.WriteEndArray();
            writer.WriteEndObject();
        }

        return System.Text.Encoding.UTF8.GetString(stream.ToArray());
    }

    private static void WriteLineJson(Utf8JsonWriter writer, PlaygroundOrderLineDto line)
    {
        writer.WriteStartObject();
        if (line.Id.HasValue)
        {
            writer.WriteNumber("Id", line.Id.Value);
        }
        else
        {
            writer.WriteNull("Id");
        }

        writer.WriteString("Sku", line.Sku);
        writer.WriteString("Product", line.Product);
        writer.WriteNumber("Qty", line.Qty);
        writer.WriteEndObject();
    }

    private static string WriteLineJson(PlaygroundOrderLineDto line)
    {
        using var stream = new MemoryStream();
        using (var writer = new Utf8JsonWriter(stream))
        {
            WriteLineJson(writer, line);
        }

        return System.Text.Encoding.UTF8.GetString(stream.ToArray());
    }

    private static string WriteOrderEntity(PlaygroundOrderEntity order)
    {
        using var stream = new MemoryStream();
        using (var writer = new Utf8JsonWriter(stream, new JsonWriterOptions { Indented = true }))
        {
            writer.WriteStartObject();
            writer.WriteNumber("Id", order.Id);
            writer.WriteString("CustomerName", order.CustomerName);
            writer.WriteString("Notes", order.Notes);
            writer.WriteNumber("Total", order.Total);
            writer.WriteStartArray("Lines");
            foreach (var line in order.Lines.OrderBy(static item => item.SortOrder))
            {
                writer.WriteStartObject();
                writer.WriteNumber("Id", line.Id);
                writer.WriteString("Sku", line.Sku);
                writer.WriteString("Product", line.Product);
                writer.WriteNumber("Qty", line.Qty);
                writer.WriteNumber("SortOrder", line.SortOrder);
                writer.WriteNumber("OrderId", line.OrderId);
                writer.WriteEndObject();
            }

            writer.WriteEndArray();
            writer.WriteEndObject();
        }

        return System.Text.Encoding.UTF8.GetString(stream.ToArray());
    }

    private static string ChangeOperation(PlaygroundOrderDto.ChangeSet.ChangeKind kind) =>
        kind switch
        {
            PlaygroundOrderDto.ChangeSet.ChangeKind.Changed => "Edit",
            PlaygroundOrderDto.ChangeSet.ChangeKind.Added => "Add",
            PlaygroundOrderDto.ChangeSet.ChangeKind.Removed => "Remove",
            PlaygroundOrderDto.ChangeSet.ChangeKind.Order => "Order",
            _ => throw new ArgumentOutOfRangeException(nameof(kind), kind, null),
        };

    private static string ChangeOperationClass(string operation) =>
        $"pg-change-operation pg-change-{operation.ToLowerInvariant()}";

    private static string FormatChangeValue(Optional<object?> value) =>
        value.IsPresent ? FormatValue(value.Value) : "—";

    private static string EfStateOperation(string state) => state switch
    {
        "Added" => "Add",
        "Deleted" => "Remove",
        "Modified" => "Edit",
        _ => state,
    };

    private static string FormatValue(object? value) =>
        value switch
        {
            null => "null",
            string text => text,
            PlaygroundOrderLineDto line => WriteLineJson(line),
            System.Collections.IEnumerable sequence => "["
                + string.Join(
                    ", ",
                    sequence.Cast<object?>().Select(static item => FormatValue(item)))
                + "]",
            IFormattable formattable => formattable.ToString(null, CultureInfo.InvariantCulture),
            _ => value.ToString() ?? "null",
        };

    private static string Try(Func<string> render)
    {
        try
        {
            return render();
        }
        catch (Exception ex)
        {
            return $"Error: {ex.GetType().Name}: {ex.Message}";
        }
    }
}
