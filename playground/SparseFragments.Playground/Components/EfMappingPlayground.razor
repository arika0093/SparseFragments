@using System.Globalization
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@using SparseFragments
@using SparseFragments.EntityFrameworkCore
@using SparseFragments.Playground.Models
@implements IDisposable

<div class="pg-stack">
    <p class="pg-hint">Entity → DTO → edit → ChangeSet → tracked-entity Apply (watch which EF properties turn modified) → SaveChanges → fresh-context re-fetch. The store is EF Core InMemory.</p>
    <div class="pg-grid pg-grid-trio">
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>1. Entity (tracked)</h3>
                <FluentButton Appearance="ButtonAppearance.Primary" @onclick="Reset">Reseed</FluentButton>
            </div>
            <MonacoView Content="@EntityJson" Language="json" Height="270px" />
        </FluentCard>
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>2. DTO projection</h3>
            </div>
            <MonacoView Content="@BaselineJson" Language="json" Height="270px" />
        </FluentCard>
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>3. Edit draft</h3>
                <FluentButton Appearance="ButtonAppearance.Primary" @onclick="ResetDraft">Reset draft</FluentButton>
            </div>
            <div class="pg-stack pg-edit-fields">
                <div class="pg-row pg-session-field">
                    <span class="pg-name notranslate" translate="no">Customer <small>string</small></span>
                    <FluentTextInput Style="flex: 1 1 12rem;"
                        Value="@_draft.Customer"
                        ValueChanged="@(v => EditDraft(d => d.Customer = v ?? string.Empty))" />
                </div>
                <div class="pg-row pg-session-field">
                    <span class="pg-name notranslate" translate="no">Notes <small>string</small></span>
                    <FluentTextInput Style="flex: 1 1 12rem;"
                        Value="@_draft.Notes"
                        ValueChanged="@(v => EditDraft(d => d.Notes = v ?? string.Empty))" />
                </div>
            </div>
            <table class="pg-change-table" aria-label="Draft lines">
                <thead>
                    <tr><th>Sku (key)</th><th>Product</th><th>Qty</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var line in _draft.Lines)
                    {
                        <tr>
                            <td><span class="pg-change-value">@line.Sku</span></td>
                            <td>
                                <FluentTextInput Style="width: 9rem;"
                                    Value="@line.Product"
                                    ValueChanged="@(v => EditDraft(_ => line.Product = v ?? string.Empty))" />
                            </td>
                            <td>
                                <FluentNumberInput TValue="int" Style="width: 5rem;"
                                    Value="@line.Qty"
                                    ValueChanged="@(v => EditDraft(_ => line.Qty = v))" />
                            </td>
                            <td>
                                <FluentButton Appearance="ButtonAppearance.Default" Title="@($"Remove {line.Sku}")"
                                    @onclick="@(() => EditDraft(d => d.Lines.Remove(line)))">Remove</FluentButton>
                            </td>
                        </tr>
                    }
                    <tr>
                        <td>
                            <FluentTextInput Placeholder="sku" Style="width: 7rem;"
                                Value="@_newSku" ValueChanged="@(v => _newSku = v ?? string.Empty)" />
                        </td>
                        <td>
                            <FluentTextInput Placeholder="product" Style="width: 9rem;"
                                Value="@_newProduct" ValueChanged="@(v => _newProduct = v ?? string.Empty)" />
                        </td>
                        <td>
                            <FluentNumberInput TValue="int" Style="width: 5rem;"
                                Value="@_newQty" ValueChanged="@(v => _newQty = v)" />
                        </td>
                        <td>
                            <FluentButton Appearance="ButtonAppearance.Primary" @onclick="AddLine">Add</FluentButton>
                        </td>
                    </tr>
                </tbody>
            </table>
            <MonacoView Content="@DraftJson" Language="json" Height="200px" />
        </FluentCard>
    </div>
    <div class="pg-grid pg-grid-trio">
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>4. ChangeSet</h3>
                <span class="pg-has-changes-badge @(_changes?.IsChanged == true ? "pg-has-changes" : "pg-no-changes")">
                    <span aria-hidden="true"></span>@(_changes?.IsChanged == true ? "Changes" : "No changes")
                </span>
            </div>
            @if (_changesError is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Error">@_changesError</FluentMessageBar>
            }
            else if (_changeRows.Count == 0)
            {
                <p class="pg-hint">No changes.</p>
            }
            else
            {
                <div class="pg-change-table-wrap">
                    <table class="pg-change-table" aria-label="Order ChangeSet">
                        <thead>
                            <tr><th>Operation</th><th>Path</th><th>Before</th><th>After</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _changeRows)
                            {
                                <tr>
                                    <td><span class="@ChangeOperationClass(row.Operation)">@row.Operation</span></td>
                                    <td><span class="pg-change-value">@row.Path</span></td>
                                    <td><span class="pg-change-value">@row.Before</span></td>
                                    <td><span class="pg-change-value">@row.After</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </FluentCard>
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>5. Apply → modified EF properties</h3>
                <FluentButton Appearance="ButtonAppearance.Primary"
                    Disabled="@(_changes?.IsChanged != true)" @onclick="ApplyChanges">Apply</FluentButton>
            </div>
            @if (_applyError is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Error">@_applyError</FluentMessageBar>
            }
            else if (_modifiedRows.Count == 0)
            {
                <p class="pg-hint">Apply the ChangeSet to see exactly which tracked properties turn modified. Untouched properties stay unmodified.</p>
            }
            else
            {
                <div class="pg-change-table-wrap">
                    <table class="pg-change-table" aria-label="Modified EF properties">
                        <thead>
                            <tr><th>Entity</th><th>State</th><th>Property</th><th>Before</th><th>After</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _modifiedRows)
                            {
                                <tr>
                                    <td><span class="pg-change-value">@row.Entity</span></td>
                                    <td><span class="@ChangeOperationClass(row.State)">@row.State</span></td>
                                    <td><span class="pg-change-value">@row.Property</span></td>
                                    <td><span class="pg-change-value">@row.Before</span></td>
                                    <td><span class="pg-change-value">@row.After</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <MonacoDiffView Original="@_entityJsonBeforeApply" Modified="@EntityJson" Language="json" Height="240px" />
            }
        </FluentCard>
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>6. Save &amp; re-fetch</h3>
                <FluentButton Appearance="ButtonAppearance.Primary"
                    Disabled="@(!_applied)" @onclick="SaveAndRefetch">Save &amp; re-fetch</FluentButton>
            </div>
            @if (_saveError is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Error">@_saveError</FluentMessageBar>
            }
            else if (_refetchedJson is null)
            {
                <p class="pg-hint">Saves with a fresh context over the same InMemory store, then re-reads the order from the database.</p>
            }
            else
            {
                <p class="pg-hint">Fresh context, re-read after <em>SaveChanges</em>. Matches the applied state above.</p>
                <MonacoView Content="@_refetchedJson" Language="json" Height="270px" />
            }
        </FluentCard>
    </div>
</div>

@code {
    private static readonly DbContextOptions<PlaygroundEfContext> SharedOptions =
        new DbContextOptionsBuilder<PlaygroundEfContext>()
            .UseInMemoryDatabase("pg-ef-demo")
            .Options;

    private PlaygroundEfContext? _db;
    private PlaygroundOrderEntity? _tracked;
    private SparseEntityMapper<PlaygroundOrderEntity, PlaygroundOrderDto>? _mapper;
    private PlaygroundOrderDto _baseline = new();
    private PlaygroundOrderDto _draft = new();
    private PlaygroundOrderDto.ChangeSet? _changes;
    private string? _changesError;
    private string? _applyError;
    private string? _saveError;
    private string _newSku = string.Empty;
    private string _newProduct = string.Empty;
    private int _newQty = 1;
    private bool _applied;
    private string _entityJsonBeforeApply = string.Empty;
    private string? _refetchedJson;
    private List<(string Operation, string Path, string Before, string After)> _changeRows = [];
    private List<(string Entity, string State, string Property, string Before, string After)> _modifiedRows = [];

    private string EntityJson => Try(() => _tracked is null ? "{}" : WriteOrderEntity(_tracked));
    private string BaselineJson => Try(WriteBaselineJson);
    private string DraftJson => Try(WriteDraftJson);

    /// <summary>Reseeds the store and resets the whole pipeline. Called by the page too.</summary>
    public void Reset() => Seed();

    protected override void OnInitialized() => Seed();

    public void Dispose() => _db?.Dispose();

    private void Seed()
    {
        _db?.Dispose();
        _db = new PlaygroundEfContext(SharedOptions);
        _db.Database.EnsureDeleted();
        _db.Database.EnsureCreated();
        var seeded = _db.Orders.Add(
            new PlaygroundOrderEntity
            {
                CustomerName = "Cafe Vienna",
                Notes = "first order",
                Lines =
                [
                    new PlaygroundOrderLineEntity { Sku = "espresso", Product = "Espresso", Qty = 2 },
                    new PlaygroundOrderLineEntity { Sku = "croissant", Product = "Croissant", Qty = 3 },
                ],
            }
        ).Entity;
        _db.SaveChanges();
        _db.Entry(seeded).Collection(static order => order.Lines).Load();
        _tracked = seeded;
        _mapper = SparseEntityMapper<PlaygroundOrderEntity, PlaygroundOrderDto>.Create(
            new PlaygroundOrderMapper(),
            _db.Model);
        _baseline = Project(_tracked);
        _draft = Clone(_baseline);
        _applied = false;
        _refetchedJson = null;
        _modifiedRows = [];
        _newSku = string.Empty;
        _newProduct = string.Empty;
        _newQty = 1;
        RefreshChanges();
    }

    private void ResetDraft()
    {
        _draft = Clone(_baseline);
        _applied = false;
        _refetchedJson = null;
        _modifiedRows = [];
        RefreshChanges();
    }

    private void EditDraft(Action<PlaygroundOrderDto> edit)
    {
        edit(_draft);
        _applied = false;
        _refetchedJson = null;
        _modifiedRows = [];
        RefreshChanges();
    }

    private void AddLine()
    {
        EditDraft(draft => draft.Lines.Add(
            new PlaygroundOrderLineDto { Sku = _newSku.Trim(), Product = _newProduct.Trim(), Qty = _newQty }));
        _newSku = string.Empty;
        _newProduct = string.Empty;
        _newQty = 1;
    }

    private void RefreshChanges()
    {
        _changesError = null;
        _applyError = null;
        _saveError = null;
        try
        {
            _changes = _baseline.CreateChangeSet(_draft);
            _changeRows = _changes
                .EnumerateChanges()
                .Select(static change => (
                    Operation: ChangeOperation(change.Kind),
                    Path: change.PathText,
                    Before: FormatChangeValue(change.Before),
                    After: FormatChangeValue(change.After)))
                .ToList();
        }
        catch (Exception ex)
        {
            _changes = null;
            _changeRows = [];
            _changesError = $"{ex.GetType().Name}: {ex.Message}";
        }
    }

    private void ApplyChanges()
    {
        _applyError = null;
        if (_db is null || _tracked is null || _mapper is null || _changes is null)
        {
            return;
        }

        _entityJsonBeforeApply = EntityJson;
        try
        {
            _mapper.Apply(_db, _tracked, _changes);
            _modifiedRows = CollectModifiedRows(_db);
            // The entity now matches the draft: rebase the pipeline baseline.
            _baseline = Clone(_draft);
            _applied = true;
            RefreshChanges();
        }
        catch (Exception ex)
        {
            _applyError = $"{ex.GetType().Name}: {ex.Message}";
        }
    }

    private void SaveAndRefetch()
    {
        _saveError = null;
        if (_db is null || _tracked is null)
        {
            return;
        }

        try
        {
            _db.SaveChanges();
            using var fresh = new PlaygroundEfContext(SharedOptions);
            var reloaded = fresh.Orders
                .Include(static order => order.Lines)
                .Single(order => order.Id == _tracked.Id);
            _refetchedJson = WriteOrderEntity(reloaded);
        }
        catch (Exception ex)
        {
            _saveError = $"{ex.GetType().Name}: {ex.Message}";
        }
    }

    private static PlaygroundOrderDto Project(PlaygroundOrderEntity order) =>
        new()
        {
            Customer = order.CustomerName,
            Notes = order.Notes,
            Lines = order
                .Lines.OrderBy(static line => line.Id)
                .Select(static line => new PlaygroundOrderLineDto
                {
                    Sku = line.Sku,
                    Product = line.Product,
                    Qty = line.Qty,
                })
                .ToList(),
        };

    private static PlaygroundOrderDto Clone(PlaygroundOrderDto source) =>
        new()
        {
            Customer = source.Customer,
            Notes = source.Notes,
            Lines = source
                .Lines.Select(static line => new PlaygroundOrderLineDto
                {
                    Sku = line.Sku,
                    Product = line.Product,
                    Qty = line.Qty,
                })
                .ToList(),
        };

    private static List<(string Entity, string State, string Property, string Before, string After)> CollectModifiedRows(
        PlaygroundEfContext db)
    {
        var rows = new List<(string Entity, string State, string Property, string Before, string After)>();
        foreach (var entry in db.ChangeTracker.Entries())
        {
            if (entry.State is not (EntityState.Added or EntityState.Modified or EntityState.Deleted))
            {
                continue;
            }

            var name = entry.Entity.GetType().Name;
            var key = string.Join(
                ",",
                entry.Properties
                    .Where(static property => property.Metadata.IsPrimaryKey())
                    .Select(static property => FormatValue(property.CurrentValue)));
            if (entry.State == EntityState.Added)
            {
                var values = string.Join(
                    ", ",
                    entry.Properties.Select(static property =>
                        $"{property.Metadata.Name}={FormatValue(property.CurrentValue)}"));
                rows.Add((name, "Added", $"#{key}", "—", values));
                continue;
            }

            if (entry.State == EntityState.Deleted)
            {
                rows.Add((name, "Deleted", $"#{key}", $"#{key}", "—"));
                continue;
            }

            foreach (var property in entry.Properties.Where(static property => property.IsModified))
            {
                rows.Add((
                    name,
                    "Modified",
                    property.Metadata.Name,
                    FormatValue(property.OriginalValue),
                    FormatValue(property.CurrentValue)));
            }
        }

        return rows;
    }

    private string WriteBaselineJson() => WriteOrderDto(_baseline);

    private string WriteDraftJson() => WriteOrderDto(_draft);

    private static string WriteOrderDto(PlaygroundOrderDto dto)
    {
        using var stream = new MemoryStream();
        using (var writer = new Utf8JsonWriter(stream, new JsonWriterOptions { Indented = true }))
        {
            writer.WriteStartObject();
            writer.WriteString("Customer", dto.Customer);
            writer.WriteString("Notes", dto.Notes);
            writer.WriteStartArray("Lines");
            foreach (var line in dto.Lines)
            {
                writer.WriteStartObject();
                writer.WriteString("Sku", line.Sku);
                writer.WriteString("Product", line.Product);
                writer.WriteNumber("Qty", line.Qty);
                writer.WriteEndObject();
            }

            writer.WriteEndArray();
            writer.WriteEndObject();
        }

        return System.Text.Encoding.UTF8.GetString(stream.ToArray());
    }

    private static string WriteOrderEntity(PlaygroundOrderEntity order)
    {
        using var stream = new MemoryStream();
        using (var writer = new Utf8JsonWriter(stream, new JsonWriterOptions { Indented = true }))
        {
            writer.WriteStartObject();
            writer.WriteNumber("Id", order.Id);
            writer.WriteString("CustomerName", order.CustomerName);
            writer.WriteString("Notes", order.Notes);
            writer.WriteStartArray("Lines");
            foreach (var line in order.Lines.OrderBy(static item => item.Id))
            {
                writer.WriteStartObject();
                writer.WriteNumber("Id", line.Id);
                writer.WriteString("Sku", line.Sku);
                writer.WriteString("Product", line.Product);
                writer.WriteNumber("Qty", line.Qty);
                writer.WriteNumber("OrderId", line.OrderId);
                writer.WriteEndObject();
            }

            writer.WriteEndArray();
            writer.WriteEndObject();
        }

        return System.Text.Encoding.UTF8.GetString(stream.ToArray());
    }

    private static string ChangeOperation(PlaygroundOrderDto.ChangeSet.ChangeKind kind) =>
        kind switch
        {
            PlaygroundOrderDto.ChangeSet.ChangeKind.Changed => "Edit",
            PlaygroundOrderDto.ChangeSet.ChangeKind.Added => "Add",
            PlaygroundOrderDto.ChangeSet.ChangeKind.Removed => "Remove",
            PlaygroundOrderDto.ChangeSet.ChangeKind.Order => "Order",
            _ => throw new ArgumentOutOfRangeException(nameof(kind), kind, null),
        };

    private static string ChangeOperationClass(string operation) =>
        $"pg-change-operation pg-change-{operation.ToLowerInvariant()}";

    private static string FormatChangeValue(Optional<object?> value) =>
        value.IsPresent ? FormatValue(value.Value) : "—";

    private static string FormatValue(object? value) =>
        value switch
        {
            null => "null",
            string text => text,
            IFormattable formattable => formattable.ToString(null, CultureInfo.InvariantCulture),
            _ => value.ToString() ?? "null",
        };

    private static string Try(Func<string> render)
    {
        try
        {
            return render();
        }
        catch (Exception ex)
        {
            return $"Error: {ex.GetType().Name}: {ex.Message}";
        }
    }
}
