@* Prev/Next pager for the per-case pages. *@
<nav class="pg-pager" aria-label="Sample pages">
    @if (PrevHref is not null)
    {
        <FluentAnchorButton Appearance="ButtonAppearance.Primary" Href="@PrevHref">← @PrevLabel</FluentAnchorButton>
    }
    else
    {
        <span></span>
    }
    @if (NextHref is not null)
    {
        <FluentAnchorButton Appearance="ButtonAppearance.Primary" Href="@NextHref">@NextLabel →</FluentAnchorButton>
    }
    else
    {
        <span></span>
    }
</nav>

@code {
    [Parameter]
    public string? PrevHref { get; set; }

    [Parameter]
    public string? PrevLabel { get; set; }

    [Parameter]
    public string? NextHref { get; set; }

    [Parameter]
    public string? NextLabel { get; set; }
}
