@using SparseFragments.Playground.Models

<FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
    @if (AllowReorder)
    {
        <SortableList Items="Model.Quests" Handle=".pg-drag" Class="pg-roster-list"
            GhostClass="pg-sort-ghost" ChosenClass="pg-sort-chosen"
            OnUpdate="OnSortableUpdate" Context="quest">
            <SortableItemTemplate>
                @RowFragment((quest, Model.Quests.IndexOf(quest)))
            </SortableItemTemplate>
        </SortableList>
    }
    else
    {
        <div class="pg-roster-list">
        @for (var i = 0; i < Model.Quests.Count; i++)
        {
            @RowFragment((Model.Quests[i], i))
        }
        </div>
    }
    <div>
        <FluentButton Appearance="Appearance.Accent" Size="Size.Small" @onclick="AddAsync">Add quest</FluentButton>
    </div>
</FluentStack>

@code {
    private static readonly string[] RandomTitles =
        ["Raid", "Arena", "Trial", "Hunt", "Siege", "Expedition", "Duel", "Patrol"];

    [Parameter, EditorRequired]
    public PlaygroundRoster Model { get; set; } = null!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public IReadOnlyDictionary<PlaygroundQuest, RosterRowHighlight>? Highlights { get; set; }

    /// <summary>Gets or sets whether reorder controls (handle, up/down) are shown.</summary>
    [Parameter]
    public bool AllowReorder { get; set; } = true;

    /// <summary>Gets or sets whether edit highlights are shown.</summary>
    [Parameter]
    public bool ShowHighlights { get; set; } = true;

    /// <summary>Gets or sets whether only removed rows are highlighted.</summary>
    [Parameter]
    public bool RemovedOnly { get; set; }

    private RenderFragment<(PlaygroundQuest Quest, int Index)> RowFragment => item =>
        @<div class="@RowClass(GetHighlight(item.Quest))">
            <div class="pg-rline1">
                <div class="pg-roster-field">
                    <span class="pg-mini notranslate" translate="no">Id <small>key</small></span>
                    <FluentTextField Placeholder="id" Style="width: 100%;"
                        Value="@item.Quest.Id"
                        ValueChanged="@(async v => { item.Quest.Id = v; await NotifyAsync(); })" />
                </div>
                <div class="pg-roster-field @(GetHighlight(item.Quest)?.TitleChanged == true ? "pg-changed" : "")">
                    <span class="pg-mini notranslate" translate="no">@TitleDot(GetHighlight(item.Quest)?.TitleChanged == true)Title</span>
                    <FluentTextField Placeholder="title" Style="width: 100%;"
                        Value="@item.Quest.Title"
                        ValueChanged="@(async v => { item.Quest.Title = v; await NotifyAsync(); })" />
                </div>
                <div class="pg-roster-field @(GetHighlight(item.Quest)?.PointsChanged == true ? "pg-changed" : "")">
                    <span class="pg-mini notranslate" translate="no">@TitleDot(GetHighlight(item.Quest)?.PointsChanged == true)Points</span>
                    <FluentNumberField TValue="int" Style="width: 100%;"
                        Value="@item.Quest.Points"
                        ValueChanged="@(async v => { item.Quest.Points = v; await NotifyAsync(); })" />
                </div>
            </div>
            <div class="pg-rline2">
                <div class="pg-roster-field @(GetHighlight(item.Quest)?.ScoresChanged == true ? "pg-changed" : "")">
                    <span class="pg-mini notranslate" translate="no">@TitleDot(GetHighlight(item.Quest)?.ScoresChanged == true)Scores <small>List&lt;int&gt; whole</small></span>
                    <IntListField Placeholder="10, 20" Style="width: 100%;"
                        Value="@item.Quest.Scores"
                        ValueChanged="@(async v => { item.Quest.Scores = v; await NotifyAsync(); })" />
                </div>
                <div class="pg-roster-field">
                    <span class="pg-mini notranslate" translate="no">Order</span>
                    <div class="pg-order @(GetHighlight(item.Quest)?.Moved == true ? "pg-moved-num" : "")" title="Position in this list">@(item.Index + 1)</div>
                </div>
                <div class="pg-roster-actions">
                    @if (AllowReorder)
                    {
                        <span class="pg-drag" title="Drag to reorder">⠿</span>
                        <FluentButton Appearance="Appearance.Neutral" Size="Size.Small" Title="Move up" Disabled="@(item.Index == 0)" @onclick="@(async () => await MoveAsync(item.Index, -1))">↑</FluentButton>
                        <FluentButton Appearance="Appearance.Neutral" Size="Size.Small" Title="Move down" Disabled="@(item.Index == Model.Quests.Count - 1)" @onclick="@(async () => await MoveAsync(item.Index, 1))">↓</FluentButton>
                    }
                    <FluentButton Appearance="Appearance.Neutral" Size="Size.Small" Title="Remove" @onclick="@(async () => await RemoveAsync(item.Index))">✕</FluentButton>
                </div>
            </div>
        </div>;

    private Task OnSortableUpdate((int oldIndex, int newIndex) indices)
    {
        var (oldIndex, newIndex) = indices;
        if (oldIndex == newIndex
            || oldIndex < 0
            || oldIndex >= Model.Quests.Count
            || newIndex < 0
            || newIndex > Model.Quests.Count)
        {
            return Task.CompletedTask;
        }
        var item = Model.Quests[oldIndex];
        Model.Quests.RemoveAt(oldIndex);
        if (newIndex < Model.Quests.Count)
        {
            Model.Quests.Insert(newIndex, item);
        }
        else
        {
            Model.Quests.Add(item);
        }
        return NotifyAsync();
    }

    private RosterRowHighlight? GetHighlight(PlaygroundQuest quest)
    {
        if (!ShowHighlights
            || Highlights is null
            || !Highlights.TryGetValue(quest, out var highlight))
        {
            return null;
        }
        if (RemovedOnly && !highlight.IsRemoved)
        {
            return null;
        }
        return highlight;
    }

    private static string RowClass(RosterRowHighlight? highlight)
    {
        var cls = "pg-roster-row";
        if (highlight?.IsAdded == true)
        {
            cls += " pg-added";
        }
        if (highlight?.IsRemoved == true)
        {
            cls += " pg-removed";
        }
        if (highlight is not null && !highlight.IsAdded && !highlight.IsRemoved && highlight.Moved)
        {
            cls += " pg-moved";
        }
        return cls;
    }

    private static RenderFragment TitleDot(bool changed) => builder =>
    {
        if (changed)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "pg-dot");
            builder.AddAttribute(2, "title", "edited");
            builder.CloseElement();
        }
    };

    private Task AddAsync()
    {
        var existing = new HashSet<string>(Model.Quests.Select(q => q.Id));
        string id;
        do
        {
            id = $"q{Random.Shared.Next(1, 100)}";
        }
        while (!existing.Add(id));
        var scoreCount = Random.Shared.Next(0, 3);
        var scores = Enumerable.Range(0, scoreCount)
            .Select(_ => Random.Shared.Next(0, 100))
            .ToList();
        Model.Quests.Add(new PlaygroundQuest
        {
            Id = id,
            Title = RandomTitles[Random.Shared.Next(RandomTitles.Length)],
            Points = Random.Shared.Next(0, 100),
            Scores = scores,
        });
        return NotifyAsync();
    }

    private Task RemoveAsync(int index)
    {
        Model.Quests.RemoveAt(index);
        return NotifyAsync();
    }

    private Task MoveAsync(int index, int delta)
    {
        var target = index + delta;
        if (target < 0 || target >= Model.Quests.Count)
        {
            return Task.CompletedTask;
        }
        (Model.Quests[target], Model.Quests[index]) = (Model.Quests[index], Model.Quests[target]);
        return NotifyAsync();
    }

    private Task NotifyAsync() => OnChanged.InvokeAsync();
}
