@using SparseFragments.Playground.Models

<FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
    @if (AllowReorder)
    {
        <SortableList Items="State.Rows" Handle=".pg-drag" Class="pg-roster-list"
            GhostClass="pg-sort-ghost" ChosenClass="pg-sort-chosen"
            OnUpdate="OnSortableUpdate" Context="row">
            <SortableItemTemplate>
                @RowFragment((row, State.Rows.IndexOf(row)))
            </SortableItemTemplate>
        </SortableList>
    }
    else
    {
        <div class="pg-roster-list">
        @for (var i = 0; i < State.Rows.Count; i++)
        {
            @RowFragment((State.Rows[i], i))
        }
        </div>
    }
    <div>
        <FluentButton Appearance="Appearance.Accent" Size="Size.Small" @onclick="AddAsync">Add quest</FluentButton>
    </div>
</FluentStack>

@code {
    private static readonly string[] RandomTitles =
        ["Raid", "Arena", "Trial", "Hunt", "Siege", "Expedition", "Duel", "Patrol"];

    [Parameter, EditorRequired]
    public RosterEditState State { get; set; } = null!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public IReadOnlyDictionary<QuestRow, RosterRowHighlight>? Highlights { get; set; }

    /// <summary>Gets or sets whether reorder controls (handle, up/down) are shown.</summary>
    [Parameter]
    public bool AllowReorder { get; set; } = true;

    /// <summary>Gets or sets whether edit highlights are shown.</summary>
    [Parameter]
    public bool ShowHighlights { get; set; } = true;

    private RenderFragment<(QuestRow Row, int Index)> RowFragment => item =>
        @<div class="@RowClass(GetHighlight(item.Row))">
            <div class="pg-rline1">
                <div class="pg-roster-field">
                    <span class="pg-mini notranslate" translate="no">Id <small>key</small></span>
                    <FluentTextField Placeholder="id" Style="width: 100%;"
                        Value="@item.Row.Id"
                        ValueChanged="@(async v => { item.Row.Id = v; await NotifyAsync(); })" />
                </div>
                <div class="pg-roster-field @(GetHighlight(item.Row)?.TitleChanged == true ? "pg-changed" : "")">
                    <span class="pg-mini notranslate" translate="no">@TitleDot(GetHighlight(item.Row)?.TitleChanged == true)Title</span>
                    <FluentTextField Placeholder="title" Style="width: 100%;"
                        Value="@item.Row.Title"
                        ValueChanged="@(async v => { item.Row.Title = v; await NotifyAsync(); })" />
                </div>
                <div class="pg-roster-field @(GetHighlight(item.Row)?.PointsChanged == true ? "pg-changed" : "")">
                    <span class="pg-mini notranslate" translate="no">@TitleDot(GetHighlight(item.Row)?.PointsChanged == true)Points</span>
                    <FluentNumberField TValue="int" Style="width: 100%;"
                        Value="@item.Row.Points"
                        ValueChanged="@(async v => { item.Row.Points = v; await NotifyAsync(); })" />
                </div>
            </div>
            <div class="pg-rline2">
                <div class="pg-roster-field @(GetHighlight(item.Row)?.ScoresChanged == true ? "pg-changed" : "")">
                    <span class="pg-mini notranslate" translate="no">@TitleDot(GetHighlight(item.Row)?.ScoresChanged == true)Scores <small>List&lt;int&gt; whole</small></span>
                    <FluentTextField Placeholder="10, 20" Style="width: 100%;"
                        Value="@item.Row.ScoresText"
                        ValueChanged="@(async v => { item.Row.ScoresText = v; await NotifyAsync(); })" />
                </div>
                <div class="pg-roster-field">
                    <span class="pg-mini notranslate" translate="no">Order</span>
                    <div class="pg-order @(GetHighlight(item.Row)?.Moved == true ? "pg-moved-num" : "")" title="Position in this list">@(item.Index + 1)</div>
                </div>
                <div class="pg-roster-actions">
                    @if (AllowReorder)
                    {
                        <span class="pg-drag" title="Drag to reorder">⠿</span>
                        <FluentButton Appearance="Appearance.Neutral" Size="Size.Small" Title="Move up" Disabled="@(item.Index == 0)" @onclick="@(async () => await MoveAsync(item.Index, -1))">↑</FluentButton>
                        <FluentButton Appearance="Appearance.Neutral" Size="Size.Small" Title="Move down" Disabled="@(item.Index == State.Rows.Count - 1)" @onclick="@(async () => await MoveAsync(item.Index, 1))">↓</FluentButton>
                    }
                    <FluentButton Appearance="Appearance.Neutral" Size="Size.Small" Title="Remove" @onclick="@(async () => await RemoveAsync(item.Index))">✕</FluentButton>
                </div>
            </div>
        </div>;

    private Task OnSortableUpdate((int oldIndex, int newIndex) indices)
    {
        var (oldIndex, newIndex) = indices;
        if (oldIndex == newIndex
            || oldIndex < 0
            || oldIndex >= State.Rows.Count
            || newIndex < 0
            || newIndex > State.Rows.Count)
        {
            return Task.CompletedTask;
        }
        var item = State.Rows[oldIndex];
        State.Rows.RemoveAt(oldIndex);
        if (newIndex < State.Rows.Count)
        {
            State.Rows.Insert(newIndex, item);
        }
        else
        {
            State.Rows.Add(item);
        }
        return NotifyAsync();
    }

    private RosterRowHighlight? GetHighlight(QuestRow row) =>
        ShowHighlights && Highlights is not null && Highlights.TryGetValue(row, out var highlight)
            ? highlight
            : null;

    private static string RowClass(RosterRowHighlight? highlight)
    {
        var cls = "pg-roster-row";
        if (highlight?.IsAdded == true)
        {
            cls += " pg-added";
        }
        if (highlight?.IsRemoved == true)
        {
            cls += " pg-removed";
        }
        if (highlight is not null && !highlight.IsAdded && !highlight.IsRemoved && highlight.Moved)
        {
            cls += " pg-moved";
        }
        return cls;
    }

    private static RenderFragment TitleDot(bool changed) => builder =>
    {
        if (changed)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "pg-dot");
            builder.AddAttribute(2, "title", "edited");
            builder.CloseElement();
        }
    };

    private Task AddAsync()
    {
        var existing = new HashSet<string>(State.Rows.Select(r => r.Id));
        string id;
        do
        {
            id = $"q{Random.Shared.Next(1, 100)}";
        }
        while (!existing.Add(id));
        var scoreCount = Random.Shared.Next(0, 3);
        var scores = string.Join(
            ", ",
            Enumerable.Range(0, scoreCount).Select(_ => Random.Shared.Next(0, 100)));
        State.Rows.Add(new QuestRow
        {
            Id = id,
            Title = RandomTitles[Random.Shared.Next(RandomTitles.Length)],
            Points = Random.Shared.Next(0, 100),
            ScoresText = scores,
        });
        return NotifyAsync();
    }

    private Task RemoveAsync(int index)
    {
        State.Rows.RemoveAt(index);
        return NotifyAsync();
    }

    private Task MoveAsync(int index, int delta)
    {
        var target = index + delta;
        if (target < 0 || target >= State.Rows.Count)
        {
            return Task.CompletedTask;
        }
        (State.Rows[target], State.Rows[index]) = (State.Rows[index], State.Rows[target]);
        return NotifyAsync();
    }

    private Task NotifyAsync() => OnChanged.InvokeAsync();
}
