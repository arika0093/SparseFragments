@using SparseFragments
@using SparseFragments.Playground.Models

@{
    var change = GetRowChange();
}

<div class="@RowClass(change)">
    <div class="pg-rline1">
        <div class="pg-roster-field">
            <span class="pg-mini notranslate" translate="no">Id <small>key</small></span>
            <FluentTextInput Placeholder="id" Style="width: 100%"
                Value="@Quest.Id"
                ValueChanged="@(async value => { Quest.Id = value; await NotifyAsync(); })" />
        </div>
        <div class="pg-roster-field @(TitleChanged ? "pg-changed" : "")">
            <span class="pg-mini notranslate" translate="no">
                @if (TitleChanged)
                {
                    <span class="pg-dot" title="edited"></span>
                }
                Title
            </span>
            <FluentTextInput Placeholder="title" Style="width: 100%"
                Value="@Quest.Title"
                ValueChanged="@(async value => { Quest.Title = value; await NotifyAsync(); })" />
        </div>
        <div class="pg-roster-field @(PointsChanged ? "pg-changed" : "")">
            <span class="pg-mini notranslate" translate="no">
                @if (PointsChanged)
                {
                    <span class="pg-dot" title="edited"></span>
                }
                Points
            </span>
            <FluentNumberInput TValue="int" Style="width: 100%"
                Value="@Quest.Points"
                ValueChanged="@(async value => { Quest.Points = value; await NotifyAsync(); })" />
        </div>
    </div>
    <div class="pg-rline2">
        <div class="pg-roster-field @(ScoresChanged ? "pg-changed" : "")">
            <span class="pg-mini notranslate" translate="no">
                @if (ScoresChanged)
                {
                    <span class="pg-dot" title="edited"></span>
                }
                Scores <small>List&lt;int&gt; whole</small>
            </span>
            <IntListField Placeholder="10, 20" Style="width: 100%"
                Value="@Quest.Scores"
                ValueChanged="@(async value => { Quest.Scores = value; await NotifyAsync(); })" />
        </div>
        <div class="pg-roster-field">
            <span class="pg-mini notranslate" translate="no">Order</span>
            <div class="pg-order @(IsMoved(change) ? "pg-moved-num" : "")" title="Position in this list">@(Index + 1)</div>
        </div>
        <div class="pg-roster-actions">
            @if (AllowReorder)
            {
                <span class="pg-drag sortable-grab" title="Drag to reorder">⠿</span>
                <FluentButton Appearance="ButtonAppearance.Default" Title="Move up" Disabled="@(Index == 0)" @onclick="() => MoveAsync(-1)">↑</FluentButton>
                <FluentButton Appearance="ButtonAppearance.Default" Title="Move down" Disabled="@(Index == Model.Quests.Count - 1)" @onclick="() => MoveAsync(1)">↓</FluentButton>
            }
            <FluentButton Appearance="ButtonAppearance.Default" Title="Remove" @onclick="RemoveAsync">✕</FluentButton>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public PlaygroundRoster Model { get; set; } = null!;

    [Parameter, EditorRequired]
    public PlaygroundQuest Quest { get; set; } = null!;

    [Parameter, EditorRequired]
    public PlaygroundRoster.ChangeSet.QuestsTransition Changes { get; set; } = null!;

    [Parameter]
    public bool AllowReorder { get; set; }

    [Parameter]
    public bool RemovedOnly { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private int Index => Model.Quests.IndexOf(Quest);

    // Row highlights read the shared keyed-collection state built from the
    // typed transition, so added/removed/reordered reuse the canonical item
    // semantics. Per-field dots read the typed member transitions directly.
    private SparseCollectionState QuestStates =>
        Changes.KeyedState(PlaygroundRoster.SparsePath.Quests);

    private PlaygroundRoster.ChangeSet.QuestsTransition.Item TypedItem =>
        Changes.GetChange(Quest.Id);

    private bool TitleChanged => !TypedItem.IsEmpty && TypedItem.IsEdited && TypedItem.Edit.Title.IsChanged;

    private bool PointsChanged => !TypedItem.IsEmpty && TypedItem.IsEdited && TypedItem.Edit.Points.IsChanged;

    private bool ScoresChanged => !TypedItem.IsEmpty && TypedItem.IsEdited && TypedItem.Edit.Scores.IsChanged;

    private SparseCollectionItemState? GetRowChange()
    {
        var change = QuestStates.GetItemState(Quest.Id);
        if (change.IsEmpty || (RemovedOnly && !change.IsRemoved))
        {
            return null;
        }
        return change;
    }

    private static bool IsMoved(SparseCollectionItemState? change) =>
        change.HasValue && !change.Value.IsAdded && !change.Value.IsRemoved && change.Value.IsReordered;

    private static string RowClass(SparseCollectionItemState? change)
    {
        var cls = "pg-roster-row";
        if (change?.IsAdded == true)
        {
            cls += " pg-added";
        }
        if (change?.IsRemoved == true)
        {
            cls += " pg-removed";
        }
        if (IsMoved(change))
        {
            cls += " pg-moved";
        }
        return cls;
    }

    private Task RemoveAsync()
    {
        Model.Quests.RemoveAt(Index);
        return NotifyAsync();
    }

    private Task MoveAsync(int delta)
    {
        var index = Index;
        var target = index + delta;
        if (target < 0 || target >= Model.Quests.Count)
        {
            return Task.CompletedTask;
        }
        (Model.Quests[target], Model.Quests[index]) = (Model.Quests[index], Model.Quests[target]);
        return NotifyAsync();
    }

    private Task NotifyAsync() => OnChanged.InvokeAsync();
}
