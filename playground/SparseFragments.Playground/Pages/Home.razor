@page "/"
@using System.Text
@using SparseFragments
@using SparseFragments.Playground.Models
@using SparseFragments.Playground.Components

<PageTitle>SparseFragments Playground</PageTitle>

<h1>SparseFragments Playground</h1>
<p class="pg-lead">
    Typed partial state for C#: <strong>missing</strong> falls through to lower layers,
    while an explicit <strong>null</strong> wins.
    Edit the layers, reset anytime, and watch fragments, patches, and RFC 6902 JSON Patch update.
    See <a href="https://github.com/arika0093/SparseFragments" target="_blank">arika0093/SparseFragments</a>.
</p>

<div class="pg-toolbar">
    <FluentButton Appearance="Appearance.Accent" @onclick="ResetAll">Reset everything</FluentButton>
</div>

<h2>1. Layers: merge <code>Lower</code> + <code>Higher</code></h2>
<p class="pg-hint">Only <em>present</em> members of the higher layer override. Missing members keep the lower layer's values. <code>Plugins</code> uses append-merge.</p>
<div class="pg-grid">
    <div class="pg-stack">
        <FragmentEditor Title="Lower (baseline)" State="Lower" OnReset="ResetLower" OnChanged="Refresh" />
        <FluentCard Class="pg-fluent-card">
            <FluentTabs>
                <FluentTab Label="C#" Id="lower-csharp">
                    <MonacoView Content="@LowerCSharp" Language="csharp" Height="260px" />
                </FluentTab>
                <FluentTab Label="JSON" Id="lower-json">
                    <MonacoView Content="@LowerFragmentJson" Language="json" Height="260px" />
                </FluentTab>
            </FluentTabs>
        </FluentCard>
    </div>
    <div class="pg-stack">
        <FragmentEditor Title="Higher (overlay)" State="Higher" OnReset="ResetHigher" OnChanged="Refresh" />
        <FluentCard Class="pg-fluent-card">
            <FluentTabs>
                <FluentTab Label="C#" Id="higher-csharp">
                    <MonacoView Content="@HigherCSharp" Language="csharp" Height="260px" />
                </FluentTab>
                <FluentTab Label="JSON" Id="higher-json">
                    <MonacoView Content="@HigherFragmentJson" Language="json" Height="260px" />
                </FluentTab>
            </FluentTabs>
        </FluentCard>
    </div>
</div>
<FluentCard Class="pg-fluent-card pg-section-card">
    <div class="pg-card-head">
        <h3>Merged result</h3>
        <FluentBadge Appearance="Appearance.Accent">@($"IsEmpty: {MergedFragment.IsEmpty}")</FluentBadge>
    </div>
    <FluentTabs>
        <FluentTab Label="Model (C#)" Id="merged-model-csharp">
            <MonacoView Content="@MergedModelCSharp" Language="csharp" Height="260px" />
        </FluentTab>
        <FluentTab Label="Model (JSON)" Id="merged-model-json">
            <MonacoView Content="@MergedModelJson" Language="json" Height="260px" />
        </FluentTab>
        <FluentTab Label="Fragment (JSON)" Id="merged-fragment-json">
            <MonacoView Content="@MergedFragmentJson" Language="json" Height="260px" />
        </FluentTab>
        <FluentTab Label="Diff Lower→Merged (JSON)" Id="merged-diff-json">
            <MonacoView Content="@MergeDiffJson" Language="json" Height="260px" />
        </FluentTab>
    </FluentTabs>
</FluentCard>

<h2>2. Typed patch applied to the merged fragment</h2>
<p class="pg-hint">A patch carries <em>Set / Unset / unchanged</em> edits (plus <em>set null</em> for nullable members). The original fragment is never mutated.</p>
<div class="pg-grid">
    <div class="pg-stack">
        <PatchEditor Title="Patch edits" State="PatchState" OnReset="ResetPatch" OnChanged="Refresh" />
        <FluentCard Class="pg-fluent-card">
            <FluentTabs>
                <FluentTab Label="Patch (C#)" Id="patch-csharp">
                    <MonacoView Content="@PatchCSharp" Language="csharp" Height="260px" />
                </FluentTab>
            </FluentTabs>
        </FluentCard>
    </div>
    <FluentCard Class="pg-fluent-card">
        <div class="pg-card-head">
            <h3>Patched result</h3>
            <FluentBadge Appearance="Appearance.Accent">@($"Patch IsEmpty: {TypedPatch.IsEmpty}")</FluentBadge>
        </div>
        <FluentTabs>
            <FluentTab Label="Model (C#)" Id="patched-model-csharp">
                <MonacoView Content="@PatchedModelCSharp" Language="csharp" Height="260px" />
            </FluentTab>
            <FluentTab Label="Model (JSON)" Id="patched-model-json">
                <MonacoView Content="@PatchedModelJson" Language="json" Height="260px" />
            </FluentTab>
            <FluentTab Label="Fragment (JSON)" Id="patched-fragment-json">
                <MonacoView Content="@PatchedFragmentJson" Language="json" Height="260px" />
            </FluentTab>
            <FluentTab Label="Diff Merged→Patched (JSON)" Id="patched-diff-json">
                <MonacoView Content="@PatchDiffJson" Language="json" Height="260px" />
            </FluentTab>
        </FluentTabs>
    </FluentCard>
</div>

<h2>3. RFC 6902 JSON Patch bridge</h2>
<p class="pg-hint">Export the typed patch above against the merged baseline, or import any JSON Patch document against the same baseline.</p>
<div class="pg-grid">
    <FluentCard Class="pg-fluent-card">
        <div class="pg-card-head">
            <h3>Export</h3>
            <FluentButton Appearance="Appearance.Accent" Size="Size.Small" @onclick="CopyExportToImport">Copy to import box</FluentButton>
        </div>
        <MonacoView Content="@ExportText" Language="json" Height="220px" />
    </FluentCard>
    <FluentCard Class="pg-fluent-card">
        <div class="pg-card-head">
            <h3>Import</h3>
            <FluentButton Appearance="Appearance.Accent" Size="Size.Small" @onclick="ImportJsonPatch">Apply to merged baseline</FluentButton>
        </div>
        <FluentTextArea Rows="8" Placeholder='[{"op":"replace","path":"/Label","value":"..."}]'
            Value="@ImportText"
            ValueChanged="@(async v => { ImportText = v; })"
            Style="width: 100%;" />
        @if (ImportError is not null)
        {
            <FluentMessageBar Intent="MessageIntent.Error" Style="margin-top: 0.5rem;">@ImportError</FluentMessageBar>
        }
        @if (ImportResult is not null)
        {
            <div style="margin-top: 0.5rem;">
                <MonacoView Content="@ImportResult" Language="json" Height="220px" />
            </div>
        }
    </FluentCard>
</div>

@code {
    private FragmentEditState Lower = FragmentEditState.LowerDefaults();
    private FragmentEditState Higher = FragmentEditState.HigherDefaults();
    private PatchEditState PatchState = PatchEditState.Defaults();
    private string ImportText = """[{"op":"replace","path":"/Label","value":"imported!"}]""";
    private string? ImportError;
    private string? ImportResult;

    private PlaygroundSettings.Fragment LowerFragment => Lower.Build();
    private PlaygroundSettings.Fragment HigherFragment => Higher.Build();
    private PlaygroundSettings.Fragment MergedFragment => LowerFragment.Merge(HigherFragment);
    private PlaygroundSettings.Patch TypedPatch => PatchState.Build();
    private PlaygroundSettings.Fragment PatchedFragment => MergedFragment.Apply(TypedPatch);

    private string LowerCSharp => PlaygroundSnippets.FragmentCSharp("lower", Lower);
    private string HigherCSharp => PlaygroundSnippets.FragmentCSharp("higher", Higher);
    private string PatchCSharp => PlaygroundSnippets.PatchCSharp("patch", PatchState);

    private string LowerFragmentJson => Try(() => PlaygroundJson.WriteFragment(LowerFragment));
    private string HigherFragmentJson => Try(() => PlaygroundJson.WriteFragment(HigherFragment));
    private string MergedModelJson => Try(() => PlaygroundJson.WriteModel(MergedFragment.ToModel()));
    private string MergedModelCSharp => Try(() => PlaygroundSnippets.ModelCSharp("merged", MergedFragment.ToModel()));
    private string MergedFragmentJson => Try(() => PlaygroundJson.WriteFragment(MergedFragment));
    private string MergeDiffJson => Try(() => PlaygroundJson.WriteFragment(
        PlaygroundSettings.Fragment.Diff(LowerFragment.ToModel(), MergedFragment.ToModel())));
    private string PatchedModelJson => Try(() => PlaygroundJson.WriteModel(PatchedFragment.ToModel()));
    private string PatchedModelCSharp => Try(() => PlaygroundSnippets.ModelCSharp("patched", PatchedFragment.ToModel()));
    private string PatchedFragmentJson => Try(() => PlaygroundJson.WriteFragment(PatchedFragment));
    private string PatchDiffJson => Try(() => PlaygroundJson.WriteFragment(
        PlaygroundSettings.Fragment.Diff(MergedFragment.ToModel(), PatchedFragment.ToModel())));

    private string ExportText => Try(() =>
    {
        var exported = TypedPatch.ToJsonPatch(
            Optional<PlaygroundSettings.Fragment?>.Present(MergedFragment),
            PlaygroundJson.BridgeOptions());
        return PlaygroundJson.Pretty(Encoding.UTF8.GetString(exported.ToArray()));
    });

    private void Refresh() => StateHasChanged();

    private void ResetLower() => Lower = FragmentEditState.LowerDefaults();

    private void ResetHigher() => Higher = FragmentEditState.HigherDefaults();

    private void ResetPatch() => PatchState = PatchEditState.Defaults();

    private void ResetAll()
    {
        ResetLower();
        ResetHigher();
        ResetPatch();
        ImportText = """[{"op":"replace","path":"/Label","value":"imported!"}]""";
        ImportError = null;
        ImportResult = null;
    }

    private void CopyExportToImport()
    {
        ImportText = ExportText;
        ImportError = null;
        ImportResult = null;
    }

    private void ImportJsonPatch()
    {
        ImportError = null;
        ImportResult = null;
        try
        {
            var baseline = Optional<PlaygroundSettings.Fragment?>.Present(MergedFragment);
            var patch = PlaygroundSettings.Patch.FromJsonPatch(
                baseline,
                Encoding.UTF8.GetBytes(ImportText),
                PlaygroundJson.BridgeOptions());
            var applied = MergedFragment.Apply(patch);
            ImportResult =
                $"IsEmpty: {patch.IsEmpty}\nApplied fragment:\n{PlaygroundJson.WriteFragment(applied)}\nApplied model:\n{PlaygroundJson.WriteModel(applied.ToModel())}";
        }
        catch (Exception ex)
        {
            ImportError = $"{ex.GetType().Name}: {ex.Message}";
        }
    }

    private static string Try(Func<string> render)
    {
        try
        {
            return render();
        }
        catch (Exception ex)
        {
            return $"Error: {ex.GetType().Name}: {ex.Message}";
        }
    }
}
