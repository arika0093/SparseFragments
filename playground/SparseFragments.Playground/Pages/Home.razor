@page "/"
@using System.Text
@using SparseFragments
@using SparseFragments.Playground.Models
@using SparseFragments.Playground.Components
@inject PlaygroundThemeState ThemeState

<PageTitle>SparseFragments Playground</PageTitle>

<h1>SparseFragments Playground</h1>
<p class="pg-lead">
    Typed partial state for C#: <strong>missing</strong> falls through to lower layers,
    while an explicit <strong>null</strong> wins.
    Edit the layers, reset anytime, and watch fragments, patches, and RFC 6902 JSON Patch update.
    See <a href="https://github.com/arika0093/SparseFragments" target="_blank">arika0093/SparseFragments</a>.
</p>

<div class="pg-toolbar">
    <FluentButton Appearance="Appearance.Accent" @onclick="ResetAll">Reset everything</FluentButton>
    <div class="pg-theme">
        <span>Theme</span>
        <FluentSelect TOption="string"
            Items="@ThemeNames"
            OptionValue="@(v => v)"
            OptionText="@(v => v)"
            Value="@ThemeState.Mode.ToString()"
            ValueChanged="@OnThemeChanged" />
    </div>
</div>

<h2>1. Layers: merge <code>Lower</code> + <code>Higher</code></h2>
<p class="pg-hint">Only present members of the higher layer override. Untick a member to leave it <em>missing</em> so the lower layer's value survives. <code>Plugins</code> uses append-merge.</p>
<div class="pg-grid">
    <FluentCard Class="pg-fluent-card">
        <div class="pg-card-head">
            <h3>Lower (baseline)</h3>
            <FluentButton Appearance="Appearance.Accent" Size="Size.Small" @onclick="ResetLower">Reset</FluentButton>
        </div>
        <FragmentEditor State="Lower" OnChanged="Refresh" />
        <FluentTabs ActiveTabId="@LowerTabId" ActiveTabIdChanged="@OnLayerTabChanged">
            <FluentTab Label="C#" Id="lower-csharp">
                <MonacoView Content="@LowerCSharp" Language="csharp" Height="220px" />
            </FluentTab>
            <FluentTab Label="JSON" Id="lower-json">
                <MonacoView Content="@LowerFragmentJson" Language="json" Height="220px" />
            </FluentTab>
        </FluentTabs>
    </FluentCard>
    <FluentCard Class="pg-fluent-card">
        <div class="pg-card-head">
            <h3>Higher (overlay)</h3>
            <FluentButton Appearance="Appearance.Accent" Size="Size.Small" @onclick="ResetHigher">Reset</FluentButton>
        </div>
        <FragmentEditor State="Higher" OnChanged="Refresh" />
        <FluentTabs ActiveTabId="@HigherTabId" ActiveTabIdChanged="@OnLayerTabChanged">
            <FluentTab Label="C#" Id="higher-csharp">
                <MonacoView Content="@HigherCSharp" Language="csharp" Height="220px" />
            </FluentTab>
            <FluentTab Label="JSON" Id="higher-json">
                <MonacoView Content="@HigherFragmentJson" Language="json" Height="220px" />
            </FluentTab>
        </FluentTabs>
    </FluentCard>
</div>
<FluentCard Class="pg-fluent-card pg-section-card">
    <div class="pg-card-head">
        <h3>Merged result</h3>
    </div>
    <FluentTabs>
        <FluentTab Label="Model (C#)" Id="merged-model-csharp">
            <MonacoView Content="@MergedModelCSharp" Language="csharp" Height="240px" />
        </FluentTab>
        <FluentTab Label="Model (JSON)" Id="merged-model-json">
            <MonacoView Content="@MergedModelJson" Language="json" Height="240px" />
        </FluentTab>
        <FluentTab Label="Diff Lower→Merged (JSON)" Id="merged-diff-json">
            <MonacoView Content="@MergeDiffJson" Language="json" Height="240px" />
        </FluentTab>
    </FluentTabs>
</FluentCard>

<h2>2. Typed patch applied to the merged fragment</h2>
<p class="pg-hint">A patch carries <em>Set / Unset / unchanged</em> edits (plus <em>set null</em> for nullable members). The original fragment is never mutated.</p>
<FluentCard Class="pg-fluent-card pg-section-card">
    <div class="pg-card-head">
        <h3>Patch edits</h3>
        <div class="pg-actions">
            <FluentButton Appearance="Appearance.Accent" Size="Size.Small" @onclick="OpenImport">Import JSON Patch…</FluentButton>
            <FluentButton Appearance="Appearance.Accent" Size="Size.Small" @onclick="ResetPatch">Reset</FluentButton>
        </div>
    </div>
    <PatchEditor State="PatchState" OnChanged="Refresh" />
    <FluentTabs>
        <FluentTab Label="C#" Id="patch-csharp">
            <MonacoView Content="@PatchCSharp" Language="csharp" Height="220px" />
        </FluentTab>
        <FluentTab Label="JSON Patch" Id="patch-json-patch">
            <MonacoView Content="@ExportText" Language="json" Height="220px" />
        </FluentTab>
    </FluentTabs>
</FluentCard>
<div class="pg-grid">
    <FluentCard Class="pg-fluent-card pg-stretch">
        <div class="pg-card-head">
            <h3>Baseline (merged)</h3>
        </div>
        <FluentTabs>
            <FluentTab Label="Model (C#)" Id="baseline-model-csharp">
                <MonacoView Content="@MergedModelCSharp" Language="csharp" Fill="true" />
            </FluentTab>
            <FluentTab Label="Model (JSON)" Id="baseline-model-json">
                <MonacoView Content="@MergedModelJson" Language="json" Fill="true" />
            </FluentTab>
        </FluentTabs>
    </FluentCard>
    <FluentCard Class="pg-fluent-card">
        <div class="pg-card-head">
            <h3>Patched result</h3>
        </div>
        <FluentTabs>
            <FluentTab Label="Model (C#)" Id="patched-model-csharp">
                <MonacoView Content="@PatchedModelCSharp" Language="csharp" Height="260px" />
            </FluentTab>
            <FluentTab Label="Model (JSON)" Id="patched-model-json">
                <MonacoView Content="@PatchedModelJson" Language="json" Height="260px" />
            </FluentTab>
            <FluentTab Label="Diff Merged→Patched (JSON)" Id="patched-diff-json">
                <MonacoView Content="@PatchDiffJson" Language="json" Height="260px" />
            </FluentTab>
        </FluentTabs>
    </FluentCard>
</div>

<FluentDialog @bind-Hidden="_importHidden" Modal="true" TrapFocus="true" AriaLabel="Import JSON Patch">
    <FluentDialogHeader>
        <h3>Import JSON Patch</h3>
    </FluentDialogHeader>
    <FluentDialogBody>
        <p class="pg-hint">Applies an RFC 6902 document to the merged baseline and previews the result.</p>
        <FluentTextArea Rows="8" Placeholder='[{"op":"replace","path":"/Label","value":"..."}]'
            Value="@_importText"
            ValueChanged="@(v => _importText = v ?? string.Empty)"
            Style="width: 100%;" />
        @if (_importError is not null)
        {
            <FluentMessageBar Intent="MessageIntent.Error" Style="margin-top: 0.5rem;">@_importError</FluentMessageBar>
        }
        @if (_importResult is not null)
        {
            <div style="margin-top: 0.5rem;">
                <MonacoView Content="@_importResult" Language="json" Height="220px" />
            </div>
        }
    </FluentDialogBody>
    <FluentDialogFooter>
        <FluentButton Appearance="Appearance.Accent" @onclick="ApplyImport">Apply to merged baseline</FluentButton>
        <FluentButton Appearance="Appearance.Neutral" @onclick="CloseImport">Close</FluentButton>
    </FluentDialogFooter>
</FluentDialog>

@code {
    private static readonly List<string> ThemeNames = Enum.GetNames<DesignThemeModes>().ToList();

    private FragmentEditState Lower = FragmentEditState.LowerDefaults();
    private FragmentEditState Higher = FragmentEditState.HigherDefaults();
    private PatchEditState PatchState = PatchEditState.Defaults();
    private string LowerTabId = "lower-csharp";
    private string HigherTabId = "higher-csharp";
    private bool _importHidden = true;
    private string _importText = """[{"op":"replace","path":"/Label","value":"imported!"}]""";
    private string? _importError;
    private string? _importResult;

    private PlaygroundSettings.Fragment LowerFragment => Lower.Build();
    private PlaygroundSettings.Fragment HigherFragment => Higher.Build();
    private PlaygroundSettings.Fragment MergedFragment => LowerFragment.Merge(HigherFragment);
    private PlaygroundSettings.Patch TypedPatch => PatchState.Build();
    private PlaygroundSettings.Fragment PatchedFragment => MergedFragment.Apply(TypedPatch);

    private string LowerCSharp => PlaygroundSnippets.FragmentCSharp("lower", Lower);
    private string HigherCSharp => PlaygroundSnippets.FragmentCSharp("higher", Higher);
    private string PatchCSharp => PlaygroundSnippets.PatchCSharp("patch", PatchState);

    private string LowerFragmentJson => Try(() => PlaygroundJson.WriteFragment(LowerFragment));
    private string HigherFragmentJson => Try(() => PlaygroundJson.WriteFragment(HigherFragment));
    private string MergedModelJson => Try(() => PlaygroundJson.WriteModel(MergedFragment.ToModel()));
    private string MergedModelCSharp => Try(() => PlaygroundSnippets.ModelCSharp("merged", MergedFragment.ToModel()));
    private string MergeDiffJson => Try(() => PlaygroundJson.WriteFragment(
        PlaygroundSettings.Fragment.Diff(LowerFragment.ToModel(), MergedFragment.ToModel())));
    private string PatchedModelJson => Try(() => PlaygroundJson.WriteModel(PatchedFragment.ToModel()));
    private string PatchedModelCSharp => Try(() => PlaygroundSnippets.ModelCSharp("patched", PatchedFragment.ToModel()));
    private string PatchDiffJson => Try(() => PlaygroundJson.WriteFragment(
        PlaygroundSettings.Fragment.Diff(MergedFragment.ToModel(), PatchedFragment.ToModel())));

    private string ExportText => Try(() =>
    {
        var exported = TypedPatch.ToJsonPatch(
            Optional<PlaygroundSettings.Fragment?>.Present(MergedFragment),
            PlaygroundJson.BridgeOptions());
        return PlaygroundJson.Pretty(Encoding.UTF8.GetString(exported.ToArray()));
    });

    private void Refresh() => StateHasChanged();

    private void OnThemeChanged(string value)
    {
        if (Enum.TryParse<DesignThemeModes>(value, out var mode))
        {
            ThemeState.SetMode(mode);
        }
    }

    private void OnLayerTabChanged(string? id)
    {
        if (id is null)
        {
            return;
        }
        var language = id.EndsWith("csharp", StringComparison.Ordinal) ? "csharp" : "json";
        LowerTabId = $"lower-{language}";
        HigherTabId = $"higher-{language}";
    }

    private void ResetLower() => Lower = FragmentEditState.LowerDefaults();

    private void ResetHigher() => Higher = FragmentEditState.HigherDefaults();

    private void ResetPatch() => PatchState = PatchEditState.Defaults();

    private void ResetAll()
    {
        ResetLower();
        ResetHigher();
        ResetPatch();
        LowerTabId = "lower-csharp";
        HigherTabId = "higher-csharp";
        _importHidden = true;
        _importText = """[{"op":"replace","path":"/Label","value":"imported!"}]""";
        _importError = null;
        _importResult = null;
    }

    private void OpenImport()
    {
        _importText = ExportText;
        _importError = null;
        _importResult = null;
        _importHidden = false;
    }

    private void CloseImport() => _importHidden = true;

    private void ApplyImport()
    {
        _importError = null;
        _importResult = null;
        try
        {
            var baseline = Optional<PlaygroundSettings.Fragment?>.Present(MergedFragment);
            var patch = PlaygroundSettings.Patch.FromJsonPatch(
                baseline,
                Encoding.UTF8.GetBytes(_importText),
                PlaygroundJson.BridgeOptions());
            var applied = MergedFragment.Apply(patch);
            _importResult =
                $"IsEmpty: {patch.IsEmpty}\nApplied fragment:\n{PlaygroundJson.WriteFragment(applied)}\nApplied model:\n{PlaygroundJson.WriteModel(applied.ToModel())}";
        }
        catch (Exception ex)
        {
            _importError = $"{ex.GetType().Name}: {ex.Message}";
        }
    }

    private static string Try(Func<string> render)
    {
        try
        {
            return render();
        }
        catch (Exception ex)
        {
            return $"Error: {ex.GetType().Name}: {ex.Message}";
        }
    }
}
