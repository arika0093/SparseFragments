@page "/"
@using System.Text.Json
@using SparseFragments
@using SparseFragments.Playground.Models
@using SparseFragments.Playground.Components
@inject PlaygroundThemeState ThemeState

<PageTitle>SparseFragments Playground</PageTitle>

<div class="pg-title">
    <img class="pg-brand" src="favicon.png" alt="SparseFragments logo" />
    <h1>SparseFragments Playground</h1>
    <div class="pg-theme">
        <span>Theme</span>
        <FluentSelect TOption="string" TValue="string"
            Items="@ThemeNames"
            OptionValue="@(v => v)"
            OptionText="@(v => v)"
            Value="@ThemeState.Mode.ToString()"
            ValueChanged="@OnThemeChanged" />
    </div>
    <a class="pg-gh" href="https://github.com/arika0093/SparseFragments" target="_blank" rel="noopener" title="arika0093/SparseFragments on GitHub" aria-label="arika0093/SparseFragments on GitHub">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" /></svg>
    </a>
    <FluentButton Appearance="ButtonAppearance.Primary" @onclick="ResetAll">Reset everything</FluentButton>
</div>

<h2>1. Layers: merge Lower + Higher</h2>
<p class="pg-hint">Only present members of the higher layer override. Untick a member to leave it <em>missing</em> so the lower layer's value survives. Plugins uses append-merge.</p>
<div class="pg-grid">
    <FluentCard Class="pg-fluent-card">
        <div class="pg-card-head">
            <h3>Lower (baseline)</h3>
            <FluentButton Appearance="ButtonAppearance.Primary" @onclick="ResetLower">Reset</FluentButton>
        </div>
        <FragmentEditor State="Lower" OnChanged="Refresh" />
        <FluentTabs ActiveTabId="@LowerTabId" ActiveTabIdChanged="@OnLayerTabChanged">
            <FluentTab Label="C#" Id="lower-csharp">
                <MonacoView Content="@LowerCSharp" Language="csharp" Height="270px" />
            </FluentTab>
            <FluentTab Label="JSON" Id="lower-json">
                <MonacoView Content="@LowerFragmentJson" Language="json" Height="270px" />
            </FluentTab>
        </FluentTabs>
    </FluentCard>
    <FluentCard Class="pg-fluent-card">
        <div class="pg-card-head">
            <h3>Higher (overlay)</h3>
            <FluentButton Appearance="ButtonAppearance.Primary" @onclick="ResetHigher">Reset</FluentButton>
        </div>
        <FragmentEditor State="Higher" OnChanged="Refresh" />
        <FluentTabs ActiveTabId="@HigherTabId" ActiveTabIdChanged="@OnLayerTabChanged">
            <FluentTab Label="C#" Id="higher-csharp">
                <MonacoView Content="@HigherCSharp" Language="csharp" Height="270px" />
            </FluentTab>
            <FluentTab Label="JSON" Id="higher-json">
                <MonacoView Content="@HigherFragmentJson" Language="json" Height="270px" />
            </FluentTab>
        </FluentTabs>
    </FluentCard>
</div>
<FluentCard Class="pg-fluent-card pg-section-card">
    <div class="pg-card-head">
        <h3>Merged result</h3>
    </div>
    <FluentTabs>
        <FluentTab Label="Fragment (JSON)" Id="merged-fragment-json">
            <MonacoView Content="@MergedFragmentJson" Language="json" Height="270px" />
        </FluentTab>
        <FluentTab Label="Model (C#)" Id="merged-model-csharp">
            <MonacoView Content="@MergedModelCSharp" Language="csharp" Height="270px" />
        </FluentTab>
        <FluentTab Label="Model (JSON)" Id="merged-model-json">
            <MonacoView Content="@MergedModelJson" Language="json" Height="270px" />
        </FluentTab>
        <FluentTab Label="Diff Lower→Merged (JSON)" Id="merged-diff-json">
            <MonacoView Content="@MergeDiffJson" Language="json" Height="270px" />
        </FluentTab>
    </FluentTabs>
</FluentCard>

<h2>2. Typed patch applied to the merged fragment</h2>
<p class="pg-hint">A patch carries <em>Set / Remove / Keep</em> edits (plus <em>set null</em> for nullable members). The original fragment is never mutated.</p>
<FluentCard Class="pg-fluent-card pg-section-card">
    <div class="pg-card-head">
        <h3>Patch edits</h3>
        <div class="pg-actions">
            <FluentButton Appearance="ButtonAppearance.Primary" @onclick="OpenImport">Import ChangeSet JSON…</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Primary" @onclick="ResetPatch">Reset</FluentButton>
        </div>
    </div>
    <PatchEditor State="PatchState" OnChanged="Refresh" />
    <FluentTabs>
        <FluentTab Label="C#" Id="patch-csharp">
            <MonacoView Content="@PatchCSharp" Language="csharp" Height="270px" />
        </FluentTab>
        <FluentTab Label="ChangeSet (JSON)" Id="patch-changeset-json">
            <MonacoView Content="@ChangeSetExportText" Language="json" Height="270px" />
        </FluentTab>
    </FluentTabs>
</FluentCard>
<FluentCard Class="pg-fluent-card pg-section-card">
    <div class="pg-card-head">
        <h3>Baseline → Patched</h3>
    </div>
    <FluentTabs>
        <FluentTab Label="Fragment (JSON)" Id="patched-fragment-json">
            <MonacoDiffView Original="@MergedFragmentJson" Modified="@PatchedFragmentJson" Language="json" Height="300px" />
        </FluentTab>
        <FluentTab Label="Model (C#)" Id="patched-model-csharp">
            <MonacoDiffView Original="@MergedModelCSharp" Modified="@PatchedModelCSharp" Language="csharp" Height="300px" />
        </FluentTab>
        <FluentTab Label="Model (JSON)" Id="patched-model-json">
            <MonacoDiffView Original="@MergedModelJson" Modified="@PatchedModelJson" Language="json" Height="300px" />
        </FluentTab>
    </FluentTabs>
</FluentCard>

<h2>3. Keyed list: List&lt;Quest&gt;</h2>
<p class="pg-hint">Outer <em>List&lt;Quest&gt;</em> patches by <em>Id</em> key; inner <em>Scores</em> replaces the whole list.</p>
<div class="pg-legend" aria-label="Edit highlight legend">
    <span class="pg-lg"><span class="pg-sw pg-sw-add"></span>added</span>
    <span class="pg-lg"><span class="pg-sw pg-sw-del"></span>removed</span>
    <span class="pg-lg"><span class="pg-sw pg-sw-move"></span>moved</span>
    <span class="pg-lg"><span class="pg-dot"></span>edited</span>
</div>
<div class="pg-grid">
    <FluentCard Class="pg-fluent-card">
        <div class="pg-card-head">
            <h3>Before</h3>
            <FluentButton Appearance="ButtonAppearance.Primary" @onclick="ResetRosterBefore">Reset</FluentButton>
        </div>
        <RosterEditor Model="RosterBefore" AllowReorder="false" Changes="RosterEditorChanges" RemovedOnly="true" OnChanged="Refresh" />
    </FluentCard>
    <FluentCard Class="pg-fluent-card">
        <div class="pg-card-head">
            <h3>After</h3>
            <FluentButton Appearance="ButtonAppearance.Primary" @onclick="ResetRosterAfter">Reset</FluentButton>
        </div>
        <RosterEditor Model="RosterAfter" Changes="RosterEditorChanges" OnChanged="Refresh" />
    </FluentCard>
</div>
<div class="pg-grid">
    <FluentCard Class="pg-fluent-card">
        <div class="pg-card-head">
            <h3>Before code</h3>
        </div>
        <FluentTabs ActiveTabId="@RosterBeforeTabId" ActiveTabIdChanged="@OnRosterTabChanged">
            <FluentTab Label="Model (C#)" Id="roster-before-csharp">
                <MonacoView Content="@RosterBeforeCSharp" Language="csharp" Height="270px" />
            </FluentTab>
            <FluentTab Label="Fragment (JSON)" Id="roster-before-json">
                <MonacoView Content="@RosterBeforeFragmentJson" Language="json" Height="270px" />
            </FluentTab>
        </FluentTabs>
    </FluentCard>
    <FluentCard Class="pg-fluent-card">
        <div class="pg-card-head">
            <h3>After code</h3>
        </div>
        <FluentTabs ActiveTabId="@RosterAfterTabId" ActiveTabIdChanged="@OnRosterTabChanged">
            <FluentTab Label="Model (C#)" Id="roster-after-csharp">
                <MonacoView Content="@RosterAfterCSharp" Language="csharp" Height="270px" />
            </FluentTab>
            <FluentTab Label="Fragment (JSON)" Id="roster-after-json">
                <MonacoView Content="@RosterAfterFragmentJson" Language="json" Height="270px" />
            </FluentTab>
        </FluentTabs>
    </FluentCard>
</div>
<FluentCard Class="pg-fluent-card pg-section-card">
    <div class="pg-card-head">
        <h3>Before → After keyed diff</h3>
        <span class="pg-hint">@RosterSummary</span>
    </div>
    <FluentTabs>
        <FluentTab Label="Patch (C#)" Id="roster-patch-manual">
            <MonacoView Content="@RosterManualCSharp" Language="csharp" Height="270px" />
        </FluentTab>
        <FluentTab Label="ChangeSet (JSON)" Id="roster-changeset-json">
            <MonacoView Content="@RosterChangeSetJson" Language="json" Height="270px" />
        </FluentTab>
        <FluentTab Label="Applied (JSON)" Id="roster-applied-json">
            <MonacoDiffView Original="@RosterBeforeModelJson" Modified="@RosterAppliedModelJson" Language="json" Height="300px" />
        </FluentTab>
    </FluentTabs>
</FluentCard>

<FluentDialog @ref="_importDialog" Hidden="@_importHidden" Modal="true" TrapFocus="true"
    AriaLabel="Import ChangeSet JSON">
    <div class="pg-dialog-heading">
        <h3>Import ChangeSet JSON</h3>
    </div>
    <div class="pg-dialog-body">
        <p class="pg-hint">Paste a ChangeSet JSON document exported from the merged baseline and preview its applied result.</p>
        <FluentTextArea Rows="8" Placeholder='{"version":"0.1","changes":[{"member":"Label","before":{"state":"value","value":"..."},"after":{"state":"value","value":"..."}}]}'
            translate="no"
            Value="@_importText"
            ValueChanged="@(v => _importText = v ?? string.Empty)"
            Style="width: 100%;" />
        @if (_importError is not null)
        {
            <FluentMessageBar Intent="MessageBarIntent.Error" Style="margin-top: 0.5rem;">@_importError</FluentMessageBar>
        }
        @if (_importResult is not null)
        {
            <div style="margin-top: 0.5rem;">
                <MonacoView Content="@_importResult" Language="json" Height="270px" />
            </div>
        }
    </div>
    <div class="pg-dialog-footer">
        <FluentButton Appearance="ButtonAppearance.Primary" @onclick="ApplyImport">Apply to merged baseline</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Default" @onclick="CloseImport">Close</FluentButton>
    </div>
</FluentDialog>

<h2>4. EditSession with Undo/Redo</h2>
<EditSessionUndoRedo />

@code {
    private static readonly List<string> ThemeNames = Enum.GetNames<PlaygroundThemeMode>().ToList();

    private FragmentEditState Lower = FragmentEditState.LowerDefaults();
    private FragmentEditState Higher = FragmentEditState.HigherDefaults();
    private PatchEditState PatchState = PatchEditState.Defaults();
    private PlaygroundRoster RosterBefore = RosterDefaults.Before();
    private PlaygroundRoster RosterAfter = RosterDefaults.After();
    private PlaygroundRoster.ChangeSet? _rosterChanges;
    private static readonly PlaygroundRoster.ChangeSet EmptyRosterChangeSet =
        PlaygroundRoster.ChangeSet.Between(
            Optional<PlaygroundRoster.Fragment?>.Missing,
            Optional<PlaygroundRoster.Fragment?>.Missing);
    private string LowerTabId = "lower-csharp";
    private string HigherTabId = "higher-csharp";
    private string RosterBeforeTabId = "roster-before-csharp";
    private string RosterAfterTabId = "roster-after-csharp";
    private bool _importHidden = true;
    private FluentDialog? _importDialog;
    private string _importText = """{"version":"0.1","changes":[]}""";
    private string? _importError;
    private string? _importResult;

    private PlaygroundSettings.Fragment LowerFragment => Lower.Build();
    private PlaygroundSettings.Fragment HigherFragment => Higher.Build();
    private PlaygroundSettings.Fragment MergedFragment => LowerFragment.Merge(HigherFragment);
    private PlaygroundSettings.Patch TypedPatch => PatchState.Build();
    private PlaygroundSettings.Fragment PatchedFragment => MergedFragment.Apply(TypedPatch);

    private string LowerCSharp => PlaygroundSnippets.FragmentCSharp("lower", Lower);
    private string HigherCSharp => PlaygroundSnippets.FragmentCSharp("higher", Higher);
    private string PatchCSharp => PlaygroundSnippets.PatchCSharp("patch", PatchState);

    private string LowerFragmentJson => Try(() => PlaygroundJson.WriteFragment(LowerFragment));
    private string HigherFragmentJson => Try(() => PlaygroundJson.WriteFragment(HigherFragment));
    private string MergedFragmentJson => Try(() => PlaygroundJson.WriteFragment(MergedFragment));
    private string MergedModelJson => Try(() => PlaygroundJson.WriteModel(MergedFragment.ToModel()));
    private string MergedModelCSharp => Try(() => PlaygroundSnippets.ModelCSharp("model", MergedFragment.ToModel()));
    private string MergeDiffJson => Try(() => PlaygroundJson.WriteFragment(
        PlaygroundSettings.Fragment.Diff(LowerFragment.ToModel(), MergedFragment.ToModel())));
    private string PatchedFragmentJson => Try(() => PlaygroundJson.WriteFragment(PatchedFragment));
    private string PatchedModelJson => Try(() => PlaygroundJson.WriteModel(PatchedFragment.ToModel()));
    private string PatchedModelCSharp => Try(() => PlaygroundSnippets.ModelCSharp("model", PatchedFragment.ToModel()));

    private string ChangeSetExportText => Try(() =>
    {
        var baseline = Optional<PlaygroundSettings.Fragment?>.Present(MergedFragment);
        var changes = PlaygroundSettings.ChangeSet.FromPatch(baseline, TypedPatch);
        return PlaygroundJson.WriteSettingsChangeSet(changes);
    });

    private string RosterBeforeCSharp => Try(() => PlaygroundSnippets.RosterModelCSharp("before", RosterBefore));
    private string RosterAfterCSharp => Try(() => PlaygroundSnippets.RosterModelCSharp("after", RosterAfter));
    private string RosterBeforeFragmentJson => Try(() => PlaygroundJson.WriteRosterFragment(PlaygroundRoster.Fragment.From(RosterBefore)));
    private string RosterAfterFragmentJson => Try(() => PlaygroundJson.WriteRosterFragment(PlaygroundRoster.Fragment.From(RosterAfter)));
    private string RosterBeforeModelJson => Try(() => PlaygroundJson.WriteRosterModel(RosterBefore));
    private string RosterManualCSharp => Try(RosterManualPatchText);
    private string RosterSummary => _rosterChanges is null
        ? "cannot diff: duplicate keys or invalid state"
        : PlaygroundSnippets.RosterSummary(_rosterChanges);

    private PlaygroundRoster.ChangeSet? RosterChanges => _rosterChanges;
    private PlaygroundRoster.ChangeSet.QuestsTransition RosterEditorChanges =>
        (_rosterChanges ?? EmptyRosterChangeSet).Quests;

    private string RosterChangeSetJson => Try(() =>
    {
        if (_rosterChanges is null)
        {
            throw new InvalidOperationException("Cannot diff roster state.");
        }

        return PlaygroundJson.WriteRosterChangeSet(_rosterChanges);
    });

    private string RosterAppliedModelJson => Try(() =>
    {
        if (_rosterChanges is null)
        {
            throw new InvalidOperationException("Cannot diff roster state.");
        }

        if (!_rosterChanges.TryApplyTo(RosterBefore, out var applied))
        {
            throw new InvalidOperationException("The roster changes conflict with the baseline.");
        }

        return PlaygroundJson.WriteRosterModel(applied);
    });

    private string RosterManualPatchText()
    {
        if (_rosterChanges is null)
        {
            return "// Cannot diff: duplicate keys or invalid state. See the ChangeSet JSON tab for the error.";
        }

        return PlaygroundSnippets.RosterManualPatchCSharp("patch", _rosterChanges);
    }

    private bool TryRefreshRosterChanges()
    {
        try
        {
            _rosterChanges = RosterBefore.CreateChangeSet(RosterAfter);
            return true;
        }
        catch
        {
            _rosterChanges = null;
            return false;
        }
    }

    protected override void OnInitialized() => TryRefreshRosterChanges();

    private void Refresh()
    {
        TryRefreshRosterChanges();
        StateHasChanged();
    }

    private void OnThemeChanged(string value)
    {
        if (Enum.TryParse<PlaygroundThemeMode>(value, out var mode))
        {
            ThemeState.SetMode(mode);
        }
    }

    private void OnLayerTabChanged(string? id)
    {
        if (id is null)
        {
            return;
        }
        var language = id.EndsWith("csharp", StringComparison.Ordinal) ? "csharp" : "json";
        LowerTabId = $"lower-{language}";
        HigherTabId = $"higher-{language}";
    }

    private void OnRosterTabChanged(string? id)
    {
        if (id is null)
        {
            return;
        }
        var language = id.EndsWith("csharp", StringComparison.Ordinal) ? "csharp" : "json";
        RosterBeforeTabId = $"roster-before-{language}";
        RosterAfterTabId = $"roster-after-{language}";
    }

    private void ResetLower() => Lower = FragmentEditState.LowerDefaults();

    private void ResetHigher() => Higher = FragmentEditState.HigherDefaults();

    private void ResetPatch() => PatchState = PatchEditState.Defaults();

    private void ResetRosterBefore()
    {
        RosterBefore = RosterDefaults.Before();
        TryRefreshRosterChanges();
    }

    private void ResetRosterAfter()
    {
        RosterAfter = RosterDefaults.After();
        TryRefreshRosterChanges();
    }

    private async Task ResetAll()
    {
        if (!_importHidden && _importDialog is not null)
        {
            await _importDialog.HideAsync();
        }

        ResetLower();
        ResetHigher();
        ResetPatch();
        ResetRosterBefore();
        ResetRosterAfter();
        LowerTabId = "lower-csharp";
        HigherTabId = "higher-csharp";
        RosterBeforeTabId = "roster-before-csharp";
        RosterAfterTabId = "roster-after-csharp";
        _importHidden = true;
        _importText = """{"version":"0.1","changes":[]}""";
        _importError = null;
        _importResult = null;
    }

    private async Task OpenImport()
    {
        _importText = ChangeSetExportText;
        _importError = null;
        _importResult = null;
        _importHidden = false;
        if (_importDialog is null)
        {
            throw new InvalidOperationException("The import dialog is not initialized.");
        }

        await _importDialog.ShowAsync();
    }

    private async Task CloseImport()
    {
        _importHidden = true;
        if (_importDialog is null)
        {
            throw new InvalidOperationException("The import dialog is not initialized.");
        }

        await _importDialog.HideAsync();
    }

    private void ApplyImport()
    {
        _importError = null;
        _importResult = null;
        try
        {
            var changes = PlaygroundJson.ReadSettingsChangeSet(_importText);
            if (changes is null)
            {
                throw new JsonException("The ChangeSet JSON deserialized to null.");
            }

            var applied = MergedFragment.Apply(changes.ToPatch());
            _importResult =
                $"IsEmpty: {changes.IsEmpty}\nChangeSet JSON:\n{PlaygroundJson.WriteSettingsChangeSet(changes)}\nApplied fragment:\n{PlaygroundJson.WriteFragment(applied)}\nApplied model:\n{PlaygroundJson.WriteModel(applied.ToModel())}";
        }
        catch (Exception ex)
        {
            _importError = $"{ex.GetType().Name}: {ex.Message}";
        }
    }

    private static string Try(Func<string> render)
    {
        try
        {
            return render();
        }
        catch (Exception ex)
        {
            return $"Error: {ex.GetType().Name}: {ex.Message}";
        }
    }
}
