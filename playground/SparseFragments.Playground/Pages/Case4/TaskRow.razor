@using Microsoft.AspNetCore.Components.Forms
@using SparseFragments
@using SparseFragments.Blazor
@using SparseFragments.Playground.Models
@using SettingsSession = global::SparseFragments.Playground.Models.PlaygroundSettings.EditSession;
@using TaskObservable = global::SparseFragments.Playground.Models.PlaygroundTask.Observable;

<div class="@RowClass pg-task-row">
    <div class="pg-task-line">
        <div class="pg-roster-field">
            <span class="pg-mini notranslate" translate="no">Id</span>
            @* focusout (not blur): blur doesn't bubble out of Fluent's inner input, so blur never commits. *@
            <FluentTextInput Value="@_idDraft"
                ValueChanged="@(value => _idDraft = value ?? string.Empty)"
                @onfocusout="CommitTaskId" />
        </div>
        <div class="pg-roster-field @(TitleChanged ? "pg-changed" : "")">
            <span class="pg-mini notranslate" translate="no">
                @if (TitleChanged)
                {
                    <span class="pg-dot" title="edited"></span>
                }
                Title
            </span>
            <FluentTextInput Value="@_title.Value"
                ValueChanged="@_title.SetAsync" />
        </div>
        <div class="pg-roster-field @(PointsChanged ? "pg-changed" : "")">
            <span class="pg-mini notranslate" translate="no">
                @if (PointsChanged)
                {
                    <span class="pg-dot" title="edited"></span>
                }
                Points
            </span>
            <FluentNumberInput TValue="int" Style="width: 100%;" Value="@_points.Value"
                ValueChanged="@_points.SetAsync" />
        </div>
        <div class="pg-roster-actions pg-task-actions">
            <span class="pg-drag sortable-grab" title="Drag to reorder">⠿</span>
            <FluentButton Appearance="ButtonAppearance.Default" Title="Move up"
                Disabled="@(Index == 0)" @onclick="() => MoveTask(-1)">↑</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Default" Title="Move down"
                Disabled="@(Index == Session.Observable.Tasks.Count - 1)"
                @onclick="() => MoveTask(1)">↓</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Default" Title="Remove"
                @onclick="RemoveTask">✕</FluentButton>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public SettingsSession Session { get; set; } = null!;

    [Parameter, EditorRequired]
    public TaskObservable Task { get; set; } = null!;

    // Point-in-time snapshot from the parent render; row and field lookups
    // probe it without re-diffing the live model per row.
    [Parameter, EditorRequired]
    public PlaygroundSettings.ChangeSet Changes { get; set; } = null!;

    [Parameter, EditorRequired]
    public EditContext EditContext { get; set; } = null!;

    [Parameter]
    public EventCallback<string?> OnError { get; set; }

    private TaskObservable? _lastTask;
    private string? _lastBoundId;
    private string _idDraft = string.Empty;
    private SparseFieldBinding<PlaygroundSettings, string> _title = null!;
    private SparseFieldBinding<PlaygroundSettings, int> _points = null!;
    private int Index => Session.Observable.Tasks.IndexOf(Task);

    // Row highlights reuse the canonical keyed semantics instead of a
    // hand-rolled baseline map: added rows report IsAdded, surviving rows
    // report IsReordered on relative-rank changes.
    private SparseCollectionItemState RowState =>
        Changes.Tasks.KeyedState(PlaygroundSettings.SparsePath.Tasks).GetItemState(Task.Id);

    private bool TitleChanged =>
        Changes.FieldState(PlaygroundSettings.SparsePath.Tasks.Key(Task.Id).Title).IsChanged;

    private bool PointsChanged =>
        Changes.FieldState(PlaygroundSettings.SparsePath.Tasks.Key(Task.Id).Points).IsChanged;

    private string RowClass =>
        RowState.IsAdded
            ? "pg-roster-row pg-added"
            : !RowState.IsRemoved && RowState.IsReordered
                ? "pg-roster-row pg-moved"
                : "pg-roster-row";

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_lastTask, Task) || !string.Equals(_lastBoundId, Task.Id, StringComparison.Ordinal))
        {
            _lastTask = Task;
            _lastBoundId = Task.Id;
            _idDraft = Task.Id;
            // Toolkit-neutral bindings over the keyed path: reads resolve live
            // and writes notify the shared EditContext. Keyed paths expose no
            // value expression, so Fluent inputs bind value and callback only.
            _title = Session.Bind(PlaygroundSettings.SparsePath.Tasks.Key(Task.Id).Title, EditContext);
            _points = Session.Bind(PlaygroundSettings.SparsePath.Tasks.Key(Task.Id).Points, EditContext);
        }
    }

    private void Edit(Action edit) => Session.BatchEdit(edit);

    private async Task CommitTaskId()
    {
        var value = _idDraft.Trim();
        var tasks = Session.Observable.Tasks;
        var index = tasks.IndexOf(Task);
        if (index < 0)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(value) || tasks.Any(item => !ReferenceEquals(item, Task) && item.Id == value))
        {
            _idDraft = Task.Id;
            await OnError.InvokeAsync("Task IDs must be non-empty and unique.");
            return;
        }

        await OnError.InvokeAsync(null);
        if (value == Task.Id)
        {
            return;
        }

        var title = Task.Title;
        var points = Task.Points;
        Edit(() =>
        {
            tasks.RemoveAt(index);
            tasks.InsertModel(index, new PlaygroundTask { Id = value, Title = title, Points = points });
        });
        _idDraft = value;
    }

    private void RemoveTask()
    {
        var index = Index;
        if (index >= 0)
        {
            Edit(() => Session.Observable.Tasks.RemoveAt(index));
        }
    }

    private void MoveTask(int delta)
    {
        var tasks = Session.Observable.Tasks;
        var index = Index;
        var target = index + delta;
        if (index < 0 || target < 0 || target >= tasks.Count)
        {
            return;
        }

        Edit(() =>
        {
            var task = tasks[index];
            tasks.RemoveAt(index);
            tasks.Insert(target, task);
        });
    }
}
