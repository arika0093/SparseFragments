@page "/case-3"
@using SparseFragments
@using SparseFragments.Playground.Models
@using SparseFragments.Playground.Components

<PageTitle>03 Keyed list — SparseFragments Playground</PageTitle>

<section class="pg-section">
    <div class="pg-section-heading">
        <span class="pg-section-number">03</span>
        <h2>Keyed list: List&lt;Quest&gt;</h2>
    </div>
    <FluentTabs Orientation="Orientation.Horizontal" Class="pg-section-tabs-inline">
        <FluentTab Header="Playground" Id="section-3-playground">
            <div class="pg-section-content">
                <p class="pg-hint">Outer <em>List&lt;Quest&gt;</em> patches by <em>Id</em> key; inner <em>Scores</em> replaces the whole list.</p>
                <div class="pg-legend" aria-label="Edit highlight legend">
                    <span class="pg-lg"><span class="pg-sw pg-sw-add"></span>added</span>
                    <span class="pg-lg"><span class="pg-sw pg-sw-del"></span>removed</span>
                    <span class="pg-lg"><span class="pg-sw pg-sw-move"></span>moved</span>
                    <span class="pg-lg"><span class="pg-dot"></span>edited</span>
                </div>
                <div class="pg-grid pg-grid-trio">
                    <FluentCard Class="pg-fluent-card">
                        <div class="pg-card-head">
                            <h3>Before</h3>
                            <FluentButton Appearance="ButtonAppearance.Primary" @onclick="ResetRosterBefore">Reset</FluentButton>
                        </div>
                        <RosterEditor Model="RosterBefore" AllowReorder="false" Changes="RosterEditorChanges" RemovedOnly="true" OnChanged="Refresh" />
                    </FluentCard>
                    <FluentCard Class="pg-fluent-card">
                        <div class="pg-card-head">
                            <h3>After</h3>
                            <FluentButton Appearance="ButtonAppearance.Primary" @onclick="ResetRosterAfter">Reset</FluentButton>
                        </div>
                        <RosterEditor Model="RosterAfter" Changes="RosterEditorChanges" OnChanged="Refresh" />
                    </FluentCard>
                    <FluentCard Class="pg-fluent-card pg-span-full">
                        <div class="pg-card-head">
                            <h3>Before → After keyed diff</h3>
                        </div>
                        <FluentTabs>
                            <FluentTab Header="Patch (C#)" Id="roster-patch-manual">
                                <MonacoView Content="@RosterManualCSharp" Language="csharp" Height="270px" />
                            </FluentTab>
                            <FluentTab Header="ChangeSet" Id="roster-changeset">
                                @{
                                    var changeRows = BuildRosterChangeRows();
                                }
                                @if (_rosterChanges is null)
                                {
                                    <p class="pg-hint">Cannot calculate changes because the list has duplicate keys or an invalid state.</p>
                                }
                                else if (changeRows.Count == 0)
                                {
                                    <p class="pg-hint">No changes.</p>
                                }
                                else
                                {
                                    <div class="pg-change-table-wrap pg-roster-change-table-wrap">
                                        <table class="pg-change-table" aria-label="Roster ChangeSet">
                                            <thead>
                                                <tr><th>Operation</th><th>Path</th><th>Before</th><th>After</th></tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in changeRows)
                                                {
                                                    <tr>
                                                        <td><span class="@PlaygroundPageHelper.ChangeOperationClass(row.Operation)">@row.Operation</span></td>
                                                        <td><span class="pg-change-value">@row.Path</span></td>
                                                        <td><span class="pg-change-value">@row.Before</span></td>
                                                        <td><span class="pg-change-value">@row.After</span></td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </FluentTab>
                            <FluentTab Header="ChangePayload" Id="roster-changeset-json">
                                <MonacoView Content="@RosterChangeSetJson" Language="json" Height="270px" />
                            </FluentTab>
                            <FluentTab Header="Applied (JSON)" Id="roster-applied-json">
                                <MonacoDiffView Original="@RosterBeforeModelJson" Modified="@RosterAppliedModelJson" Language="json" Height="300px" />
                            </FluentTab>
                        </FluentTabs>
                    </FluentCard>
                </div>
            </div>
        </FluentTab>
        <FluentTab Header="Codes" Id="section-3-codes">
            <PlaygroundCodeSamples Section="3" />
        </FluentTab>
    </FluentTabs>
</section>

<CasePager PrevHref="case-2" PrevLabel="02 Typed patch" NextHref="case-4" NextLabel="04 Undo / Redo" />

@code {
    private PlaygroundRoster RosterBefore = RosterDefaults.Before();
    private PlaygroundRoster RosterAfter = RosterDefaults.After();
    private PlaygroundRoster.ChangeSet? _rosterChanges;
    private static readonly PlaygroundRoster.ChangeSet EmptyRosterChangeSet =
        PlaygroundRoster.ChangeSet.Between(
            Optional<PlaygroundRoster.Fragment?>.Missing,
            Optional<PlaygroundRoster.Fragment?>.Missing);

    private string RosterBeforeModelJson => PlaygroundPageHelper.Try(() => PlaygroundJson.WriteRosterModel(RosterBefore));
    private string RosterManualCSharp => PlaygroundPageHelper.Try(RosterManualPatchText);
    private PlaygroundRoster.ChangeSet.QuestsTransition RosterEditorChanges =>
        (_rosterChanges ?? EmptyRosterChangeSet).Quests;

    private string RosterChangeSetJson => PlaygroundPageHelper.Try(() =>
    {
        if (_rosterChanges is null)
        {
            throw new InvalidOperationException("Cannot diff roster state.");
        }

        return PlaygroundJson.WriteRosterChangeSet(_rosterChanges);
    });

    private string RosterAppliedModelJson => PlaygroundPageHelper.Try(() =>
    {
        if (_rosterChanges is null)
        {
            throw new InvalidOperationException("Cannot diff roster state.");
        }

        if (!_rosterChanges.TryApplyTo(RosterBefore, out var applied))
        {
            throw new InvalidOperationException("The roster changes conflict with the baseline.");
        }

        return PlaygroundJson.WriteRosterModel(applied);
    });

    private string RosterManualPatchText()
    {
        if (_rosterChanges is null)
        {
            return "// Cannot diff: duplicate keys or invalid state. See the ChangePayload tab for the error.";
        }

        return PlaygroundSnippets.RosterManualPatchCSharp("patch", _rosterChanges);
    }

    private IReadOnlyList<(string Operation, string Path, string Before, string After)> BuildRosterChangeRows()
    {
        if (_rosterChanges is null)
        {
            return [];
        }

        return _rosterChanges.EnumerateChanges()
            .Select(static change => (
                Operation: PlaygroundPageHelper.ChangeOperation(change.Kind),
                Path: change.PathText,
                Before: PlaygroundPageHelper.FormatRosterValue(change.Before),
                After: PlaygroundPageHelper.FormatRosterValue(change.After)
            ))
            .ToArray();
    }

    private bool TryRefreshRosterChanges()
    {
        try
        {
            _rosterChanges = RosterBefore.CreateChangeSet(RosterAfter);
            return true;
        }
        catch
        {
            _rosterChanges = null;
            return false;
        }
    }

    protected override void OnInitialized() => TryRefreshRosterChanges();

    private void Refresh()
    {
        TryRefreshRosterChanges();
        StateHasChanged();
    }

    private void ResetRosterBefore()
    {
        RosterBefore = RosterDefaults.Before();
        TryRefreshRosterChanges();
    }

    private void ResetRosterAfter()
    {
        RosterAfter = RosterDefaults.After();
        TryRefreshRosterChanges();
    }
}
