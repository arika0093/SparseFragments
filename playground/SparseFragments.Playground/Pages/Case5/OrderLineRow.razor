@using SparseFragments
@using SparseFragments.Playground.Models

<div class="@RowClass pg-task-row">
    <div class="pg-task-line-ef">
        <div class="pg-roster-field">
            <span class="pg-mini notranslate" translate="no">Id <small>@(Line.Id.HasValue ? "int" : "new")</small></span>
            <FluentTextInput Value="@(Line.Id.HasValue ? $"#{Line.Id.Value}" : "#new")" ReadOnly="true" />
        </div>
        <div class="pg-roster-field @(ProductChanged ? "pg-changed" : "")">
            <span class="pg-mini notranslate" translate="no">
                @if (ProductChanged)
                {
                    <span class="pg-dot" title="edited"></span>
                }
                Product
            </span>
            <FluentTextInput Value="@Line.Product"
                ValueChanged="@(value => EditDraft(draft => draft.Lines[Index].Product = value ?? string.Empty))" />
        </div>
        <div class="pg-roster-field @(QtyChanged ? "pg-changed" : "")">
            <span class="pg-mini notranslate" translate="no">
                @if (QtyChanged)
                {
                    <span class="pg-dot" title="edited"></span>
                }
                Qty
            </span>
            <FluentNumberInput TValue="int" Value="@Line.Qty"
                ValueChanged="@(value => EditDraft(draft => draft.Lines[Index].Qty = value))" />
        </div>
        <div class="pg-roster-actions pg-task-actions">
            <span class="pg-drag sortable-grab" title="Drag to reorder">⠿</span>
            <FluentButton Appearance="ButtonAppearance.Default" Title="Move up"
                Disabled="@(Index == 0)" @onclick="() => MoveAsync(-1)">↑</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Default" Title="Move down"
                Disabled="@(Index == Draft.Lines.Count - 1)" @onclick="() => MoveAsync(1)">↓</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Default" Title="Remove"
                @onclick="RemoveAsync">✕</FluentButton>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public PlaygroundOrderLineDto Line { get; set; } = null!;

    [Parameter, EditorRequired]
    public PlaygroundOrderDto Draft { get; set; } = null!;

    // Point-in-time draft transition for highlights. The parent passes the
    // empty snapshot while the draft cannot be diffed; rows then render clean.
    [Parameter, EditorRequired]
    public PlaygroundOrderDto.ChangeSet Changes { get; set; } = null!;

    [Parameter, EditorRequired]
    public EventCallback<Action<PlaygroundOrderDto>> OnEditDraft { get; set; }

    private int Index => Draft.Lines.IndexOf(Line);

    // New rows carry no store identity, exactly as before: they render added.
    private bool IsAdded => !Line.Id.HasValue;

    // Row and field highlights reuse the shared collection and field state.
    // Moved observes surviving-key relative rank, matching the old manual
    // rank comparison. Added rows never query per-field state.
    private SparseCollectionState LineStates =>
        Changes.Lines.KeyedState(PlaygroundOrderDto.SparsePath.Lines);

    private bool ProductChanged =>
        !IsAdded
        && Line.Id is int productId
        && Changes.FieldState(PlaygroundOrderDto.SparsePath.Lines.Key(productId).Product).IsChanged;

    private bool QtyChanged =>
        !IsAdded
        && Line.Id is int qtyId
        && Changes.FieldState(PlaygroundOrderDto.SparsePath.Lines.Key(qtyId).Qty).IsChanged;

    private bool IsMoved =>
        !IsAdded
        && Line.Id is int movedId
        && LineStates.GetItemState(movedId) is { IsRemoved: false, IsReordered: true };

    private string RowClass => IsAdded ? "pg-roster-row pg-added" : IsMoved ? "pg-roster-row pg-moved" : "pg-roster-row";

    private Task EditDraft(Action<PlaygroundOrderDto> edit) => OnEditDraft.InvokeAsync(edit);

    private Task RemoveAsync()
    {
        var index = Index;
        return index < 0 ? Task.CompletedTask : EditDraft(draft => draft.Lines.RemoveAt(index));
    }

    private Task MoveAsync(int direction)
    {
        var index = Index;
        var target = index + direction;
        if (index < 0 || target < 0 || target >= Draft.Lines.Count)
        {
            return Task.CompletedTask;
        }

        return EditDraft(draft => (draft.Lines[index], draft.Lines[target]) = (draft.Lines[target], draft.Lines[index]));
    }
}
