@using Microsoft.EntityFrameworkCore
@using SparseFragments
@using SparseFragments.EntityFrameworkCore
@using SparseFragments.Playground.Models
@using SparseFragments.Playground.Components
@implements IDisposable

<div class="pg-stack">
    <div class="pg-grid pg-grid-duo">
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>1. Entity (tracked)</h3>
                <FluentButton Appearance="ButtonAppearance.Primary" @onclick="Reset">Reseed</FluentButton>
            </div>
            <MonacoView Content="@EntityJson" Language="json" Height="270px" />
        </FluentCard>
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>2. DTO projection</h3>
            </div>
            <MonacoView Content="@BaselineJson" Language="json" Height="270px" />
        </FluentCard>
    </div>
    <div class="pg-grid pg-grid-duo">
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>3. Edit draft</h3>
                <div class="pg-actions">
                    <FluentButton Appearance="ButtonAppearance.Default" @onclick="ResetDraft">Reset draft</FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Primary" Class="pg-submit-button"
                        Disabled="@(_savePending || _changes?.IsChanged != true)" @onclick="OpenSaveDialog">Save</FluentButton>
                </div>
            </div>
            <div class="pg-stack pg-edit-fields">
                <div class="pg-row pg-session-field @(IsScalarChanged(nameof(PlaygroundOrderDto.Customer)) ? "pg-changed" : "")">
                    <span class="pg-name notranslate" translate="no">@ChangedDot(IsScalarChanged(nameof(PlaygroundOrderDto.Customer)))Customer <small>string</small></span>
                    <FluentTextInput Style="flex: 1 1 12rem;"
                        Value="@_draft.Customer"
                        ValueChanged="@(v => EditDraft(d => d.Customer = v ?? string.Empty))" />
                </div>
                <div class="pg-row pg-session-field @(IsScalarChanged(nameof(PlaygroundOrderDto.Notes)) ? "pg-changed" : "")">
                    <span class="pg-name notranslate" translate="no">@ChangedDot(IsScalarChanged(nameof(PlaygroundOrderDto.Notes)))Notes <small>string</small></span>
                    <FluentTextInput Style="flex: 1 1 12rem;"
                        Value="@_draft.Notes"
                        ValueChanged="@(v => EditDraft(d => d.Notes = v ?? string.Empty))" />
                </div>
                <div class="pg-row pg-session-field @(IsScalarChanged(nameof(PlaygroundOrderDto.Total)) ? "pg-changed" : "")">
                    <span class="pg-name notranslate" translate="no">@ChangedDot(IsScalarChanged(nameof(PlaygroundOrderDto.Total)))Total <small>decimal</small></span>
                    <FluentNumberInput TValue="decimal" Style="width: 10rem;"
                        Value="@_draft.Total"
                        ValueChanged="@(v => EditDraft(d => d.Total = v))" />
                </div>
            </div>
            <div class="pg-row pg-session-field pg-task-field">
                <span class="pg-name notranslate" translate="no">Lines <small>List&lt;Line&gt;</small></span>
                <span class="pg-task-add">
                    <FluentButton Appearance="ButtonAppearance.Primary" Title="Add a random line" @onclick="AddLine">Add</FluentButton>
                </span>
            </div>
            <SortableList Items="_draft.Lines" Handle=".pg-drag" Class="pg-roster-list"
                OnUpdate="OnLinesReordered" Context="line">
                <SortableItemTemplate>
                    <OrderLineRow Line="line" Draft="_draft" Baseline="_baseline" OnEditDraft="EditDraft" />
                </SortableItemTemplate>
            </SortableList>
            <div class="pg-legend pg-session-legend" aria-label="Edit highlight legend">
                <span class="pg-lg"><span class="pg-sw pg-sw-add"></span>added</span>
                <span class="pg-lg"><span class="pg-sw pg-sw-move"></span>moved</span>
                <span class="pg-lg"><span class="pg-dot"></span>edited</span>
            </div>
            <MonacoView Content="@DraftJson" Language="json" Height="200px" />
        </FluentCard>
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>4. Save Entity</h3>
                <span class="pg-has-changes-badge @(_changes?.IsChanged == true ? "pg-has-changes" : "pg-no-changes")">
                    <span aria-hidden="true"></span>@(_changes?.IsChanged == true ? "Changes" : "No changes")
                </span>
            </div>
            <div class="pg-case5-conflict-toggle">
                <FluentCheckbox Value="@_simulateConflict"
                    ValueChanged="@(value => _simulateConflict = value)" Disabled="@_savePending">
                    Simulate another user editing before save
                </FluentCheckbox>
            </div>
            <p class="pg-hint">When enabled, a concurrent update changes the order revision. The submitted save is rejected and its changes are rebased onto the latest entity.</p>
            @if (_changesError is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Error">@_changesError</FluentMessageBar>
            }
            @if (_applyError is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Error">@_applyError</FluentMessageBar>
            }
            @if (_saveError is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Error">@_saveError</FluentMessageBar>
            }
            @if (!_applied && _applyError is null)
            {
                <p class="pg-hint">Confirm a ChangeSet to apply its snapshot after 10 seconds. You can keep editing the draft during the delay.</p>
            }
            @if (_applied)
            {
                <div class="pg-change-table-wrap">
                    <table class="pg-change-table" aria-label="Modified EF properties">
                        <thead>
                            <tr><th>Entity</th><th>Operation</th><th>Property</th><th>Before</th><th>After</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _modifiedRows)
                            {
                                <tr>
                                    <td><span class="pg-change-value">@row.Entity</span></td>
                                    <td><span class="@ChangeOperationClass(EfStateOperation(row.State))">@EfStateOperation(row.State)</span></td>
                                    <td><span class="pg-change-value">@row.Property</span></td>
                                    <td><span class="pg-change-value">@row.Before</span></td>
                                    <td><span class="pg-change-value">@row.After</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <MonacoDiffView Original="@_entityJsonBeforeApply" Modified="@EntityJson" Language="json" Height="240px" />
            }
        </FluentCard>
    </div>
</div>

<SaveSnackbar Visible="_savePending" OnApply="ApplyPendingSave" />

<FluentDialog @ref="_saveDialog" Hidden="@_saveDialogHidden" Modal="true" TrapFocus="true"
    Class="pg-submit-preview-dialog" AriaLabel="Confirm save changes">
    <div class="pg-dialog-heading">
        <h3>Save changes</h3>
    </div>
    <div class="pg-dialog-body">
        <p class="pg-hint">Review the ChangeSet. After confirmation, this snapshot applies in 10 seconds; you can keep editing the draft meanwhile.</p>
        @if (_changeRows.Count == 0)
        {
            <p class="pg-hint">No changes.</p>
        }
        else
        {
            <div class="pg-change-table-wrap">
                <table class="pg-change-table" aria-label="Order ChangeSet">
                    <thead>
                        <tr><th>Operation</th><th>Path</th><th>Before</th><th>After</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _changeRows)
                        {
                            <tr>
                                <td><span class="@ChangeOperationClass(row.Operation)">@row.Operation</span></td>
                                <td><span class="pg-change-value">@row.Path</span></td>
                                <td><span class="pg-change-value">@row.Before</span></td>
                                <td><span class="pg-change-value">@row.After</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    <div class="pg-dialog-footer">
        <FluentButton Appearance="ButtonAppearance.Primary" @onclick="ConfirmSave">Save</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Default" @onclick="CloseSaveDialog">Cancel</FluentButton>
    </div>
</FluentDialog>

<ConflictDialog Visible="_conflictVisible" Summary="@_conflictSummary"
    Conflicts="_conflictRows" OnClose="CloseConflictDialog" />

@code {
    private static readonly DbContextOptions<PlaygroundEfContext> SharedOptions =
        new DbContextOptionsBuilder<PlaygroundEfContext>()
            .UseInMemoryDatabase("pg-ef-demo")
            .Options;

    private PlaygroundEfContext? _db;
    private PlaygroundOrderEntity? _tracked;
    private SparseEntityMapper<PlaygroundOrderEntity, PlaygroundOrderDto>? _mapper;
    private PlaygroundOrderDto _baseline = new();
    private PlaygroundOrderDto _draft = new();
    private PlaygroundOrderDto.ChangeSet? _changes;
    private string? _changesError;
    private string? _applyError;
    private string? _saveError;
    private bool _applied;
    private bool _savePending;
    private bool _simulateConflict;
    private string _entityJsonBeforeApply = string.Empty;
    private FluentDialog? _saveDialog;
    private bool _saveDialogHidden = true;
    private bool _conflictVisible;
    private string _conflictSummary = string.Empty;
    private List<(string Operation, string Path, string Before, string After)> _changeRows = [];
    private List<(string Entity, string State, string Property, string Before, string After)> _modifiedRows = [];
    private PlaygroundOrderDto.ChangeSet? _pendingChanges;
    private PlaygroundOrderDto? _pendingDraft;
    private PlaygroundOrderDto? _pendingBaseline;
    private bool _pendingSimulateConflict;
    private List<(string Path, string Baseline, string Local, string Current, string Kind)> _conflictRows = [];

    private string EntityJson => Try(() => _tracked is null ? "{}" : PlaygroundOrderJson.WriteEntity(_tracked));
    private string BaselineJson => Try(() => PlaygroundOrderJson.WriteDto(_baseline));
    private string DraftJson => Try(() => PlaygroundOrderJson.WriteDto(_draft));

    /// <summary>Reseeds the store and resets the whole pipeline. Called by the page too.</summary>
    public void Reset()
    {
        _saveDialogHidden = true;
        Seed();
    }

    protected override void OnInitialized() => Seed();

    public void Dispose() => _db?.Dispose();

    private void Seed()
    {
        _savePending = false;
        _pendingChanges = null;
        _pendingDraft = null;
        _pendingBaseline = null;
        _pendingSimulateConflict = false;
        _db?.Dispose();
        _db = new PlaygroundEfContext(SharedOptions);
        _db.Database.EnsureDeleted();
        _db.Database.EnsureCreated();
        var seeded = _db.Orders.Add(
            new PlaygroundOrderEntity
            {
                CustomerName = "Cafe Vienna",
                Total = 13.75m,
                Note = new PlaygroundNoteEntity { Text = "first order" },
                Lines =
                [
                    new PlaygroundOrderLineEntity
                    {
                        Product = "Espresso",
                        Qty = 2,
                        SortOrder = 0,
                    },
                    new PlaygroundOrderLineEntity
                    {
                        Product = "Croissant",
                        Qty = 3,
                        SortOrder = 1,
                    },
                ],
            }
        ).Entity;
        _db.SaveChanges();
        _db.Entry(seeded).Collection(static order => order.Lines).Load();
        _tracked = seeded;
        _mapper = SparseEntityMapper<PlaygroundOrderEntity, PlaygroundOrderDto>.Create(
            new PlaygroundOrderMapper(),
            _db.Model);
        _baseline = Project(_tracked);
        _draft = Clone(_baseline);
        _applied = false;
        _simulateConflict = false;
        _modifiedRows = [];
        _saveDialogHidden = true;
        _conflictVisible = false;
        _conflictRows = [];
        RefreshChanges();
    }

    private void ResetDraft()
    {
        _draft = Clone(_baseline);
        _applied = false;
        _modifiedRows = [];
        RefreshChanges();
    }

    private void EditDraft(Action<PlaygroundOrderDto> edit)
    {
        edit(_draft);
        _applied = false;
        _modifiedRows = [];
        RefreshChanges();
    }

    // New lines never carry an Id: like the case 4 task list, Add appends a
    // random draft row and the store assigns the integer identity on save.
    private static readonly string[] NewLineProducts =
        ["Espresso", "Croissant", "Latte", "Muffin", "Cappuccino", "Cookie"];
    private static readonly Random NewLineRandom = new();

    private void AddLine()
    {
        EditDraft(draft => draft.Lines.Add(
            new PlaygroundOrderLineDto
            {
                Product = NewLineProducts[NewLineRandom.Next(NewLineProducts.Length)],
                Qty = NewLineRandom.Next(1, 6),
                TemporaryId = Guid.NewGuid(),
            }));
    }

    private Task OnLinesReordered((int oldIndex, int newIndex) indices)
    {
        var (oldIndex, newIndex) = indices;
        var lines = _draft.Lines;
        if (oldIndex == newIndex || oldIndex < 0 || oldIndex >= lines.Count || newIndex < 0 || newIndex > lines.Count)
        {
            return Task.CompletedTask;
        }

        EditDraft(draft =>
        {
            var line = draft.Lines[oldIndex];
            draft.Lines.RemoveAt(oldIndex);
            draft.Lines.Insert(Math.Min(newIndex, draft.Lines.Count), line);
        });
        return Task.CompletedTask;
    }

    private static RenderFragment ChangedDot(bool changed) => builder =>
    {
        if (changed)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "pg-dot");
            builder.AddAttribute(2, "title", "edited");
            builder.CloseElement();
        }
    };

    private bool IsScalarChanged(string property) => property switch
    {
        nameof(PlaygroundOrderDto.Customer) => _draft.Customer != _baseline.Customer,
        nameof(PlaygroundOrderDto.Notes) => _draft.Notes != _baseline.Notes,
        nameof(PlaygroundOrderDto.Total) => _draft.Total != _baseline.Total,
        _ => false,
    };

    private void RefreshChanges()
    {
        _changesError = null;
        _applyError = null;
        _saveError = null;
        // Line Ids are read-only and new rows never set one, so duplicate keys
        // cannot be introduced from the UI.
        try
        {
            _changes = _baseline.CreateChangeSet(_draft);
            _changeRows = _changes
                .EnumerateChanges()
                .Select(static change => (
                    Operation: ChangeOperation(change.Kind),
                    Path: change.PathText,
                    Before: FormatChangeValue(change.Before),
                    After: FormatChangeValue(change.After)))
                .ToList();
        }
        catch (Exception ex)
        {
            _changes = null;
            _changeRows = [];
            _changesError = $"{ex.GetType().Name}: {ex.Message}";
        }
    }

    private async Task OpenSaveDialog()
    {
        if (_savePending)
        {
            return;
        }

        _saveDialogHidden = false;
        if (_saveDialog is null)
        {
            throw new InvalidOperationException("The save dialog is not initialized.");
        }

        await _saveDialog.ShowAsync();
    }

    private async Task CloseSaveDialog()
    {
        _saveDialogHidden = true;
        if (_saveDialog is null)
        {
            throw new InvalidOperationException("The save dialog is not initialized.");
        }

        await _saveDialog.HideAsync();
    }

    private async Task ConfirmSave()
    {
        var changes = _changes;
        if (changes?.IsChanged != true)
        {
            await CloseSaveDialog();
            return;
        }

        var submittedDraft = Clone(_draft);
        var submittedBaseline = Clone(_baseline);
        var simulateConflict = _simulateConflict;
        await CloseSaveDialog();
        _pendingChanges = changes;
        _pendingDraft = submittedDraft;
        _pendingBaseline = submittedBaseline;
        _pendingSimulateConflict = simulateConflict;
        _baseline = Clone(submittedDraft);
        _savePending = true;
        _applied = false;
        _modifiedRows = [];
        RefreshChanges();
    }

    private async Task ApplyPendingSave()
    {
        if (!_savePending || _pendingChanges is null || _pendingDraft is null || _pendingBaseline is null)
        {
            return;
        }

        var changes = _pendingChanges;
        var submittedDraft = _pendingDraft;
        var submittedBaseline = _pendingBaseline;
        var simulateConflict = _pendingSimulateConflict;
        _savePending = false;
        _pendingChanges = null;
        _pendingDraft = null;
        _pendingBaseline = null;
        _pendingSimulateConflict = false;
        ApplyChanges(changes);
        if (_applied)
        {
            await SaveEntity(changes, submittedDraft, submittedBaseline, simulateConflict);
        }
        else
        {
            var applyError = _applyError;
            _baseline = submittedBaseline;
            RefreshChanges();
            _applyError = applyError;
        }
    }

    private void ApplyChanges(PlaygroundOrderDto.ChangeSet changes)
    {
        _applyError = null;
        _applied = false;
        _modifiedRows = [];
        if (_db is null || _tracked is null || _mapper is null)
        {
            _applyError = "The EF Core demo store is not initialized.";
            return;
        }

        _entityJsonBeforeApply = EntityJson;
        try
        {
            _mapper.Apply(_db, _tracked, changes);
            _modifiedRows = CollectModifiedRows(_db);
            _applied = true;
        }
        catch (Exception ex)
        {
            _applyError = $"{ex.GetType().Name}: {ex.Message}";
            _applied = false;
            _modifiedRows = [];
        }
    }

    private async Task SaveEntity(
        PlaygroundOrderDto.ChangeSet submittedChanges,
        PlaygroundOrderDto submittedDraft,
        PlaygroundOrderDto submittedBaseline,
        bool simulateConflict
    )
    {
        _saveError = null;
        if (_db is null || _tracked is null)
        {
            _saveError = "The EF Core demo store is not initialized.";
            return;
        }

        try
        {
            var orderId = _tracked.Id;
            var expectedRevision = _tracked.Revision;
            if (simulateConflict)
            {
                PlaygroundConcurrency.SimulateConcurrentEdit(SharedOptions, orderId);
            }

            // Check before SaveChanges because the in-memory provider cannot roll back a partial write.
            PlaygroundConcurrency.EnsureCurrentRevision(SharedOptions, orderId, expectedRevision);
            _tracked.Revision++;
            _db.SaveChanges();
            _db.ChangeTracker.Clear();
            _tracked = _db.Orders
                .Include(static order => order.Note)
                .Include(static order => order.Lines)
                .Single(order => order.Id == orderId);
            var persistedBaseline = Project(_tracked);
            RetargetNewLineIds(submittedDraft, persistedBaseline, _draft);
            _baseline = persistedBaseline;
            RefreshChanges();
        }
        catch (DbUpdateConcurrencyException)
        {
            await RecoverFromConflict(submittedChanges, submittedDraft, submittedBaseline);
        }
        catch (Exception ex)
        {
            _applied = false;
            _modifiedRows = [];
            RefreshChanges();
            _saveError = $"{ex.GetType().Name}: {ex.Message}. The submitted snapshot may have persisted, but the fresh entity could not be reconciled; reseed to recover.";
        }
    }

    private async Task RecoverFromConflict(
        PlaygroundOrderDto.ChangeSet submittedChanges,
        PlaygroundOrderDto submittedDraft,
        PlaygroundOrderDto submittedBaseline
    )
    {
        if (_db is null || _tracked is null)
        {
            throw new InvalidOperationException("The EF Core demo store is not initialized.");
        }

        var orderId = _tracked.Id;
        _db.ChangeTracker.Clear();
        _tracked = _db.Orders
            .Include(static order => order.Note)
            .Include(static order => order.Lines)
            .Single(order => order.Id == orderId);
        var currentBaseline = Project(_tracked);
        var localDraftBeforeRebase = Clone(_draft);
        var submittedRebase = submittedChanges.RebaseOnto(currentBaseline);
        var currentFragment = Optional<PlaygroundOrderDto.Fragment?>.Present(
            PlaygroundOrderDto.Fragment.From(currentBaseline));
        var mergedSubmitted = submittedRebase.Rebased.ToPatch().Apply(currentFragment).Value!.ToModel();
        var postSubmitChanges = submittedDraft.CreateChangeSet(_draft);
        var postSubmitRebase = postSubmitChanges.RebaseOnto(mergedSubmitted);
        var mergedFragment = postSubmitRebase.Rebased.ToPatch().Apply(
            Optional<PlaygroundOrderDto.Fragment?>.Present(PlaygroundOrderDto.Fragment.From(mergedSubmitted)));
        _draft = mergedFragment.Value!.ToModel();
        _baseline = currentBaseline;

        _conflictRows = submittedRebase.Conflicts
            .Concat(postSubmitRebase.Conflicts)
            .Select(static conflict => (
                Path: conflict.PathText,
                Baseline: FormatChangeValue(conflict.BaseValue),
                Local: FormatChangeValue(conflict.LocalValue),
                Current: FormatChangeValue(conflict.CurrentValue),
                Kind: conflict.Kind.ToString()))
            .ToList();
        var hasFieldConflicts = submittedRebase.HasConflicts || postSubmitRebase.HasConflicts;
        if (!_conflictRows.Any(static row => row.Path == nameof(PlaygroundOrderDto.Customer)))
        {
            _conflictRows.Add((
                nameof(PlaygroundOrderDto.Customer),
                submittedBaseline.Customer,
                localDraftBeforeRebase.Customer,
                currentBaseline.Customer,
                "Concurrent update"));
        }

        _conflictSummary = hasFieldConflicts
            ? "Another user updated this order while the save was pending. Conflicting values reverted to the latest entity; other changes were rebased."
            : "Another user updated this order while the save was pending. The draft was rebased onto the latest entity.";
        _applied = false;
        _modifiedRows = [];
        RefreshChanges();
        _conflictVisible = true;
    }

    private void CloseConflictDialog() => _conflictVisible = false;

    private static void RetargetNewLineIds(
        PlaygroundOrderDto submittedDraft,
        PlaygroundOrderDto persistedBaseline,
        PlaygroundOrderDto localDraft
    )
    {
        if (submittedDraft.Lines.Count != persistedBaseline.Lines.Count)
        {
            throw new InvalidOperationException("The persisted line order does not match the submitted snapshot.");
        }

        for (var index = 0; index < submittedDraft.Lines.Count; index++)
        {
            var submittedLine = submittedDraft.Lines[index];
            if (submittedLine.Id.HasValue || !submittedLine.TemporaryId.HasValue)
            {
                continue;
            }

            var localLine = localDraft.Lines.FirstOrDefault(line => line.TemporaryId == submittedLine.TemporaryId);
            if (localLine is null)
            {
                continue;
            }

            // The mapper's Order configuration persists lines in this same order.
            var persistedLine = persistedBaseline.Lines[index];
            localLine.Id = persistedLine.Id
                ?? throw new InvalidOperationException("A saved line did not receive a database identity.");
            localLine.TemporaryId = null;
        }
    }

    private static PlaygroundOrderDto Project(PlaygroundOrderEntity order) =>
        new()
        {
            Customer = order.CustomerName,
            Notes = order.Note?.Text ?? string.Empty,
            Total = order.Total,
            Lines = order
                .Lines.OrderBy(static line => line.SortOrder)
                .Select(static line => new PlaygroundOrderLineDto
                {
                    Id = line.Id,
                    Product = line.Product,
                    Qty = line.Qty,
                })
                .ToList(),
        };

    private static PlaygroundOrderDto Clone(PlaygroundOrderDto source) =>
        new()
        {
            Customer = source.Customer,
            Notes = source.Notes,
            Total = source.Total,
            Lines = source
                .Lines.Select(static line => new PlaygroundOrderLineDto
                {
                    Id = line.Id,
                    TemporaryId = line.TemporaryId,
                    Product = line.Product,
                    Qty = line.Qty,
                })
                .ToList(),
        };

    private static List<(string Entity, string State, string Property, string Before, string After)> CollectModifiedRows(
        PlaygroundEfContext db)
    {
        var rows = new List<(string Entity, string State, string Property, string Before, string After)>();
        foreach (var entry in db.ChangeTracker.Entries())
        {
            if (entry.State is not (EntityState.Added or EntityState.Modified or EntityState.Deleted))
            {
                continue;
            }

            var name = entry.Entity.GetType().Name;
            var key = string.Join(
                ",",
                entry.Properties
                    .Where(static property => property.Metadata.IsPrimaryKey())
                    .Select(static property => PlaygroundOrderJson.FormatValue(property.CurrentValue)));
            if (entry.State == EntityState.Added)
            {
                var values = string.Join(
                    ", ",
                    entry.Properties.Select(static property =>
                        $"{property.Metadata.Name}={PlaygroundOrderJson.FormatValue(property.CurrentValue)}"));
                rows.Add((name, "Added", $"#{key}", "—", values));
                continue;
            }

            if (entry.State == EntityState.Deleted)
            {
                rows.Add((name, "Deleted", $"#{key}", $"#{key}", "—"));
                continue;
            }

            foreach (var property in entry.Properties.Where(static property => property.IsModified))
            {
                rows.Add((
                    name,
                    "Modified",
                    property.Metadata.Name,
                    PlaygroundOrderJson.FormatValue(property.OriginalValue),
                    PlaygroundOrderJson.FormatValue(property.CurrentValue)));
            }
        }

        return rows;
    }

    private static string ChangeOperation(PlaygroundOrderDto.ChangeSet.ChangeKind kind) =>
        kind switch
        {
            PlaygroundOrderDto.ChangeSet.ChangeKind.Changed => "Edit",
            PlaygroundOrderDto.ChangeSet.ChangeKind.Added => "Add",
            PlaygroundOrderDto.ChangeSet.ChangeKind.Removed => "Remove",
            PlaygroundOrderDto.ChangeSet.ChangeKind.Order => "Order",
            _ => throw new ArgumentOutOfRangeException(nameof(kind), kind, null),
        };

    private static string ChangeOperationClass(string operation) =>
        $"pg-change-operation pg-change-{operation.ToLowerInvariant()}";

    private static string FormatChangeValue(Optional<object?> value) =>
        value.IsPresent ? PlaygroundOrderJson.FormatValue(value.Value) : "—";

    private static string EfStateOperation(string state) => state switch
    {
        "Added" => "Add",
        "Deleted" => "Remove",
        "Modified" => "Edit",
        _ => state,
    };

    private static string Try(Func<string> render)
    {
        try
        {
            return render();
        }
        catch (Exception ex)
        {
            return $"Error: {ex.GetType().Name}: {ex.Message}";
        }
    }
}
