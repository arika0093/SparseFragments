# EditorConfig is awesome: https://EditorConfig.org
# C# coding rules live here so editors and analyzers can enforce them.

root = true

[*.cs]
indent_style = space
indent_size = 4
insert_final_newline = true

# Write braces for every control-flow body, including single-statement branches.
csharp_prefer_braces = true:error
dotnet_diagnostic.IDE0011.severity = error

# Keep the Allman brace layout that CSharpier emits.
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Prefer file-scoped namespaces.
csharp_style_namespace_declarations = file_scoped:error

# Sonar S104: Files should not have too many lines of code.
dotnet_diagnostic.S104.severity = error

