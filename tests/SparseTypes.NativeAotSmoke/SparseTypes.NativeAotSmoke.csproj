<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SparseTypes.NativeAotSmoke</RootNamespace>
    <AssemblyName>SparseTypes.NativeAotSmoke</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- NativeAOT TUnit gate: this test project publishes ahead-of-time and the
      native binary runs real TUnit tests (source-generation mode is AOT
      compatible by default). -->
    <PublishAot>true</PublishAot>
    <!-- No reflection fallback: the AOT tests must prove the source-generated path. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>
  <!-- tests/Directory.Build.props assumes Shouldly alongside TUnit; Shouldly
    relies on runtime reflection, so AOT tests use TUnit assertions instead. -->
  <ItemGroup>
    <PackageReference Remove="Shouldly" />
    <Using Remove="Shouldly" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SparseTypes/SparseTypes.csproj" />
    <ProjectReference Include="../SparseTypes.NativeAotFixtures/SparseTypes.NativeAotFixtures.csproj" />
    <ProjectReference
      Include="../../src/SparseTypes.Generator/SparseTypes.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
  <ItemGroup>
    <Using Include="SparseTypes" />
  </ItemGroup>
</Project>
