<?xml version="1.0" encoding="utf-8" ?>
<Configuration>
  <CodeCoverage>
    <Sources>
      <Exclude>
        <!-- Source-generator emitted code. -->
        <Source>.*\.g\.cs$</Source>
        <Source>.*\.SparseTypes\.g\.cs$</Source>
        <Source>.*\.SparsePromoted\.g\.cs$</Source>
        <!-- Generated code under intermediate output. -->
        <Source>.*[\\/]obj[\\/].*\.cs$</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
