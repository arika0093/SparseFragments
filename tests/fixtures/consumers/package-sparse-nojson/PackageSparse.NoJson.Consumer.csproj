<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <AssemblyName>PackageSparse.NoJson.Consumer</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Remove="TUnit;Shouldly" />
    <Using Remove="Shouldly" />
  </ItemGroup>
  <!-- No System.Text.Json reference by design: this
    fixture proves the serializer-independent core compiles and works without
    any JSON API surface. Do not add one here. -->
  <ItemGroup Condition="'$(SparseTypesPackageVersion)' == ''">
    <ProjectReference Include="../../../../src/SparseTypes/SparseTypes.csproj" />
    <ProjectReference
      Include="../../../../src/SparseTypes.Generator/SparseTypes.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
  <ItemGroup Condition="'$(SparseTypesPackageVersion)' != ''">
    <PackageReference Include="SparseTypes" Version="$(SparseTypesPackageVersion)" />
  </ItemGroup>
</Project>
