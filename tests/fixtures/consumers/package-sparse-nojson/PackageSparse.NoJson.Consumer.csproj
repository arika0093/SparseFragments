<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <AssemblyName>PackageSparse.NoJson.Consumer</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Remove="TUnit;Shouldly" />
    <Using Remove="Shouldly" />
  </ItemGroup>
  <!-- No System.Text.Json reference by design (issues #242/#243): this
    fixture proves the serializer-independent core compiles and works without
    any JSON API surface. Do not add one here. -->
  <ItemGroup Condition="'$(SparseFragmentsPackageVersion)' == ''">
    <ProjectReference Include="../../../../src/SparseFragments/SparseFragments.csproj" />
    <ProjectReference
      Include="../../../../src/SparseFragments.Generator/SparseFragments.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
  <ItemGroup Condition="'$(SparseFragmentsPackageVersion)' != ''">
    <PackageReference Include="SparseFragments" Version="$(SparseFragmentsPackageVersion)" />
  </ItemGroup>
</Project>
