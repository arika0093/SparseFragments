@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using SparseFragments
@using SparseFragments.Blazor

@implements IDisposable

@* Compilable counterpart of docs/how-to/blazor-edit-form.md. The C# save
   lifecycle is verified by the Blazor consumer fixture (Program.cs); this
   component proves the Razor shape around it compiles: EditForm bound to the
   session model, an InputText adapter that edits through Observable while
   validation tracks the original model, and explicit conflict choices.
   The session type names the model-nested session because
   a field declaration requires it; handler code elsewhere prefers var.
   The EditForm carries a @key tied to an explicit session generation (#219):
   adopting a new session/EditContext tears down and recreates the input
   subtree, because InputBase caches its cascaded EditContext and throws when
   the same instance sees a different context. *@
<EditForm @key="formGeneration" EditContext="@editContext" OnValidSubmit="@HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <InputText Value="@session.Current.Number"
               ValueChanged="@OnNumberChanged"
               ValueExpression="@(() => live.Number)"
               disabled="@isSaving" />
    <ValidationMessage For="@(() => live.Number)" />
    <button type="submit" disabled="@isSaving">Save</button>
    @if (latestServer is not null)
    {
        <button type="button" disabled="@isSaving" @onclick="UseServerValue">Use server value</button>
    }
    @if (conflictNotice is not null)
    {
        <p>@conflictNotice</p>
    }
    @if (transportError is not null)
    {
        <p>@transportError</p>
    }
</EditForm>

@code {
    private BlazorEditFormOrder live = new() { Number = "ORD-1", Version = 7 };

    // Model-nested session; stable for this model identity.
    private global::BlazorEditFormOrder.EditSession session = null!;
    private EditContext editContext = null!;
    private ValidationMessageStore store = null!;
    private BlazorEditFormOrder? latestServer;
    private string? conflictNotice;
    private string? transportError;
    private bool isSaving;
    private int formGeneration;

    [Parameter]
    public FakeOrderSaveService SaveService { get; set; } = new();

    protected override void OnInitialized()
    {
        AdoptSession(live.CreateEditSession());
    }

    public void Dispose()
    {
        if (editContext is not null)
        {
            editContext.OnValidationRequested -= OnValidationRequested;
        }
    }

    private void OnValidationRequested(object? sender, ValidationRequestedEventArgs args)
    {
        store.Clear();
        if (string.IsNullOrWhiteSpace(session.Current.Number))
        {
            store.Add(session.Field(nameof(BlazorEditFormOrder.Number)), "Number is required.");
        }
    }

    private void OnNumberChanged(string value)
    {
        session.Observable.Number = value;
        editContext.NotifyFieldChanged(session.Field(nameof(BlazorEditFormOrder.Number)));
    }

    private async Task HandleValidSubmit()
    {
        isSaving = true;
        transportError = null;
        try
        {
            var submitted = session.CreateChangeSet();
            var result = await SaveService.SaveAsync(submitted.ToPayload(), CancellationToken.None);
            if (result is BlazorFormSaved saved)
            {
                latestServer = null;
                conflictNotice = null;
                AdoptSession(saved.Persisted.CreateEditSession());
            }
            else if (result is BlazorFormConflicted conflicted)
            {
                latestServer = conflicted.ServerState;
                // Probe on a defensive copy: TryApplyTo can mutate its target,
                // while the authoritative server row must stay pristine for the
                // explicit user decision below.
                var probe = CopyServerState(conflicted.ServerState);
                if (submitted.TryApplyTo(probe, out _, out var conflicts))
                {
                    // Row-version mismatch with disjoint changes: clean semantic
                    // rebase. Merge the server state, keep the pending edits,
                    // and ask for an explicit retry instead of silently returning.
                    var reload = session.Reload(conflicted.ServerState);
                    if (!reload.HasConflicts)
                    {
                        latestServer = null;
                        conflictNotice =
                            "Server changed other fields. Merged the latest values; review and save again.";
                    }
                    else
                    {
                        conflictNotice =
                            "Server reported a conflict. Use the server value or edit to resolve.";
                    }
                }
                else
                {
                    foreach (var conflict in conflicts)
                    {
                        session.AddValidationError(store, conflict.PathText, "Server kept a newer value.");
                    }
                    conflictNotice =
                        "Server kept a newer value. Keep editing, or use the server value to discard your change.";
                    editContext.NotifyValidationStateChanged();
                }
            }
        }
        catch (HttpRequestException)
        {
            transportError = "Save failed. Retry without losing edits.";
        }
        finally
        {
            isSaving = false;
        }
    }

    // Explicit discard choice (#220): replace the session and EditContext from
    // the authoritative response and drop local edits, field tracking, and
    // conflict errors with them. Reload alone cannot do this; it preserves the
    // local edit and keeps reporting the same overlap.
    private void UseServerValue()
    {
        if (latestServer is null)
        {
            return;
        }
        AdoptSession(latestServer.CreateEditSession());
        latestServer = null;
        conflictNotice = null;
    }

    private void AdoptSession(global::BlazorEditFormOrder.EditSession next)
    {
        // Detach from the previous context first: the named handler closes over
        // these fields, so a lingering subscription would clear the new store.
        if (editContext is not null)
        {
            editContext.OnValidationRequested -= OnValidationRequested;
        }
        session = next;
        live = session.GetModelForFrameworkAccess();
        editContext = session.CreateEditContext();
        store = session.CreateValidationStore(editContext);
        editContext.OnValidationRequested += OnValidationRequested;
        formGeneration++;
    }

    private static BlazorEditFormOrder CopyServerState(BlazorEditFormOrder source) =>
        new()
        {
            Number = source.Number,
            Note = source.Note,
            Version = source.Version,
            UpdatedAt = source.UpdatedAt,
        };
}
