<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <AssemblyName>PackageSparse.Blazor.Consumer</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Remove="TUnit;Shouldly" />
    <Using Remove="Shouldly" />
  </ItemGroup>
  <!-- Both packages ship from this repository at one shared version, so a
    single version property pins the whole candidate set under test. -->
  <ItemGroup Condition="'$(SparseTypesPackageVersion)' == ''">
    <ProjectReference Include="../../../../src/SparseTypes/SparseTypes.csproj" />
    <ProjectReference Include="../../../../src/SparseTypes.Blazor/SparseTypes.Blazor.csproj" />
    <ProjectReference
      Include="../../../../src/SparseTypes.Generator/SparseTypes.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
  <ItemGroup Condition="'$(SparseTypesPackageVersion)' != ''">
    <PackageReference Include="SparseTypes" Version="$(SparseTypesPackageVersion)" />
    <PackageReference
      Include="SparseTypes.Blazor"
      Version="$(SparseTypesPackageVersion)"
    />
  </ItemGroup>
</Project>
