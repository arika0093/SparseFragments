<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <AssemblyName>PackageSparse.Blazor.Consumer</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Remove="TUnit;Shouldly" />
    <Using Remove="Shouldly" />
  </ItemGroup>
  <!-- Both packages ship from this repository at one shared version (#46), so a
    single version property pins the whole candidate set under test. -->
  <ItemGroup Condition="'$(SparseFragmentsPackageVersion)' == ''">
    <ProjectReference Include="../../../../src/SparseFragments/SparseFragments.csproj" />
    <ProjectReference Include="../../../../src/SparseFragments.Blazor/SparseFragments.Blazor.csproj" />
    <ProjectReference
      Include="../../../../src/SparseFragments.Generator/SparseFragments.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
  <ItemGroup Condition="'$(SparseFragmentsPackageVersion)' != ''">
    <PackageReference Include="SparseFragments" Version="$(SparseFragmentsPackageVersion)" />
    <PackageReference
      Include="SparseFragments.Blazor"
      Version="$(SparseFragmentsPackageVersion)"
    />
  </ItemGroup>
</Project>
