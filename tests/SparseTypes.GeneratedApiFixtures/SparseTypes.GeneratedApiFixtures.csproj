<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SparseTypes.GeneratedApiFixtures</RootNamespace>
    <AssemblyName>SparseTypes.GeneratedApiFixtures</AssemblyName>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Enable on-disk generated output for inspection (obj/, git-ignored). -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Fixture library, not a test runner: undo tests/Directory.Build.props. -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SparseTypes/SparseTypes.csproj" />
    <ProjectReference
      Include="../../src/SparseTypes.Generator/SparseTypes.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="true"
    />
  </ItemGroup>
  <!-- tests/Directory.Build.props adds the test platform to every project under
    tests/; this fixture ships no tests, so drop it to keep the assembly clean. -->
  <ItemGroup>
    <PackageReference Remove="TUnit" />
    <PackageReference Remove="Shouldly" />
    <Using Remove="Shouldly" />
  </ItemGroup>
</Project>
