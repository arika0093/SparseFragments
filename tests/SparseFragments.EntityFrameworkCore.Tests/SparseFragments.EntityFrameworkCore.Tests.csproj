<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SparseFragments.EntityFrameworkCore.Tests</RootNamespace>
    <AssemblyName>SparseFragments.EntityFrameworkCore.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <!-- Explicit pin lifts the transitive SQLitePCLRaw.lib.e_sqlite3 past GHSA-2m69-gcr7-jv3q (NU1903). -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SparseFragments/SparseFragments.csproj" />
    <ProjectReference Include="../../src/SparseFragments.EntityFrameworkCore/SparseFragments.EntityFrameworkCore.csproj" />
    <ProjectReference
      Include="../../src/SparseFragments.Generator/SparseFragments.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="true"
    />
    <ProjectReference Include="../../samples/EfCoreSample.Server/EfCoreSample.Server.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="SparseFragments" />
    <Using Include="SparseFragments.EntityFrameworkCore" />
  </ItemGroup>
</Project>
