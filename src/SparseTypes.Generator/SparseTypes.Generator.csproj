<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>SparseTypes.Generator</AssemblyName>
    <RootNamespace>SparseTypes.Generator</RootNamespace>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PackageDescription>Standalone source generator for SparseTypes models.</PackageDescription>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- Analyzer release tracking (AnalyzerReleases.Shipped/Unshipped.md) is not used.
      Diagnostics are documented in docs/reference/analyzer.md and linked via HelpLinkUri. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Memory" Version="4.6.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.1" PrivateAssets="all" />
    <PackageReference
      Include="Microsoft.CodeAnalysis.Analyzers"
      Version="3.3.4"
      PrivateAssets="all"
    />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource
      Include="..\SparseTypes.Generator.Shared\Sessions\SparseEditSessionCore.template"
      LogicalName="SparseTypes.Generator.Shared.Sessions.SparseEditSessionCore.template"
      Type="Non-Resx"
    />
    <EmbeddedResource
      Include="..\SparseTypes.Generator.Shared\Sessions\SparseEditSessionWithCurrentCore.template"
      LogicalName="SparseTypes.Generator.Shared.Sessions.SparseEditSessionWithCurrentCore.template"
      Type="Non-Resx"
    />
    <!-- Shared generator sources are always compiled in-repo (#21).
      There is no NuGet fallback: the sibling Shared project is the single
      source of truth, so local and shipped generator behavior cannot diverge. -->
    <Compile
      Include="..\SparseTypes.Generator.Shared\**\*.cs"
      Exclude="..\SparseTypes.Generator.Shared\obj\**;..\SparseTypes.Generator.Shared\bin\**"
      LinkBase="Shared"
    />
  </ItemGroup>
</Project>
