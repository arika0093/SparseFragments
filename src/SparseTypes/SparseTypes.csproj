<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>SparseTypes</AssemblyName>
    <RootNamespace>SparseTypes</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageDescription>Typed partial state for C# with source-generated fragments and patches.</PackageDescription>
    <PackageTags>dotnet;source-generator;patch;merge;nativeaot</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference
      Include="../SparseTypes.Generator/SparseTypes.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
  <ItemGroup>
    <None
      Include="../SparseTypes.Generator/bin/$(Configuration)/netstandard2.0/SparseTypes.Generator.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
    />
    <None
      Include="../SparseTypes.Generator/build/SparseTypes.props"
      Pack="true"
      PackagePath="build/SparseTypes.props"
      Visible="false"
    />
    <None Include="..\..\README.md" Pack="true" PackagePath="/" Link="README.md" />
  </ItemGroup>
</Project>
