<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Internal-only source directory (#21): the shared generator sources are
      compiled directly into SparseFragments.Generator via an in-repo Compile
      glob. This project is not packed and no SparseFragments.Generator.Shared
      NuGet package is shipped; keeping a single in-repo path guarantees the
      shipped generator always matches the local sources.
    -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>SparseFragments.Generator.Shared</AssemblyName>
    <RootNamespace>SparseFragments.Generator.Shared</RootNamespace>
    <IsPackable>false</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
