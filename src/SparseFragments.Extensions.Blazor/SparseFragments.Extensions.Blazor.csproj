<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>SparseFragments.Extensions.Blazor</AssemblyName>
    <RootNamespace>SparseFragments.Extensions.Blazor</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageDescription>Blazor edit sessions for SparseFragments with semantic change tracking.</PackageDescription>
    <PackageTags>blazor;forms;patch;dotnet</PackageTags>
    <!-- Explicit README handling (#37): this package does not ship the core README. Clearing the
      inherited PackageReadmeFile keeps the Blazor package metadata explicit and valid. -->
    <PackageReadmeFile></PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SparseFragments/SparseFragments.csproj" />
  </ItemGroup>
</Project>
