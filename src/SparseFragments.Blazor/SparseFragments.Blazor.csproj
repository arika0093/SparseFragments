<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>SparseFragments.Blazor</AssemblyName>
    <RootNamespace>SparseFragments.Blazor</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageDescription>Blazor edit sessions for SparseFragments with semantic change tracking.</PackageDescription>
    <PackageTags>blazor;forms;patch;dotnet</PackageTags>
    <!-- Dedicated package README (#52): concise first-use page, not the core README. -->
    <PackageReadmeFile>README.Blazor.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.Blazor.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SparseFragments/SparseFragments.csproj" />
  </ItemGroup>
</Project>
